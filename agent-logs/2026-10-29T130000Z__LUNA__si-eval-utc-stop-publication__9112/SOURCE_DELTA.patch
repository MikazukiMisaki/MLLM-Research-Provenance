+"""Fake CPU-only CUDA boundary; no torch.cuda or real GPU is invoked."""
+import json
+from types import SimpleNamespace
+import pytest
+from self_improvement.si_transfer_eval.evaluator import EvaluationError
+from self_improvement.si_transfer_eval.resource import SharedGPU, GIB
+
+class Memory:
+    def __init__(self):self.fraction=None
+    def get_allocator_backend(self):return 'native'
+    def set_per_process_memory_fraction(self, fraction, device):self.fraction=fraction
+    def get_per_process_memory_fraction(self, device):return self.fraction
+    def memory_stats(self,device):return {'allocated_bytes.all.current':0,'allocated_bytes.all.peak':0,'reserved_bytes.all.current':0,'reserved_bytes.all.peak':0,'num_ooms':0,'num_alloc_retries':0}
+
+class Cuda:
+    def __init__(self,free,uuid):self.free=free;self.uuid=uuid;self.memory=Memory();self.initialized=False
+    def init(self):self.initialized=True
+    def is_available(self):return True
+    def device_count(self):return 1
+    def get_device_properties(self,device):return SimpleNamespace(uuid=self.uuid)
+    def mem_get_info(self,device):return self.free,40*GIB
+    def synchronize(self):pass
+
+class FakeTorch:
+    uint8='fake-uint8'
+    def __init__(self,free,uuid):self.cuda=Cuda(free,uuid)
+    def empty(self,*args,**kwargs):return object()
+
+UUID='GPU-00000000-1111-2222-3333-444444444444'
+
+def test_shared_memory_guard_records_checks_without_ownership_claim(tmp_path):
+    fake=FakeTorch(35*GIB,UUID[4:]);guard=SharedGPU(expected_uuid=UUID,journal_path=tmp_path/'gpu.jsonl');guard.before_model_load(fake);guard.before_generation(fake,arm='A');guard.close()
+    rows=[json.loads(x) for x in (tmp_path/'gpu.jsonl').read_text().splitlines()]
+    assert [r['point'] for r in rows]==['cuda_initialization_intent','preweight','one_byte_before_weights','before_generation']
+    assert all(r['ownership']=='UNPROVEN_NOT_ASSERTED' for r in rows)
+    assert rows[-1]['allocator_limit_bytes']==24*GIB
+
+@pytest.mark.parametrize('free,uuid',[(27*GIB,UUID[4:]),(35*GIB,'ffffffff-1111-2222-3333-444444444444')])
+def test_wrong_uuid_or_busy_device_fails_before_weights(tmp_path,free,uuid):
+    fake=FakeTorch(free,uuid);guard=SharedGPU(expected_uuid=UUID,journal_path=tmp_path/'gpu.jsonl')
+    with pytest.raises(EvaluationError):guard.before_model_load(fake)
+    guard.close();rows=[json.loads(x) for x in (tmp_path/'gpu.jsonl').read_text().splitlines()]
+    assert rows[-1]['status']=='REJECTED' and not any(r.get('point')=='model_loaded' for r in rows)
+
+
+def test_allocator_oom_counter_stops_and_is_preserved(tmp_path):
+    fake=FakeTorch(35*GIB,UUID[4:]);guard=SharedGPU(expected_uuid=UUID,journal_path=tmp_path/'gpu.jsonl');guard.before_model_load(fake)
+    old=fake.cuda.memory.memory_stats
+    fake.cuda.memory.memory_stats=lambda device:old(device)|{'num_ooms':1}
+    with pytest.raises(EvaluationError,match='OOM'):guard.before_generation(fake,arm='A')
+    guard.close();rows=[json.loads(x) for x in (tmp_path/'gpu.jsonl').read_text().splitlines()]
+    assert rows[-1]['status']=='REJECTED' and rows[-1]['allocator_stats']['num_ooms']==1
+
+
+def test_allocator_retry_rejected_for_engineering_but_recorded_for_science(tmp_path):
+    for engineering in (True,False):
+        fake=FakeTorch(35*GIB,UUID[4:]);guard=SharedGPU(expected_uuid=UUID,journal_path=tmp_path/str(engineering),engineering_only=engineering);guard.before_model_load(fake)
+        old=fake.cuda.memory.memory_stats;fake.cuda.memory.memory_stats=lambda device:old(device)|{'num_alloc_retries':1}
+        if engineering:
+            with pytest.raises(EvaluationError,match='retry'):guard.before_generation(fake,arm='A')
+        else:guard.before_generation(fake,arm='A')
+        guard.close();row=json.loads((tmp_path/str(engineering)).read_text().splitlines()[-1])
+        assert row['allocator_stats']['num_alloc_retries']==1 and row['status']==('REJECTED' if engineering else 'PASS')
