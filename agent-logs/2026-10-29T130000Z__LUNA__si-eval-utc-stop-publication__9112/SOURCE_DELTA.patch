+#!/usr/bin/env python3
+"""One statically preflighted and independently cleared three-arm evaluation."""
+from __future__ import annotations
+import argparse,json,sys,time
+from datetime import datetime,timezone
+from pathlib import Path
+sys.dont_write_bytecode=True
+ROOT=Path(__file__).resolve().parents[1]
+sys.path.insert(0,str(ROOT/'src'))
+from self_improvement.si_transfer_eval.evaluator import _need
+from self_improvement.si_transfer_eval.gate import authenticate_preflight,write_preflight
+
+
+def main():
+    entered=time.monotonic();parser=argparse.ArgumentParser(description=__doc__)
+    mode=parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument('--preflight-only',action='store_true');mode.add_argument('--live',action='store_true');mode.add_argument('--worker',action='store_true',help=argparse.SUPPRESS)
+    parser.add_argument('--authorization',type=Path,required=True);parser.add_argument('--authorization-sha256',required=True)
+    parser.add_argument('--clearance',type=Path);parser.add_argument('--clearance-sha256');parser.add_argument('--launch-context-sha256',help=argparse.SUPPRESS)
+    args=parser.parse_args()
+    try:
+        _need(sys.flags.isolated==1,'pinned Python isolated mode required')
+        if args.preflight_only:
+            _need(args.clearance is None and args.clearance_sha256 is None and args.launch_context_sha256 is None,'preflight scope')
+            auth,receipt=authenticate_preflight(ROOT,args.authorization,args.authorization_sha256,argv=list(sys.orig_argv))
+            write_preflight(auth,receipt);print(json.dumps(receipt));return 0
+        _need(args.clearance is not None and args.clearance_sha256 is not None,'independent live clearance required')
+        from self_improvement.si_transfer_eval.live_gate import authenticate_live,authenticate_worker
+        m='worker' if args.worker else 'live'
+        permit=authenticate_live(ROOT,args.authorization,args.authorization_sha256,args.clearance,args.clearance_sha256,mode=m,argv=list(sys.orig_argv))
+        if args.worker:
+            _need(args.launch_context_sha256 is not None,'supervisor context hash required')
+            worker=authenticate_worker(permit,args.launch_context_sha256,argv=list(sys.orig_argv))
+            from self_improvement.si_transfer_eval.evaluator import Evaluator
+            from self_improvement.si_transfer_eval.live_runtime import ProductionProducer,ProductionEnvironment
+            from self_improvement.si_transfer_eval.resource import SharedGPU
+            from self_improvement.si_transfer_eval.runtime_binding import file_binding
+            env=permit.spec['environment'];games={r['task_id']:r for r in permit.spec['games']};adapters=permit.spec['adapters'];resource=SharedGPU(expected_uuid=permit.protocol['resource']['gpu_uuid'],journal_path=permit.output/'resource.jsonl')
+            identity=json.loads(file_binding(permit.spec['training_protocol']).read_bytes())['runtime_identity']
+            try:
+                def producer_factory(arm,sha):
+                    return ProductionProducer.load(arm=arm,adapter_path=Path(adapters[arm]['path']),adapter_sha256=sha,base_path=Path(permit.spec['base_path']),base_sha256=permit.spec['base_sha256'],resource=resource,packages=permit.spec['packages'],runtime_identity=identity,import_receipt_dir=permit.output)
+                def env_factory(task):
+                    return ProductionEnvironment(task,game=Path(games[task['task_id']]['game']['path']),traj_data=Path(games[task['task_id']]['traj_data']['path']),traj_sha256=games[task['task_id']]['traj_data']['sha256'],config_path=Path(env['config']['path']),config_sha256=env['config']['sha256'],data_root=Path(env['data_root']),pool_seed=env['pool_seed'],packages=permit.spec['packages'])
+                result=Evaluator(permit.manifest,permit.output/'evaluation',producer_factory=producer_factory,environment_factory=env_factory,evidence_class='live',allocation_started_at=worker.allocation_started_monotonic,live_permit=worker).run()
+                return 0 if result['status']=='COMPLETE' and not result['pending_na'] else 1
+            finally:resource.close()
+        _need(args.launch_context_sha256 is None,'live supervisor cannot accept worker context')
+        from self_improvement.si_transfer_eval.supervisor import supervise
+        from self_improvement.si_p3.runtime_gate import utc
+        remaining=(min(utc(permit.authorization['expires']),utc(permit.clearance['expires']))-datetime.now(timezone.utc)).total_seconds()
+        _need(remaining>=permit.manifest['limits']['elapsed_seconds'], 'insufficient authorization window for full frozen allocation')
+        seconds=permit.manifest['limits']['elapsed_seconds']
+        command=['--worker' if x=='--live' else x for x in sys.orig_argv]
+        context={'authorization_sha256':permit.authorization_sha256,'source_sha':permit.authorization['source_sha'],'evidence_class':'live','binding':permit.binding,'clearance_sha256':permit.clearance_sha256,'allocation_started_monotonic':entered,'max_allocation_seconds':permit.manifest['limits']['elapsed_seconds'],'per_arm_allocation_seconds':permit.manifest['arm_limits']['elapsed_seconds'],'supervisor_argv':list(sys.orig_argv)}
+        exit_receipt=supervise(command,permit.output,context=context,seconds=seconds,environment=permit.authorization['environment'],capability=permit)
+        return 0 if exit_receipt['authentic_returncode']==0 and exit_receipt['execution_status']=='EXIT_RECORDED' and exit_receipt['child_report_present'] else 1
+    except Exception as exc:
+        print(json.dumps({'status':'REJECTED_OR_INCONCLUSIVE','exception':type(exc).__name__,'message':str(exc)}),file=sys.stderr);return 1
+
+
+if __name__=='__main__':raise SystemExit(main())
