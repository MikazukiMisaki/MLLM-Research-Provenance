+"""Offline CPU audit of the separate engineering-only event stream."""
+from __future__ import annotations
+import json
+from pathlib import Path
+from models.action_parser import action_id_mapping
+from models.protocol_stability import parse_p2_selection
+from self_improvement.si_p3.contract import PublicState,projection
+from .engineering import ENGINEERING_LIMITS
+from .evaluator import COUNTERS,OUTPUT_CAP,_hash,_need,validate_generation
+from .return_audit import add_return, generation_observation, validate_completed
+
+
+def audit_interrupted(path:Path):
+    """Reconcile an unfinished engineering ledger without claiming success."""
+    rows=[json.loads(x) for x in Path(path).read_text().splitlines()]
+    _need(rows and rows[0]['kind']=='run_opened' and rows[-1]['kind']!='run_closed','interrupted engineering journal required')
+    prev=None
+    for i,row in enumerate(rows):
+        _need(row['sequence']==i and row['previous']==prev and row['event_id']==_hash({k:v for k,v in row.items() if k!='event_id'}),'interrupted engineering chain');prev=row['event_id']
+    h=rows[0]['payload'];_need(h['schema']=='SI_U1_EVAL_ENGINEERING_EVENTS_V1' and h['limits']==ENGINEERING_LIMITS and h['scientific_result'] is False,'engineering header')
+    units={};active=None;spent=dict.fromkeys(COUNTERS,0)
+    for row in rows[1:]:
+        p=row['payload'];kind=row['kind']
+        if kind=='unit_started':
+            op=p['op'];debit=dict.fromkeys(COUNTERS,0);_need(active is None and op not in units and op in ('model_load','environment_construct','reset','generation','step','environment_close','model_close'),'engineering reservation identity')
+            if op in ('reset','step'):debit['environment_operations']=1
+            if op=='generation':
+                prep=p['prepared'];_need(type(prep) is dict and type(prep.get('input_ids')) is list and bool(prep['input_ids']),'engineering input')
+                debit.update(generations=1,input_tokens=len(prep['input_ids']),output_tokens=OUTPUT_CAP)
+            _need(p['reservation']==debit and all(spent[k]+debit[k]<=ENGINEERING_LIMITS[k] for k in COUNTERS),'engineering debit')
+            spent={k:spent[k]+debit[k] for k in COUNTERS};units[op]={'event_id':row['event_id'],'prepared':p['prepared'],'returns':[],'debit':debit};active=op
+        elif kind=='external_returned':
+            op=p['op'];_need(active==op,'engineering return identity');add_return(units[op],op,row)
+        elif kind in ('unit_completed','unit_failed'):
+            op=p['op'];u=units[op];_need(active==op and p['started_event']==u['event_id'] and p['return_events']==[x['id'] for x in u['returns']],'engineering completion binding')
+            if kind=='unit_completed':
+                validate_completed(u,op,p['data'],require_live=h['evidence_class']=='live_engineering_only');actual=dict(u['debit'])
+                if op=='generation':actual['output_tokens']=len(p['data']['token_ids'])
+                _need(p['actual']==actual and actual['output_tokens']<=u['debit']['output_tokens'],'engineering actual debit');spent['output_tokens']-=u['debit']['output_tokens']-actual['output_tokens']
+            active=None
+        else:_need(False,'unexpected interrupted engineering event')
+    return {'status':'INTERRUPTED_ENGINEERING_NOT_COMPLETE','scientific_result':False,'reserved_or_spent':spent,'active_operation':active,'generation_return_observation':generation_observation(units.values())}
+
+
+def audit(path:Path,*,decode,eos_ids,live_binding=None,live_output:Path|None=None):
+    rows=[json.loads(x) for x in Path(path).read_text().splitlines()];_need(bool(rows) and rows[0]['kind']=='run_opened' and rows[-1]['kind']=='run_closed','engineering journal boundaries')
+    prev=None
+    for i,row in enumerate(rows):
+        _need(row['sequence']==i and row['previous']==prev and row['event_id']==_hash({k:v for k,v in row.items() if k!='event_id'}),'engineering journal chain');prev=row['event_id']
+    h=rows[0]['payload'];_need(h['schema']=='SI_U1_EVAL_ENGINEERING_EVENTS_V1' and h['limits']==ENGINEERING_LIMITS and h['scientific_result'] is False,'engineering-only header')
+    if h['evidence_class']=='synthetic':_need(h['live_binding'] is None and live_binding is None and live_output is None,'synthetic binding')
+    else:
+        from .live_audit import authenticate_engineering_run
+        _need(h['evidence_class']=='live_engineering_only' and live_output is not None and Path(path)==Path(live_output)/'engineering'/'engineering_events.jsonl' and h['live_binding']==authenticate_engineering_run(live_output) and (live_binding is None or live_binding==h['live_binding']),'real engineering provenance')
+    task=h['task'];units={};active=None;completed=dict.fromkeys(COUNTERS,0);used=dict.fromkeys(COUNTERS,0);state=None;parsed=None;step=False
+    for row in rows[1:-1]:
+        p=row['payload']
+        if row['kind']=='unit_started':
+            op=p['op'];_need(active is None and op not in units and op in ('model_load','environment_construct','reset','generation','step','environment_close','model_close'),'engineering unit order/retry')
+            debit=dict.fromkeys(COUNTERS,0)
+            if op in ('reset','step'):debit['environment_operations']=1
+            if op=='generation':
+                prepared=p['prepared'];_need(type(prepared) is dict and prepared['prompt']==projection(state,[])['public_prompt'] and type(prepared['input_ids']) is list and bool(prepared['input_ids']) and prepared['attention_mask']==[1]*len(prepared['input_ids']),'engineering causal input')
+                debit.update(generations=1,input_tokens=len(prepared['input_ids']),output_tokens=OUTPUT_CAP)
