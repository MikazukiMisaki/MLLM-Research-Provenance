+"""Pinned interpreter and package identity, separating static from real import."""
+from __future__ import annotations
+
+import hashlib
+import importlib
+import importlib.metadata
+import importlib.util
+import json
+import os
+import sys
+from pathlib import Path
+
+from self_improvement.si_s01.evidence import atomic_fresh_json
+from .training import ContractError, file_sha256
+
+PACKAGES = {"torch": "torch", "peft": "peft", "transformers": "transformers", "tokenizers": "tokenizers", "safetensors": "safetensors", "accelerate": "accelerate", "huggingface_hub": "huggingface-hub"}
+
+
+def python_version() -> str:
+    return sys.version
+
+
+def package_tree_sha256(root: Path) -> str:
+    """All package source, assets and binaries; omit only Python bytecode caches.
+
+    Symlinks are rejected rather than following mutable links outside the tree.
+    This does not claim to hash external shared libraries or the whole environment.
+    """
+    if root.is_symlink() or not root.is_dir():
+        raise ContractError("package root must be an ordinary directory")
+    entries = []
+    for current, directories, files in os.walk(root, followlinks=False):
+        parent = Path(current)
+        directories[:] = sorted(d for d in directories if d != "__pycache__")
+        if any((parent / d).is_symlink() for d in directories):
+            raise ContractError("package tree directory symlink is forbidden")
+        for name in sorted(files):
+            if name.endswith((".pyc", ".pyo")):
+                continue
+            path = parent / name
+            if path.is_symlink() or not path.is_file():
+                raise ContractError("package tree non-ordinary file or symlink")
+            entries.append([path.relative_to(root).as_posix(), path.stat().st_size, file_sha256(path)])
+    if not entries:
+        raise ContractError("empty package tree")
+    # Path component ordering matches the independent protocol fingerprint.
+    entries.sort(key=lambda entry: Path(entry[0]))
+    return hashlib.sha256(json.dumps(entries, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
+
+
+def static_identity() -> dict:
+    """Observe locations and metadata without importing the target packages."""
+    interpreter = Path(sys.executable).resolve()
+    packages = {}
+    for name, distribution in PACKAGES.items():
+        spec = importlib.util.find_spec(name)
+        if spec is None or not isinstance(spec.origin, str):
+            raise ContractError(f"missing static package origin: {name}")
+        path = Path(spec.origin).resolve()
+        if not path.is_file():
+            raise ContractError(f"package origin is not a file: {name}")
+        packages[name] = {"path": str(path), "sha256": file_sha256(path), "version": importlib.metadata.version(distribution), "tree_sha256": package_tree_sha256(path.parent)}
+    return {"interpreter": {"path": str(interpreter), "sha256": file_sha256(interpreter), "python_version": python_version()}, "packages": packages}
+
+
+def identity_digest(expected: dict) -> str:
+    return hashlib.sha256(json.dumps(expected, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def verify_static(expected: dict, interpreter: str, shuffle: dict) -> None:
+    """Check signed expectations, interpreter bytes, module spec and metadata."""
+    if not isinstance(expected, dict) or set(expected) != {"interpreter", "packages"}:
+        raise ContractError("runtime identity schema")
+    if not isinstance(expected["interpreter"], dict) or set(expected["interpreter"]) != {"path", "sha256", "python_version"}:
+        raise ContractError("interpreter identity schema")
+    if not isinstance(expected["packages"], dict) or set(expected["packages"]) != set(PACKAGES):
+        raise ContractError("runtime package identity set")
+    for name, item in expected["packages"].items():
+        if not isinstance(item, dict) or set(item) != {"path", "sha256", "version", "tree_sha256"}:
+            raise ContractError(f"runtime package identity schema: {name}")
+    if Path(interpreter).resolve() != Path(expected["interpreter"]["path"]) or Path(interpreter).resolve() != Path(sys.executable).resolve():
+        raise ContractError("pinned interpreter path differs")
+    if shuffle.get("python_version_binding") != expected["interpreter"]["python_version"]:
+        raise ContractError("shuffle Python version is not the pinned version")
+    interpreter_path = Path(sys.executable).resolve()
+    if file_sha256(interpreter_path) != expected["interpreter"]["sha256"] or python_version() != expected["interpreter"]["python_version"]:
+        raise ContractError("static interpreter bytes or version mismatch")
+    for name, distribution in PACKAGES.items():
+        spec = importlib.util.find_spec(name)
+        if spec is None or not isinstance(spec.origin, str):
+            raise ContractError(f"missing static package origin: {name}")
+        path = Path(spec.origin).resolve()
+        signed = expected["packages"][name]
+        if str(path) != signed["path"] or file_sha256(path) != signed["sha256"] or importlib.metadata.version(distribution) != signed["version"]:
+            raise ContractError(f"static package origin, version or entrypoint mismatch: {name}")
+    for name in PACKAGES:
+        signed = expected["packages"][name]
+        if package_tree_sha256(Path(signed["path"]).parent) != signed["tree_sha256"]:
+            raise ContractError(f"static package tree mismatch: {name}")
+
+
+def verify_actual_imports(expected: dict, receipt_path: Path) -> dict:
+    """Import actual modules once and persist observations before model work."""
+    result = {"schema": "SI_CONTINUATION_RUNTIME_IMPORT_V1", "runtime_identity_sha256": identity_digest(expected), "python_version": python_version(), "modules": {}, "status": "FAILED"}
+    try:
+        if result["python_version"] != expected["interpreter"]["python_version"] or Path(sys.executable).resolve() != Path(expected["interpreter"]["path"]) or file_sha256(Path(sys.executable).resolve()) != expected["interpreter"]["sha256"]:
+            raise ContractError("actual interpreter identity drift")
+        for name in PACKAGES:
+            module = importlib.import_module(name)
+            path = Path(module.__file__).resolve()
+            actual = {"path": str(path), "sha256": file_sha256(path), "version": str(module.__version__), "tree_sha256": package_tree_sha256(path.parent), "spec_origin": str(Path(module.__spec__.origin).resolve())}
+            result["modules"][name] = actual
+            signed = expected["packages"][name]
+            if {k: actual[k] for k in ("path", "sha256", "version", "tree_sha256")} != signed or actual["spec_origin"] != signed["path"]:
+                raise ContractError(f"actual imported package identity mismatch: {name}")
+        result["status"] = "PASS_ACTUAL_IMPORTED_MODULES"
+    except BaseException as exc:
+        result["error"] = f"{type(exc).__name__}: {exc}"
+        atomic_fresh_json(receipt_path, result)
+        raise
+    atomic_fresh_json(receipt_path, result)
+    return result
