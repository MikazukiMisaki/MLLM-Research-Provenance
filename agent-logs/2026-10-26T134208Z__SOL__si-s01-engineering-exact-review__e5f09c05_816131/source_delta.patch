+        insist(self.active is not None,'engineering runtime observation requires reserved active unit')
+        unit=self.units[self.active]
+        if kind=='generation_returned':
+            insist(unit['identity']['kind']=='generation' and 'return_event' not in unit,'one engineering generation return')
