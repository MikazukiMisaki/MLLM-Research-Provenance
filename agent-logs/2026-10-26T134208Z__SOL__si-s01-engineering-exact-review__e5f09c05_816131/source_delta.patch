+        report.get('science_authorized') is False and report.get('source_sha')==receipt['source_sha'] and
+        report.get('status')=='OBSERVED_PUBLIC_PATH_COMPATIBLE_NOT_RNG_RECONSTRUCTED' and report.get('internal_rng_reconstructed') is False)
