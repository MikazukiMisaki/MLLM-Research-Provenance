+"""Read-only exact-byte bindings for future reviewed three-arm runtime.
+
+No model, tokenizer, CUDA or environment is imported or constructed here.
+Successful validation is not authorization to launch a worker.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from typing import Any, Mapping
+from .evaluator import ARMS, _hash, _need, validate_manifest
+
+
+def file_sha256(path: Path) -> str:
+    h = hashlib.sha256()
+    with Path(path).open('rb') as f:
+        for block in iter(lambda: f.read(1024*1024), b''):
+            h.update(block)
+    return h.hexdigest()
+
+
+def file_binding(binding: Mapping[str, Any]) -> Path:
+    _need(type(binding) is dict and set(binding) == {'path', 'sha256'}, 'file binding shape')
+    path = Path(binding['path'])
+    _need(path.is_absolute() and path.is_file() and file_sha256(path) == binding['sha256'], 'bound file bytes')
+    return path
+
+
+def tree_sha256(path: Path) -> str:
+    """Match continuation trainer tree digest; no file content in metadata."""
+    path = Path(path)
+    _need(not path.is_symlink() and path.is_dir(), 'model/adapter tree must be ordinary directory')
+    rows = []
+    for item in sorted(path.rglob('*')):
+        _need(not item.is_symlink() or item.is_file(), 'broken/directory symlink in artifact tree')
+        if item.is_file():
+            rows.append([item.relative_to(path).as_posix(), item.stat().st_size, file_sha256(item)])
+        else:
+            _need(item.is_dir(), 'unexpected artifact entry')
+    _need(bool(rows), 'empty adapter tree')
+    return hashlib.sha256(json.dumps(rows, separators=(',', ':'), ensure_ascii=False).encode()).hexdigest()
+
+
+
+def legacy_directory_sha256(path: Path) -> str:
+    """Historical SFT-P0 provenance digest uses path names and file bytes."""
+    path = Path(path); _need(path.is_dir(), 'P0 directory missing'); h=hashlib.sha256()
+    files = sorted(x for x in path.rglob('*') if x.is_file()); _need(bool(files), 'empty P0')
+    for p in files:
+        h.update(str(p.relative_to(path)).encode())
+        with p.open('rb') as f:
+            for block in iter(lambda: f.read(1024*1024), b''): h.update(block)
+    return h.hexdigest()
+
+
+def verify_training_receipt(row: Mapping[str, Any], *, arm: str, p0_sha256: str,
+                            expected_adapter_sha256: str, base_sha256: str, training_source_sha: str, training_protocol_sha256: str) -> dict[str, Any]:
+    """Bind successful training and a real supervisor; no self-reported PASS alone."""
+    _need(type(row) is dict and set(row) == {'training_result', 'supervisor_exit', 'manifest'}, 'receipt shape')
+    result_path = file_binding(row['training_result']); exit_path = file_binding(row['supervisor_exit'])
+    manifest_path=file_binding(row['manifest']); train_manifest=json.loads(manifest_path.read_bytes())
+    result = json.loads(result_path.read_bytes()); supervisor = json.loads(exit_path.read_bytes())
+    _need(result.get('schema') == 'SI_CONTINUATION_RESULT_V1' and result.get('status') == 'COMPLETED', 'completed training receipt required')
+    _need(result.get('p0_adapter_sha256') == p0_sha256 and result.get('base_sha256') == base_sha256 and result.get('final_adapter_sha256') == expected_adapter_sha256, 'training lineage')
+    _need(result.get('arm') == arm and result.get('manifest_sha256') == row['manifest']['sha256'] and train_manifest.get('arm')==arm and train_manifest.get('schema')=='SI_CONTINUATION_DATA_V1', 'training arm/manifest')
+    _need(supervisor.get('schema') == 'SI_CONTINUATION_SUPERVISOR_EXIT_V1' and supervisor.get('training_result_sha256') == row['training_result']['sha256'], 'supervisor result binding')
+    _need(supervisor.get('authentic_returncode') == 0 and supervisor.get('cleanup_established') is True and supervisor.get('status') == 'EXIT_RECORDED' and supervisor.get('within_time_cap') is True and supervisor.get('retry_authorized') is False, 'training subprocess success and cleanup required')
+    binding = supervisor.get('binding'); _need(type(binding) is dict and binding.get('arm') == arm and binding.get('source_sha') == training_source_sha and binding.get('protocol_sha256') == training_protocol_sha256 and binding.get('manifest_sha256') == result.get('manifest_sha256') and binding.get('evidence_class') == 'live', 'training supervisor binding')
