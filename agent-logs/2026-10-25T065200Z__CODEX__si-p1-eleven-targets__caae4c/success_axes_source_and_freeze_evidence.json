  "current_static_methods": {
    "Trajectory.succeeded": {
      "method": "succeeded",
      "line": 60,
      "end_line": 62,
      "AST_sha256": "2f530611b6508d5b9c9764c5c109571cdb1aed9d20d210c2f15261f7925a5d28",
      "source_text": "def succeeded(self) -> bool:\n        \"\"\"Return whether ALFWorld emitted a positive terminal reward.\"\"\"\n        return bool(self.steps and self.steps[-1].done and self.steps[-1].reward > 0)"
    },
    "AlfWorldTextEnvironment.step": {
      "method": "step",
      "line": 58,
      "end_line": 72,
      "AST_sha256": "2d76fe6ff761a40e84ddea0e0ef7d141c55e481693ee0832472f7dd6d6b59aa4",
      "source_text": "def step(self, action: str) -> Transition:\n        \"\"\"Apply one text action to ALFWorld.\"\"\"\n        if self._environment is None:\n            raise RuntimeError(\"reset() must be called before step()\")\n        observations, rewards, dones, info = self._environment.step([action])\n        info_dict = self._info_dict(info)\n        self._valid_actions = self._valid_actions_from_info(info_dict)\n        return Transition(\n            observation=self._first(observations),\n            reward=float(self._first(rewards)),\n            done=bool(self._first(dones)),\n            truncated=False,\n            valid_actions=self._valid_actions,\n            metadata={\"alfworld_info\": info_dict},\n        )"
    },
    "R19.record_step": {
      "method": "record_step",
      "line": 1635,
      "end_line": 1663,
      "AST_sha256": "367f5e08662d784b515ebd6a7e6ac8e2f2f74a5464f55bd71fdfe81c9373a2d9",
      "source_text": "def record_step(\n        self, env: Any, command: str, identity: Mapping[str, Any],\n        *, before: Mapping[str, Any], action_id: str | None = None,\n    ) -> tuple[Any, str]:\n        from models.action_parser import action_id_mapping\n\n        self._reserve_environment_step(identity)\n        mapping = action_id_mapping(tuple(map(str, before[\"valid_actions\"])))\n        start_identity = dict(identity)\n        self.sink(\"environment_operation_started\", start_identity, {\n            \"operation\": identity.get(\"operation\"), \"command\": command,\n            \"action_id\": action_id, \"action_map\": mapping,\n            \"before_state\": dict(before),\n        })\n        transition_obj = env.step(command)\n        transition = {\n            \"observation\": str(transition_obj.observation),\n            \"valid_actions\": list(transition_obj.valid_actions or ()),\n            \"reward\": float(transition_obj.reward),\n            \"done\": bool(transition_obj.done),\n            \"truncated\": bool(transition_obj.truncated),\n            \"executed_command\": command,\n        }\n        complete = self.sink(\"environment_operation_completed\", start_identity, {\n            \"operation\": identity.get(\"operation\"), \"command\": command,\n            \"action_id\": action_id, \"action_map\": mapping,\n            \"before_state\": dict(before), \"transition\": transition,\n        })\n        return transition_obj, str(complete[\"event_id\"])"
    },
    "R19.run_sft_suffix": {
      "method": "run_sft_suffix",
      "line": 2204,
      "end_line": 2277,
      "AST_sha256": "e8a22a804a6fb1c689fa1ab0fa4fd8eff7614d0589f337890844070bfae9edd5",
      "source_text": "def run_sft_suffix(\n        self, prefix_id: str, canonical_trial_id: str, cursor: RecoveryCursor,\n        action_cap: int, k: int,\n    ) -> dict[str, Any]:\n        from models.action_parser import action_id_mapping\n\n        env = self.suffix_envs.pop((prefix_id, int(k)), None)\n        if env is None:\n            raise EvidenceIntegrityError(\"SFT suffix has no isolated reset-and-replay environment\")\n        generations: list[dict[str, Any]] = []\n        generation_ids: list[str] = []\n        transition_ids: list[str] = []\n        prompts: list[str] = []\n        env_actions = 0\n        success = 0\n        terminal = False\n        reason = \"remaining_horizon\"\n        current = cursor\n        try:\n            for offset in range(action_cap):\n                generation_identity = {\n                    \"prefix_id\": prefix_id, \"canonical_trial_id\": canonical_trial_id,\n                    \"operation\": \"sft_generation\",\n                    \"k\": int(k), \"decision_index\": offset,\n                    \"actions_consumed\": current.actions_consumed,\n                }\n                generation, parsed, generation_id = self.actor_generation(\n                    current, component=\"sft\", identity=generation_identity,\n                )\n                generation_ids.append(generation_id)\n                generations.append(generation)\n                prompts.append(parsed[\"prompt\"])\n                if parsed[\"status\"] != \"selected\":\n                    reason = \"selection_failure\"\n                    break\n                before = {\"observation\": current.observation,\n                          \"valid_actions\": list(current.valid_actions),\n                          \"history\": [list(item) for item in current.history],\n                          \"actions_consumed\": current.actions_consumed}\n                transition, transition_id = self.record_step(\n                    env, str(parsed[\"action\"]),\n                    {\"prefix_id\": prefix_id,\n                     \"canonical_trial_id\": canonical_trial_id,\n                     \"component\": \"sft\", \"operation\": \"sft_environment_step\",\n                     \"k\": int(k), \"decision_index\": offset},\n                    before=before, action_id=parsed[\"action_id\"],\n                )\n                transition_ids.append(transition_id)\n                env_actions += 1\n                current = RecoveryCursor(\n                    task=current.task, task_id=current.task_id,\n                    canonical_trial_id=current.canonical_trial_id,\n                    nominal_seed=current.nominal_seed,\n                    observation=str(transition.observation),\n                    valid_actions=tuple(map(str, transition.valid_actions or ())),\n                    history=(*current.history, (current.observation, str(parsed[\"action\"]))),\n                    actions_consumed=current.actions_consumed + 1,\n                )\n                terminal = bool(transition.done or transition.truncated)\n                if terminal:\n                    success = int(bool(transition.done and float(transition.reward) > 0))\n                    reason = \"environment_terminal\" if transition.done else \"environment_truncated\"\n                    break\n            return {\n                \"success\": success, \"generations\": generations,\n                \"environment_actions\": env_actions, \"terminal\": terminal,\n                \"termination_reason\": reason, \"prompts\": prompts,\n                \"evidence_refs\": {\n                    \"suffix_generation_event_ids\": generation_ids,\n                    \"suffix_transition_event_ids\": transition_ids,\n                },\n            }\n        finally:\n            env.close()"
    }
  },
