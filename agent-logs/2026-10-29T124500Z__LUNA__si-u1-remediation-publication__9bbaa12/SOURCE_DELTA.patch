+    steps = result.get("optimizer_step_seconds", [])
+    t = plan["training"]
+    expected_counts = {"microbatches_started": t["maximum_microbatches"], "microbatches_completed": t["maximum_microbatches"], "optimizer_steps_started": 2, "optimizer_steps_completed": 2, "input_tokens": t["maximum_nonpad_input_tokens"], "supervised_tokens": t["maximum_supervised_tokens"], "trial_saves_started": 1, "trial_saves_completed": 1}
+    valid = (result.get("schema") == "SI_CONTINUATION_ENGINEERING_RESULT_V1" and result.get("evidence_class") == evidence_class and receipt.get("binding", {}).get("evidence_class") == evidence_class and result.get("status") == "ENGINEERING_COMPLETED" and result.get("scientific_checkpoint_eligible") is False and result.get("trial_adapter_deleted") is True and result.get("counts") == expected_counts and type(result.get("trial_adapter_bytes")) is int and result["trial_adapter_bytes"] > 0 and isinstance(result.get("trial_adapter_sha256"), str) and len(result["trial_adapter_sha256"]) == 64 and len(steps) == 2 and all(type(x) in (int, float) and math.isfinite(x) and x > 0 for x in steps) and receipt.get("authentic_returncode") == 0 and receipt.get("status") == "EXIT_RECORDED" and receipt.get("cleanup_established") is True and receipt.get("within_time_cap") is True and bool(receipt.get("engineering_result_sha256")) and bool(receipt.get("runtime_import_receipt_sha256")))
+    if evidence_class == "engineering_live":
+        valid = valid and result.get("post_cleanup_allocated_bytes") == 0 and result.get("post_cleanup_reserved_bytes") == 0
+        expected_points = (["before_model_load", "after_model_load"] + ["before_microbatch"] * t["gradient_accumulation_steps"] + ["after_optimizer_step"] + ["before_microbatch"] * t["gradient_accumulation_steps"] + ["after_optimizer_step", "before_trial_save", "after_trial_save", "after_trial_delete"])
+        valid = valid and bool(receipt.get("resource_receipt_sha256")) and isinstance(resource_observations, list) and [row.get("point") for row in resource_observations] == expected_points and all(row.get("status") == "PASS" and row.get("allocator_ooms") == 0 and row.get("allocator_retries") == 0 for row in resource_observations)
+    durations = [result.get("load_seconds"), result.get("save_hash_delete_seconds"), result.get("cleanup_seconds"), receipt.get("elapsed_seconds")]
+    valid = valid and all(type(x) in (int, float) and math.isfinite(x) and x > 0 for x in durations)
+    if valid:
+        valid = sum(steps) + sum(durations[:3]) <= durations[3] + .05
+    projected = None
+    if valid:
+        nonstep = max(0., receipt["elapsed_seconds"] - sum(steps))
+        projected = 1.5 * (nonstep + 78 * max(steps))
+    status = "STOP_OR_INCONCLUSIVE"
+    if valid and projected < science_seconds:
+        status = "FIT_MODEL_PASS" if evidence_class == "engineering_live" else "SYNTHETIC_SOFTWARE_ONLY"
+    return {"schema": "SI_CONTINUATION_ENGINEERING_ASSESSMENT_V1", "scope": "ENGINEERING_ONLY_NOT_SCIENTIFIC_RESULT", "evidence_class": evidence_class, "status": status, "projection_seconds": projected, "projection_valid_for_real_device": valid and evidence_class == "engineering_live", "science_allocation_seconds": science_seconds, "fit_multiplier": 1.5, "extrapolation": "all measured non-step supervisor elapsed plus 78 times slower observed complete optimizer step", "scientific_checkpoint_eligible": False, "future_shared_gpu_performance_guaranteed": False}
