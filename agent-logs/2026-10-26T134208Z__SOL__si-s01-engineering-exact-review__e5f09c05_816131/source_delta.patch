+        'environment_operations':7,'generated_tokens':16,'input_tokens':8192,'seconds':600}
+
+def ceilings(value:Mapping[str,Any])->dict:
+    insist(set(value)==set(MAXIMA),'engineering ceilings fields')
+    for key,maximum in MAXIMA.items():
+        insist(type(value[key]) is int and 0<value[key]<=maximum,'engineering ceiling may only tighten: '+key)
+    return dict(value)
+
+@dataclass(frozen=True)
+class EngineeringPermit:
+    authorization:Mapping[str,Any]
+    proposal:Mapping[str,Any]
+    authorization_sha256:str
+    proposal_sha256:str
