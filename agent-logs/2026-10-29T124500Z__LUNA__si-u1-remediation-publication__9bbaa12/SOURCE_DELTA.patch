+    expected_argv += ["--clearance", str(clearance_path), "--clearance-sha256", clearance_sha]
+    if mode == "live":
+        need(argv == expected_argv and not output.exists() and not claim.exists(), "one exact fresh launch")
+    else:
+        expected_argv += ["--launch-context-sha256", launch_context_sha]
+        need(argv == expected_argv and launch_context_sha is not None, "exact worker invocation")
+        context = bind(output / "launch_context.json", launch_context_sha)
+        need(context["binding"] == binding and context["supervisor_pid"] == os.getppid(), "same real supervisor")
+        actual_parent = [x.decode() for x in Path(f"/proc/{os.getppid()}/cmdline").read_bytes().split(b"\0") if x]
+        need(actual_parent == ["--live" if x == "--worker" else x for x in expected_argv[:-2]], "real supervisor argv")
+        until = time.monotonic() + 3
+        start = output / "worker_start.json"
+        while not start.exists() and time.monotonic() < until:
+            time.sleep(.01)
+        w = json.loads(start.read_bytes())
+        tick = int(Path("/proc/self/stat").read_text().rsplit(")", 1)[1].split()[19])
+        need(w == {"pid": os.getpid(), "uid": os.getuid(), "start_tick": tick, "pgid": os.getpgid(0), "sid": os.getsid(0), "argv": argv, "launch_context_sha256": launch_context_sha}, "real child process identity")
+        arm_parent_death(context["supervisor_pid"], context["supervisor_start_tick"])
+    return a, binding
+
+
+def preflight(a, binding):
+    value = {"schema": "SI_CONTINUATION_PREFLIGHT_V1", "binding": binding, "status": "PREFLIGHT_ONLY_PASS", "runtime_check": "STATIC_METADATA_ONLY_NO_PACKAGE_IMPORTS", "effects": {"tokenizer": 0, "model": 0, "cuda": 0, "training": 0, "environment": 0}}
+    atomic_fresh_json(Path(a["preflight_path"]), value)
+    return value
