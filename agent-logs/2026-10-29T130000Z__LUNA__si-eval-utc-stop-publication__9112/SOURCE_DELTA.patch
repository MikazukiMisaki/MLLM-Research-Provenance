+        self.output.mkdir(parents=False,exist_ok=False)
+        j=Journal(self.output/'engineering_events.jsonl',{'schema':'SI_U1_EVAL_ENGINEERING_EVENTS_V1','evidence_class':self.evidence_class,'task':self.task,'adapter_sha256':self.adapter_sha256,'limits':ENGINEERING_LIMITS,'scientific_result':False,'live_binding':({'binding':self.live_permit.permit.binding,'launch_context_sha256':self.live_permit.launch_context_sha256,'worker_start_sha256':self.live_permit.worker_start_sha256} if self.evidence_class=='live_engineering_only' else None)})
