diff --git a/tests/test_si_s01_runtime_reliability.py b/tests/test_si_s01_runtime_reliability.py
new file mode 100644
index 0000000..3322793
--- /dev/null
+++ b/tests/test_si_s01_runtime_reliability.py
@@ -0,0 +1,99 @@
+"""RT01/02/03 software process/filesystem edges; no real runtime or GPU."""
+import json
+from pathlib import Path
+from threading import Event,Thread
+from types import SimpleNamespace
+import pytest
+from self_improvement.si_s01 import evidence,supervisor
+from self_improvement.si_s01.audit import audit
+from si_s01_support import run_fixture
+
+
+def test_post_kill_wait_uses_remaining_absolute_time_and_unknown_exit_stays_unknown(tmp_path,monkeypatch):
+    now=[100.0];waits=[];pid=987654321
+    class UnreapedProcess:
+        def __init__(self,*args,**kwargs):
+            self.pid=pid
+            assert kwargs['env']['CUDA_VISIBLE_DEVICES']==''
+        def wait(self,*,timeout):
+            waits.append(timeout)
+            now[0]=100.95 if len(waits)==1 else 101.2
+            raise supervisor.subprocess.TimeoutExpired('explicit software unreap edge',timeout)
+    monkeypatch.setattr(supervisor.time,'monotonic',lambda:now[0])
+    monkeypatch.setattr(supervisor.subprocess,'Popen',UnreapedProcess)
+    monkeypatch.setattr(supervisor.ctypes,'CDLL',lambda *a,**k:SimpleNamespace(prctl=lambda *a:0))
+    monkeypatch.setattr(supervisor,'process_table',lambda:{pid:(supervisor.os.getpid(),991,supervisor.os.getuid())})
+    monkeypatch.setattr(supervisor,'group_members',lambda pgid:[pid])
+    monkeypatch.setattr(supervisor,'descendants',lambda *a:{})
+    monkeypatch.setattr(supervisor,'kill_identities',lambda *a:None)
+    monkeypatch.setattr(supervisor.os,'killpg',lambda *a:None)
+    r=supervisor.supervise_source(['explicit-software-child'],tmp_path/'run',context={
+        'authorization_sha256':'a'*64,'source_sha':'b'*40,'evidence_class':'synthetic_software_fixture',
+        'allocation_started_monotonic':100.0},seconds=1,environment={'CUDA_VISIBLE_DEVICES':''})
+    assert len(waits)==2 and waits[0]==pytest.approx(.9) and waits[1]==pytest.approx(.05)
+    assert r['authentic_returncode'] is None and r['reaping_error']['exception']=='TimeoutExpired'
+    assert not r['cleanup_established'] and r['execution_status']=='SUPERVISOR_INCOMPLETE'
+    assert r['unreaped_worker_identity']=={'pid':pid,'start_tick':991,'uid':supervisor.os.getuid()}
+    assert r['members_after_cleanup']==[pid] and r['elapsed_seconds']==pytest.approx(1.2)
+    assert not r['within_time_cap'] and r['allocated_device_hours']==0 and not r['retry_authorized']
+    assert json.loads((tmp_path/'run/supervisor_exit.json').read_text())==r
+
+
+def test_worker_marker_partial_write_is_never_published_as_final_json(tmp_path,monkeypatch):
+    marker=tmp_path/'worker_start.json';value={'pid':123,'uid':456,'start_tick':789,'argv':['explicit software']}
+    partial=Event();release=Event();errors=[];fdopen=evidence.os.fdopen
+    class PausedWrite:
+        def __init__(self,handle):self.handle=handle
+        def __enter__(self):return self
+        def __exit__(self,*args):return self.handle.__exit__(*args)
+        def write(self,text):
+            split=len(text)//2;self.handle.write(text[:split]);self.handle.flush();partial.set()
+            assert release.wait(3),'software interleaving release deadline'
+            self.handle.write(text[split:]);return len(text)
+        def flush(self):return self.handle.flush()
+        def fileno(self):return self.handle.fileno()
+    monkeypatch.setattr(evidence.os,'fdopen',lambda *a,**k:PausedWrite(fdopen(*a,**k)))
+    def writer():
+        try:evidence.atomic_fresh_json(marker,value)
+        except BaseException as error:errors.append(error)
+    thread=Thread(target=writer);thread.start()
+    try:
+        assert partial.wait(3) and not marker.exists()
+        temporary=list(tmp_path.glob('.worker_start.json.*.tmp'));assert len(temporary)==1
+        with pytest.raises(json.JSONDecodeError):json.loads(temporary[0].read_text())
+        # The unchanged worker's exists/read sequence has no final marker to consume yet.
+        assert not marker.exists()
+    finally:
+        release.set();thread.join(timeout=3)
+    assert not thread.is_alive() and errors==[] and json.loads(marker.read_text())==value
+    assert not list(tmp_path.glob('.worker_start.json.*.tmp'))
+
+
+def test_atomic_marker_publication_cannot_overwrite_file_or_symlink(tmp_path):
+    marker=tmp_path/'worker_start.json';marker.write_text('{"original":true}')
+    before=marker.read_bytes()
+    with pytest.raises(FileExistsError):evidence.atomic_fresh_json(marker,{'replacement':True})
+    assert marker.read_bytes()==before
+    link=tmp_path/'link.json';link.symlink_to(marker)
+    with pytest.raises(FileExistsError):evidence.atomic_fresh_json(link,{'replacement':True})
+    assert link.is_symlink() and marker.read_bytes()==before
+    assert not list(tmp_path.glob('.*.tmp'))
+
+
+def test_source_report_hours_are_explicit_through_run_closed_lower_bound(tmp_path):
+    class Clock:
+        now=0.0
+        def __call__(self):self.now+=.01;return self.now
+    clock=Clock()
+    p,r,_,producer,_,_=run_fixture(tmp_path/'run',options={'*':{'empty_at':0}},clock=clock,devices=1)
+    stage_hours=r['allocation_budget_device_hours'];assert stage_hours>0 and r['real_device_hours']==0
+    clock.now+=3600
+    again=audit(tmp_path/'run/source_events.jsonl',tmp_path/'run/source_trajectories.jsonl',p,producer)
+    assert again['allocation_budget_device_hours']==stage_hours
+    scope=r['allocation_cost_measurement']
+    assert scope['endpoint']=='collector_run_closed' and scope['endpoint_event_id']==r['raw_final_event']
+    assert scope['scope']=='STAGE_LOWER_BOUND_NOT_FINAL_ALLOCATED_COST' and scope['final_allocated_device_hours'] is None
+    assert scope['final_authority']=={'artifact':'supervisor_exit.json','schema':'SI_S01_SUPERVISOR_EXIT_V1','field':'allocated_device_hours','requires':'AUTHENTIC_SUPERVISOR_EXECUTION_RECEIPT'}
+    assert scope['aggregation']=='DO_NOT_ADD_STAGE_HOURS_TO_SAME_ALLOCATION_SUPERVISOR_TOTAL'
+    text=(tmp_path/'run/SOURCE_REPORT.md').read_text()
+    assert 'stage lower bound' in text and 'do not add these overlapping intervals' in text
