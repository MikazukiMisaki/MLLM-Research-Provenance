path = PosixPath('/tmp/si-s01-eng-draft_engineering_v1/test_broken_join_stops_once_wi7/output/engineering_events.jsonl')
permit = EngineeringPermit(authorization={'schema': 'SI_S01_ENGINEERING_AUTHORIZATION_V1', 'status': 'SOFTWARE_TEST_ONLY', 'pur...pleted', 'sequence': 27}), maximum_read_offset=58357, historical_input_ids_status='UNRECORDED'), context_evidence=None)
encoder = <self_improvement.si_s01.engineering_runtime.EngineeringProducer object at 0x7fcb8805dc90>

    def audit_engineering(path:Path,permit:EngineeringPermit,encoder=None)->dict:
        insist(isinstance(permit,EngineeringPermit),'typed engineering audit authority')
        events=read_events(path);h=events[0]['payload'];history=permit.history;a=permit.authorization;caps=permit.ceilings
        expected={'schema':'SI_S01_ENGINEERING_EVENT_V1','purpose':PURPOSE,'science_authorized':False,'evidence_class':permit.evidence_class,
            'run_id':a['run_id'],'source_sha':a['source_sha'],'authorization_sha256':permit.authorization_sha256,'proposal_sha256':permit.proposal_sha256,
            'history_manifest_sha256':history.manifest_sha256,'task_id':history.task_id,'ceilings':caps,'RNG_status':RNG_STATUS,'allocated_devices':int(permit.evidence_class==MODE)}
        insist(all(h[k]==v for k,v in expected.items()) and type(h['worker_pid']) is int and h['worker_pid']>0 and h['worker_uid']==a['execution_uid'],'engineering header/authority identity')
        if permit.evidence_class==MODE:
            from .engineering_gate import verified_engineering_context
            launch,worker=verified_engineering_context(permit)
            insist(h['worker_pid']==worker['pid'] and h['worker_uid']==worker['uid'] and h['allocation_started_monotonic']==launch['allocation_started_monotonic'],'external engineering allocation/PID/UID')
        used=Counter(dict.fromkeys(COST_KEYS,0));completed=Counter(used);units={};stack=[];returned={};state=None;joined=None;derived_join=None;stop=None;mismatch=None;failed=False
        for event in events[1:]:
            p=event['payload'];kind=event['kind']
            if kind=='unit_started':
                identity=p['identity'];op=identity['kind'];index=identity['index'];debit=reservation(op,p['prepared']);parent=stack[-1] if stack else None
                insist(identity=={'purpose':PURPOSE,'task_id':history.task_id,'kind':op,'index':index} and type(index) is int and index==(used['step'] if op=='step' else 0),'engineering exact operation index/identity')
                unit=p['unit'];insist(unit==digest([a['run_id'],identity]) and unit not in units and p['reservation']==debit and p['parent_unit']==parent,'engineering physical unit/start/reservation binding')
                insist((parent is None and op!='context_probe') or (op=='context_probe' and units[parent]['identity']['kind']=='model_load'),'engineering physical nesting')
                if failed or mismatch:insist(op=='env_close','no new work after mismatch/failure')
                if op=='model_load':insist(not units,'one initial engineering load')
                elif op=='context_probe':insist(used['model_load']==1,'one nested engineering probe')
                elif op=='env_construct':insist(completed['model_load']==completed['context_probe']==1 and p['request']=={'pool_seed':42,'historical_internal_rng':RNG_STATUS},'single environment after guarded load')
                elif op=='reset':insist(completed['env_construct']==1 and p['request']=={'seed':30000},'one reset30000')
                elif op=='generation':
                    insist(completed['reset']==1 and state==history.states[0] and used['step']==0 and encoder is not None,'generation is coupled to actual reset')
                    compare_prepared(history,encoder.prepare(history.public_prompt));insist(p['prepared']==encoder.prepare(history.public_prompt).to_dict(),'coupled generation prepared/reserved')
                    refs=history.row['metadata']['r19_source_event_refs'];insist(p['request']=={'historical_reset_event_id':refs['reset_event_id'],'historical_generation_event_id':refs['generation_event_ids'][0]},'generation/reset original refs')
                elif op=='step':
                    reference=history.row['metadata']['r19_source_event_refs']['transition_event_ids'][index] if index<6 else None
                    insist(completed['reset']==completed['generation']==1 and joined is not None and index<6 and state==history.states[index] and p['request']=={'saved_command':history.commands[index],'historical_transition_event_id':reference},'saved step must follow coupled first-action validation')
                elif op=='env_close':insist(used['env_construct']==1,'close attempted engineering environment')
                used.update(debit);insist(all(used[k]<=caps[k] for k in used),'engineering cost exceeds pre-call cap')
                units[unit]={'identity':identity,'started_event':event['event_id'],'reservation':debit,'finished':False,'failed':False,'prepared':p['prepared'],'invocation_claimed':False,'boundary_entered':False};stack.append(unit)
            elif kind in ('unit_completed','unit_failed'):
                unit=p['unit'];insist(stack and stack[-1]==unit and p['identity']==units[unit]['identity'] and p['started_event']==units[unit]['started_event'] and not units[unit]['finished'] and not units[unit]['failed'],'engineering durable completion/failure refs')
                stack.pop();u=units[unit];op=u['identity']['kind'];index=u['identity']['index'];data=p['data']
                if kind=='unit_failed':u['failed']=True;failed=True;continue
                u['finished']=True;actual=0
>               if op=='model_load':insist(data=={'mode':'P0','adapter_sha256':P0_SHA256},'engineering loaded P0 identity')
