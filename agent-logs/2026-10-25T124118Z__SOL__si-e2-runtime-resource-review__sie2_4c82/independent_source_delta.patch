+def observed_public(value: Any, evidence: ReplayEvidence, *, reset: bool) -> dict[str, Any]:
+    if reset:
+        require(value.task.task_id == evidence.task_id and value.task.split == "train" and
+                value.task.family in (None, evidence.family), "exact task reset identity")
+    return {"task_id": evidence.task_id, "family": evidence.family,
+            "goal": value.task.text if reset else evidence.states[0]["goal"],
+            "observation": value.observation,
+            "valid_actions": list(value.valid_actions) if value.valid_actions is not None else None,
+            "done": False if reset else value.done, "reward": 0.0 if reset else value.reward,
+            "truncated": False if reset else value.truncated}
+
+
+def replay_twice(evidence: ReplayEvidence, factory: Callable[[], ReadIsolatedEnvironment],
+                 ledger: EngineeringLedger) -> dict[str, Any]:
+    """Two new one-game instances, not repeated reset on an advanced TextWorld RNG."""
+    observed = []
+    instances = []
+    for attempt in range(2):
+        env = factory()
+        require(all(env is not old for old in instances), "replay requires fresh environment instance")
+        instances.append(env)
+        def perform(kind: str, index: int, call: Callable[[], Any], convert: Callable[[Any], Any]) -> Any:
+            unit = f"env-{attempt}-{kind}-{index}"
+            ledger.reserve(unit, kind)
+            try:
+                value = call(); data = convert(value)
+                ledger.complete(unit, data)
+                return data
+            except BaseException as error:
+                if not ledger.units[unit].get("finished"): ledger.failed(unit, error)
+                raise
+        try:
+            perform("env_construct", 0, env.initialize, lambda value: dict(value))
+            first = perform("reset", 0, lambda: env.reset(seed=evidence.seed),
+                            lambda value: observed_public(value, evidence, reset=True))
+            require(first == evidence.states[0], "historical reset public-state/map drift")
+            states = [first]
+            for i, command in enumerate(evidence.commands):
+                require(not states[-1]["done"] and not states[-1]["truncated"] and
+                        states[-1]["valid_actions"] is not None and command in states[-1]["valid_actions"],
+                        "saved command unavailable or terminal")
+                after = perform("step", i, lambda command=command: env.step(command),
+                                lambda value: observed_public(value, evidence, reset=False))
+                # None remains None in the recorded receipt. It is never fabricated as ().
+                require(after == evidence.states[i + 1], "historical transition/map/terminal drift")
+                states.append(after)
+            observed.append(states)
+        finally:
+            perform("env_close", 0, env.close, lambda _: {"closed": True})
+    require(observed[0] == observed[1], "fresh replay mismatch")
+    return {"replays": 2, "steps_each": len(evidence.commands), "repeated_public_states_equal": True,
+            "terminal_observed": bool(observed[-1][-1]["done"]),
+            "terminal_map_observed": observed[-1][-1]["valid_actions"] is not None if observed[-1][-1]["done"] else None,
+            "not_terminal_means": "terminal-map behavior NOT_OBSERVED; no outcome search",
+            "states": observed, "generated_commands_executed": 0}
+
+
+def bind_original_game_path(environment: Mapping[str, Any], row: Mapping[str, Any], evidence: ReplayEvidence) -> None:
+    game = Path(environment["game"])
+    original = Path(row["task"]["metadata"]["game_file"])
+    require(original.is_absolute() and game.resolve() == original.resolve(), "original historical game path; no copies/staging")
+    require("/".join(game.parts[-3:-1]) == evidence.task_id and game.is_relative_to(Path(environment["data_root"])),
