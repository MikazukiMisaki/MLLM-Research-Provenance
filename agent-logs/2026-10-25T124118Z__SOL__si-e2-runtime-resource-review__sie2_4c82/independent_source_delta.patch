+    for path in [*proposal["model"].values(), *(proposal["environment"][k] for k in
+                 ("trajectory", "events", "config", "game", "traj_data", "data_root")), proposal["interpreter"]["path"]]:
+        require(type(path) is str and Path(path).is_absolute(), "explicit local runtime path")
