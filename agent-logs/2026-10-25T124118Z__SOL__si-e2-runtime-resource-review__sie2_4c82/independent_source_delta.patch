+        require(Path(config["logic"][name]).resolve() == Path(binding["path"]).resolve() and
+                file_hash(Path(binding["path"])) == binding["sha256"], "effective logic path/bytes: " + name)
+        result[name] = dict(binding)
+    return result
diff --git a/src/self_improvement/si_p3/runtime_ledger.py b/src/self_improvement/si_p3/runtime_ledger.py
new file mode 100644
index 0000000..f18dc88
--- /dev/null
+++ b/src/self_improvement/si_p3/runtime_ledger.py
@@ -0,0 +1,169 @@
+"""Distinct engineering ledger; the SI-P3 synthetic journal gate is unchanged."""
+from __future__ import annotations
+
+import json
+import math
+import os
+import time
+from collections import Counter
+from pathlib import Path
+from typing import Any, Callable, Mapping
+
+from .contract import canonical, digest, integer, require
+from .runtime_gate import PHASES, Permit
+
+KINDS = ("model_load", "env_construct", "reset", "step", "env_close", "generation")
+
+
+def fresh_json(path: Path, value: Any) -> None:
+    with Path(path).open("x", encoding="utf-8") as handle:
+        handle.write(canonical(value) + "\n")
+        handle.flush()
+        os.fsync(handle.fileno())
+
+
+class EngineeringLedger:
+    def __init__(self, path: Path, permit: Permit, *, clock: Callable[[], float] = time.monotonic,
+                 evidence_class: str = "engineering_diagnostic") -> None:
+        require(evidence_class in ("engineering_diagnostic", "synthetic_software_fixture"), "explicit engineering/software evidence")
+        self.permit, self.clock, self.started_at = permit, clock, clock()
+        self.handle = Path(path).open("x", encoding="utf-8")
+        self.events: list[dict[str, Any]] = []
+        self.units: dict[str, dict[str, Any]] = {}
+        self.stopped = False
+        self.append("engineering_opened", {"authorization_sha256": permit.authorization_sha256,
+            "proposal_sha256": permit.proposal_sha256, "purpose": "ENGINEERING_DIAGNOSTIC_ONLY",
+            "science_authorized": False, "evidence_class": evidence_class})
+
+    def append(self, kind: str, payload: Mapping[str, Any]) -> str:
+        body = {"sequence": len(self.events), "previous": self.events[-1]["event_id"] if self.events else None,
+                "kind": kind, "payload": json.loads(canonical(payload))}
+        row = body | {"event_id": digest(body)}
+        self.handle.write(canonical(row) + "\n"); self.handle.flush(); os.fsync(self.handle.fileno())
+        self.events.append(row)
+        return row["event_id"]
+
+    def elapsed(self) -> float:
+        value = self.clock() - self.started_at
+        require(math.isfinite(value) and value >= 0, "monotonic ownership clock")
+        require(value <= min(self.permit.ceilings["seconds"], self.permit.ceilings["device_hours"] * 3600),
+                "engineering allocated-device time cap")
+        return value
+
+    def reserve(self, unit: str, kind: str, *, phase: str | None = None,
+                prepared: Mapping[str, Any] | None = None) -> None:
+        require(kind in KINDS and unit not in self.units and (not self.stopped or kind == "env_close"),
+                "duplicate/retry/stopped external call")
+        self.elapsed()
+        current = reconstruct(self.events)
+        input_tokens = output_cap = 0
+        if kind == "generation":
+            n = current["reserved_or_spent"].get("generations", 0)
+            require(n < len(PHASES) and PHASES[n][0] == phase, "four fixed phases; no repeat")
+            require(prepared is not None and set(prepared) == {"prompt", "rendered_prompt", "input_ids", "attention_mask"},
+                    "full prepared tensor reservation")
+            ids, mask = prepared["input_ids"], prepared["attention_mask"]
+            require(type(ids) is list and bool(ids) and all(integer(i) for i in ids) and
+                    type(mask) is list and len(mask) == len(ids) and all(type(i) is int and i == 1 for i in mask),
+                    "unbatched unpadded full input IDs/mask")
+            input_tokens, output_cap = len(ids), PHASES[n][1]
+            require(input_tokens <= self.permit.ceilings["per_call_input"], "per-call exact input cap")
+        amounts = {"generations": int(kind == "generation"), "generated_tokens": output_cap,
+                   "input_tokens": input_tokens, "resets": int(kind == "reset"), "steps": int(kind == "step")}
+        for key, amount in amounts.items():
+            require(current["reserved_or_spent"].get(key, 0) + amount <= self.permit.ceilings[key], "pre-call ceiling: " + key)
+        if kind in ("model_load", "env_construct", "env_close"):
+            maximum = 1 if kind == "model_load" else 2
+            require(sum(x["kind"] == kind for x in self.units.values()) < maximum, "construction/close cap")
+        payload = {"unit": unit, "kind": kind, "phase": phase, "reservation": amounts, "prepared": prepared}
+        self.units[unit] = payload
+        self.append("external_started", payload)
+
+    def complete(self, unit: str, data: Mapping[str, Any]) -> None:
+        require(unit in self.units and not self.units[unit].get("finished"), "completion without unique start")
+        self.append("external_completed", {"unit": unit, "data": data})
+        self.units[unit]["finished"] = True
+        reconstruct(self.events)  # Validate cost/tensor receipts, not a caller summary.
+        self.elapsed()
+
+    def failed(self, unit: str, error: BaseException) -> None:
+        self.stopped = True
+        self.append("external_failed", {"unit": unit, "exception": type(error).__name__, "message": str(error),
+            "resource_evidence": getattr(error, "resource_evidence", None)})
+
+    def snapshot(self) -> dict[str, Any]:
+        return reconstruct(self.events)
+
+    def close(self) -> None:
+        self.handle.close()
+
+
+def reconstruct(events: list[dict[str, Any]]) -> dict[str, Any]:
+    """Actual completed cost plus conservative incomplete reservations, hash-independent."""
+    started: dict[str, Any] = {}; complete: dict[str, Any] = {}; failed: set[str] = set()
+    previous = None
+    for i, row in enumerate(events):
+        body = {k: v for k, v in row.items() if k != "event_id"}
+        require(set(row) == {"sequence", "previous", "kind", "payload", "event_id"} and row["sequence"] == i and
+                row["previous"] == previous and row["event_id"] == digest(body), "engineering journal chain")
+        previous = row["event_id"]
+        p = row["payload"]
+        if row["kind"] == "external_started":
+            u = p["unit"]
+            require(u not in started and p["kind"] in KINDS, "unique external unit")
+            started[u] = p
+        elif row["kind"] in ("external_completed", "external_failed"):
+            u = p["unit"]
+            require(u in started and u not in complete and u not in failed, "single terminal external receipt")
+            if row["kind"] == "external_completed": complete[u] = p["data"]
+            else: failed.add(u)
+        else:
+            require(row["kind"] in ("engineering_opened", "adapter_state", "resource", "driver_failed"), "engineering event kind")
+    completed = Counter(); reserved = Counter()
+    for unit, start in started.items():
+        amounts = dict(start["reservation"])
+        require(set(amounts) == {"generations", "generated_tokens", "input_tokens", "resets", "steps"} and
+                all(integer(v) for v in amounts.values()), "reservation counters")
+        kind = start["kind"]
+        require(amounts["generations"] == int(kind == "generation") and amounts["resets"] == int(kind == "reset") and
+                amounts["steps"] == int(kind == "step"), "reservation kind binding")
+        if kind == "generation":
+            phase = [x for x in PHASES if x[0] == start["phase"]]
+            prepared = start["prepared"]
+            require(set(prepared) == {"prompt", "rendered_prompt", "input_ids", "attention_mask"} and
+                    type(prepared["input_ids"]) is list and bool(prepared["input_ids"]) and
+                    all(integer(i) for i in prepared["input_ids"]) and
+                    prepared["attention_mask"] == [1] * len(prepared["input_ids"]), "stored full prepared IDs/mask")
+            require(len(phase) == 1 and amounts["generated_tokens"] == phase[0][1] and
+                    amounts["input_tokens"] == len(start["prepared"]["input_ids"]), "reservation input/phase binding")
+        else:
+            require(amounts["input_tokens"] == amounts["generated_tokens"] == 0, "non-generation token debit")
+        if unit in complete:
+            if kind == "generation":
+                data = complete[unit]; raw = data["raw"]
+                require(data["tensor_proof"]["prepared"] == start["prepared"] == data["tensor_proof"]["sent"], "sent tensor identity")
+                require(raw["input_tokens"] == amounts["input_tokens"] and raw["generated_tokens"] == len(raw["token_ids"]) and
+                        integer(raw["generated_tokens"], 1) and raw["generated_tokens"] <= amounts["generated_tokens"], "actual token debit")
+                amounts["generated_tokens"] = raw["generated_tokens"]
+            completed.update(amounts)
+        reserved.update(amounts)
+    return {"completed": dict(completed), "reserved_or_spent": dict(reserved),
+            "open_units": sorted(set(started) - set(complete)), "failed_units": sorted(failed),
+            "external_started": len(started), "external_completed": len(complete),
+            "environment_constructs": sum(x["kind"] == "env_construct" for x in started.values()),
+            "environment_closes": sum(x["kind"] == "env_close" for x in started.values()),
+            "interpretation": "engineering only; incomplete calls retain full reservations; no science"}
+
+
+def validate_report(report: Mapping[str, Any], events: list[dict[str, Any]]) -> dict[str, Any]:
+    require(report["purpose"] == "ENGINEERING_DIAGNOSTIC_ONLY" and report["science_authorized"] is False,
+            "engineering report identity")
+    observed = reconstruct(events)
+    require(report["cost"] == observed, "summary cost mismatch with actual + incomplete reservations")
+    if report["status"] == "ENGINEERING_BOUNDARY_OBSERVED_NOT_SCIENTIFIC_ACCEPTANCE":
+        require(not observed["open_units"] and not observed["failed_units"] and
+                observed["completed"].get("generations") == 4 and observed["completed"].get("resets") == 2 and
+                observed["environment_constructs"] == observed["environment_closes"] == 2, "incomplete diagnostic cannot be complete")
+    else:
+        require(report["status"] == "TECHNICAL_STOP_NO_RETRY", "report status")
+    return observed
