+        elif attack=='unit':p['unit']='0'*64
+        elif attack=='ordinal':p['ordinal']=0
+        elif attack=='free':p['global_memory']['free_bytes']=0
+        elif attack=='missing':p['allocator']['stats'].pop(STATS[0])
+        elif attack=='peak':p['allocator']['stats'][STATS[1]]=0
+        elif attack=='UUID':p['cuda']['observation']['observed']['uuid']['str']='GPU-deadbeef-abcd-abcd-abcd-123456789abc'
