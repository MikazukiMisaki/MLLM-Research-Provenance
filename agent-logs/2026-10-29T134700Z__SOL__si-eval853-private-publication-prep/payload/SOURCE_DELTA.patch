+def test_synthetic_engineering_raw_to_normalized_to_full_auditor(tmp_path):
+    """Real production runner/journal/auditor; only model and world edges are synthetic."""
+    import json
+    from test_si_transfer_eval import FakeProducer, manifest
+    from self_improvement.si_transfer_eval.engineering import EngineeringRunner
+    from self_improvement.si_transfer_eval.engineering_audit import audit
+    facts=[Proposition('synthetic_fact_'+str(i),[Variable('synthetic_object','synthetic_type')]) for i in range(193)]
+    info={'admissible_commands':[['take object']],'facts':[facts]}
+    class SyntheticWorld:
+        def reset(self):return ['observed'],info
+        def step(self,command):return ['after'],[0.0],[False],info
+    class SyntheticNormalizer:
+        def __init__(self,task):self.task=task;self._environment=SyntheticWorld()
+        def reset(self,*,seed):
+            obs,raw_info=self._environment.reset()
+            return ResetResult(obs[0],Task(self.task['task_id'],'take object','train',self.task['family']),('take object',),{'alfworld_info':AlfWorldTextEnvironment._info_dict(raw_info)})
+        def step(self,command):
+            obs,reward,done,raw_info=self._environment.step(command)
+            return Transition(obs[0],float(reward[0]),bool(done[0]),False,('take object',),{'alfworld_info':AlfWorldTextEnvironment._info_dict(raw_info)})
+        def close(self):pass
+    def environment(task):
+        p=ProductionEnvironment.__new__(ProductionEnvironment);p.task=task;p.started=False;p.goal=None;p.recorder=None;p.env=SyntheticNormalizer(task);return p
+    task=manifest()['tasks'][0].copy();task['seed']=42;out=tmp_path/'synthetic'
+    result=EngineeringRunner(task=task,adapter_sha256='a'*64,output=out,producer_factory=lambda arm,sha:FakeProducer(arm,sha),environment_factory=environment).run()
+    assert result['status']=='COMPLETED' and result['step_executed'] and result['completed']['environment_operations']==2
+    path=out/'engineering_events.jsonl';checked=audit(path,decode=lambda ids:'A000',eos_ids=(10,))
+    assert checked['report_status']=='COMPLETED' and checked['scientific_result'] is False
+    rows=[json.loads(x) for x in path.read_text().splitlines()]
+    raw=next(r['payload']['data']['value'] for r in rows if r['kind']=='external_returned' and r['payload']['boundary']=='raw_reset_returned')
+    normalized=next(r['payload']['data']['value'] for r in rows if r['kind']=='external_returned' and r['payload']['boundary']=='normalized_reset_returned')
+    assert len(_decode_wire(raw)[1]['facts'][0])==len(normalized['metadata']['alfworld_info']['facts'][0])==193
+    # Even a coherent journal rehash cannot hide a changed normalized fact.
+    normalized['metadata']['alfworld_info']['facts'][0][0]='tampered synthetic fact'
+    previous=None;changed={}
+    for row in rows:
+        old=row['event_id'];p=row['payload']
+        if row['kind'] in ('unit_completed','unit_failed'):
+            p['started_event']=changed[p['started_event']];p['return_events']=[changed[x] for x in p['return_events']]
+        row['previous']=previous;row['event_id']=_hash({k:v for k,v in row.items() if k!='event_id'});changed[old]=row['event_id'];previous=row['event_id']
+    path.write_text(''.join(json.dumps(r)+'\n' for r in rows))
+    with pytest.raises(EvaluationError,match='raw info reconstruction'):audit(path,decode=lambda ids:'A000',eos_ids=(10,))
+
