+                raise ContractError(f"actual imported package identity mismatch: {name}")
+        result["status"] = "PASS_ACTUAL_IMPORTED_MODULES"
+    except BaseException as exc:
+        result["error"] = f"{type(exc).__name__}: {exc}"
+        atomic_fresh_json(receipt_path, result)
+        raise
+    atomic_fresh_json(receipt_path, result)
+    return result
+
+
+def verify_recorded_imports(expected: dict, binding: dict, *, output: Path, name: str) -> None:
+    """Offline binding of a before/after receipt to its frozen expected identity."""
+    if type(binding) is not dict or set(binding)!={'path','sha256'}:
+        raise ContractError('runtime import receipt binding')
+    path=Path(binding['path'])
+    if path != Path(output)/name or not path.is_file() or file_sha256(path)!=binding['sha256']:
+        raise ContractError('runtime import receipt bytes')
+    result=json.loads(path.read_bytes())
+    if result.get('schema')!='SI_TRANSFER_RUNTIME_IMPORT_V1' or result.get('status')!='PASS_ACTUAL_IMPORTED_MODULES' or result.get('runtime_identity_sha256')!=identity_digest(expected) or result.get('python_version')!=expected['interpreter']['python_version'] or set(result.get('modules',{}))!=set(PACKAGES):
+        raise ContractError('runtime import receipt identity')
+    for package,signed in expected['packages'].items():
+        actual=result['modules'][package]
+        if type(actual) is not dict or set(actual)!={'path','sha256','version','tree_sha256','spec_origin'} or {k:actual[k] for k in ('path','sha256','version','tree_sha256')}!=signed or actual['spec_origin']!=signed['path']:
+            raise ContractError('runtime import receipt module drift')
