+"""CPU-only synthetic TextWorld logic values, without a simulator or model."""
+import pytest
+from textworld.logic import Proposition, Variable
+from env.alfworld import AlfWorldTextEnvironment
+from env.base import ResetResult, Task, Transition
+from self_improvement.si_transfer_eval.evaluator import EvaluationError, _hash
+from self_improvement.si_transfer_eval.live_runtime import ProductionEnvironment, _ReturnBoundary, _raw_wire
+from self_improvement.si_transfer_eval.return_audit import _check_raw_normalized, _decode_wire, validate_completed
+
+
+def test_real_textworld_proposition_identity_and_order_round_trip():
+    left=Variable('synthetic_left','kind_a');right=Variable('synthetic_right','kind_b')
+    original=Proposition('synthetic_predicate',[left,right,left])
+    wire,lossless=_raw_wire(original,preserve_tuples=True)
+    assert lossless and wire['wire_type']=='textworld_proposition_v1'
+    decoded=_decode_wire(wire)
+    assert type(decoded) is Proposition and decoded==original and repr(decoded)==repr(original)
+    assert [(v.name,v.type) for v in decoded.arguments]==[(left.name,left.type),(right.name,right.type),(left.name,left.type)]
+    # Distinct two-argument ordering is preserved, including name and type.
+    distinct=Proposition('synthetic_predicate',[left,right]);dw,ok=_raw_wire(distinct,preserve_tuples=True)
+    assert ok and _decode_wire(dw)!=Proposition('synthetic_predicate',[right,left])
+
+
+def test_actual_193_type_raw_reset_is_lossless_and_auditable():
+    """Only synthetic facts are used; production boundary and audit both run."""
+    facts=[Proposition('synthetic_predicate_'+str(i),[Variable('synthetic_a','type_a'),Variable('synthetic_b','type_b')]) for i in range(193)]
+    info={'admissible_commands':[['synthetic action']],'facts':[facts]}
+    class SyntheticEdge:
+        def reset(self):return ['synthetic observation'],info
+    events=[];boundary=_ReturnBoundary(SyntheticEdge(),lambda kind,data:events.append((kind,data)))
+    result=boundary.reset()
+    assert result[1] is info and [event[0] for event in events]==['raw_reset_call_returned','raw_reset_returned'] and events[-1][1]['lossless'] is True
+    decoded=_decode_wire(events[-1][1]['value']);restored=decoded[1]['facts'][0]
+    assert len(restored)==193 and all(type(v) is Proposition for v in restored) and restored==facts
+    task=Task('synthetic_parent/synthetic_trial','synthetic goal','train','pick_and_place_simple')
+    # Match AlfWorldTextEnvironment.reset's actual normalized dataclass and
+    # metadata conversion; only synthetic data and an in-memory edge are used.
+    normalized_result=ResetResult('synthetic observation',task,('synthetic action',),{'alfworld_info':AlfWorldTextEnvironment._info_dict(info)})
+    normalized,lossless=_raw_wire(normalized_result,preserve_tuples=False)
+    assert lossless and len(normalized['metadata']['alfworld_info']['facts'][0])==193 and all(type(v) is str for v in normalized['metadata']['alfworld_info']['facts'][0])
+    _check_raw_normalized('reset',events[-1][1]['value'],normalized)
+    unit={'returns':[{'boundary':'raw_reset_call_returned','data':events[0][1]},{'boundary':'raw_reset_returned','data':events[1][1]},{'boundary':'normalized_reset_returned','data':{'returned':True,'value':normalized,'lossless':lossless}}]}
+    public={'task_id':task.task_id,'family':task.family,'goal':task.text,'observation':'synthetic observation','valid_actions':['synthetic action'],'done':False,'reward':0.0,'truncated':False}
+    validate_completed(unit,'reset',public,require_live=True)
+
