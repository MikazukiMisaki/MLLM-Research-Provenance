+"""Machine-check the limited represented-identity review; no held-out claim."""
+from __future__ import annotations
+from typing import Any, Mapping
+from .evaluator import _need
+
+
+def validate_isolation_review(review: Mapping[str, Any], *, manifest_sha256: str, schedule_sha256: str,
+                              b_dataset_sha256: str, c_dataset_sha256: str, known_use_registry_sha256: str,
+                              source_usage_sha256: str, reservation_sha256: str, game_manifest_sha256: str) -> None:
+    fields={'schema','decision','evaluation_manifest_sha256','metadata_schedule_sha256','b_dataset_sha256','c_dataset_sha256','known_use_registry_sha256','source_usage_sha256','reservation_sha256','checks','artifact_identity','limits'}
+    _need(type(review) is dict and set(review)==fields and review['schema']=='SI_U1_ISOLATION_REVIEW_V1' and review['decision']=='PASS_REPRESENTED_IDENTITY_ISOLATION', 'represented identity review')
+    _need((review['evaluation_manifest_sha256'],review['metadata_schedule_sha256'],review['b_dataset_sha256'],review['c_dataset_sha256'],review['known_use_registry_sha256'],review['source_usage_sha256'],review['reservation_sha256']) == (manifest_sha256,schedule_sha256,b_dataset_sha256,c_dataset_sha256,known_use_registry_sha256,source_usage_sha256,reservation_sha256), 'isolation input hashes')
+    _need(type(review['checks']) is dict and all(type(review['checks'].get(k)) is int for k in ('unique_parent_count','history_parent_overlap','source_parent_overlap','engineering_parent_overlap','B_parent_overlap','C_parent_overlap')) and all(type(review['checks'].get(k)) is bool for k in ('all_original_final','one_trial_per_parent')), 'task check types')
+    _need(review['checks']=={'unique_parent_count':82,'all_original_final':True,'history_parent_overlap':0,'source_parent_overlap':0,'engineering_parent_overlap':0,'B_parent_overlap':0,'C_parent_overlap':0,'one_trial_per_parent':True}, 'task parent isolation checks')
+    _need(type(review['artifact_identity']) is dict and all(type(review['artifact_identity'].get(k)) is int for k in ('training_game_overlap','source_game_overlap','registered_expert_game_overlap','source_traj_overlap','registered_expert_traj_overlap','duplicate_eval_game','duplicate_eval_traj')), 'artifact check types')
+    _need(review['artifact_identity']=={'game_manifest_sha256':game_manifest_sha256,'training_game_overlap':0,'source_game_overlap':0,'registered_expert_game_overlap':0,'source_traj_overlap':0,'registered_expert_traj_overlap':0,'duplicate_eval_game':0,'duplicate_eval_traj':0}, 'game file identity checks')
+    _need(type(review['limits']) is dict and type(review['limits'].get('lifetime_registry_complete')) is bool and type(review['limits'].get('unseen_layout_proven')) is bool and type(review['limits'].get('byte_comparison_covers_all_historical_use')) is bool and type(review['limits'].get('reserve_sibling_parents')) is int, 'isolation limit types')
+    _need(review['limits']=={'lifetime_registry_complete':False,'unseen_layout_proven':False,'byte_comparison_covers_all_historical_use':False,'reserve_sibling_parents':40}, 'isolation limits')
+
+
+def validate_isolation_spec(spec: Mapping[str, Any], *, manifest_sha256: str, schedule_sha256: str) -> None:
+    """Connect each reviewed digest to current byte-bound runtime inputs."""
+    import json
+    from .runtime_binding import file_binding
+    inputs=spec['isolation_inputs']; review=json.loads(file_binding(spec['isolation_proof']).read_bytes())
+    for bound in inputs.values():file_binding(bound)
