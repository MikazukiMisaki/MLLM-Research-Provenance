+from pathlib import Path
+import json
+import pytest
+from self_improvement.si_s01.contract import ContractError
+from self_improvement.si_s01.engineering_contract import MODE,SOFTWARE,HISTORY_MANIFEST_SHA256
+from self_improvement.si_s01.engineering_history import read_historical
+from si_s01_engineering_support import fixture_setup,file_binding,reseal_history
+
+
+def test_bounded_reader_ignores_forbidden_later_source_and_future_journal(tmp_path,monkeypatch):
+    f=fixture_setup(tmp_path,monkeypatch);p=Path(f.proposal['history_manifest']['path']);h=read_historical(p.read_bytes(),evidence_class=SOFTWARE,expected_manifest_sha256=file_binding(p)['sha256'])
+    assert len(h.states)==7 and len(h.commands)==6 and len(h.selected_receipts)==9
+    assert h.historical_input_ids_status=='UNRECORDED'
+    assert Path(f.manifest['trajectory']['path']).read_bytes()[f.manifest['trajectory']['line_length_bytes']:].startswith(b'DO_NOT_READ')
+    assert Path(f.manifest['events'][0]['path']).stat().st_size>h.maximum_read_offset
+    with pytest.raises(ContractError,match='fixed independently certified'):
+        read_historical(p.read_bytes(),evidence_class=MODE,expected_manifest_sha256=file_binding(p)['sha256'])
+
+
+@pytest.mark.parametrize('attack,reason',[('after_map','saved full ordered after-map'),('before_map','complete receipt before-state'),('action_id','historical Action-ID'),('parser','historical parser'),('prompt','historical causal P0'),('embedded','embedded source body')])
+def test_semantic_old_wire_tamper_rejected_after_all_selected_hashes_refs_resealed(tmp_path,monkeypatch,attack,reason):
+    f=fixture_setup(tmp_path,monkeypatch)
+    def change(row,events):
+        transitions=[e for e in events if e['kind']=='environment_operation_completed' and e['payload']['operation']=='sft_environment_step']
+        first=next(e for e in events if e['kind']=='generation_completed')
+        if attack=='after_map':transitions[-1]['payload']['transition'].pop('valid_actions')
+        elif attack=='before_map':transitions[1]['payload']['before_state']['valid_actions']=list(reversed(transitions[1]['payload']['before_state']['valid_actions']))
+        elif attack=='action_id':transitions[0]['payload']['action_id']='A001'
+        elif attack=='parser':first['payload']['evidence']['parser_result']['action_id']='A001'
+        elif attack=='prompt':
+            first['payload']['evidence']['generation']['prompt']='future or alternate prompt'
+            row['steps'][0]['metadata']['policy']['generation']['prompt']='future or alternate prompt'
+            row['steps'][0]['metadata']['policy']['prompt']='future or alternate prompt'
+    embedded=(lambda row:row['metadata'].pop('termination_reason')) if attack=='embedded' else None
+    manifest,p=reseal_history(f,change,embedded_mutate=embedded)
+    with pytest.raises(ContractError,match=reason):read_historical(p.read_bytes(),evidence_class=SOFTWARE,expected_manifest_sha256=file_binding(p)['sha256'])
+
+
+@pytest.mark.parametrize('attack',['raw_hash','duplicate_event','wrong_offset','second_source','wrong_role_count'])
+def test_invalid_slice_manifest_fails_closed_before_any_model_or_environment(tmp_path,monkeypatch,attack):
+    f=fixture_setup(tmp_path,monkeypatch);p=Path(f.proposal['history_manifest']['path']);m=json.loads(p.read_bytes())
+    if attack=='raw_hash':m['events'][0]['raw_line_sha256']='0'*64
+    elif attack=='duplicate_event':m['events'][1]['event_id']=m['events'][0]['event_id']
+    elif attack=='wrong_offset':m['events'][0]['byte_offset']+=1
+    elif attack=='second_source':m['trajectory']['byte_offset']=m['trajectory']['line_length_bytes']
+    elif attack=='wrong_role_count':m['events'][0]['role']='first_generation'
+    p.write_text(json.dumps(m))
+    with pytest.raises((ContractError,ValueError,KeyError)):read_historical(p.read_bytes(),evidence_class=SOFTWARE,expected_manifest_sha256=file_binding(p)['sha256'])
+    assert f.state.calls['generation']==f.state.calls['reset']==0
