+def test_full_synthetic_1248_sequence_and_78_recorded_lr_steps(inputs, tmp_path):
+    """Software-only 4-epoch accounting; synthetic IDs, no scientific data."""
+    torch.set_num_threads(1)
+    rows = [{"sample_id": f"s{i:03}", "task_group": f"t{i // 4:02}", "prompt": "p", "completion": "A123"} for i in range(312)]
+    inputs["data"].write_text("".join(json.dumps(row) + "\n" for row in rows))
+    doc = json.loads(inputs["manifest"].read_text())
+    doc["dataset"]["sha256"] = file_sha256(inputs["data"])
+    doc["sample_schedule"] = [{"sample_id": row["sample_id"], "task_group": row["task_group"], "exposures": 4} for row in rows]
+    order = []
+    for epoch in range(4):
+        ids = [row["sample_id"] for row in rows]
+        random.Random(42 + epoch).shuffle(ids)
+        order.extend(ids)
+    doc["ordered_sample_ids"] = order
+    doc["epoch_lengths"] = [312] * 4
+    doc["epoch_each_sample_once"] = True
+    doc["task_exposures"] = {f"t{i:02}": 16 for i in range(78)}
+    config = dict(inputs["config"], batch_size=1, gradient_accumulation_steps=16, optimizer_steps=78,
+                  learning_rate=1e-4, warmup_steps=3, min_lr_ratio=.1, optimizer_fused=True,
+                  gradient_checkpointing=True, max_input_tokens=20_000, max_supervised_tokens=6_240)
+    doc["training_config"] = config
+    review = json.loads(inputs["review"].read_text())
+    review["dataset_sha256"] = file_sha256(inputs["data"])
+    review["schedule_sha256"] = schedule_digest(doc)
+    inputs["review"].write_text(json.dumps(review))
+    doc["independent_review"]["sha256"] = file_sha256(inputs["review"])
+    inputs["manifest"].write_text(json.dumps(doc))
+    result = run(inputs, tmp_path / "full", config=config)
+    events = [json.loads(line) for line in (tmp_path / "full/training_events.jsonl").read_text().splitlines()]
+    started = [e for e in events if e["kind"] == "microbatch_started"]
+    steps = [e for e in events if e["kind"] == "optimizer_step_started"]
+    assert [e["sample_ids"][0] for e in started] == order
+    assert len(started) == 1248 and len(steps) == 78
+    assert result["counts"]["supervised_tokens"] == 6240
+    assert all(row["active_tokens"] == 80 for row in steps)
+    for s, event in enumerate(steps, 1):
+        expected = 1e-4 * (s / 3 if s <= 3 else .1 + .9 / 2 * (1 + math.cos(math.pi * (s - 3) / 75)))
+        assert event["learning_rate"] == pytest.approx(expected, rel=1e-14, abs=1e-16)
+    assert steps[2]["learning_rate"] == pytest.approx(1e-4)
+    assert steps[3]["learning_rate"] < 1e-4
+    assert steps[-1]["learning_rate"] == pytest.approx(1e-5)
