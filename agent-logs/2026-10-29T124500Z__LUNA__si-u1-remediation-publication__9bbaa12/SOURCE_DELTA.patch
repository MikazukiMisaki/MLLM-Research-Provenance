+"""Separate one-shot authority for synthetic-token engineering only."""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import re
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+from self_improvement.si_m1.gate import arm_parent_death
+from self_improvement.si_p3.runtime_gate import utc
+from self_improvement.si_s01.evidence import atomic_fresh_json
+from .gate import bind, need, source_identity
+from .runtime_identity import PACKAGES, identity_digest, verify_static
+from .training import file_sha256, learning_rate_for_step, tree_sha256, validate_config
+
+
+def engineering_source_identity(root: Path, evidence: str) -> str:
+    if evidence == "engineering_live":
+        return source_identity(root, "live")
+    need(evidence == "engineering_synthetic_cpu", "invalid engineering evidence class")
+    source = source_identity(root, "synthetic_cpu")
+    entry = file_sha256(root / "scripts/run_si_continuation_engineering.py")
+    return hashlib.sha256(json.dumps([source, entry], separators=(",", ":")).encode()).hexdigest()
+
+
+def _bind_remediation_budget(remediation: dict, a: dict) -> None:
+    """Debit an independently reviewed failed predecessor; never reuse its identity."""
+    need(type(remediation) is dict and set(remediation) == {"schema", "previous_run_id", "previous_source_sha", "previous_plan_sha256", "supervisor", "result"} and remediation["schema"] == "SI_U1_ENGINEERING_REMEDIATION_BINDING_V1", "strict remediation predecessor binding")
+    for name in ("supervisor", "result"):
+        record = remediation[name]
+        need(type(record) is dict and set(record) == {"path", "sha256"}, "remediation evidence shape")
+        path = Path(record["path"])
+        need(path.is_absolute() and path == path.resolve() and path.name == ("supervisor_exit.json" if name == "supervisor" else "engineering_result.json"), "remediation evidence path")
+    supervisor = bind(remediation["supervisor"]["path"], remediation["supervisor"]["sha256"])
+    result = bind(remediation["result"]["path"], remediation["result"]["sha256"])
+    prior = supervisor.get("binding", {})
+    prior_dir = Path(remediation["supervisor"]["path"]).parent
+    need(Path(remediation["result"]["path"]).parent == prior_dir and prior.get("output_path") == str(prior_dir), "same original output")
+    need(supervisor.get("schema") == "SI_CONTINUATION_ENGINEERING_SUPERVISOR_EXIT_V1" and supervisor.get("status") == "EXIT_RECORDED" and supervisor.get("authentic_returncode") == 1 and supervisor.get("cleanup_established") is True and supervisor.get("deadline_triggered") is False and supervisor.get("engineering_result_sha256") == remediation["result"]["sha256"], "authentic failed predecessor receipt")
+    counts = result.get("counts", {})
+    need(result.get("schema") == "SI_CONTINUATION_ENGINEERING_RESULT_V1" and result.get("status") == "FAILED" and result.get("evidence_class") == "engineering_live" and result.get("retry_authorized") is False and result.get("error") == "ContractError: PyTorch allocations remain after engineering cleanup" and result.get("trial_adapter_deleted") is True and counts.get("microbatches_completed") == 32 and counts.get("optimizer_steps_completed") == 2, "original cleanup failure remains failed")
+    need(prior.get("run_id") == remediation["previous_run_id"] and re.fullmatch("[0-9a-f]{32}", remediation["previous_run_id"]) and prior["run_id"] != a["run_id"] and prior.get("source_sha") == remediation["previous_source_sha"] and prior.get("plan_sha256") == remediation["previous_plan_sha256"], "distinct run and exact predecessor")
+    need(prior.get("protocol_sha256") == a["protocol"]["sha256"] and prior.get("base_sha256") == a["base"]["sha256"] and prior.get("p0_adapter_sha256") == a["adapter"]["sha256"] and prior.get("scope") == "SYNTHETIC_TOKEN_ENGINEERING_ONLY" and prior.get("evidence_class") == "engineering_live" and not Path(a["output_path"]).is_relative_to(prior_dir), "same frozen inputs and new output")
+    spent = supervisor.get("elapsed_seconds")
+    need(type(spent) in (int, float) and math.isfinite(spent) and spent > 0 and a["allocation_seconds"] == 1080 and spent + a["allocation_seconds"] <= 1200, "prior cost debited from original 1200 second budget")
+
+
+def bind_engineering_plan(plan: dict, protocol: dict, a: dict) -> None:
+    need(plan.get("schema") == "SI_U1_ENGINEERING_PLAN_V1" and plan.get("retry_authorized") is False, "engineering-only plan")
+    t = plan["training"]
+    need(plan["resource"] == a["gpu"] and t["allocation_seconds"] == a["allocation_seconds"], "engineering resource or time drift")
+    need(type(a["allocation_seconds"]) in (int, float) and 0 < a["allocation_seconds"] <= 1200, "engineering allocation cap")
+    for field in ("sequence_length", "active_target_tokens_per_sequence_with_EOS", "microbatch_size", "gradient_accumulation_steps", "maximum_microbatches", "maximum_optimizer_steps", "maximum_nonpad_input_tokens", "maximum_supervised_tokens", "maximum_artifact_saves"):
+        need(type(t[field]) is int and t[field] > 0, "positive engineering limits")
+    need(t["microbatch_size"] == 1 and t["maximum_optimizer_steps"] == 2 and t["maximum_microbatches"] == 2 * t["gradient_accumulation_steps"], "exact two-update engineering scope")
+    need(t["maximum_nonpad_input_tokens"] == t["sequence_length"] * t["maximum_microbatches"] and t["maximum_supervised_tokens"] == t["active_target_tokens_per_sequence_with_EOS"] * t["maximum_microbatches"], "engineering token reservations")
+    need(t["maximum_artifact_saves"] == 1 and t["gradient_checkpointing"] is True and t["use_cache"] is False, "single ephemeral artifact and checkpointing")
+    if a["evidence_class"] == "engineering_live":
+        need(plan.get("total_allocated_device_seconds") == 1800 and plan.get("unused_cap_transfer_authorized") is False and plan.get("evaluation", {}).get("allocation_seconds") == 600, "separate 1200/600 engineering allocations; no cap transfer")
+        if "remediation" in plan:
+            _bind_remediation_budget(plan["remediation"], a)
+        else:
+            need(a["allocation_seconds"] == 1200, "original allocation remains 1200 seconds")
+        need(t["sequence_length"] == 2048 and t["active_target_tokens_per_sequence_with_EOS"] == 5 and t["gradient_accumulation_steps"] == 16 and t["maximum_microbatches"] == 32 and t["maximum_nonpad_input_tokens"] == 65536 and t["maximum_supervised_tokens"] == 160, "exact real engineering dose")
+        need(a["gpu"]["allocator_cap_bytes"] == 25769803776 and a["gpu"]["preweight_free_bytes"] == 30064771072 and a["gpu"]["later_free_bytes"] == 2147483648, "exact shared GPU ceilings")
+        need(protocol["runtime"]["B"]["gpu"] == a["gpu"] == protocol["runtime"]["C"]["gpu"] and protocol["runtime"]["B"]["allocation_seconds"] == protocol["runtime"]["C"]["allocation_seconds"] == 5400 and protocol["training_config"]["max_length"] == t["sequence_length"] and protocol["training_config"]["optimizer_steps"] == 78, "engineering device, sequence and 78-step projection must match both frozen science arms")
+    else:
+        need(a["evidence_class"] == "engineering_synthetic_cpu" and a["gpu"] == {} and t["sequence_length"] <= 256 and t["maximum_microbatches"] <= 32, "bounded CPU toy engineering")
+    config = protocol["training_config"]
+    validate_config(config, config["batch_size"] * config["gradient_accumulation_steps"] * config["optimizer_steps"])
+    need(config["batch_size"] == 1 and config["gradient_accumulation_steps"] == t["gradient_accumulation_steps"] and config["gradient_checkpointing"] is True and config["use_cache"] is False and config["optimizer_fused"] is True, "same scientific optimizer and checkpointing")
+    need(t["learning_rates"] == [learning_rate_for_step(config, step) for step in range(2)], "first two frozen scientific learning rates")
+
+
+def verify(root: Path, auth_path: Path, auth_sha: str, *, mode: str, argv: list[str], clearance_path: Path | None = None, clearance_sha: str | None = None, launch_context_sha: str | None = None):
+    need(mode in ("preflight", "live", "worker") and sys.flags.isolated == 1, "isolated explicit engineering mode")
+    a = bind(auth_path, auth_sha)
+    fields = {"schema", "purpose", "evidence_class", "source_sha", "base", "adapter", "plan", "protocol", "review", "interpreter", "environment", "uid", "output_path", "preflight_path", "not_before", "expires", "allocation_seconds", "gpu", "run_id", "maximum_launches"}
+    need(set(a) == fields and a["schema"] == "SI_CONTINUATION_ENGINEERING_AUTH_V1" and a["purpose"] == "SYNTHETIC_TOKEN_P0_LOAD_AND_TWO_UPDATES_ONLY", "strict engineering authorization; no data or task path")
+    need(a["maximum_launches"] == 1 and type(a["maximum_launches"]) is int and re.fullmatch("[0-9a-f]{32}", a["run_id"]) and a["uid"] == os.getuid() and type(a["uid"]) is int, "unique engineering run and UID")
+    need(utc(a["not_before"]) <= datetime.now(timezone.utc) < utc(a["expires"]), "engineering authorization expired")
+    need(engineering_source_identity(root, a["evidence_class"]) == a["source_sha"], "exact engineering source")
+    need(type(a["environment"]) is dict and all(type(k) is str and type(v) is str for k, v in a["environment"].items()) and dict(os.environ) == a["environment"], "engineering exact environment")
