+def _supervisor_option(argv: list[str], name: str) -> str:
+    values = []
+    for index, argument in enumerate(argv):
+        if argument == name:
+            if index + 1 == len(argv) or argv[index + 1].startswith("--"):
+                raise EvidenceIntegrityError(f"supervisor command lacks a value for {name}")
+            values.append(argv[index + 1])
+        elif argument.startswith(name + "="):
+            values.append(argument.split("=", 1)[1])
+    if len(values) != 1 or not values[0]:
+        raise EvidenceIntegrityError(f"supervisor command requires one unambiguous {name}")
+    return values[0]
+
