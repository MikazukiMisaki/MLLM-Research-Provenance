+        insist(self.units[active]['identity']==identity and not self.units[active]['finished'] and not self.units[active]['failed'],'engineering one-generation identity')
+        return active
+    def claim_generation(self,prepared:Mapping[str,Any])->str:
+        active=self.require_generation();unit=self.units[active]
+        insist(unit['prepared']==dict(prepared),'actual engineering prepared tensors must equal reserved unit')
+        insist(not unit.get('invocation_claimed'),'engineering one actual generation invocation already consumed')
+        self.check_time();unit['invocation_claimed']=True
