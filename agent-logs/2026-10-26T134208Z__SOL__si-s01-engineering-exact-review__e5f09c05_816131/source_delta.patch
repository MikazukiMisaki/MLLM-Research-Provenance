+"""Exact d7 AST normalization and actual old/new source raw-generation differential."""
+import ast,copy,json,subprocess,time,types
+from pathlib import Path
+import pytest
+from self_improvement.si_s01 import runtime,runtime_core,supervisor_core
+from self_improvement.si_s01.collector import Producer
+from self_improvement.si_s01.evidence import Journal,Ledger
+from self_improvement.si_s01.engineering_runtime import EngineeringProducer
+from self_improvement.si_s01.contract import digest
+from self_improvement.si_p3.runtime_gate import inspect_gpu
+from si_s01_support import plan
+from si_s01_engineering_support import fixture_setup,REPO,GPU
+
+BASE='d7a82acb510157ab7ba5439d790816c5c948439f'
+def frozen(path):
+    return subprocess.check_output(['git','show',BASE+':'+path],cwd=REPO,text=True) # Missing pinned Git objects fail, never fallback.
+def body(node):return [ast.dump(x,include_attributes=False) for x in node]
+def method(tree,cls,name):
+    return next(n for n in next(c for c in tree.body if isinstance(c,ast.ClassDef) and c.name==cls).body if isinstance(n,ast.FunctionDef) and n.name==name)
+
+
+def test_load_and_generation_shared_core_AST_exact_except_approved_hooks_and_class_label():
+    old=ast.parse(frozen('src/self_improvement/si_s01/runtime.py'));new=ast.parse(Path(runtime_core.__file__).read_text());source=ast.parse(Path(runtime.__file__).read_text())
+    class Normalize(ast.NodeTransformer):
+        def visit_If(self,node):
+            if isinstance(node.test,ast.Compare) and isinstance(node.test.left,ast.Name) and node.test.left.id in ('probe_started','probe_completed','pre_call'):
+                assert len(node.body)==1 and isinstance(node.body[0],ast.Expr) and isinstance(node.body[0].value,ast.Call) and node.body[0].value.func.id==node.test.left.id
+                return None
+            return self.generic_visit(node)
+        def visit_Name(self,node):
+            return ast.Constant('live_source_only') if node.id=='evidence_class' else node
+    load=next(n for n in new.body if isinstance(n,ast.FunctionDef) and n.name=='load_guarded')
+    raw=next(n for n in new.body if isinstance(n,ast.FunctionDef) and n.name=='guarded_generation')
+    assert body(Normalize().visit(copy.deepcopy(load)).body)==body(method(old,'LiveProducer','load').body[2:])
+    assert body(Normalize().visit(copy.deepcopy(raw)).body)==body(method(old,'LiveProducer','_raw').body[5:])
+    assert body(method(source,'LiveProducer','_raw').body[:5])==body(method(old,'LiveProducer','_raw').body[:5])
+    assert body(next(n for n in new.body if isinstance(n,ast.FunctionDef) and n.name=='resource').body)==body(method(old,'LiveProducer','resource').body)
+    assert EngineeringProducer.prepare is Producer.prepare and EngineeringProducer.decode is Producer.decode
+
+
+def test_supervisor_source_profile_normalizes_exactly_to_d7_mechanics():
+    old=next(n for n in ast.parse(frozen('src/self_improvement/si_s01/supervisor.py')).body if isinstance(n,ast.FunctionDef))
+    tree=ast.parse(Path(supervisor_core.__file__).read_text());core=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='supervise_core');profile=supervisor_core.SOURCE_PROFILE
+    class Normalize(ast.NodeTransformer):
+        def visit_Attribute(self,node):
+            if isinstance(node.value,ast.Name) and node.value.id=='profile':
+                value=getattr(profile,node.attr)
+                return ast.Dict(keys=[],values=[]) if node.attr=='claim_fields' else ast.Constant(value)
+            return self.generic_visit(node)
+        def visit_Call(self,node):
+            node=self.generic_visit(node)
+            if isinstance(node.func,ast.Name) and node.func.id=='dict' and len(node.args)==1 and isinstance(node.args[0],ast.Dict) and not node.args[0].keys:return node.args[0]
+            return node
+        def visit_BinOp(self,node):
+            node=self.generic_visit(node)
+            if isinstance(node.op,ast.BitOr) and isinstance(node.right,ast.Dict) and not node.right.keys:return node.left
+            return node
+        def visit_BoolOp(self,node):
+            node=self.generic_visit(node)
+            if isinstance(node.op,ast.And) and isinstance(node.values[0],ast.Constant) and node.values[0].value is True:
+                return node.values[1] if len(node.values)==2 else ast.BoolOp(op=ast.And(),values=node.values[1:])
+            return node
+    assert body(Normalize().visit(copy.deepcopy(core)).body)==body(old.body)
+    assert profile.maximum_seconds==14400 and profile.live_mode=='live_source_only' and profile.science_authorized is True
+
+
+@pytest.mark.parametrize('fault',[None,'tensor','disabled_P0','post_resource'])
+def test_actual_source_wrapper_differential_preserves_raw_guards_events_and_debits(tmp_path,monkeypatch,fault):
+    f=fixture_setup(tmp_path,monkeypatch)
+    for parameter in f.state.model.parameters():parameter.requires_grad_(False)
+    namespace={'__name__':'self_improvement.si_s01._frozen_d7_parity','__package__':'self_improvement.si_s01'}
+    exec(compile(frozen('src/self_improvement/si_s01/runtime.py'),'<pinned-d7-runtime-software-differential>','exec'),namespace)
+    snapshots=[];source_plan=plan()
+    for label,cls in [('d7',namespace['LiveProducer']),('current',runtime.LiveProducer)]:
+        f.state.calls.clear();f.state.model.enabled=fault!='disabled_P0';f.state.tokenizer.drift='attention_mask' if fault=='tensor' else None;f.state.foreign_post=fault=='post_resource'
+        ticks=iter([100.0,100.125]);monkeypatch.setattr(time,'perf_counter',lambda:next(ticks))
+        journal_ticks=iter([float(i) for i in range(100)])
+        journal=Journal(tmp_path/(label+'.jsonl'),{'explicit_synthetic_source_component':True},clock=lambda:next(journal_ticks));ledger=Ledger(journal,source_plan,'8'*32)
+        producer=cls(f.state.tokenizer,None,evidence_class='synthetic_software_fixture');producer.raw=producer._raw
+        producer.torch=__import__('torch');producer.model=f.state.model;producer.ledger=ledger
+        producer.resource=lambda:inspect_gpu(GPU,allowed_pids={__import__('os').getpid()},require_owned_context=True)
+        prepared=producer.prepare('explicit public source component input');value=None;error=None
+        try:
+            event=ledger.call(source_plan.slots[0],'generation',0,lambda:producer.generate(prepared,source_plan.slots[0],0),prepared=prepared.to_dict());value=ledger.data(event)
+        except Exception as exc:error={'type':type(exc).__name__,'message':str(exc),'raw':getattr(exc,'raw_evidence',None),'resource':getattr(exc,'resource_evidence',None)}
+        observations=[{'kind':e['kind'],'payload':e['payload']} for e in journal.events[1:]];journal.close()
+        snapshots.append({'value':value,'error':error,'observations':observations,'used':dict(ledger.used),'completed':dict(ledger.completed),'stopped':ledger.stopped,'model_edge_calls':f.state.calls['generation']})
+    assert snapshots[0]==snapshots[1]
+    assert snapshots[1]['model_edge_calls']==int(fault not in ('tensor','disabled_P0'))
