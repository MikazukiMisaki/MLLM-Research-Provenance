+++ b/src/self_improvement/si_p3/runtime_backend.py
@@ -0,0 +1,239 @@
+"""Offline single-device P0/base inference with actual PEFT and tensor evidence."""
+from __future__ import annotations
+
+from contextlib import nullcontext
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any, Callable, Mapping
+import json
+import time
+import importlib.metadata
+
+from .contract import Generation, P0_SHA256, Prepared, require, text_hash
+from .runtime_gate import Permit, file_hash, inspect_gpu
+from .runtime_ledger import EngineeringLedger
+
+
+@dataclass(frozen=True)
+class PreparedTensors:
+    prepared: Prepared
+    attention_mask: tuple[int, ...]
+
+    def to_dict(self) -> dict[str, Any]:
+        return self.prepared.to_dict() | {"attention_mask": list(self.attention_mask)}
+
+
+def module_origin(module: Any) -> dict[str, str]:
+    path = Path(module.__file__).resolve()
+    return {"path": str(path), "sha256": file_hash(path), "version": str(getattr(module, "__version__", ""))}
+
+
+def installed_distribution_versions() -> dict[str, str | None]:
+    """Supplement module attributes, whose absence must not be invented as a version."""
+    result = {}
+    for name in ("torch", "transformers", "peft", "alfworld", "textworld", "PyYAML"):
+        try: result[name] = importlib.metadata.version(name)
+        except importlib.metadata.PackageNotFoundError: result[name] = None
+    return result
+
+
+def adapter_state(model: Any) -> dict[str, Any]:
+    """Names alone are insufficient: disable_adapter retains active names."""
+    return {"model": asdict(model.get_model_status()),
+            "layers": [asdict(value) for value in model.get_layer_status()]}
+
+
+def verify_adapter_state(state: Mapping[str, Any], *, enabled: bool) -> None:
+    summary, layers = state["model"], state["layers"]
+    require(bool(layers) and summary["num_adapter_layers"] == len(layers), "PEFT adapter layer count")
+    for row in [summary, *layers]:
+        require(row["enabled"] is enabled and row["active_adapters"] == ["default"] and
+                row["merged_adapters"] == [] and row["available_adapters"] == ["default"],
+                "PEFT enabled/name/merged state mismatch")
+    require(summary["trainable_params"] == 0, "inference adapter must be frozen")
+
+
+class LocalInference:
+    """The real loader is entered only inside the separately authorized worker.
+
+    Software fixtures inject a tiny frozen PEFT model and generation boundary;
+    they never exercise this real loader or claim an 8B state observation.
+    """
+    def __init__(self, tokenizer: Any, model: Any, torch: Any, ledger: EngineeringLedger,
+                 resource_check: Callable[[], Any], *, software_fixture: bool = False) -> None:
+        self.tokenizer, self.model, self.torch = tokenizer, model, torch
+        self.ledger, self.resource_check = ledger, resource_check
+        self.software_fixture = software_fixture
+        if software_fixture:
+            require(str(model.device) == "cpu" and sum(p.numel() for p in model.parameters()) <= 1_000_000,
+                    "software boundary requires tiny CPU model")
+        else:
+            require(str(model.device) == "cuda:0" and all(str(p.device) == "cuda:0" for p in model.parameters()),
+                    "one CUDA device, no CPU/disk offload")
+            require(not getattr(model, "is_loaded_in_4bit", False) and not getattr(model, "is_loaded_in_8bit", False),
+                    "quantization forbidden")
+            # PEFT's default F32 LoRA autocast is intentional; do not cast it away.
+            for name, param in model.named_parameters():
+                if param.is_floating_point():
+                    allowed = (torch.bfloat16, torch.float32) if "lora_" in name else (torch.bfloat16,)
+                    require(param.dtype in allowed, "frozen base dtype/default PEFT dtype")
+        require(all(not p.requires_grad for p in model.parameters()), "inference only, no trainable parameters")
+        verify_adapter_state(adapter_state(model), enabled=True)
+        model.eval()
+        eos = tokenizer.eos_token_id
+        self.eos_ids = (eos,) if type(eos) is int else tuple(eos or ())
+        require(bool(self.eos_ids), "EOS IDs")
+
+    @classmethod
+    def load(cls, permit: Permit, ledger: EngineeringLedger) -> LocalInference:
+        ledger.reserve("model-load", "model_load")
+        try:
+            import torch
+            import transformers
+            import peft
+            import models.qwen as qwen
+            from models.policy import GenerationOptions
+            from models.qwen import QwenPolicy, QwenPolicyConfig
+            for name, module in (("torch", torch), ("transformers", transformers), ("peft", peft)):
+                require(module_origin(module) == permit.proposal["packages"][name], "package origin/version: " + name)
+            from .runtime_gate import PHASES, engineering_prompts
+            pretokenizer = transformers.AutoTokenizer.from_pretrained(permit.proposal["model"]["base_snapshot"],
+                local_files_only=True, trust_remote_code=False)
+            known_inputs = []
+            for prompt in engineering_prompts().values():
+                rendered = pretokenizer.apply_chat_template([{"role": "user", "content": prompt}], tokenize=False,
+                    add_generation_prompt=True, enable_thinking=False)
+                known_inputs.append(len(pretokenizer(rendered, add_special_tokens=True)["input_ids"]))
+            require(max(known_inputs) <= permit.ceilings["per_call_input"] and
+                    sum(known_inputs) <= permit.ceilings["input_tokens"] and
+                    permit.ceilings["generations"] >= 4 and permit.ceilings["generated_tokens"] >= sum(x[1] for x in PHASES),
+                    "four fixed prepared-input/output ceilings before GPU allocation")
+            require(torch.cuda.is_available() and torch.cuda.device_count() == 1, "one visible CUDA device")
+            check = lambda: inspect_gpu(permit.gpu_uuid, allowed_pids={__import__("os").getpid()}, require_owned_context=True)
+            # Resolve namespace/ownership cheaply, before allocating the 8B weights.
+            torch.cuda.init()
+            require(str(getattr(torch.cuda.get_device_properties(0), "uuid", "")) == permit.gpu_uuid,
+                    "actual CUDA device UUID differs or is unobservable")
+            context_probe = torch.empty(1, dtype=torch.uint8, device="cuda:0")
+            ledger.append("resource", {"point": "one_byte_context_before_weights", "observed": check()})
+            del context_probe
+            backend = QwenPolicy(QwenPolicyConfig(model_id=permit.proposal["model"]["base_snapshot"],
+                device="cuda:0", dtype="bfloat16", local_files_only=True, trust_remote_code=False,
+                enable_thinking=False, generation=GenerationOptions(max_new_tokens=16, do_sample=False)))
+            tokenizer, base, _ = backend._load()
+            model = peft.PeftModel.from_pretrained(base, permit.proposal["model"]["adapter_path"],
+                is_trainable=False, local_files_only=True)
+            for p in model.parameters(): p.requires_grad_(False)
+            actual_config = {"model_type": model.config.model_type,
+                "attention_implementation": str(getattr(model.config, "_attn_implementation", "")),
+                "name_or_path": str(model.config._name_or_path),
+                "config_file_sha256": file_hash(Path(permit.proposal["model"]["base_snapshot"]) / "config.json"),
+                "hidden_size": model.config.hidden_size, "num_hidden_layers": model.config.num_hidden_layers,
+                "hf_device_map": getattr(model, "hf_device_map", {})}
+            require(actual_config["model_type"] == "qwen3" and actual_config["attention_implementation"] == "sdpa" and
+                    Path(actual_config["name_or_path"]).resolve() == Path(permit.proposal["model"]["base_snapshot"]).resolve(),
+                    "effective Qwen3/config/sdpa identity")
+            require(all(value in (0, "cuda:0") for value in actual_config["hf_device_map"].values()), "no CPU/disk offload map")
+            require(str(getattr(torch.cuda.get_device_properties(0), "uuid", "")) == permit.gpu_uuid,
+                    "actual CUDA device UUID differs or is unobservable")
+            result = cls(tokenizer, model, torch, ledger, check)
+            ledger.complete("model-load", {"origins": {m.__name__: module_origin(m) for m in (torch, transformers, peft, qwen)},
+                "adapter_state": adapter_state(model), "distribution_versions": installed_distribution_versions(), "effective_model_config": actual_config, "device": str(model.device),
+                "parameter_dtypes": sorted({str(p.dtype) for p in model.parameters()}),
+                "gpu": check(), "memory_allocated": torch.cuda.memory_allocated(),
+                "memory_reserved": torch.cuda.memory_reserved(), "max_memory_allocated": torch.cuda.max_memory_allocated()})
+            return result
+        except BaseException as error:
+            ledger.failed("model-load", error)
+            raise
+
+    def prepare(self, prompt: str) -> PreparedTensors:
+        rendered = self.tokenizer.apply_chat_template([{"role": "user", "content": prompt}],
+            tokenize=False, add_generation_prompt=True, enable_thinking=False)
+        encoded = self.tokenizer(text=rendered, add_special_tokens=True)
+        require(set(encoded) == {"input_ids", "attention_mask"}, "tokenizer tensor keys")
+        ids, mask = encoded["input_ids"], encoded["attention_mask"]
+        require(type(ids) is list and bool(ids) and all(type(i) is int and i >= 0 for i in ids) and
+                mask == [1] * len(ids), "full unpadded tokenizer IDs/mask")
+        return PreparedTensors(Prepared(prompt, rendered, tuple(ids)), tuple(mask))
+
+    def generate(self, phase: str, prepared: PreparedTensors, cap: int, mode: str) -> Generation:
+        from .runtime_gate import PHASES
+        require((phase, cap, mode) in PHASES, "fixed phase/cap/mode")
+        self.model.eval()
+        # Re-render and re-tokenize before reservation; stale/caller-forged Prepared is rejected.
+        require(self.prepare(prepared.prepared.prompt) == prepared, "prepared-token drift")
+        encoded = self.tokenizer(text=prepared.prepared.rendered_prompt, add_special_tokens=True, return_tensors="pt")
+        require(set(encoded) == {"input_ids", "attention_mask"}, "generate tensor keys")
+        inputs = {name: value.to(self.model.device) for name, value in encoded.items()}
+        require(all(value.ndim == 2 and value.shape[0] == 1 for value in inputs.values()), "one exact tensor row")
+        sent = prepared.prepared.to_dict() | {"input_ids": inputs["input_ids"][0].tolist(),
+                                            "attention_mask": inputs["attention_mask"][0].tolist()}
+        require(sent == prepared.to_dict(), "prepared/sent full input IDs and mask mismatch")
+        before = adapter_state(self.model)
+        verify_adapter_state(before, enabled=True)
+        self.resource_check()
+        unit = "generation-" + phase
+        started = False
+        raw = None
+        original_grad = {name: p.requires_grad for name, p in self.model.named_parameters()}
+        def restore_grad() -> None:
+            require(set(original_grad) == {name for name, _ in self.model.named_parameters()}, "parameter identity changed")
+            for name, parameter in self.model.named_parameters(): parameter.requires_grad_(original_grad[name])
+        try:
+            context = self.model.disable_adapter() if mode == "BASE" else nullcontext()
+            with context:
+                during = adapter_state(self.model)
+                verify_adapter_state(during, enabled=mode == "P0")
+                # No external-generation reservation until tensors AND actual PEFT state agree.
+                self.ledger.reserve(unit, "generation", phase=phase, prepared=prepared.to_dict())
+                started = True
+                self.ledger.append("adapter_state", {"phase": phase, "point": "during", "state": during})
+                if not self.software_fixture: self.torch.cuda.synchronize()
+                at = time.perf_counter()
+                with self.torch.no_grad():
+                    generated = self.model.generate(**inputs, max_new_tokens=cap, do_sample=False,
+                        return_dict_in_generate=True, output_scores=True)
+                if not self.software_fixture: self.torch.cuda.synchronize()
+                elapsed = time.perf_counter() - at
+                # Detect a bad generate boundary mutating its arguments or adapter state.
+                require(inputs["input_ids"][0].tolist() == sent["input_ids"] and
+                        inputs["attention_mask"][0].tolist() == sent["attention_mask"], "input tensors mutated during generate")
+                verify_adapter_state(adapter_state(self.model), enabled=mode == "P0")
+                sequence = generated.sequences[0].tolist()
+                require(sequence[:len(sent["input_ids"])] == sent["input_ids"], "generated input prefix changed")
+                tokens = sequence[len(sent["input_ids"]):]
+                require(len(generated.scores or ()) == len(tokens), "scores/token count")
+                reached = len(tokens) == cap
+                raw = {"prompt": prepared.prepared.prompt, "rendered_prompt": prepared.prepared.rendered_prompt,
+                       "rendered_prompt_sha256": text_hash(prepared.prepared.rendered_prompt),
+                       "raw_output": self.tokenizer.decode(tokens, skip_special_tokens=True).strip(),
+                       "token_ids": tokens, "token_ids_sha256": text_hash(json.dumps(tokens,separators=(",", ":"))),
+                       "input_tokens": len(sent["input_ids"]), "generated_tokens": len(tokens),
+                       "latency_seconds": elapsed, "output_complete": not reached or bool(tokens and tokens[-1] in self.eos_ids),
+                       "token_cap_reached": reached, "max_new_tokens": cap, "do_sample": False, "thinking": False,
+                       "adapter_mode": mode, "adapter_sha256": P0_SHA256 if mode == "P0" else None}
+                value = Generation.from_raw(raw, prepared.prepared, cap, mode, self.eos_ids)
+            # Installed PEFT re-enables LoRA grads on context exit; restore original inference flags.
+            restore_grad()
+            after = adapter_state(self.model)
+            verify_adapter_state(after, enabled=True)
+            require(after == before, "adapter restoration mismatch")
+            self.ledger.complete(unit, {"raw": dict(value.raw), "tensor_proof": {"prepared": prepared.to_dict(), "sent": sent},
+                "adapter_states": {"before": before, "during": during, "after": after}, "resource": self.resource_check(),
+                "memory": {"software_no_gpu": True} if self.software_fixture else {
+                    "allocated": self.torch.cuda.memory_allocated(), "reserved": self.torch.cuda.memory_reserved(),
+                    "peak_allocated_since_context": self.torch.cuda.max_memory_allocated(),
+                    "peak_reserved_since_context": self.torch.cuda.max_memory_reserved()}})
+            return value
+        except BaseException as error:
+            if started and not self.ledger.units[unit].get("finished"):
+                self.ledger.failed(unit, error)
+            raise
+        finally:
+            restore_grad()
+            restored = adapter_state(self.model)
+            self.ledger.append("adapter_state", {"phase": phase, "point": "after_or_exception", "state": restored,
+                "raw_received_before_failure": raw})
+            verify_adapter_state(restored, enabled=True)
+            require(restored == before, "adapter exception restoration mismatch")
