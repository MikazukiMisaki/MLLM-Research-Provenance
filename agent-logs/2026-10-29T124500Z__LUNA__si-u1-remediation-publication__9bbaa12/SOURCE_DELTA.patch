index 0000000..547e4e8
--- /dev/null
+++ b/src/self_improvement/continuation/supervisor.py
@@ -0,0 +1,121 @@
+"""One allocation, one child, hard timeout, descendant cleanup, exit receipt."""
+from __future__ import annotations
+
+import ctypes
+import os
+import subprocess
+import time
+from pathlib import Path
+
+from self_improvement.si_p3.runtime_supervisor import process_table, group_members, descendants, kill_identities
+from self_improvement.si_s01.evidence import atomic_fresh_json, fresh_json
+from .training import file_sha256
+
+
+def supervise(command, output: Path, *, binding, environment, seconds, entered, gpu_allocated,
+              receipt_schema="SI_CONTINUATION_SUPERVISOR_EXIT_V1", result_relative="training/training_result.json", result_key="training_result_sha256"):
+    if (receipt_schema, result_relative, result_key) not in (
+        ("SI_CONTINUATION_SUPERVISOR_EXIT_V1", "training/training_result.json", "training_result_sha256"),
+        ("SI_CONTINUATION_ENGINEERING_SUPERVISOR_EXIT_V1", "engineering_result.json", "engineering_result_sha256"),
+    ):
+        raise ValueError("unrecognized supervisor result contract")
+    claim = output.parent / (output.name + ".claim.json")
+    fresh_json(claim, {"binding": binding, "maximum_launches": 1, "retry_authorized": False})
+    output.mkdir(exist_ok=False)
+    deadline = entered + seconds
+    baseline = {pid for pid, info in process_table().items() if info[0] == os.getpid()}
+    libc = ctypes.CDLL(None, use_errno=True)
+    previous = ctypes.c_int()
+    have_old = False
+    process = None
+    returncode = None
+    timed_out = False
+    failure = None
+    known = {}
+    context_sha = None
+    before = []
+    worker_identity = None
+
+    def discover():
+        table = process_table()
+        if process is not None:
+            known.update(descendants(process.pid, table))
+        known.update({pid: info for pid, info in table.items() if info[0] == os.getpid() and pid not in baseline and (process is None or pid != process.pid)})
+        return table
+
+    try:
+        if time.monotonic() >= deadline:
+            raise RuntimeError("deadline expired before spawn")
+        if libc.prctl(37, ctypes.byref(previous), 0, 0, 0) != 0:
+            raise RuntimeError("cannot get subreaper state")
+        have_old = True
+        if libc.prctl(36, 1, 0, 0, 0) != 0:
+            raise RuntimeError("cannot set subreaper")
+        tick = int(Path("/proc/self/stat").read_text().rsplit(")", 1)[1].split()[19])
+        context = {"binding": binding, "supervisor_pid": os.getpid(), "supervisor_start_tick": tick,
+                   "allocation_started_monotonic": entered, "absolute_deadline_monotonic": deadline,
+                   "retry_authorized": False}
+        fresh_json(output / "launch_context.json", context)
+        context_sha = file_sha256(output / "launch_context.json")
+        worker_argv = list(command) + ["--launch-context-sha256", context_sha]
+        with (output / "worker.stdout").open("xb") as stdout, (output / "worker.stderr").open("xb") as stderr:
+            process = subprocess.Popen(worker_argv, stdout=stdout, stderr=stderr, env=dict(environment), start_new_session=True)
+            worker_identity = process_table().get(process.pid)
+            if worker_identity is None:
+                raise RuntimeError("cannot observe worker start")
+            atomic_fresh_json(output / "worker_start.json", {"pid": process.pid, "uid": os.getuid(), "start_tick": worker_identity[1], "pgid": process.pid, "sid": process.pid, "argv": worker_argv, "launch_context_sha256": context_sha})
+            try:
+                returncode = process.wait(timeout=max(0, deadline - min(2, seconds / 10) - time.monotonic()))
+            except subprocess.TimeoutExpired:
+                timed_out = True
+    except BaseException as exc:
+        failure = {"type": type(exc).__name__, "message": str(exc)}
+    finally:
+        if process is not None:
+            before = group_members(process.pid)
+            discover()
+            if worker_identity is not None:
+                kill_identities({process.pid: worker_identity})
+            elif process.poll() is None:
+                process.kill()  # unreaped Popen child; PID cannot yet be reused
+            kill_identities(known)
+            try:
+                returncode = process.wait(timeout=max(0, deadline - time.monotonic()))
+            except subprocess.TimeoutExpired:
+                pass
+            until = max(time.monotonic() + .05, min(deadline, time.monotonic() + 1))
+            while True:
+                discover()
+                kill_identities(known)
+                for pid in list(known):
+                    try:
+                        os.waitpid(pid, os.WNOHANG)
+                    except ChildProcessError:
+                        pass
+                table = discover()
+                alive = [pid for pid, info in known.items() if pid in table and table[pid][1:] == info[1:]]
+                if not group_members(process.pid) and not alive:
+                    break
+                if time.monotonic() >= until:
+                    break
+                time.sleep(.005)
+            if returncode is None:
+                returncode = process.poll()
+        table = discover()
+        remaining = sorted(set(group_members(process.pid) if process else []) | {pid for pid, info in known.items() if pid in table and table[pid][1:] == info[1:]})
+        restored = have_old and libc.prctl(36, previous.value, 0, 0, 0) == 0
+        elapsed = time.monotonic() - entered
+        cleanup = returncode is not None and not remaining
+        receipt = {"schema": receipt_schema, "binding": binding,
+                   "authentic_returncode": returncode, "deadline_triggered": timed_out, "supervisor_error": failure,
+                   "members_before_cleanup": before, "members_after_cleanup": remaining,
+                   "cleanup_established": cleanup, "subreaper_restored": restored,
+                   "elapsed_seconds": elapsed, "allocated_device_hours": gpu_allocated * elapsed / 3600,
+                   "within_time_cap": elapsed <= seconds, "retry_authorized": False,
+                   "launch_context_sha256": context_sha,
+                   "runtime_import_receipt_sha256": file_sha256(output / "runtime_import_receipt.json") if (output / "runtime_import_receipt.json").is_file() else None,
+                   "resource_receipt_sha256": file_sha256(output / "resource.jsonl") if (output / "resource.jsonl").is_file() else None,
+                   result_key: file_sha256(output / result_relative) if (output / result_relative).is_file() else None}
+        receipt["status"] = "EXIT_RECORDED" if cleanup and restored and not timed_out and not failure and elapsed <= seconds else "INCONCLUSIVE"
+        fresh_json(output / "supervisor_exit.json", receipt)
+    return receipt
diff --git a/src/self_improvement/continuation/training.py b/src/self_improvement/continuation/training.py
new file mode 100644
index 0000000..ee891fc
--- /dev/null
+++ b/src/self_improvement/continuation/training.py
@@ -0,0 +1,414 @@
+"""Frozen-P0 continuation primitives. This module does not grant run authority.
+
+The caller must supply an independently reviewed manifest and implement a
+separate supervised launcher, wall-clock enforcement and resource gate. No
+configuration, data selection, evaluation or restart policy is implicit here.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import time
+from pathlib import Path
+from typing import Any, Callable
+
+from sft.masking import tokenize_prompt_completion
+
+
+class ContractError(ValueError):
+    pass
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def tree_sha256(path: Path) -> str:
+    """Hash file names, sizes and contents; allow file links in HF snapshots."""
+    if path.is_symlink() or not path.is_dir():
+        raise ContractError("model and adapter must be ordinary directories")
+    entries = []
+    for item in sorted(path.rglob("*")):
+        if item.is_symlink() and not item.is_file():
+            raise ContractError("broken or directory symlink in frozen artifact tree")
+        if item.is_file():
+            entries.append([item.relative_to(path).as_posix(), item.stat().st_size, file_sha256(item)])
+        elif not item.is_dir():
+            raise ContractError("unexpected non-file in frozen artifact tree")
+    if not entries:
+        raise ContractError("frozen artifact tree is empty")
+    return hashlib.sha256(json.dumps(entries, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
+
+
+def _positive_int(value: Any, field: str) -> int:
+    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+        raise ContractError(f"{field} must be a positive integer")
+    return value
+
+
+def _finite(value: Any, field: str, *, positive: bool = False) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
+        raise ContractError(f"{field} must be finite")
+    value = float(value)
+    if value < 0 or (positive and value == 0):
+        raise ContractError(f"{field} is outside its allowed range")
+    return value
+
+
+def read_bound_json(path: Path, expected: str) -> dict[str, Any]:
+    contents = path.read_bytes()
+    if not isinstance(expected, str) or len(expected) != 64 or hashlib.sha256(contents).hexdigest() != expected:
+        raise ContractError(f"hash mismatch for {path}")
+    result = json.loads(contents)
+    if not isinstance(result, dict):
+        raise ContractError("bound document must be a JSON object")
+    return result
+
+
+def load_reviewed_manifest(path: Path, sha256: str) -> tuple[dict[str, Any], list[dict[str, Any]]]:
+    """Verify exact bytes and explicit sample order, groups and exposure counts.
+
+    The external audit file is *bound*, not independently adjudicated by this
+    function. A separate protocol gate must decide whether its review is valid.
+    """
+    manifest = read_bound_json(path, sha256)
+    if manifest.get("schema") != "SI_CONTINUATION_DATA_V1" or manifest.get("arm") not in ("B", "C"):
+        raise ContractError("unexpected manifest schema or arm")
+    binding = manifest.get("dataset")
+    review = manifest.get("independent_review")
+    if not isinstance(binding, dict) or not isinstance(review, dict):
+        raise ContractError("dataset and independent review bindings are required")
+    review_doc = read_bound_json(Path(review["path"]), review["sha256"])
+    if review_doc.get("decision") != "PASS_DATA_ONLY":
+        raise ContractError("data review decision is not PASS_DATA_ONLY")
+    if review_doc.get("dataset_sha256") != binding.get("sha256"):
+        raise ContractError("data review does not bind dataset bytes")
+    dataset_path = Path(binding["path"])
+    dataset_contents = dataset_path.read_bytes()
+    if hashlib.sha256(dataset_contents).hexdigest() != binding.get("sha256"):
+        raise ContractError("dataset hash mismatch")
+    rows = []
+    for line in dataset_contents.decode("utf-8").splitlines():
+        row = json.loads(line)
+        if not isinstance(row, dict) or any(not isinstance(row.get(k), str) or not row[k] for k in ("sample_id", "task_group", "prompt", "completion")):
+            raise ContractError("invalid source row")
+        rows.append(row)
+    by_id = {r["sample_id"]: r for r in rows}
+    if not rows or len(by_id) != len(rows):
+        raise ContractError("empty dataset or duplicate sample IDs")
+    schedule = manifest.get("sample_schedule")
+    if not isinstance(schedule, list) or not schedule:
+        raise ContractError("explicit sample schedule is required")
+    order = manifest.get("ordered_sample_ids")
+    if not isinstance(order, list) or not order or any(not isinstance(x, str) for x in order):
+        raise ContractError("explicit complete training order is required")
+    epochs = manifest.get("epoch_lengths")
+    each_once = manifest.get("epoch_each_sample_once")
+    task_exposures = manifest.get("task_exposures")
+    if not isinstance(epochs, list) or not epochs or type(each_once) is not bool or not isinstance(task_exposures, dict):
+        raise ContractError("explicit epoch and task exposure policy required")
+    if any(_positive_int(x, "epoch length") <= 0 for x in epochs) or sum(epochs) != len(order):
+        raise ContractError("epoch lengths do not cover complete training order")
+    binding = {"sample_schedule": schedule, "ordered_sample_ids": order, "epoch_lengths": epochs,
+               "epoch_each_sample_once": each_once, "task_exposures": task_exposures}
+    schedule_hash = hashlib.sha256(json.dumps(binding, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
+    if review_doc.get("schedule_sha256") != schedule_hash or review_doc.get("arm") != manifest["arm"]:
+        raise ContractError("data review does not bind arm and exact schedule")
+    seen: set[str] = set()
+    required_counts: dict[str, int] = {}
+    for entry in schedule:
+        if not isinstance(entry, dict) or entry.get("sample_id") not in by_id:
+            raise ContractError("schedule references missing sample")
+        sample_id = entry["sample_id"]
+        if sample_id in seen:
+            raise ContractError("duplicate schedule sample")
+        seen.add(sample_id)
+        row = by_id[sample_id]
+        if entry.get("task_group") != row["task_group"]:
+            raise ContractError("task grouping does not match reviewed source")
+        exposures = _positive_int(entry.get("exposures"), "exposures")
+        required_counts[sample_id] = exposures
+    if seen != set(by_id):
+        raise ContractError("schedule must explicitly disposition every dataset sample")
+    from collections import Counter
+    if Counter(order) != Counter(required_counts):
+        raise ContractError("training order differs from declared sample exposure counts")
+    if each_once:
+        cursor = 0
+        for length in epochs:
+            if Counter(order[cursor:cursor + length]) != Counter({key: 1 for key in by_id}):
+                raise ContractError("epoch omits or duplicates a reviewed sample")
+            cursor += length
+    actual_task_exposures = Counter()
+    for sample_id in order:
+        actual_task_exposures[by_id[sample_id]["task_group"]] += 1
+    if any(type(v) is not int or v <= 0 for v in task_exposures.values()) or dict(actual_task_exposures) != task_exposures:
+        raise ContractError("task exposure counts differ from frozen schedule")
+    return manifest, [by_id[sample_id] for sample_id in order]
+
+
+def encode_examples(tokenizer: Any, rows: list[dict[str, Any]], max_length: int) -> list[dict[str, Any]]:
+    _positive_int(max_length, "max_length")
+    if not getattr(tokenizer, "eos_token", None) or getattr(tokenizer, "eos_token_id", None) is None:
+        raise ContractError("tokenizer must supply EOS string and token ID")
+    encoded = []
+    for row in rows:
+        tokens = tokenize_prompt_completion(tokenizer, row["prompt"], row["completion"], max_length=max_length)
+        if tokens["input_ids"][-1] != tokenizer.eos_token_id or tokens["labels"][-1] != tokenizer.eos_token_id:
+            raise ContractError("active final EOS token required")
+        supervised = sum(x != -100 for x in tokens["labels"][1:])
+        if supervised == 0:
+            raise ContractError("no causally supervised tokens")
+        encoded.append({**tokens, "sample_id": row["sample_id"], "task_group": row["task_group"], "supervised_tokens": supervised})
+    return encoded
+
+
+def collate(items: list[dict[str, Any]], pad_token_id: int) -> dict[str, Any]:
+    import torch
+    length = max(len(x["input_ids"]) for x in items)
+    result = {"input_ids": [], "attention_mask": [], "labels": []}
+    for item in items:
+        pad = length - len(item["input_ids"])
+        result["input_ids"].append(item["input_ids"] + [pad_token_id] * pad)
+        result["attention_mask"].append(item["attention_mask"] + [0] * pad)
+        result["labels"].append(item["labels"] + [-100] * pad)
+    return {key: torch.tensor(value, dtype=torch.long) for key, value in result.items()}
+
+
+def validate_config(config: dict[str, Any], n: int) -> None:
+    required = {"seed", "batch_size", "gradient_accumulation_steps", "optimizer_steps", "learning_rate", "weight_decay", "max_grad_norm", "max_length", "max_supervised_tokens", "max_input_tokens", "max_wall_seconds", "adam_beta1", "adam_beta2", "adam_epsilon", "gradient_checkpointing", "use_cache", "optimizer", "optimizer_fused", "scheduler", "warmup_steps", "min_lr_ratio", "loss_normalization"}
+    if set(config) != required:
+        raise ContractError("training config has missing or unexpected keys")
+    for field in ("batch_size", "gradient_accumulation_steps", "optimizer_steps", "max_length", "max_supervised_tokens", "max_input_tokens"):
+        _positive_int(config[field], field)
+    if isinstance(config["seed"], bool) or not isinstance(config["seed"], int) or config["seed"] < 0:
+        raise ContractError("seed must be a nonnegative integer")
+    if type(config["gradient_checkpointing"]) is not bool or config["use_cache"] is not False:
+        raise ContractError("gradient_checkpointing must be bool and use_cache must be false")
+    if config["optimizer"] != "adamw" or type(config["optimizer_fused"]) is not bool or config["scheduler"] != "cosine" or config["loss_normalization"] != "active_tokens":
+        raise ContractError("unsupported optimizer, scheduler or loss normalization")
+    warmup = config["warmup_steps"]
+    if type(warmup) is not int or not 0 <= warmup < config["optimizer_steps"]:
+        raise ContractError("warmup_steps must leave at least one cosine update")
+    if _finite(config["min_lr_ratio"], "min_lr_ratio") > 1:
+        raise ContractError("minimum LR ratio must be at most one")
+    for field in ("learning_rate", "max_grad_norm", "max_wall_seconds", "adam_epsilon"):
+        _finite(config[field], field, positive=True)
+    _finite(config["weight_decay"], "weight_decay")
+    for field in ("adam_beta1", "adam_beta2"):
+        if _finite(config[field], field) >= 1:
+            raise ContractError(f"{field} must be < 1")
+    consumed = config["batch_size"] * config["gradient_accumulation_steps"] * config["optimizer_steps"]
+    if consumed != n:
+        raise ContractError("schedule exposure count must exactly match the configured training steps")
+
+
+def learning_rate_for_step(config: dict[str, Any], step: int) -> float:
+    """One-based linear warmup, then cosine to the frozen minimum at last step."""
+    total, warmup = config["optimizer_steps"], config["warmup_steps"]
+    if type(step) is not int or not 0 <= step < total:
+        raise ContractError("optimizer step outside frozen range")
+    if step < warmup:
+        factor = (step + 1) / warmup
+    else:
+        progress = (step + 1 - warmup) / (total - warmup)
+        floor = config["min_lr_ratio"]
+        factor = floor + (1 - floor) * (1 + math.cos(math.pi * progress)) / 2
+    return config["learning_rate"] * factor
+
+
+def compare_initial_conditions(manifest_b: dict[str, Any], manifest_c: dict[str, Any]) -> None:
+    """Check comparable initial conditions; data balance is reviewed separately."""
+    if manifest_b.get("arm") != "B" or manifest_c.get("arm") != "C":
+        raise ContractError("expected B and C arm manifests")
+    for key in ("base_sha256", "p0_adapter_sha256", "training_config"):
+        if key not in manifest_b or manifest_b[key] != manifest_c.get(key):
+            raise ContractError(f"B/C initial condition mismatch: {key}")
+
+
+def load_p0_adapter(base_model: Any, adapter_dir: Path) -> Any:
+    """Load the *existing* adapter, and verify that only LoRA weights train."""
+    from peft import PeftModel, get_peft_model_state_dict
+    from safetensors.torch import load_file
+    import torch
+    model = PeftModel.from_pretrained(base_model, str(adapter_dir), is_trainable=True)
+    trainable = [name for name, param in model.named_parameters() if param.requires_grad]
+    if not trainable or any("lora_" not in name for name in trainable):
+        raise ContractError("base or non-LoRA adapter parameters are trainable")
+    saved = load_file(str(adapter_dir / "adapter_model.safetensors"), device="cpu")
+    loaded = get_peft_model_state_dict(model)
+    if set(saved) != set(loaded) or any(not torch.equal(saved[k], loaded[k].detach().cpu()) for k in saved):
+        raise ContractError("loaded P0 adapter tensors differ from frozen adapter")
+    return model
+
+
+def load_frozen_local_base(base_dir: Path) -> Any:
+    """Production local-only BF16 model loader; never downloads code or weights."""
+    import torch
+    from transformers import AutoModelForCausalLM
+    return AutoModelForCausalLM.from_pretrained(
+        str(base_dir), torch_dtype=torch.bfloat16, local_files_only=True,
+        trust_remote_code=False, low_cpu_mem_usage=True,
+    )
+
+
+def load_frozen_local_tokenizer(base_dir: Path) -> Any:
+    from transformers import AutoTokenizer
+    return AutoTokenizer.from_pretrained(str(base_dir), local_files_only=True, trust_remote_code=False)
+
+
+def train_from_p0(*, base_dir: Path, base_sha256: str, adapter_dir: Path, adapter_sha256: str,
+                  manifest_path: Path, manifest_sha256: str, config: dict[str, Any], output_dir: Path,
+                  model_loader: Callable[[Path], Any], tokenizer_loader: Callable[[Path], Any],
+                  device: str, clock: Callable[[], float] = time.monotonic,
+                  resource_check: Callable[[str], None] | None = None,
+                  expected_totals: dict[str, int] | None = None,
+                  expected_supervised_per_example: int | None = None) -> dict[str, Any]:
+    """Run a bounded continuation. The calling supervisor must enforce deadlines.
+
+    Explicit injected loaders support testing and reviewed runtime integration.
+    They are not evidence of runtime identity; the launcher must bind loaders.
+    """
+    import torch
+    if output_dir.exists():
+        raise ContractError("output already exists")
+    if tree_sha256(base_dir) != base_sha256 or tree_sha256(adapter_dir) != adapter_sha256:
+        raise ContractError("P0 or base artifact hash mismatch")
+    manifest, rows = load_reviewed_manifest(manifest_path, manifest_sha256)
+    if manifest.get("base_sha256") != base_sha256 or manifest.get("p0_adapter_sha256") != adapter_sha256:
+        raise ContractError("manifest does not bind exact base and P0 adapter")
+    config = json.loads(json.dumps(config, allow_nan=False))
+    if manifest.get("training_config") != config:
+        raise ContractError("training config is not frozen by the manifest")
+    validate_config(config, len(rows))
+    output_dir.mkdir(parents=True, exist_ok=False)
+    started = clock()
+    counts = {"input_tokens": 0, "padded_input_tokens": 0, "supervised_tokens": 0, "microbatches_started": 0, "microbatches_completed": 0, "optimizer_steps": 0}
+    journal_path = output_dir / "training_events.jsonl"
+
+    def event(kind: str, **fields: Any) -> None:
+        with journal_path.open("a", encoding="utf-8") as handle:
+            handle.write(json.dumps({"kind": kind, **fields}, sort_keys=True) + "\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+
+    def deadline() -> None:
+        if clock() - started > config["max_wall_seconds"]:
+            raise ContractError("cooperative wall-clock budget exceeded; supervisor must enforce hard deadline")
+
+    def result(status: str, error: str | None = None) -> dict[str, Any]:
+        return {"schema": "SI_CONTINUATION_RESULT_V1", "status": status, "arm": manifest["arm"],
+                "base_sha256": base_sha256, "p0_adapter_sha256": adapter_sha256,
+                "manifest_sha256": manifest_sha256, "config": config, "counts": counts,
+                "elapsed_seconds": clock() - started, "final_adapter_sha256": None, "error": error}
+
+    try:
+        torch.manual_seed(config["seed"])
+        tokenizer = tokenizer_loader(base_dir)
+        encoded = encode_examples(tokenizer, rows, config["max_length"])
+        actual_totals = {"input_tokens": sum(len(x["input_ids"]) for x in encoded), "supervised_tokens": sum(x["supervised_tokens"] for x in encoded)}
+        if actual_totals["input_tokens"] > config["max_input_tokens"] or actual_totals["supervised_tokens"] > config["max_supervised_tokens"]:
+            raise ContractError("scheduled token exposure exceeds frozen budget before model load")
+        if expected_totals is not None and actual_totals != expected_totals:
+            raise ContractError("encoded token totals differ from frozen protocol before model load")
+        if expected_supervised_per_example is not None and any(x["supervised_tokens"] != expected_supervised_per_example for x in encoded):
+            raise ContractError("per-example supervised token count differs from frozen protocol")
+        event("encoded_schedule_verified", **actual_totals)
+        pad_id = tokenizer.pad_token_id if tokenizer.pad_token_id is not None else tokenizer.eos_token_id
+        deadline()
+        if resource_check:
+            resource_check("before_model_load")
+        event("model_load_started")
+        base = model_loader(base_dir)
+        model = load_p0_adapter(base, adapter_dir)
+        model.to(device)
+        if not hasattr(model, "config"):
+            raise ContractError("model has no verifiable config")
+        model.config.use_cache = config["use_cache"]
+        if model.config.use_cache is not False:
+            raise ContractError("model did not disable cache")
+        if config["gradient_checkpointing"]:
+            if not getattr(model, "supports_gradient_checkpointing", False):
+                raise ContractError("model does not support gradient checkpointing")
+            model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
+            if getattr(model, "is_gradient_checkpointing", None) is not True:
+                raise ContractError("gradient checkpointing not actually enabled")
+        elif getattr(model, "is_gradient_checkpointing", False) is not False:
+            raise ContractError("gradient checkpointing unexpectedly enabled")
+        event("model_load_completed")
+        if resource_check:
+            resource_check("after_model_load")
+        deadline()
+        model.train()
+        optimizer = torch.optim.AdamW((p for p in model.parameters() if p.requires_grad),
+            lr=config["learning_rate"], weight_decay=config["weight_decay"],
+            betas=(config["adam_beta1"], config["adam_beta2"]), eps=config["adam_epsilon"],
+            fused=config["optimizer_fused"])
+        if optimizer.defaults.get("fused") is not config["optimizer_fused"] or len(optimizer.state) != 0:
+            raise ContractError("optimizer mode or fresh-state invariant failed")
+        event("optimizer_configured", optimizer="adamw", fused=optimizer.defaults["fused"], initial_state_entries=len(optimizer.state), scheduler="cosine", loss_normalization="active_tokens")
+        cursor = 0
+        for step in range(config["optimizer_steps"]):
+            optimizer.zero_grad(set_to_none=True)
+            learning_rate = learning_rate_for_step(config, step)
+            for group in optimizer.param_groups:
+                group["lr"] = learning_rate
+            update_size = config["batch_size"] * config["gradient_accumulation_steps"]
+            update_active = sum(item["supervised_tokens"] for item in encoded[cursor:cursor + update_size])
+            if update_active <= 0:
+                raise ContractError("optimizer update has no active label tokens")
+            for _ in range(config["gradient_accumulation_steps"]):
+                deadline()
+                if resource_check:
+                    resource_check("before_microbatch")
+                batch_items = encoded[cursor:cursor + config["batch_size"]]
+                cursor += len(batch_items)
+                input_tokens = sum(len(item["input_ids"]) for item in batch_items)
+                padded_tokens = len(batch_items) * max(len(item["input_ids"]) for item in batch_items)
+                supervised = sum(item["supervised_tokens"] for item in batch_items)
+                if counts["input_tokens"] + input_tokens > config["max_input_tokens"] or counts["supervised_tokens"] + supervised > config["max_supervised_tokens"]:
+                    raise ContractError("token budget exceeded before forward")
+                counts["microbatches_started"] += 1
+                # Reserve before input transfer/forward; charge if either fails.
+                counts["input_tokens"] += input_tokens
+                counts["padded_input_tokens"] += padded_tokens
+                counts["supervised_tokens"] += supervised
+                event("microbatch_started", optimizer_step=step, sample_ids=[x["sample_id"] for x in batch_items], task_groups=[x["task_group"] for x in batch_items], input_tokens=input_tokens, padded_input_tokens=padded_tokens, supervised_tokens=supervised)
