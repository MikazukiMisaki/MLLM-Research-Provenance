@@ -0,0 +1,65 @@
+#!/usr/bin/env python3
+"""Fail-closed SI-E2 diagnostic. No default release, inputs, devices or output."""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+from datetime import datetime, timezone
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+
+from self_improvement.si_p3.contract import require
+from self_improvement.si_p3.runtime_gate import authenticate, inspect_gpu, utc, verify_artifacts
+from self_improvement.si_p3.runtime_ledger import fresh_json
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--authorization", type=Path, required=True)
+    parser.add_argument("--authorization-sha256", required=True)
+    parser.add_argument("--proposal", type=Path, required=True)
+    parser.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
+    args = parser.parse_args(argv)
+    try:
+        require(sys.flags.isolated == 1, "entrypoint requires python -I")
+        permit = authenticate(ROOT, args.authorization, args.authorization_sha256, args.proposal, worker=args.worker)
+        artifact_receipt = verify_artifacts(permit)
+        # No backend/ALFWorld construction has occurred above this gate.
+        resource = inspect_gpu(permit.gpu_uuid, allowed_pids=set())
+        if args.worker:
+            from self_improvement.si_p3.runtime_diagnostic import run_diagnostic
+            fresh_json(permit.output / "worker_gate.json", {"artifacts": artifact_receipt, "resource_before_load": resource})
+            report = run_diagnostic(permit)
+            return 0 if report["status"] == "ENGINEERING_BOUNDARY_OBSERVED_NOT_SCIENTIFIC_ACCEPTANCE" else 1
+        from self_improvement.si_p3.runtime_supervisor import supervise
+        remaining = (utc(permit.authorization["expires_utc"]) - datetime.now(timezone.utc)).total_seconds()
+        seconds = min(permit.ceilings["seconds"], permit.ceilings["device_hours"] * 3600, remaining)
+        require(seconds > 0, "release expired before launch")
+        command = [sys.executable, "-I", str(Path(__file__).resolve()), "--worker", "--authorization",
+            str(args.authorization.resolve()), "--authorization-sha256", args.authorization_sha256,
+            "--proposal", str(args.proposal.resolve())]
+        environment = {k:v for k,v in os.environ.items() if k not in ("PYTHONPATH", "PYTHONHOME", "LD_PRELOAD", "CUDA_DEVICE_ORDER")}
+        environment.update(HF_HUB_OFFLINE="1", TRANSFORMERS_OFFLINE="1", TOKENIZERS_PARALLELISM="false",
+                           PYTHONDONTWRITEBYTECODE="1", CUDA_VISIBLE_DEVICES=permit.gpu_uuid)
+        context = {"source_sha": permit.authorization["source_sha"], "authorization_sha256": permit.authorization_sha256,
+            "proposal_sha256": permit.proposal_sha256, "gpu_uuid": permit.gpu_uuid, "evidence_class": "engineering_diagnostic",
+            "artifact_precheck": artifact_receipt, "resource_precheck": resource, "supervisor_argv": list(sys.orig_argv)}
+        receipt = supervise(command, permit.output, context=context, seconds=seconds, environment=environment)
+        try:
+            fresh_json(permit.output / "resource_after.json", inspect_gpu(permit.gpu_uuid, allowed_pids=set()))
+        except Exception as error:
+            fresh_json(permit.output / "resource_after_error.json", {"exception": type(error).__name__, "message": str(error)})
+            return 1
+        return 0 if receipt["authentic_returncode"] == 0 and not receipt["deadline_triggered"] and not receipt["members_after_cleanup"] and receipt["within_time_cap"] else 1
+    except Exception as error:
+        print(json.dumps({"status": "REJECTED_OR_TECHNICAL_STOP", "exception": type(error).__name__, "message": str(error),
+            "resource_evidence": getattr(error, "resource_evidence", None)}), file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
