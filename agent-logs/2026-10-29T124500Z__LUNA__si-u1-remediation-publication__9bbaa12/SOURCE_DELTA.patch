+def test_frozen_file_symlink_hashes_target_bytes_and_rejects_dangling(tmp_path):
+    external = tmp_path / "blob"
+    external.write_text("first")
+    snapshot = tmp_path / "snapshot"
+    snapshot.mkdir()
+    (snapshot / "weights").symlink_to(external)
+    before = tree_sha256(snapshot)
+    external.write_text("changed")
+    assert tree_sha256(snapshot) != before
+    external.unlink()
+    with pytest.raises(ContractError, match="symlink"):
+        tree_sha256(snapshot)
+
