+def cuda_uuid_matches(observed: str | None, expected: str) -> bool:
+    """Compare complete CUDA/NVML UUIDs, never partial IDs, ordinals or MIG IDs."""
+    if type(observed) is not str or type(expected) is not str:
+        return False
+    canonical = r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
+    actual = re.fullmatch(r"(?:GPU-)?(" + canonical + r")", observed)
+    bound = re.fullmatch(r"GPU-(" + canonical + r")", expected)
+    return actual is not None and bound is not None and actual[1].lower() == bound[1].lower()
+
+
+def verify_cuda_uuid(torch: Any, ledger: EngineeringLedger, expected: str, *, point: str) -> None:
+    """Fsync the unnormalized observation before either UUID assertion can fail."""
+    missing = object()
+    raw: dict[str, Any] = {"present": False, "type_module": None, "type_name": None,
+                           "str": None, "repr": None}
+    observed: dict[str, Any] = {"device": 0, "expected_uuid": expected, "uuid": raw}
+    try:
+        value = getattr(torch.cuda.get_device_properties(0), "uuid", missing)
+        if value is not missing:
+            raw.update(present=True, type_module=type(value).__module__, type_name=type(value).__name__)
+            raw["str"] = str(value)
+            raw["repr"] = repr(value)
+    except BaseException as error:
+        observed["observation_error"] = {"exception": type(error).__name__, "message": str(error)}
+        ledger.append("resource", {"point": point, "observed": observed})
+        raise
+    ledger.append("resource", {"point": point, "observed": observed})
+    require(cuda_uuid_matches(raw["str"], expected), "actual CUDA device UUID differs or is unobservable")
+
