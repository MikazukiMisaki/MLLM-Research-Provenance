+        self.journal.append('unit_failed',{'unit':unit,'identity':self.units[unit]['identity'],'started_event':self.units[unit]['started_event'],
+            'data':{'exception':type(error).__name__,'message':str(error),'raw_evidence':getattr(error,'raw_evidence',None),'resource_evidence':getattr(error,'resource_evidence',None)}})
