+"""Static exact-source/data gate for one separately cleared continuation arm."""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import re
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+from self_improvement.si_m1.gate import arm_parent_death
+from self_improvement.si_p3.runtime_gate import git_state, utc
+from self_improvement.si_s01.evidence import atomic_fresh_json
+from .training import ContractError, compare_initial_conditions, file_sha256, learning_rate_for_step, load_reviewed_manifest, read_bound_json, tree_sha256, validate_config
+from .runtime_identity import PACKAGES, identity_digest, verify_static
+
+
+def need(value, message):
+    if not value:
+        raise ContractError(message)
+
+
+def bind(path, digest):
+    return read_bound_json(Path(path), digest)
+
+
+def source_identity(root: Path, evidence_class: str) -> str:
+    if evidence_class == "live":
+        sha, clean = git_state(root)
+        need(clean, "live source tree must be clean")
+        return sha
+    need(evidence_class == "synthetic_cpu", "unknown evidence class")
+    # Synthetic-only mode binds the actual implementation bytes without asking
+    # a developer's dirty checkout to masquerade as a clean live commit.
+    files = [root / "scripts/run_si_continuation.py", *sorted((root / "src/self_improvement/continuation").glob("*.py"))]
+    return hashlib.sha256(json.dumps([[str(p.relative_to(root)), file_sha256(p)] for p in files], separators=(",", ":")).encode()).hexdigest()
+
+
+def bind_protocol_runtime(protocol: dict, authorization: dict) -> None:
+    """The pre-registered arm policy is authoritative, including GPU and time."""
+    need(protocol.get("schema") == "SI_CONTINUATION_PROTOCOL_V1", "continuation protocol schema")
+    runtime = protocol.get("runtime")
+    need(type(runtime) is dict and set(runtime) == {"B", "C"}, "both per-arm runtime policies required")
+    expected = {"allocation_seconds": authorization["allocation_seconds"], "gpu": authorization["gpu"]}
+    need(runtime[authorization["arm"]] == expected, "runtime/time/GPU differs from frozen arm protocol")
+
+
+def bind_protocol_training(protocol: dict, manifest: dict, rows: list[dict], arm: str) -> dict[str, int]:
+    """Fail closed on preregistered config, full dose, family counts and LR."""
+    from collections import Counter
+    config = manifest["training_config"]
+    need(protocol.get("training_config") == config, "training config differs from frozen protocol")
+    rates = protocol.get("learning_rate_definition", {}).get("values_by_one_based_step")
+    need(type(rates) is list and len(rates) == config["optimizer_steps"] and all(type(rate) in (int, float) and math.isfinite(rate) and math.isclose(rate, learning_rate_for_step(config, i), rel_tol=1e-14, abs_tol=1e-16) for i, rate in enumerate(rates)), "optimizer LR sequence differs from frozen protocol")
+    dose = protocol.get("dose")
+    need(type(dose) is dict, "explicit frozen training dose required")
+    distinct = {row["sample_id"]: row for row in rows}
+    need(len(distinct) == dose["unique_examples_per_arm"] and len(rows) == dose["complete_ordered_example_ids_required"], "unique or exposed sample count differs from frozen dose")
+    need(manifest["epoch_lengths"] == dose["epoch_lengths"] and manifest["epoch_each_sample_once"] is dose["each_example_once_per_epoch"] and len(manifest["epoch_lengths"]) == dose["epochs"], "epoch schedule differs from frozen dose")
+    shuffle = protocol.get("epoch_shuffle_rule")
+    need(type(shuffle) is dict and shuffle.get("implementation") == "python_random_Random_shuffle" and shuffle.get("initial_order") == "ascending sample_id string" and shuffle.get("epoch_seed") == f"{config['seed']} + zero_based_epoch" and shuffle.get("epochs") == dose["epochs"] and type(shuffle.get("python_version_binding")) is str and bool(shuffle["python_version_binding"]), "frozen epoch shuffle rule")
+    import random
+    expected_order = []
+    for epoch in range(dose["epochs"]):
+        ids = sorted(distinct)
+        random.Random(config["seed"] + epoch).shuffle(ids)
+        expected_order.extend(ids)
+    need(manifest["ordered_sample_ids"] == expected_order, "ordered IDs differ from frozen shuffle")
+    groups = Counter(row["task_group"] for row in distinct.values())
+    count_groups = dose["distinct_parent_directories_per_arm"]
