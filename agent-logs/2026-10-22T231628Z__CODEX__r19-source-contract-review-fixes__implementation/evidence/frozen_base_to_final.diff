+def _validate_duration_arm_order(
+    row: Mapping[str, Any], source_event: Mapping[str, Any],
+    events: list[dict[str, Any]], expected_ks: set[str],
+) -> dict[int, Mapping[str, Any]]:
+    """Authenticate physical arm order independently of numeric K order."""
+    prefix_id = row["prefix_id"]
+    order_events = [event for event in events if event.get("kind") == "suffix_order_frozen"
+                    and event.get("identity", {}).get("prefix_id") == prefix_id]
+    expected_order = sorted(map(int, expected_ks))
+    random.Random(R19_SUFFIX_ORDER_SEED).shuffle(expected_order)
+    if len(order_events) != 1:
+        raise EvidenceIntegrityError("branch lacks one frozen suffix-order event")
+    order_event = order_events[0]
+    _same_execution_identity(source_event, order_event)
+    if order_event.get("payload") != {
+        "seed": R19_SUFFIX_ORDER_SEED, "order": expected_order, "k_in_generation_prompt": False,
+    }:
+        raise EvidenceIntegrityError("branch changed the frozen suffix order or seed")
+    by_kind: dict[str, dict[int, Mapping[str, Any]]] = {}
+    for kind in ("duration_arm_started", "duration_arm_completed"):
+        selected = [event for event in events if event.get("kind") == kind
+                    and event.get("identity", {}).get("prefix_id") == prefix_id]
+        if len(selected) != len(expected_ks):
+            raise EvidenceIntegrityError("branch arm lifecycle is missing or repeated")
+        arms: dict[int, Mapping[str, Any]] = {}
+        for event in selected:
+            _same_execution_identity(source_event, event)
+            identity = event.get("identity", {})
+            k = identity.get("k")
+            if (type(k) is not int or str(k) not in expected_ks or k in arms
+                    or identity.get("canonical_trial_id", row["canonical_trial_id"]) != row["canonical_trial_id"]):
+                raise EvidenceIntegrityError("branch arm lifecycle changed K or task identity")
+            arms[k] = event
+        by_kind[kind] = arms
+    previous = int(order_event.get("sequence", -1))
+    for k in expected_order:
+        start = by_kind["duration_arm_started"][k]
+        complete = by_kind["duration_arm_completed"][k]
+        if not previous < int(start.get("sequence", -1)) < int(complete.get("sequence", -1)):
+            raise EvidenceIntegrityError("branch arms do not follow the frozen physical execution order")
+        if start.get("payload", {}).get("suffix_order_seed") != R19_SUFFIX_ORDER_SEED:
+            raise EvidenceIntegrityError("branch arm start changed the frozen suffix-order seed")
