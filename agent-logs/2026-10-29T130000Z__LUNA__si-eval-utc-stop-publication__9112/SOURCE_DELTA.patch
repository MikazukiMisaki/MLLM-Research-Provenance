+            raise
+
+    def after_model_load(self,torch,*,arm,adapter_sha256,adapter_state,import_receipts):
+        self._sample(torch,'model_loaded',arm=arm,metadata={'adapter_sha256':adapter_sha256,'adapter_state':adapter_state,'import_receipts':import_receipts})
+
+    def before_generation(self,torch,*,arm):self._sample(torch,'before_generation',arm=arm)
