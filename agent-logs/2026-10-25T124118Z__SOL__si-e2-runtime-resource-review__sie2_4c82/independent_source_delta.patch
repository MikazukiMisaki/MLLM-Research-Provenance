+def file_hash(path: Path) -> str:
+    h = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def read_bound(path: Path, expected: str) -> bytes:
+    require(type(expected) is str and re.fullmatch("[0-9a-f]{64}", expected) is not None, "expected SHA256")
+    data = Path(path).read_bytes()
+    require(hashlib.sha256(data).hexdigest() == expected, "input bytes changed: " + str(path))
+    return data
+
+
+def utc(value: str) -> datetime:
+    require(type(value) is str and value.endswith("Z"), "UTC timestamp must end in Z")
+    return datetime.fromisoformat(value[:-1] + "+00:00")
