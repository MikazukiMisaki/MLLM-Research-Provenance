+"""One engineering-only boundary exercise. This never invokes the Collector."""
+from __future__ import annotations
+
+import importlib
+import json
+import os
+from pathlib import Path
+from typing import Any, Callable
+
+from .collector import parse_generation
+from .contract import PublicState, digest, require
+from .runtime_backend import LocalInference, module_origin, installed_distribution_versions
+from .runtime_environment import ReadIsolatedEnvironment, ReplayEvidence, historical_replay, replay_twice, bind_original_game_path
+from .runtime_gate import PACKAGE_NAMES, PHASES, Permit, engineering_prompts, file_hash
+from .runtime_ledger import EngineeringLedger, fresh_json, validate_report
+
+
+def verify_packages(permit: Permit) -> dict[str, Any]:
+    expected = permit.proposal["packages"]
+    for binding in expected.values():
+        require(file_hash(Path(binding["path"])) == binding["sha256"], "package input bytes changed")
+    observed = {}
+    for name in PACKAGE_NAMES:
+        module = importlib.import_module(name)
+        observed[name] = module_origin(module)
+        require(observed[name] == expected[name], "actual runtime package origin/version: " + name)
+    return {"module_origins": observed, "distribution_versions": installed_distribution_versions()}
+
+
+def run_diagnostic(permit: Permit, *, software_fixture: bool = False,
+                   software_loader: Callable[..., LocalInference] | None = None,
+                   software_environment_factory: Callable[[], Any] | None = None,
+                   software_replay: ReplayEvidence | None = None) -> dict[str, Any]:
+    """Explicit fixtures substitute only model/env edges; never exposed as a CLI bypass."""
+    require(software_fixture or (software_loader is None and software_environment_factory is None and software_replay is None),
+            "software injection forbidden in real diagnostic")
+    require(permit.authorization["purpose"] == "ENGINEERING_DIAGNOSTIC_ONLY" and
+            permit.authorization["science_authorized"] is False, "no science")
+    ledger = EngineeringLedger(permit.output / "engineering_events.jsonl", permit,
+        evidence_class="synthetic_software_fixture" if software_fixture else "engineering_diagnostic")
+    if not software_fixture:
+        allocation = json.loads((permit.output / "launch_context.json").read_bytes())["allocation_started_monotonic"]
+        require(allocation <= ledger.started_at, "supervisor allocation clock")
+        ledger.started_at = allocation
+    status = "ENGINEERING_BOUNDARY_OBSERVED_NOT_SCIENTIFIC_ACCEPTANCE"
+    results: dict[str, Any] = {}; error = None
+    try:
+        prompts = engineering_prompts()
+        require(digest(prompts) == permit.proposal["synthetic_prompts_sha256"], "fixed prompts changed")
+        if software_fixture:
+            require(software_loader is not None and software_environment_factory is not None and software_replay is not None,
+                    "complete explicit software edges")
+            replay, env_factory = software_replay, software_environment_factory
+            loader = software_loader
+            results["runtime_packages"] = "SOFTWARE_FIXTURE_NOT_REAL_RUNTIME_ORIGINS"
+        else:
+            env = permit.proposal["environment"]
+            replay = historical_replay(Path(env["trajectory"]).read_bytes(), Path(env["events"]).read_bytes())
+            row = json.loads(Path(env["trajectory"]).read_bytes().splitlines()[0])
+            bind_original_game_path(env, row, replay)
+            game = Path(env["game"])
+            from env.alfworld import AlfWorldConfig
+            def env_factory() -> ReadIsolatedEnvironment:
+                return ReadIsolatedEnvironment(AlfWorldConfig(Path(env["config"]), split="train",
+                    data_path=Path(env["data_root"])), game=game, pool_seed=replay.seed)
+            results["runtime_packages"] = verify_packages(permit)
+            loader = LocalInference.load
+        require(len(replay.commands) * 2 <= permit.ceilings["steps"] and 2 <= permit.ceilings["resets"],
+                "frozen historical replay budget before external calls")
+        backend = loader(permit, ledger)
+        state = PublicState("pick_and_place_simple-Engineering-None-Table-0/trial_engineering", "pick_and_place_simple",
+            "Move the engineering fixture object to the table", "Engineering fixture only. You see a table and a fixture object.",
+            ("look", "inventory"))
+        prepared = {phase: backend.prepare(prompt) for phase, prompt in prompts.items()}
+        # Reserve all four known inputs/output caps in a feasibility check before the first generation.
+        require(all(len(value.prepared.input_ids) <= permit.ceilings["per_call_input"] for value in prepared.values()) and
+                sum(len(value.prepared.input_ids) for value in prepared.values()) <= permit.ceilings["input_tokens"] and
+                sum(cap for _,cap,_ in PHASES) <= permit.ceilings["generated_tokens"] and permit.ceilings["generations"] >= 4,
+                "fixed four-call total input/output/count ceiling")
+        results["generations"] = []
+        for phase, cap, mode in PHASES:
+            generation = backend.generate(phase, prepared[phase], cap, mode)
+            results["generations"].append({"phase": phase, "raw": dict(generation.raw),
+                "parsed": parse_generation(phase, generation, state)})
+        # Outputs do not alter prompts or become environment commands, including invalid/incomplete outputs.
+        results["environment"] = replay_twice(replay, env_factory, ledger)
+    except BaseException as exc:
+        status = "TECHNICAL_STOP_NO_RETRY"
+        error = {"exception": type(exc).__name__, "message": str(exc)}
+        ledger.append("driver_failed", error)
+    finally:
+        report = {"schema": "SI_E2_ENGINEERING_REPORT_V1", "purpose": "ENGINEERING_DIAGNOSTIC_ONLY",
+            "evidence_class": "synthetic_software_fixture" if software_fixture else "engineering_diagnostic",
+            "science_authorized": False, "source_sha": permit.authorization["source_sha"],
+            "authorization_sha256": permit.authorization_sha256, "proposal_sha256": permit.proposal_sha256,
+            "status": status, "error": error, "results": results, "cost": ledger.snapshot(),
+            "historical_science_unchanged": {"generations": 5142, "environment_operations": 7949},
+            "limits": ["not a causal teacher branch", "Collector remains synthetic-only", "no acquisition/train/eval driver",
+                       "GPU observations do not establish training fit or acquisition completion"]}
+        validate_report(report, ledger.events)
+        fresh_json(permit.output / "engineering_report.json", report)
+        ledger.close()
+    return report
