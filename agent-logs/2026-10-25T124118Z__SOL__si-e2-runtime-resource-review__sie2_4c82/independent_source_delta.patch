+    from transformers import PreTrainedTokenizerFast, GPT2Config, GPT2LMHeadModel
+    from peft import LoraConfig, get_peft_model
+    vocab={"<unk>":0,"<eos>":1,"<pad>":2,"A001":3,"A000":4,"look":5,"inventory":6}
+    tok=Tokenizer(WordLevel(vocab,unk_token="<unk>"));tok.pre_tokenizer=Whitespace()
+    tokenizer=PreTrainedTokenizerFast(tokenizer_object=tok,unk_token="<unk>",eos_token="<eos>",pad_token="<pad>")
+    tokenizer.model_input_names=["input_ids","attention_mask"]
+    tokenizer.chat_template="{% for message in messages %}{{ message['content'] }}{% endfor %}"
+    model=get_peft_model(GPT2LMHeadModel(GPT2Config(vocab_size=len(vocab),n_layer=1,n_head=1,n_embd=8,n_positions=2048,
+        eos_token_id=1,pad_token_id=2)),LoraConfig(r=2,lora_alpha=2,target_modules=['c_attn'],task_type='CAUSAL_LM'))
+    for p in model.parameters():p.requires_grad_(False)
+    model.eval()
