+        self.check_time()
+    def close(self,stop:Mapping[str,Any]|None):
+        insist(not self.closed and not self._stack,'engineering ledger closure')
+        if stop is not None:self.journal.append('run_stopped',dict(stop))
+        self.journal.append('run_closed',{'stop':stop,'RNG_status':RNG_STATUS,'science_authorized':False});self.journal.close();self.closed=True
