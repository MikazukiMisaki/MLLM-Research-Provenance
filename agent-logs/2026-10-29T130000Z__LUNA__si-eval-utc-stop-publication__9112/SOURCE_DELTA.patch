+        else:_need(evidence_class=='synthetic' and live_permit is None, 'engineering synthetic/live mode')
+        _need(type(task) is dict and set(task)=={'task_id','family','seed','game_sha256'}, 'engineering task identity')
+        _need(type(task['seed']) is int and task['seed']==42 and type(adapter_sha256) is str and len(adapter_sha256)==64, 'engineering fixed seed/adapter')
+        self.task,self.adapter_sha256,self.output=task,adapter_sha256,Path(output)
+        self.producer_factory,self.environment_factory=producer_factory,environment_factory
+        self.evidence_class,self.allocation_started_at,self.live_permit=evidence_class,allocation_started_at,live_permit
+        self.started=False;self.units=set();self.active=None;self.return_events={};self.used=dict.fromkeys(COUNTERS,0);self.completed=dict.fromkeys(COUNTERS,0)
+
+    def call(self, journal, op, fn, debit, *, prepared=None, request=None):
+        if op not in ('environment_close','model_close'):_need(time.monotonic()-self.start <= ENGINEERING_LIMITS['elapsed_seconds'], 'engineering elapsed cap')
+        _need(op not in self.units and self.active is None, 'engineering unit replay/overlap')
+        _need(all(self.used[k]+debit[k]<=ENGINEERING_LIMITS[k] for k in COUNTERS), 'engineering physical cap')
+        if op=='generation':_need(debit['input_tokens']<=ENGINEERING_LIMITS['per_call_input'], 'engineering input cap')
+        self.units.add(op);self.active=op;self.return_events[op]=[];self.used={k:self.used[k]+debit[k] for k in COUNTERS}
+        started=journal.append('unit_started',{'op':op,'prepared':prepared,'request':request,'reservation':debit})
+        try:
+            data=fn();actual=dict(debit)
+            if op=='generation':
+                _need(type(data) is dict and type(data.get('token_ids')) is list and 0<len(data['token_ids'])<=OUTPUT_CAP, 'engineering generation boundary');actual['output_tokens']=len(data['token_ids'])
+            journal.append('unit_completed',{'op':op,'started_event':started,'data':data,'actual':actual,'return_events':list(self.return_events[op])})
+            self.used['output_tokens']-=debit['output_tokens']-actual['output_tokens'];self.completed={k:self.completed[k]+actual[k] for k in COUNTERS}
+            return data
+        except BaseException as exc:
+            journal.append('unit_failed',{'op':op,'started_event':started,'exception':type(exc).__name__,'message':str(exc),'raw_evidence':getattr(exc,'raw_evidence',None),'resource_evidence':getattr(exc,'resource_evidence',None),'return_events':list(self.return_events[op])})
+            raise
+        finally:self.active=None
+
+    def run(self):
+        _need(not self.started,'engineering retry forbidden');self.started=True;now=time.monotonic();self.start=now if self.allocation_started_at is None else self.allocation_started_at
