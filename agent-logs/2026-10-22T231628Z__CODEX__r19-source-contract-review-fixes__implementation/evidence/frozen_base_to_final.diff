+                         family='pick_and_place_simple')
+        self.terminal_after = terminal_after
+        self.actions = []
+        self.closed = False
+        self.comparison_path = None
+    def reset(self, *, seed=None):
+        assert seed == 30000
+        return ResetResult('state 0', self.task, ('look', 'go to garbagecan 1'))
+    def step(self, action):
+        if self.comparison_path is not None:
+            comparison = json.loads(self.comparison_path.read_text())
+            assert comparison['status'] == 'PASS'
+            assert comparison['comparison_before_first_environment_action'] is True
+            assert comparison['environment_actions_executed_before_comparison'] == 0
+        assert action in ('look', 'go to garbagecan 1')
+        self.actions.append(action)
+        done = len(self.actions) == self.terminal_after
+        return Transition(f'state {len(self.actions)}', float(done), done, False,
+                          ('look', 'go to garbagecan 1'))
+    def close(self):
+        self.closed = True
+
+def _synthetic_generation(prompt, raw):
+    ids = [65]
+    return {
+        'prompt': prompt, 'rendered_prompt': prompt,
+        'rendered_prompt_sha256': hashlib.sha256(prompt.encode()).hexdigest(),
+        'raw_output': raw, 'token_ids': ids,
+        'token_ids_sha256': hashlib.sha256(json.dumps(ids,separators=(',',':')).encode()).hexdigest(),
+        'input_tokens': 100, 'generated_tokens': 1, 'latency_seconds': 0.0,
+        'output_complete': True, 'token_cap_reached': False,
+        'max_new_tokens': 16, 'do_sample': False, 'thinking': False,
+    }
+
+def _expected_restart_snapshot(raw='A001'):
+    from models.action_parser import action_id_mapping
+    from models.policy import ActionRequest
+    from models.protocol_stability import parse_p2_selection
+    from sft.protocol import sft_p0_prompt
+    task = Task(task_id=TRIAL, text='put a pencil in garbagecan', split='train',
+                family='pick_and_place_simple')
+    valid_actions = ('look', 'go to garbagecan 1')
+    prompt = sft_p0_prompt(ActionRequest(task, 'state 0', (), valid_actions))
+    generation = _synthetic_generation(prompt, raw)
+    parsed = parse_p2_selection(raw, valid_actions, reflection_required=False)
+    mapping = action_id_mapping(valid_actions)
+    parser_result = {
+        'selection_status': parsed.selection_status, 'action_id': parsed.action_id,
+        'action': parsed.action, 'valid_actions': list(valid_actions), 'id_to_command': mapping,
+    }
+    return runner._source_restart_snapshot(
+        canonical_trial_id=TRIAL, schedule_index=0, seed=30000,
+        observation='state 0', valid_actions=valid_actions, prompt=prompt,
+        generation=generation, parser_result=parser_result, action_map=mapping,
+    )
