index 0000000..d248139
--- /dev/null
+++ b/src/self_improvement/si_p3/runtime_supervisor.py
@@ -0,0 +1,125 @@
+"""External POSIX deadline and authentic exit, including descendant cleanup."""
+from __future__ import annotations
+
+import ctypes
+import errno
+import os
+from pathlib import Path
+import signal
+import subprocess
+import time
+from typing import Any, Mapping, Sequence
+
+from .contract import require
+from .runtime_ledger import fresh_json
+
+
+def group_members(pgid: int) -> list[int]:
+    found = []
+    for path in Path("/proc").iterdir():
+        if not path.name.isdigit(): continue
+        try:
+            stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
+            if int(stat[2]) == pgid: found.append(int(path.name))
+        except (FileNotFoundError, PermissionError, ProcessLookupError): pass
+    return sorted(found)
+
+
+
+def process_table() -> dict[int, tuple[int, int, int]]:
+    """PPID, start tick and UID bind descendants even if they create a new session."""
+    result = {}
+    for path in Path("/proc").iterdir():
+        if not path.name.isdigit(): continue
+        try:
+            stat = (path / "stat").read_text().rsplit(")", 1)[1].split()
+            result[int(path.name)] = (int(stat[1]), int(stat[19]), path.stat().st_uid)
+        except (FileNotFoundError, PermissionError, ProcessLookupError): pass
+    return result
+
+
+def descendants(parent: int, table: Mapping[int, tuple[int, int, int]]) -> dict[int, tuple[int, int, int]]:
+    found = {}; frontier = {parent}
+    while frontier:
+        children = {pid for pid, value in table.items() if value[0] in frontier and pid not in found}
+        found.update({pid: table[pid] for pid in children}); frontier = children
+    return found
+
+
+def kill_identities(identities: Mapping[int, tuple[int, int, int]]) -> None:
+    current = process_table()
+    for pid, identity in identities.items():
+        if pid in current and current[pid][1:] == identity[1:] and identity[2] == os.getuid():
+            try: os.kill(pid, signal.SIGKILL)
+            except ProcessLookupError: pass
+
+def supervise(command: Sequence[str], output: Path, *, context: Mapping[str, Any],
+              seconds: float, environment: Mapping[str, str]) -> dict[str, Any]:
+    require(seconds > 0 and seconds <= 1800 and not output.exists() and not output.is_symlink(), "fresh bounded supervisor output")
+    output.mkdir(parents=False, exist_ok=False)
+    start = time.monotonic()
+    baseline_children = {pid for pid,value in process_table().items() if value[0] == os.getpid()}
+    # Reap orphaned same-group grandchildren on Linux after their parent is killed.
+    libc = ctypes.CDLL(None, use_errno=True)
+    old_subreaper = ctypes.c_int()
+    require(libc.prctl(37, ctypes.byref(old_subreaper), 0, 0, 0) == 0, "cannot read subreaper state")
+    require(libc.prctl(36, 1, 0, 0, 0) == 0, "Linux child subreaper unavailable")
+    evidence_class = context["evidence_class"]
+    require(evidence_class in ("engineering_diagnostic", "synthetic_software_fixture"), "supervisor evidence class")
+    devices = int(evidence_class == "engineering_diagnostic")
+    launch = dict(context) | {"supervisor_pid": os.getpid(), "argv": list(command),
+                              "allocated_devices": devices, "deadline_seconds": seconds, "allocation_started_monotonic": start}
+    fresh_json(output / "launch_context.json", launch)
+    known_descendants: dict[int, tuple[int, int, int]] = {}
+    process = None; timed_out = False; failure = None; members = []; code = None
+    # Reserve cleanup time inside the full allocation ceiling.
+    callback_deadline = max(0.001, seconds - min(2.0, seconds / 10))
+    try:
+        with (output / "worker.stdout").open("xb") as stdout, (output / "worker.stderr").open("xb") as stderr:
+            process = subprocess.Popen(list(command), stdout=stdout, stderr=stderr,
+                env=dict(environment), start_new_session=True)
+            fresh_json(output / "worker_start.json", {"pid": process.pid, "pgid": process.pid,
+                "argv": list(command), "authorization_sha256": context["authorization_sha256"]})
+            try:
+                code = process.wait(timeout=max(0.001, callback_deadline - (time.monotonic() - start)))
+            except subprocess.TimeoutExpired:
+                timed_out = True
+    except BaseException as error:
+        failure = {"exception": type(error).__name__, "message": str(error)}
+    finally:
+        if process is not None:
+            members = group_members(process.pid)
+            known_descendants.update(descendants(process.pid, process_table()))
+            try: os.killpg(process.pid, signal.SIGKILL)
+            except ProcessLookupError: pass
+            kill_identities(known_descendants)
+            code = process.wait()
+            # Bounded cleanup; record any surviving group rather than claiming it disappeared.
+            until = min(start + seconds, time.monotonic() + 1.0)
+            while time.monotonic() < until:
+                table = process_table()
+                # Newly orphaned sessions are adopted by this dedicated subreaper.
+                known_descendants.update({pid:value for pid,value in table.items()
+                    if value[0] == os.getpid() and pid not in baseline_children and pid != process.pid})
+                kill_identities(known_descendants)
+                for pid in known_descendants:
+                    try: os.waitpid(pid, os.WNOHANG)
+                    except ChildProcessError: pass
+                table = process_table()
+                alive = [pid for pid,value in known_descendants.items() if pid in table and table[pid][1:] == value[1:]]
+                if not group_members(process.pid) and not alive: break
+                time.sleep(0.01)
+        table = process_table()
+        remaining = sorted(set(group_members(process.pid) if process is not None else []) |
+            {pid for pid,value in known_descendants.items() if pid in table and table[pid][1:] == value[1:]})
+        elapsed = time.monotonic() - start
+        receipt = {"schema": "SI_E2_SUPERVISOR_EXIT_V1", "authorization_sha256": context["authorization_sha256"],
+            "source_sha": context["source_sha"], "evidence_class": context["evidence_class"],
+            "authentic_returncode": code, "deadline_triggered": timed_out, "spawn_or_supervisor_error": failure,
+            "members_before_cleanup": members, "descendants_observed": sorted(known_descendants), "members_after_cleanup": remaining,
+            "elapsed_seconds": elapsed, "allocated_devices": devices, "allocated_device_hours": devices * elapsed / 3600,
+            "within_time_cap": elapsed <= seconds, "child_report_present": (output / "engineering_report.json").is_file(),
+            "retry_authorized": False, "science_authorized": False}
+        require(libc.prctl(36, old_subreaper.value, 0, 0, 0) == 0, "cannot restore subreaper state")
+        fresh_json(output / "supervisor_exit.json", receipt)
+    return receipt
