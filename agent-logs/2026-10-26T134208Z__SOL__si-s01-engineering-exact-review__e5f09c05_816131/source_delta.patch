+    def call(self,kind:str,index:int,function:Callable[[],Mapping[str,Any]],*,prepared=None,request=None):
+        unit=self.begin(kind,index,prepared=prepared,request=request)
+        try:
+            data=dict(function());self.finish(unit,data);self.check_time();return data
