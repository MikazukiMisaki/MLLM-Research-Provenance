+        (arm, task["task_id"], 1) for arm in ("A", "B", "C") for task in manifest()["tasks"]]
+    assert [a for a, _ in loads] == ["A", "B", "C"]
+    assert len(envs) == 6 and all(x.actions == ["take object"] for x in envs)
