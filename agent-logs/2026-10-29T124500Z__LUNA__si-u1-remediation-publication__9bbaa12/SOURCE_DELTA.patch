+    need(output.is_absolute() and output == output.resolve() and output.parent.is_dir() and output.parent.stat().st_uid == os.getuid() and not output.parent.stat().st_mode & 0o022, "private canonical output parent")
+    need(preflight.is_absolute() and preflight == preflight.resolve() and preflight.parent.is_dir() and not preflight.is_relative_to(output), "separate canonical preflight")
+    claim = output.parent / (output.name + ".claim.json")
+    base_args = [a["interpreter"], "-I", str(root / "scripts/run_si_continuation.py")]
