+def test_cpu_cleanup_drops_model_parameters_buffers_and_optimizer_state(engineering_case, monkeypatch):
+    import torch
+    import self_improvement.continuation.engineering_worker as worker
+    original_load = worker.load_p0_adapter
+    tracked = {"models": [], "parameters": [], "buffers": [], "optimizer_states": []}
+    observations = []
+    original_step = torch.optim.AdamW.step
+    def step_and_track(optimizer, *args, **kwargs):
+        result = original_step(optimizer, *args, **kwargs)
+        tracked["optimizer_states"].extend(weakref.ref(value) for state in optimizer.state.values()
+                                          for value in state.values() if isinstance(value, torch.Tensor))
+        return result
+    def load_and_track(base, adapter):
+        model = original_load(base, adapter)
+        model.register_buffer("cleanup_probe_buffer", torch.ones(3), persistent=False)
+        tracked["models"].append(weakref.ref(model))
+        tracked["parameters"].extend(weakref.ref(parameter) for parameter in model.parameters())
+        tracked["buffers"].extend(weakref.ref(buffer) for buffer in model.buffers())
+        return model
+    def observe():
+        observations.append({name: sum(ref() is not None for ref in refs) for name, refs in tracked.items()})
+    monkeypatch.setattr(worker, "load_p0_adapter", load_and_track)
+    monkeypatch.setattr(torch.optim.AdamW, "step", step_and_track)
