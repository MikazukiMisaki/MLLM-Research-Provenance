+    comparison['comparison_before_first_environment_action'] = False
+    args['comparison_path'].write_text(json.dumps(comparison))
+    with pytest.raises(EvidenceIntegrityError, match='exact pre-action'):
+        analyzer.validate_source_restart_comparison(**args)
+    args['comparison_path'].write_bytes(original)
+    fake = SimpleNamespace(__file__=str(tmp_path / 'other-checkout/scripts/run_r19_experiment.py'))
+    monkeypatch.setitem(sys.modules, 'scripts.run_r19_experiment', fake)
+    import scripts
+    monkeypatch.setattr(scripts, 'run_r19_experiment', fake)
+    with pytest.raises(EvidenceIntegrityError, match='outside the analyzed checkout'):
+        analyzer.validate_source_restart_comparison(**args)
