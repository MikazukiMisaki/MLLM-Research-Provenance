+    binding = {"authorization_sha256": auth_sha, "manifest_sha256": a["manifest"]["sha256"], "paired_manifest_sha256": a["paired_manifest"]["sha256"], "protocol_sha256": a["protocol"]["sha256"], "pair_review_sha256": a["pair_review"]["sha256"], "runtime_identity_sha256": identity_digest(protocol["runtime_identity"]), "source_sha": a["source_sha"], "arm": a["arm"], "run_id": a["run_id"], "output_path": a["output_path"], "evidence_class": a["evidence_class"]}
+    if mode == "preflight":
+        need(argv == expected_argv and not output.exists() and not claim.exists() and not preflight.exists(), "fresh zero-science preflight")
+        return a, binding
+    need(clearance_path is not None and clearance_sha is not None, "separate launch clearance required")
+    clearance = bind(clearance_path, clearance_sha)
+    need(clearance == {"schema": "SI_CONTINUATION_CLEARANCE_V1", "decision": "RELEASE_ONE_ARM", "binding": binding, "preflight_sha256": file_sha256(preflight), "maximum_launches": 1, "retry_authorized": False}, "exact separate clearance")
+    previous = bind(preflight, clearance["preflight_sha256"])
