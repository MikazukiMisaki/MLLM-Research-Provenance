+        assert arms['3']['derived_identity_from'] == 5
+        assert arms['5']['terminal'] is True
+        assert not arms['5']['evidence_refs'].get('suffix_generation_event_ids')
+        assert arms['5']['replay_evidence'] is None
+        assert runtime.environment_step_counts['initial_attempt'] == 1
+        assert runtime.environment_step_counts['path_extension'] == 2
+    operations = [event for event in events if event['kind'] == 'environment_operation_completed'
+                  and event['identity'].get('operation') == 'recovery_environment_operation']
+    assert [event['identity']['recovery_action_index'] for event in operations] == list(range(1, len(operations) + 1))
+    clean = dict(os.environ)
