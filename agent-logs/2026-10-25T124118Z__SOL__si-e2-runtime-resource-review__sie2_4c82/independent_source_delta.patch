+        value=b.generate(phase,b.prepare('engineering public input'),cap,mode)
+        assert value.raw['raw_output']=='A001' and value.raw['adapter_mode']==mode
+        assert adapter_state(b.model)==before
+    assert [c['adapter']['model']['enabled'] for c in calls]==[True,False,False,True]
+    assert all(c['adapter']['model']['active_adapters']==['default'] for c in calls)
+    assert ledger.snapshot()['completed']['generations']==4 and ledger.snapshot()['completed']['generated_tokens']==8
+    assert all(c['options']['do_sample'] is False and c['options']['output_scores'] is True for c in calls)
+
+
+def test_real_tiny_cpu_generate_returns_frozen_raw_contract(tmp_path):
+    p=permit(tmp_path);p.output.mkdir();ledger=EngineeringLedger(p.output/'events.jsonl',p,evidence_class='synthetic_software_fixture')
+    tok,model,torch=tiny_components()
