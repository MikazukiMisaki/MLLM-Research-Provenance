+        need(tree_sha256(path) == a[key]["sha256"], "model artifact hash mismatch")
+    if a["evidence_class"] == "synthetic_cpu":
+        toy = json.loads((Path(a["base"]["path"]) / "config.json").read_text())
+        need(toy.get("model_type") == "gpt2" and all(type(toy.get(k)) is int and 0 < toy[k] <= v for k, v in {"n_embd": 64, "n_layer": 2, "n_head": 4, "vocab_size": 1024, "n_positions": 256}.items()), "software fixture requires explicitly tiny GPT2 config")
+    review = bind(a["review"]["path"], a["review"]["sha256"])
+    need(review == {"schema": "SI_CONTINUATION_REVIEW_V1", "decision": "PASS_SOFTWARE_ONLY", "source_sha": a["source_sha"], "manifest_sha256": a["manifest"]["sha256"], "arm": a["arm"]}, "independent exact review")
+    output = Path(a["output_path"])
