+@pytest.mark.parametrize('remaining,should_reach', [(510,True),(490,False)])
+def test_real_engineering_cli_uses_499_remaining_window_and_supervisor_cap(tmp_path,remaining,should_reach):
+    """Production main with synthetic gate/supervisor edges; no live subprocess."""
+    root=Path(__file__).resolve().parents[1];wrapper=tmp_path/'remediation_cli_fixture.py'
+    wrapper.write_text('''import runpy,sys
+from pathlib import Path
+from datetime import datetime,timedelta,timezone
+from types import SimpleNamespace
+root=Path(sys.argv[1]);remaining=int(sys.argv[2]);sys.path.insert(0,str(root/'src'))
+import self_improvement.si_transfer_eval.engineering_gate as gate
+import self_improvement.si_transfer_eval.supervisor as supervisor
+expires=(datetime.now(timezone.utc)+timedelta(seconds=remaining)).isoformat()
+permit=SimpleNamespace(output=Path('/synthetic/no-output'),allocation_seconds=499,binding={'allocation_seconds':499},clearance={'expires':expires},clearance_sha='c'*64,auth_sha='a'*64,auth={'expires':expires,'source_sha':'a'*40,'environment':{}})
+gate.authenticate_live=lambda *a,**k:permit
+def safe_supervisor(*a,**k):
+ print('SYNTHETIC_SUPERVISOR_SECONDS='+str(k['seconds']))
+ return {'authentic_returncode':0,'execution_status':'EXIT_RECORDED','child_report_present':True}
+supervisor.supervise=safe_supervisor
+script=root/'scripts/run_si_transfer_engineering.py'
+sys.argv=[str(script),'--live','--authorization','/synthetic/absent-auth','--authorization-sha256','a'*64,'--clearance','/synthetic/absent-clearance','--clearance-sha256','c'*64]
+sys.orig_argv=[sys.executable,'-I',*sys.argv]
+runpy.run_path(str(script),run_name='__main__')
+''')
+    result=subprocess.run([sys.executable,'-I',str(wrapper),str(root),str(remaining)],capture_output=True,text=True)
+    assert ('SYNTHETIC_SUPERVISOR_SECONDS=499' in result.stdout)==should_reach and result.returncode==(0 if should_reach else 1)
+    if not should_reach:assert 'insufficient engineering time window' in result.stderr
+    assert sorted(p.name for p in tmp_path.iterdir())==['remediation_cli_fixture.py']
