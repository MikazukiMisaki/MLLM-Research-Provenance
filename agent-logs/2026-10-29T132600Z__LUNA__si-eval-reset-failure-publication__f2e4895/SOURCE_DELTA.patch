+def test_real_cli_reaches_only_synthetic_supervisor_for_allowed_time(tmp_path,kind,style,should_reach):
+    """Execute production main under -I; no real authorization, worker or GPU."""
+    root=Path(__file__).resolve().parents[1]
+    wrapper=tmp_path/'isolated_cli_fixture.py'
+    wrapper.write_text('''import runpy,sys
+from pathlib import Path
+from datetime import datetime,timedelta,timezone
+from types import SimpleNamespace
+root=Path(sys.argv[1]);kind=sys.argv[2];style=sys.argv[3]
+sys.path.insert(0,str(root/'src'))
+import self_improvement.si_transfer_eval.supervisor as supervisor
+now=datetime.now(timezone.utc);future=now+timedelta(seconds=30 if style=='too_short' else 50000)
+value=future.replace(tzinfo=None).isoformat() if style=='naive' else future.isoformat()
+if style=='zulu':value=value.replace('+00:00','Z')
+permit=SimpleNamespace(output=Path('/synthetic/no-output'),binding={'fixture':True},clearance={'expires':value},clearance_sha='c'*64,clearance_sha256='c'*64,auth_sha='a'*64,authorization_sha256='a'*64,auth={'expires':value,'source_sha':'a'*40,'environment':{}},authorization={'expires':value,'source_sha':'a'*40,'environment':{}},manifest={'limits':{'elapsed_seconds':43200},'arm_limits':{'elapsed_seconds':14400}})
+if kind=='engineering':
+ import self_improvement.si_transfer_eval.engineering_gate as gate
+ script=root/'scripts/run_si_transfer_engineering.py'
+else:
+ import self_improvement.si_transfer_eval.live_gate as gate
+ script=root/'scripts/run_si_transfer_eval.py'
+gate.authenticate_live=lambda *a,**k:permit
+def safe_supervisor(*a,**k):
+ print('SYNTHETIC_SUPERVISOR_BOUNDARY_REACHED')
+ return {'authentic_returncode':0,'execution_status':'EXIT_RECORDED','child_report_present':True}
+supervisor.supervise=safe_supervisor
+sys.argv=[str(script),'--live','--authorization','/synthetic/absent-auth','--authorization-sha256','a'*64,'--clearance','/synthetic/absent-clearance','--clearance-sha256','c'*64]
+sys.orig_argv=[sys.executable,'-I',*sys.argv]
+runpy.run_path(str(script),run_name='__main__')
+''')
+    result=subprocess.run([sys.executable,'-I',str(wrapper),str(root),kind,style],capture_output=True,text=True)
+    assert ('SYNTHETIC_SUPERVISOR_BOUNDARY_REACHED' in result.stdout)==should_reach
