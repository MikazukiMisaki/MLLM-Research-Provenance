+            execution_manifest=manifest, events=events,
+            predecessor_run_id='preserved-failed-source-run',
+            expected_snapshot=_expected_restart_snapshot('A001'),
+            expected_snapshot_sha256=hashlib.sha256(json.dumps(
+                _expected_restart_snapshot('A001'), sort_keys=True, separators=(',', ':')).encode()).hexdigest(),
+            comparison_path=comparison_path,
+        )
+
+def test_first_source_restart_mismatch_stops_before_any_action_or_retry(tmp_path, monkeypatch):
+    expected = _expected_restart_snapshot('A001')
+    expected['prompt_and_generation']['raw_output_sha256'] = '0' * 64
+    row, events, physical, runtime, env, _, _ = run_source(
