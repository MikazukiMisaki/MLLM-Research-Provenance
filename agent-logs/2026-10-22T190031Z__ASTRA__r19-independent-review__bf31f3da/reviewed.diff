+def test_real_preflight_supervisor_and_pilot_cli_reject_bad_repair_auth_without_science(
+    tmp_path: Path,
+) -> None:
+    head = subprocess.check_output(
+        ["git", "-C", str(PROJECT_ROOT), "rev-parse", "HEAD"], text=True,
+    ).strip()
+    protocol_sha = hashlib.sha256(PROTOCOL.read_bytes()).hexdigest()
+    old_authorization = json.loads(
+        (PROJECT_ROOT / "configs/experiments/r19_b1_g3_authorization_v1.json")
+        .read_text(encoding="utf-8")
+    )
+    old_authorization_sha = hashlib.sha256(
+        (PROJECT_ROOT / "configs/experiments/r19_b1_g3_authorization_v1.json").read_bytes()
+    ).hexdigest()
+    bad_repair_sha = "0" * 64
+    gate = {
+        "schema_version": "r19_gate_manifest_v1",
+        "implementation_sha": head,
+        "protocol_sha256": protocol_sha,
+        "review": {
+            "status": "BLOCKED", "review_type": "independent_exact_sha",
+            "implementation_sha": head, "g3_launch_implementation_sha": head,
+            "g3_authorization_sha256": old_authorization_sha,
+            "entrypoint_repair_authorization_sha256": bad_repair_sha,
+        },
+        "g2_carry_forward": {
+            "g3_authorization_sha256": old_authorization_sha,
+            "entrypoint_repair_authorization_sha256": bad_repair_sha,
+            "g3_launch_implementation_sha": head,
+            "g2_executed_implementation_sha": old_authorization[
+                "g2_carry_forward"
+            ]["g2_executed_implementation_sha"],
+            "g2_evidence_carried_forward": True,
+            "new_g2_run_performed": False,
+        },
+    }
+    gate_path = tmp_path / "bad-g3-gate.json"
+    gate_path.write_text(json.dumps(gate) + "\n", encoding="utf-8")
+    output = tmp_path / "must-not-be-created"
+    record = tmp_path / "supervisor-record"
+    preflight_receipt = record / "preflight_receipt.json"
+    command = [
+        sys.executable, str(DRIVER), "pilot",
+        "--protocol", str(PROTOCOL), "--manifest", str(gate_path),
+        "--output", str(output), "--preflight-only",
+        "--preflight-receipt", str(preflight_receipt),
+    ]
+    result = subprocess.run(
+        [
+            sys.executable, str(SUPERVISOR), "--record-dir", str(record),
+            "--evidence-class", "preflight_only", "--supersedes-run-id", FAILED_RUN_ID,
+            "--", *command,
+        ],
+        cwd=tmp_path, env=_clean_python_environment(), text=True, capture_output=True,
+    )
+    assert result.returncode == 2
+    runner_log = (record / "runner.log").read_text(encoding="utf-8")
+    assert "G3 gate must bind the separate authorization" in runner_log
+    assert "ModuleNotFoundError" not in runner_log
+    launch_context = json.loads((record / "launch_context.json").read_text(encoding="utf-8"))
+    assert launch_context["evidence_class"] == "preflight_only"
+    assert launch_context["supersedes_run_id"] == FAILED_RUN_ID
+    assert launch_context["command_argv"] == command
+    assert "--preflight-only" in launch_context["command_argv"]
+    assert not output.exists()
+    assert not preflight_receipt.exists()
+    exit_receipt = json.loads((record / "runner_exit.json").read_text(encoding="utf-8"))
+    assert exit_receipt["exit_code"] == 2
+    assert exit_receipt["exit_code_source"] == "subprocess.returncode"
+
