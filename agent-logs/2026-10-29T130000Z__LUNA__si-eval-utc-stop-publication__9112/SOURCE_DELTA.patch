+    rows=[json.loads(l) for l in resource_path.read_text().splitlines()]
+    _need(bool(rows), 'resource journal missing');counts=Counter();last=-float('inf');loads=[];previous=None
+    for i,row in enumerate(rows):
+        _need(row.get('sequence')==i and type(row.get('monotonic')) in (int,float) and math.isfinite(row['monotonic']) and row['monotonic']>=last and row.get('ownership')=='UNPROVEN_NOT_ASSERTED', 'resource journal order/claim');last=row['monotonic']
+        point=row['point'];counts[(point,row.get('arm'))]+=1
+        if point=='cuda_initialization_intent':_need(row.get('status')=='STARTED','CUDA intent');continue
+        _need(row.get('status')=='PASS' and cuda_uuid_matches(row.get('uuid_raw'),row['gpu_uuid_expected']) and row.get('allocator_backend')=='native' and type(row.get('allocator_limit_bytes')) is int and 0<row['allocator_limit_bytes']<=24*GIB, 'resource UUID/allocator')
+        threshold=28*GIB if point in ('preweight','one_byte_before_weights') else 2*GIB
+        _need(type(row.get('global_free_bytes')) is int and row['global_free_bytes']>=threshold and type(row.get('global_total_bytes')) is int and row['global_total_bytes']>=row['global_free_bytes'], 'resource global free')
+        stats=row.get('allocator_stats');names=('allocated_bytes.all.current','allocated_bytes.all.peak','reserved_bytes.all.current','reserved_bytes.all.peak','num_ooms','num_alloc_retries')
+        _need(type(stats) is dict and set(stats)==set(names) and all(type(stats[k]) is int and stats[k]>=0 for k in names), 'resource allocator stats')
+        _need(stats['num_ooms']==0, 'resource OOM counter')
+        if engineering_only:_need(stats['num_alloc_retries']==0,'engineering resource allocator retry counter')
+        fraction=row.get('allocator_fraction');_need(type(fraction) is float and math.isfinite(fraction) and abs(fraction*row['global_total_bytes']-row['allocator_limit_bytes'])<=1,'resource allocator fraction')
+        a,ap,r,rp=(stats[k] for k in names[:4]);_need(a<=r<=row['allocator_limit_bytes'] and a<=ap<=rp<=row['allocator_limit_bytes'] and r<=rp,'resource allocator peak/limit')
+        if previous is not None:_need(all(stats[k]>=previous[k] for k in (names[1],names[3],names[4],names[5])),'resource allocator monotonic counters')
+        previous=stats
+        if point=='model_loaded':
