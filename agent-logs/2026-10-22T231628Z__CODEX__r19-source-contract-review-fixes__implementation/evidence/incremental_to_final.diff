+def test_clean_fresh_comparator_nonempty_success_and_tampering(tmp_path, monkeypatch):
+    runtime, registry, schedule, output, _, _ = runtime_fixture(
+        tmp_path, monkeypatch, restart=True, terminal_after=2)
+    runtime.run_source_episodes(schedule, output, registry, {})
