+    environment.update({key+"_sha256": "b"*64 for key in ("trajectory", "events", "config", "game", "traj_data")})
+    environment['logic_files'] = {key:{'path':str(tmp_path/key),'sha256':'c'*64} for key in ('domain','grammar')}
+    proposal = {"schema":"SI_E2_PROPOSAL_V1", "purpose":PURPOSE, "model":model, "environment":environment,
+        "interpreter":{"path":str(Path(__import__('sys').executable).resolve()),"sha256":"d"*64},
+        "packages":{name:{"path":str(tmp_path/(name+'.py')),"sha256":"e"*64,"version":"software-fixture"} for name in PACKAGE_NAMES},
+        "synthetic_prompts_sha256":digest(engineering_prompts())}
+    auth = {"schema":"SI_E2_AUTHORIZATION_V1", "purpose":PURPOSE, "scope_sha256":SCOPE_SHA256,
+        "authorization_id":"1"*32, "issuer":"Sol Designer", "status":"RELEASED_ENGINEERING_ONLY",
+        "source_sha":CODE, "proposal_sha256":digest(proposal), "output_path":str((tmp_path/'output').resolve()),
+        "gpu_uuid":GPU, "not_before_utc":"2026-01-01T00:00:00Z", "expires_utc":"2027-01-01T00:00:00Z",
+        "ceilings":dict(MAXIMA), "science_authorized":False}
+    return auth,proposal
