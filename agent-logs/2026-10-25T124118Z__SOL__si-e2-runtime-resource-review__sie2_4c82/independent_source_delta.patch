+
+
+def environment_factory(tmp_path,evidence,*,missing_terminal=False,drift=False):
+    from env.alfworld import AlfWorldConfig
+    from self_improvement.si_p3.runtime_environment import ReadIsolatedEnvironment
+    taskdir=tmp_path/'train'/evidence.task_id;taskdir.mkdir(parents=True)
+    game=taskdir/'game.tw-pddl';game.write_text('software game')
+    (taskdir/'traj_data.json').write_text('{}')
+    config=tmp_path/'config.yaml';config.write_text('dataset:\n  data_path: '+str(tmp_path/'train')+'\n')
+    siblings=tmp_path/'train'/'reserved_sibling';siblings.mkdir()
+    sentinel=siblings/'traj_data.json';sentinel.write_text('MUST_NOT_OPEN')
+    constructed=[]
+    class Factory:
+        def __init__(self,configuration,train_eval):
+            assert train_eval=='train' and Path(configuration['dataset']['data_path'])==taskdir
+            # Simulate the real constructor's eager discovery; wrong restriction reaches sentinel.
+            for p in Path(configuration['dataset']['data_path']).rglob('traj_data.json'):
+                assert p!=sentinel
+                p.read_bytes()
+            self.game_files=[str(game)];self.num_games=1
+            self.tw=FakeTextWorld(evidence,game,missing_terminal=missing_terminal,drift=drift)
+            constructed.append(self.tw)
+        def init_env(self,batch_size):assert batch_size==1;return self.tw
+    def factory():
+        return ReadIsolatedEnvironment(AlfWorldConfig(config,split='train',data_path=tmp_path),
+            game=game,pool_seed=evidence.seed,factory_boundary=Factory)
+    return factory,constructed,sentinel
