+    elif attack=='merged':state['layers'][0]['merged_adapters']=['default']
+    elif attack=='count':state['model']['num_adapter_layers']+=1
+    else:state['model']['trainable_params']=1
+    with pytest.raises(ContractError):verify_adapter_state(state,enabled=True)
+
+
+@pytest.mark.parametrize('limit',['per_call_input','input_tokens'])
+def test_exact_input_limits_reject_before_generation_reservation(parts,limit):
