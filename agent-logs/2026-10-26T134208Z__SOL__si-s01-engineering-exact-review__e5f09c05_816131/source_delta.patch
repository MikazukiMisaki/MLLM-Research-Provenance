+        self.journal.append('runtime_evidence',{'unit':self.active,'kind':kind,'data':dict(data)})
+    def finish(self,unit:str,data:Mapping[str,Any]):
+        insist(self.active==unit and not self.units[unit]['finished'] and not self.units[unit]['failed'],'engineering active completion')
+        value=dict(data);kind=self.units[unit]['identity']['kind'];debit=self.units[unit]['reservation']
+        self.runtime('operation_returned',value)
+        actual=value['raw']['generated_tokens'] if kind=='generation' else 0
+        insist(type(actual) is int and 0<=actual<=debit['generated_tokens'],'engineering actual output debit')
+        self.journal.append('unit_completed',{'unit':unit,'identity':self.units[unit]['identity'],'started_event':self.units[unit]['started_event'],'data':value})
+        self.units[unit]['finished']=True;self.used['generated_tokens']-=debit['generated_tokens']-actual;self.completed.update(debit|{'generated_tokens':actual});self._stack.pop()
