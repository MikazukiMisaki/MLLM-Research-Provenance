+from typing import Any,Callable,Mapping
+import math,os,time
+from .contract import insist,digest,BudgetStop
+from .evidence import Journal
+from .engineering_contract import *
+
+COST_KEYS=tuple(k for k in MAXIMA if k!='seconds')
+
+def reservation(kind:str,prepared:Mapping[str,Any]|None)->dict:
+    insist(kind in ('model_load','context_probe','generation','env_construct','reset','step','env_close'),'engineering operation only')
+    debit=dict.fromkeys(COST_KEYS,0);debit[kind]=1;debit['environment_operations']=int(kind in ('reset','step'))
+    if kind=='generation':
+        insist(prepared is not None and set(prepared)=={'prompt','rendered_prompt','input_ids','attention_mask'},'complete engineering prepared tensors')
+        ids=prepared['input_ids'];insist(type(ids) is list and bool(ids) and all(type(i) is int and i>=0 for i in ids) and prepared['attention_mask']==[1]*len(ids),'engineering input IDs/mask')
+        debit['input_tokens']=len(ids);debit['generated_tokens']=16
+    else:insist(prepared is None,'non-generation prepared data forbidden')
+    return debit
+
+class EngineeringLedger:
+    def __init__(self,path:Path,permit:EngineeringPermit,*,started_at:float|None=None,clock:Callable[[],float]=time.monotonic):
+        insist(isinstance(permit,EngineeringPermit),'typed engineering ledger authority')
+        self.permit=permit;self.clock=clock;self.started_at=clock() if started_at is None else started_at;self.last=self.started_at
+        self.caps=permit.ceilings;self.run_id=permit.authorization['run_id'];self.used=Counter(dict.fromkeys(COST_KEYS,0));self.completed=Counter(self.used)
+        self.units={};self._stack=[];self.stopped=False;self.closed=False
+        self.journal=Journal(path,{'schema':'SI_S01_ENGINEERING_EVENT_V1','purpose':PURPOSE,'science_authorized':False,
+            'evidence_class':permit.evidence_class,'run_id':self.run_id,'source_sha':permit.authorization['source_sha'],
+            'authorization_sha256':permit.authorization_sha256,'proposal_sha256':permit.proposal_sha256,
+            'history_manifest_sha256':permit.history.manifest_sha256,'task_id':permit.history.task_id,'ceilings':self.caps,
+            'allocation_started_monotonic':self.started_at,'allocated_devices':int(permit.evidence_class==MODE),'worker_pid':os.getpid(),'worker_uid':os.getuid(),'RNG_status':RNG_STATUS},clock=clock)
+    @property
+    def active(self):return self._stack[-1] if self._stack else None
+    def check_time(self):
+        now=self.clock();insist(math.isfinite(now) and now>=self.last,'engineering monotonic clock');self.last=now
+        if now-self.started_at>self.caps['seconds']:
+            self.stopped=True;raise BudgetStop('engineering absolute600-second allocation budget')
+    def begin(self,kind:str,index:int=0,*,prepared=None,request=None)->str:
+        insist(not self.closed and (not self.stopped or kind=='env_close'),'engineering run stopped/closed')
+        self.check_time();insist(type(index) is int and index==(self.used['step'] if kind=='step' else 0),'engineering one-pass operation index')
+        parent=self.active
+        insist((parent is None and kind!='context_probe') or (kind=='context_probe' and self.units[parent]['identity']['kind']=='model_load'),'only context probe may nest under model load')
+        if kind=='model_load':insist(not self.units,'one initial model/tokenizer load')
+        elif kind=='context_probe':insist(self.used['model_load']==1,'probe belongs to one load')
+        elif kind=='generation':insist(self.completed['model_load']==self.completed['context_probe']==self.completed['reset']==1 and self.used['step']==0,'one coupled first-prompt generation after reset')
+        elif kind=='env_construct':insist(self.completed['model_load']==self.completed['context_probe']==1,'environment after guarded load')
+        elif kind=='reset':insist(self.completed['env_construct']==1,'reset after one environment construction')
+        elif kind=='step':insist(self.completed['reset']==self.completed['generation']==1 and index<6,'six saved steps after coupled generation')
+        elif kind=='env_close':insist(self.used['env_construct']==1,'close only an attempted environment')
