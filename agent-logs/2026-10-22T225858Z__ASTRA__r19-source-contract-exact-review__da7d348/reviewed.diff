+def validate_source_restart_comparison(
+    *, execution_manifest: Mapping[str, Any], events: list[dict[str, Any]],
+    predecessor_run_id: str, expected_snapshot: Mapping[str, Any],
+    expected_snapshot_sha256: str, comparison_path: Path,
+) -> dict[str, Any]:
+    """Authenticate the one allowed repeated first source decision before its first action."""
+    if comparison_path.is_symlink() or not comparison_path.is_file():
+        raise EvidenceIntegrityError("authorized source restart lacks its immutable comparison receipt")
+    try:
+        comparison = json.loads(comparison_path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as error:
+        raise EvidenceIntegrityError("source restart comparison receipt is unreadable") from error
+    comparison_sha256 = sha256_file(comparison_path)
+    if (
+        execution_manifest.get("source_restart_comparison_sha256") != comparison_sha256
+        or execution_manifest.get("source_restart_comparison_status") != "PASS"
+        or execution_manifest.get("source_restart_predecessor_run_id") != predecessor_run_id
+        or execution_manifest.get("source_restart_repeated_generation_count") != 1
+        or execution_manifest.get("source_restart_repeated_reset_count") != 1
+        or comparison.get("schema_version") != "r19_source_restart_comparison_v1"
+        or comparison.get("status") != "PASS"
+        or comparison.get("predecessor_run_id") != predecessor_run_id
+        or comparison.get("comparison_before_first_environment_action") is not True
+        or comparison.get("environment_actions_executed_before_comparison") != 0
+        or comparison.get("expected_snapshot") != dict(expected_snapshot)
+        or comparison.get("observed_snapshot") != dict(expected_snapshot)
+        or comparison.get("expected_snapshot_sha256") != expected_snapshot_sha256
+        or comparison.get("observed_snapshot_sha256") != expected_snapshot_sha256
+        or comparison.get("mismatched_fields") != []
+    ):
+        raise EvidenceIntegrityError("source restart comparison did not pass the exact pre-action predecessor match")
+
+    source_events = [
+        event for event in events
+        if event.get("kind") == "source_episode_completed"
+        and event.get("identity", {}).get("schedule_index") == 0
+    ]
+    if len(source_events) != 1:
+        raise EvidenceIntegrityError("G3 restart must complete exactly one schedule-index-zero source episode")
+    source_event = source_events[0]
+    source_identity = source_event.get("identity", {})
+    source_payload = source_event.get("payload", {})
+    if (
+        source_identity.get("canonical_trial_id") != expected_snapshot.get("canonical_trial_id")
+        or source_identity.get("split") != "train"
+        or source_payload.get("source_restart_comparison_sha256") != comparison_sha256
+    ):
+        raise EvidenceIntegrityError("completed first source episode is not bound to the restart comparison receipt")
+
+    generation_events = [
+        event for event in events
+        if event.get("kind") == "generation_completed"
+        and event.get("identity", {}).get("schedule_index") == 0
+        and event.get("identity", {}).get("decision_index") == 0
+    ]
+    if len(generation_events) != 1:
+        raise EvidenceIntegrityError("G3 restart lacks one unique first source generation")
+    generation_event = generation_events[0]
+    identity = generation_event.get("identity", {})
+    evidence = generation_event.get("payload", {}).get("evidence", {})
+    generation = evidence.get("generation", {})
+    parser_result = evidence.get("parser_result", {})
+    if (
+        identity.get("canonical_trial_id") != expected_snapshot.get("canonical_trial_id")
+        or identity.get("split") != "train"
+        or identity.get("operation") != "source_generation"
+        or identity.get("component") != "task_actor"
+    ):
+        raise EvidenceIntegrityError("first source generation has the wrong production operation identity")
+    try:
+        from scripts import run_r19_experiment as runner
+        expected_runner = (PROJECT_ROOT / "scripts/run_r19_experiment.py").resolve()
+        if Path(str(getattr(runner, "__file__", ""))).resolve() != expected_runner:
+            raise EvidenceIntegrityError("source restart comparator resolved outside the analyzed checkout")
+        observed_snapshot = runner._source_restart_snapshot(
+            canonical_trial_id=str(identity["canonical_trial_id"]), schedule_index=0,
+            seed=int(expected_snapshot["seed"]),
