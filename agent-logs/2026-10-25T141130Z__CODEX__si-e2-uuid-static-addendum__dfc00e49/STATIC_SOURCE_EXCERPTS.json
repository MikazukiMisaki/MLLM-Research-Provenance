          "781: def _raw_device_uuid_nvml() -> Optional[List[str]]:",
          "782:     r\"\"\"Return list of device UUID as reported by NVML or None if NVM discovery/initialization failed.\"\"\"",
          "783:     from ctypes import byref, c_int, c_void_p, CDLL, create_string_buffer",
          "784: ",
          "785:     nvml_h = CDLL(\"libnvidia-ml.so.1\")",
          "786:     rc = nvml_h.nvmlInit()",
          "787:     if rc != 0:",
          "788:         warnings.warn(\"Can't initialize NVML\")",
          "789:         return None",
          "790:     dev_count = c_int(-1)",
          "791:     rc = nvml_h.nvmlDeviceGetCount_v2(byref(dev_count))",
          "792:     if rc != 0:",
          "793:         warnings.warn(\"Can't get nvml device count\")",
          "794:         return None",
          "795:     uuids: List[str] = []",
          "796:     for idx in range(dev_count.value):",
          "797:         dev_id = c_void_p()",
          "798:         rc = nvml_h.nvmlDeviceGetHandleByIndex_v2(idx, byref(dev_id))",
          "799:         if rc != 0:",
          "800:             warnings.warn(\"Can't get device handle\")",
          "801:             return None",
          "802:         buf_len = 96",
          "803:         buf = create_string_buffer(buf_len)",
          "804:         rc = nvml_h.nvmlDeviceGetUUID(dev_id, buf, buf_len)",
          "805:         if rc != 0:",
          "806:             warnings.warn(\"Can't get device UUID\")",
          "807:             return None",
          "808:         uuids.append(buf.raw.decode(\"ascii\").strip(\"\\0\"))",
          "809:     del nvml_h",
          "810:     return uuids",
          "811: ",
          "812: ",
          "813: def _transform_uuid_to_ordinals(candidates: List[str], uuids: List[str]) -> List[int]:",
          "814:     r\"\"\"Given the set of partial uuids and list of known uuids builds a set of ordinals excluding ambiguous partials IDs.\"\"\"",
          "815: ",
          "816:     def uuid_to_ordinal(candidate: str, uuids: List[str]) -> int:",
          "817:         best_match = -1",
          "818:         for idx, uuid in enumerate(uuids):",
          "819:             if not uuid.startswith(candidate):",
          "820:                 continue",
          "821:             # Ambiguous candidate",
          "822:             if best_match != -1:",
          "823:                 return -1",
          "824:             best_match = idx",
          "825:         return best_match",
          "826: ",
          "827:     rc: List[int] = []",
          "828:     for candidate in candidates:",
          "829:         if torch.version.hip:",
          "830:             candidate = candidate.replace(",
          "831:                 \"GPU-\", \"\", 1",
          "832:             )  # Remove GPU-prefix to match amdsmi asic serial",
          "833:         idx = uuid_to_ordinal(candidate, uuids)",
          "834:         # First invalid ordinal stops parsing",
          "835:         if idx < 0:",
          "836:             break",
          "837:         # Duplicates result in empty set",
          "838:         if idx in rc:",
          "839:             return cast(List[int], [])",
          "840:         rc.append(idx)"
        ]
      }
