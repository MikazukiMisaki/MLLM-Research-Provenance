+    _need(exit.get('schema')=='SI_U1_EVAL_ENGINEERING_SUPERVISOR_EXIT_V1' and exit.get('evidence_class')=='live_engineering_only' and exit.get('science_authorized') is False and exit.get('authentic_returncode')==0 and exit.get('execution_status')=='EXIT_RECORDED' and exit.get('deadline_triggered') is False and exit.get('cleanup_established') is True and exit.get('cleanup_within_budget') is True and exit.get('within_time_cap') is True and exit.get('retry_authorized') is False and exit.get('child_report_present') is True,'engineering supervisor completion')
+    _need(exit.get('launch_context_sha256')==_sha(lp) and exit.get('worker_start_sha256')==_sha(wp) and exit.get('source_sha')==launch.get('source_sha') and exit.get('authorization_sha256')==launch.get('authorization_sha256'),'engineering supervisor receipt hashes')
+    binding=launch.get('binding');_need(type(binding) is dict and binding.get('schema')=='SI_U1_EVAL_ENGINEERING_BINDING_V1' and binding.get('output_path')==str(output) and binding.get('source_sha')==launch.get('source_sha') and binding.get('authorization_sha256')==launch.get('authorization_sha256'),'engineering external binding')
+    _need(launch.get('evidence_class')=='live_engineering_only' and launch.get('allocated_devices')==1 and launch.get('science_authorized') is False and worker.get('authorization_sha256')==launch.get('authorization_sha256') and worker.get('launch_context_sha256')==_sha(lp) and type(worker.get('pid')) is int and type(worker.get('start_tick')) is int and worker.get('pgid')==worker.get('pid') and worker.get('sid')==worker.get('pid'),'engineering worker identity')
+    command=[_sha(lp) if x=='@LAUNCH_CONTEXT_SHA256@' else x for x in launch.get('argv',[])];_need(worker.get('argv')==command,'engineering worker argv')
