+    trainable_params: int=0
+
+@dataclass
+class Layer:
+    enabled: bool=True
+    active_adapters: tuple=('default',)
+    merged_adapters: tuple=()
+    available_adapters: tuple=('default',)
+
+# PEFT returns lists in production; the real adapter verifier requires lists.
+@dataclass
+class Status:
+    enabled: bool
+    active_adapters: list
+    merged_adapters: list
+    available_adapters: list
+    num_adapter_layers: int=1
+    trainable_params: int=0
+
+class Vector:
+    def __init__(self,values):self.values=values
+    def tolist(self):return self.values
+class Tensor:
+    ndim=2;shape=(1,2)
+    def __init__(self,values):self.values=values
+    def to(self,device):return self
+    def __getitem__(self,n):return Vector(self.values)
+class Tokens:
+    eos_token_id=10
+    def apply_chat_template(self,*a,**kw):return 'rendered'
+    def __call__(self,**kw):
+        if kw.get('return_tensors')=='pt':return {'input_ids':Tensor([1,2]),'attention_mask':Tensor([1,1])}
+        return {'input_ids':[1,2],'attention_mask':[1,1]}
+    def decode(self,ids,**kw):return 'A000'
+class Model:
+    device='synthetic-cuda-label-only'
+    def eval(self):return self
+    def parameters(self):return [SimpleNamespace(requires_grad=False)]
+    def get_model_status(self):return Status(True,['default'],[],['default'])
+    def get_layer_status(self):return [Status(True,['default'],[],['default'])]
+    def generate(self,**kwargs):return SimpleNamespace(sequences=[Vector([1,2,9,10])],scores=[1,2])
+class Torch:
+    cuda=SimpleNamespace(synchronize=lambda:None)
+    def no_grad(self):return nullcontext()
+class Resource:
+    def __init__(self,fail=False):self.calls=[];self.fail=fail
+    def before_generation(self,torch,*,arm):self.calls.append(('before',arm))
+    def after_generation(self,torch,*,arm,adapter_state):
+        self.calls.append(('after',arm))
+        if self.fail:raise ValueError('synthetic post-return rejection')
+
