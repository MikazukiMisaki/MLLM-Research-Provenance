+"""Authorization/resource/entrypoint checks stop before any real edge."""
+import copy
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+from datetime import datetime,timezone
+
+import pytest
+from self_improvement.si_p3.contract import ContractError,digest
+from self_improvement.si_p3.runtime_gate import (validate_documents,validate_gpu_rows,read_bound,verify_logic)
+from si_e2_support import CODE,GPU,documents
+
+
+def check(auth,proposal,**overrides):
+    kwargs=dict(proposal_sha256=digest(proposal),source_sha=CODE,clean=True,visible_devices=GPU,
+                now=datetime(2026,10,25,tzinfo=timezone.utc));kwargs.update(overrides)
+    validate_documents(auth,proposal,**kwargs)
+
+
+def test_fixed_engineering_authorization_shape(tmp_path):
+    a,p=documents(tmp_path);check(a,p)
+
+
+@pytest.mark.parametrize('attack',['absent','malformed','science','training','acquisition','eval','sha','dirty','gpu','foreign_visible',
+                                   'expired','future','proposal','count','output','input','time','device_hours','bool','scope','prompts','extra'])
+def test_authority_negative_before_edges(tmp_path,attack):
+    a,p=documents(tmp_path);overrides={}
+    if attack=='absent':a={}
+    elif attack=='malformed':a['schema']='other'
+    elif attack=='science':a['science_authorized']=True
+    elif attack in ('training','acquisition','eval'):a['purpose']=attack
+    elif attack=='sha':a['source_sha']='f'*40
+    elif attack=='dirty':overrides['clean']=False
+    elif attack=='gpu':a['gpu_uuid']='0'
+    elif attack=='foreign_visible':overrides['visible_devices']=GPU+',other'
+    elif attack=='expired':a['expires_utc']='2020-01-01T00:00:00Z'
+    elif attack=='future':a['not_before_utc']='2027-01-01T00:00:00Z'
+    elif attack=='proposal':a['proposal_sha256']='0'*64
+    elif attack in ('count','output','input','time','device_hours','bool'):
+        key={'count':'generations','output':'generated_tokens','input':'input_tokens','time':'seconds','device_hours':'device_hours','bool':'generations'}[attack]
+        a['ceilings'][key]=True if attack=='bool' else a['ceilings'][key]+1
+    elif attack=='scope':a['scope_sha256']='0'*64
+    elif attack=='prompts':p['synthetic_prompts_sha256']='0'*64;a['proposal_sha256']=digest(p)
+    elif attack=='extra':p['train']=True;a['proposal_sha256']=digest(p)
+    with pytest.raises((ContractError,KeyError,TypeError,ValueError)):check(a,p,**overrides)
