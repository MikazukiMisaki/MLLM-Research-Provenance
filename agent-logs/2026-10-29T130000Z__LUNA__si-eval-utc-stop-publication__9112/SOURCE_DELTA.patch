+        elif point=='after_generation':verify_adapter_state(row['metadata']['adapter_state'],enabled=True)
+    arms=('A',) if engineering_only else ('A','B','C');n=len(arms)
+    _need(loads==list(arms) and counts[('cuda_initialization_intent',None)]==n and counts[('preweight',None)]==n and counts[('one_byte_before_weights',None)]==n, 'exact guarded loads')
+    return {'resource_rows':len(rows),'before_generation':{a:counts[('before_generation',a)] for a in arms},'after_generation':{a:counts[('after_generation',a)] for a in arms},'resource_sha256':_sha(resource_path)}
+
+
+def authenticate_engineering_run(output: Path) -> dict:
+    output=Path(output);lp=output/'launch_context.json';wp=output/'worker_start.json';ep=output/'supervisor_exit.json'
+    launch=json.loads(lp.read_bytes());worker=json.loads(wp.read_bytes());exit=json.loads(ep.read_bytes())
