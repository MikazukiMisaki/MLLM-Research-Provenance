+    physical = analyzer.validate_event_ledger(events, expected_evidence_class='synthetic')
+    if expect_restart_mismatch:
+        comparison = json.loads((output/'source_restart_comparison.json').read_text())
+        assert comparison['status'] == 'MISMATCH_STOP'
+        assert comparison['comparison_before_first_environment_action'] is True
+        assert comparison['environment_actions_executed_before_comparison'] == 0
+        assert not env.actions
+        assert not (output/'source_trajectories.jsonl').exists()
+        assert all(u['status'] == 'in_progress' for u in registry.document['units'].values())
+        return None, events, physical, runtime, env, schedule, None
+    exclusions = {'schema_version': 'r19_exclusion_manifest_v1',
+                  'status': 'frozen_before_inference', 'excluded_task_trial_ids': []}
+    validated = analyzer.validate_live_source_schedule(schedule, exclusions, events, [], physical)
+    assert validated['status'] == 'PASS_FROZEN_TRAIN_SCHEDULE_BINDING'
+    assert validated['completed_source_episodes'] == 1
+    assert env.closed
+    assert all(u['status'] == 'completed' for u in registry.document['units'].values())
+    return rows[0], events, physical, runtime, env, schedule, exclusions
+
+@pytest.mark.parametrize('raw,status,actions', [
