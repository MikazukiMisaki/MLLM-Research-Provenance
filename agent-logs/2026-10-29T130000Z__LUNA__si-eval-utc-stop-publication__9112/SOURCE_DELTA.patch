+
+ENGINEERING_LIMITS={'generations':1,'environment_operations':2,'input_tokens':8192,'output_tokens':16,'per_call_input':8192,'elapsed_seconds':600}
+
+class EngineeringRunner:
+    def __init__(self, *, task, adapter_sha256, output:Path, producer_factory, environment_factory,
+                 evidence_class='synthetic', allocation_started_at=None, live_permit=None):
