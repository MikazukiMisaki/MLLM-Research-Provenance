+
+@pytest.mark.parametrize('phase,cap,mode',[('source',40,'P0'),('source',16,'BASE'),('stage_one',16,'BASE'),('unknown',16,'P0')])
+def test_phase_cap_mode_contract_before_edges(parts,phase,cap,mode):
