+#!/usr/bin/env python3
+"""One separately supervised synthetic-token engineering probe only."""
+from __future__ import annotations
+import argparse
+import json
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+from self_improvement.continuation.engineering_gate import preflight, verify
+from self_improvement.si_p3.runtime_gate import utc
+from self_improvement.si_s01.evidence import atomic_fresh_json
+
+
+def main(argv=None):
+    entered = time.monotonic()
+    parser = argparse.ArgumentParser(description=__doc__)
+    modes = parser.add_mutually_exclusive_group(required=True)
+    modes.add_argument("--preflight-only", action="store_true")
+    modes.add_argument("--live", action="store_true")
+    modes.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
+    parser.add_argument("--authorization", type=Path, required=True)
+    parser.add_argument("--authorization-sha256", required=True)
+    parser.add_argument("--clearance", type=Path)
+    parser.add_argument("--clearance-sha256")
+    parser.add_argument("--launch-context-sha256", help=argparse.SUPPRESS)
+    args = parser.parse_args(argv)
+    mode = "preflight" if args.preflight_only else "worker" if args.worker else "live"
+    try:
+        a, binding, plan, protocol = verify(ROOT, args.authorization, args.authorization_sha256, mode=mode,
+            argv=list(sys.orig_argv), clearance_path=args.clearance, clearance_sha=args.clearance_sha256,
+            launch_context_sha=args.launch_context_sha256)
+        if mode == "preflight":
+            print(json.dumps(preflight(a, binding)))
+            return 0
+        if mode == "worker":
+            from self_improvement.continuation.runtime_identity import verify_actual_imports
+            from self_improvement.continuation.engineering_worker import run_engineering
+            output = Path(a["output_path"])
+            verify_actual_imports(protocol["runtime_identity"], output / "runtime_import_receipt.json")
+            resource, device = None, "cpu"
+            if a["evidence_class"] == "engineering_live":
+                from self_improvement.continuation.resource import SharedResource
+                resource = SharedResource(a["gpu"], output / "resource.jsonl", strict_no_allocator_retry=True)
+                device = "cuda:0"
+            result = run_engineering(a, plan, protocol, output, device=device, resource=resource)
+            return 0 if result["status"] == "ENGINEERING_COMPLETED" else 1
+        from self_improvement.continuation.supervisor import supervise
+        from self_improvement.continuation.engineering_worker import assess_engineering
+        remaining = (utc(a["expires"]) - datetime.now(timezone.utc)).total_seconds()
+        command = ["--worker" if x == "--live" else x for x in sys.orig_argv]
+        output = Path(a["output_path"])
+        receipt = supervise(command, output, binding=binding, environment=a["environment"],
+            seconds=min(a["allocation_seconds"], remaining), entered=entered, gpu_allocated=int(a["evidence_class"] == "engineering_live"),
+            receipt_schema="SI_CONTINUATION_ENGINEERING_SUPERVISOR_EXIT_V1", result_relative="engineering_result.json", result_key="engineering_result_sha256")
+        result_path = output / "engineering_result.json"
+        result = json.loads(result_path.read_text()) if result_path.is_file() else {}
+        resource_path = output / "resource.jsonl"
+        observations = [json.loads(line) for line in resource_path.read_text().splitlines()] if resource_path.is_file() else []
+        if resource_path.is_file():
+            from self_improvement.continuation.training import file_sha256
+            if receipt["resource_receipt_sha256"] != file_sha256(resource_path):
+                raise RuntimeError("engineering resource observations changed after supervisor exit")
+        assessment = assess_engineering(result, receipt, plan=plan, evidence_class=a["evidence_class"], science_seconds=protocol["runtime"]["B"]["allocation_seconds"], resource_observations=observations)
+        atomic_fresh_json(output / "engineering_assessment.json", assessment)
+        return 0 if assessment["status"] in ("FIT_MODEL_PASS", "SYNTHETIC_SOFTWARE_ONLY") else 1
+    except Exception as error:
+        print(json.dumps({"status": "REJECTED_OR_INCONCLUSIVE", "exception": type(error).__name__, "message": str(error)}), file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
