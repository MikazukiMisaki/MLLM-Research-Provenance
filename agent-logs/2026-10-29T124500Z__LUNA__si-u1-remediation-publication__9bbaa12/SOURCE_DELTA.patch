+                    raise ContractError("synthetic token reservation exceeds engineering budget")
+                counts["microbatches_started"] += 1
+                counts["input_tokens"] += length
+                counts["supervised_tokens"] += active
+                event("microbatch_started", optimizer_step=step, microbatch=micro, input_tokens=length, supervised_tokens=active)
+                begun = time.monotonic()
+                batch = {"input_ids": torch.tensor([ids], dtype=torch.long, device=device), "attention_mask": torch.ones((1, length), dtype=torch.long, device=device), "labels": torch.tensor([labels], dtype=torch.long, device=device)}
+                loss = model(**batch).loss
+                if not bool(torch.isfinite(loss).item()):
+                    raise ContractError("non-finite synthetic engineering loss")
+                (loss / t["gradient_accumulation_steps"]).backward()
+                sync()
+                counts["microbatches_completed"] += 1
+                event("microbatch_completed", optimizer_step=step, microbatch=micro, duration_seconds=time.monotonic() - begun, loss=float(loss.detach().cpu()))
+            for param in model.parameters():
+                if param.requires_grad and (param.grad is None or not bool(torch.isfinite(param.grad).all().item())):
+                    raise ContractError("missing or non-finite synthetic engineering gradient")
+            torch.nn.utils.clip_grad_norm_((p for p in model.parameters() if p.requires_grad), config["max_grad_norm"], error_if_nonfinite=True)
+            counts["optimizer_steps_started"] += 1
+            event("optimizer_step_started", optimizer_step=step, learning_rate=lr)
+            optimizer.step()
+            sync()
+            counts["optimizer_steps_completed"] += 1
+            duration = time.monotonic() - step_started
+            step_times.append(duration)
+            event("optimizer_step_completed", optimizer_step=step, duration_seconds=duration, finite_gradients=True)
+            if resource:
+                resource("after_optimizer_step")
+        result["optimizer_step_seconds"] = step_times
+        check_time()
+        if resource:
+            resource("before_trial_save")
+        if scratch.exists() or scratch.is_symlink() or scratch.parent != output:
+            raise ContractError("engineering scratch must be new and owned by this run")
+        begun = time.monotonic()
+        counts["trial_saves_started"] += 1
+        event("trial_save_started", scientific_checkpoint_eligible=False)
+        scratch.mkdir(exist_ok=False)
+        scratch_created = True
+        model.save_pretrained(str(scratch))
+        result["trial_adapter_sha256"] = tree_sha256(scratch)
+        result["trial_adapter_bytes"] = sum(p.stat().st_size for p in scratch.rglob("*") if p.is_file())
+        counts["trial_saves_completed"] += 1
+        event("trial_saved", sha256=result["trial_adapter_sha256"], bytes=result["trial_adapter_bytes"], scientific_checkpoint_eligible=False)
+        if resource:
+            resource("after_trial_save")
+        if scratch.is_symlink() or scratch.resolve().parent != output.resolve():
+            raise ContractError("engineering scratch path changed")
+        shutil.rmtree(scratch)
+        scratch_created = False
+        result["trial_adapter_deleted"] = not scratch.exists() and not scratch.is_symlink()
+        if not result["trial_adapter_deleted"]:
+            raise ContractError("engineering trial adapter deletion not confirmed")
+        result["save_hash_delete_seconds"] = time.monotonic() - begun
+        event("trial_deleted", confirmed=True, duration_seconds=result["save_hash_delete_seconds"])
+        if resource:
+            resource("after_trial_delete")
+        begun = time.monotonic()
+        # The optimizer loop's final group retains the parameter list even after
+        # deleting the optimizer; drop it before measuring CUDA cleanup.
+        del optimizer, model, base, batch, loss, param, group
+        optimizer = model = base = None
+        gc.collect()
+        if cleanup_observer is not None:
+            cleanup_observer()
+        if device == "cuda:0":
+            _cleanup_cuda_allocator(torch, result, event)
+        result["cleanup_seconds"] = time.monotonic() - begun
+        event("worker_cleanup_completed", duration_seconds=result["cleanup_seconds"])
+        if tree_sha256(Path(a["base"]["path"])) != a["base"]["sha256"] or tree_sha256(Path(a["adapter"]["path"])) != a["adapter"]["sha256"]:
+            raise ContractError("frozen model or P0 bytes changed during engineering")
+        event("frozen_inputs_reverified")
+        check_time()
+        result["status"] = "ENGINEERING_COMPLETED"
+    except BaseException as exc:
+        result["error"] = f"{type(exc).__name__}: {exc}"
+        event("engineering_failed", error=result["error"], scratch_present=scratch.exists())
+        if scratch_created and scratch.exists() and not scratch.is_symlink() and scratch.resolve().parent == output.resolve():
+            shutil.rmtree(scratch)
+            event("failed_trial_deleted", confirmed=not scratch.exists())
+        atomic_fresh_json(output / "engineering_result.json", result)
+        raise
+    result["elapsed_worker_seconds"] = time.monotonic() - start
+    atomic_fresh_json(output / "engineering_result.json", result)
+    return result
+
+
+def assess_engineering(result: dict, receipt: dict, *, plan: dict, evidence_class: str, science_seconds: float, resource_observations: list[dict] | None = None) -> dict:
