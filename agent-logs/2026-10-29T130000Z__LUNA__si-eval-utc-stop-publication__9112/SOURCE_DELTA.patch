+"""Real CPU child processes exercise the prospective supervisor boundary."""
+import json, os, sys, time
+import pytest
+from self_improvement.si_transfer_eval.evaluator import EvaluationError
+from self_improvement.si_transfer_eval.supervisor import supervise
+
+
+def context():
+    return {'evidence_class':'synthetic','source_sha':'a'*40,'authorization_sha256':'b'*64,'max_allocation_seconds':10,'allocation_started_monotonic':time.monotonic()}
+
+
+def test_supervisor_records_real_subprocess_exit_and_no_retry(tmp_path):
+    script=tmp_path/'child.py';script.write_text("import pathlib, sys\np=pathlib.Path(sys.argv[1])/'evaluation';p.mkdir();(p/'report.json').write_text('{}')\n")
+    output=tmp_path/'output';r=supervise([sys.executable,'-I',str(script),str(output)],output,context=context(),seconds=5,environment=dict(os.environ))
+    assert r['authentic_returncode']==0 and r['execution_status']=='EXIT_RECORDED'
+    assert r['cleanup_established'] and r['child_report_present'] and not r['science_authorized'] and not r['retry_authorized']
+    assert (output/'supervisor_exit.json').is_file()
+    with pytest.raises(EvaluationError):supervise([sys.executable,'-I',str(script),str(output)],output,context=context(),seconds=5,environment=dict(os.environ))
+
+
+def test_supervisor_timeout_kills_child_and_keeps_failure_receipt(tmp_path):
+    script=tmp_path/'stuck.py';script.write_text('import time\ntime.sleep(10)\n');output=tmp_path/'output'
+    r=supervise([sys.executable,'-I',str(script)],output,context=context(),seconds=0.5,environment=dict(os.environ))
+    assert r['deadline_triggered'] and r['execution_status']=='INCONCLUSIVE' and not r['child_report_present']
+    assert (output/'supervisor_exit.json').is_file()
+
+
+def test_unwired_live_supervisor_cannot_self_authorize(tmp_path):
+    ctx=context();ctx['evidence_class']='live';output=tmp_path/'output'
+    with pytest.raises(EvaluationError,match='authenticated live supervisor'):
+        supervise([sys.executable,'-c','pass'],output,context=ctx,seconds=5,environment=dict(os.environ))
+    assert not output.exists()
+
+
+def test_arm_specific_deadline_stops_before_global_deadline(tmp_path):
+    script=tmp_path/'stuck_arm.py'
+    script.write_text("import pathlib, sys, time\np=pathlib.Path(sys.argv[1])/'evaluation';p.mkdir();time.sleep(10)\n")
+    output=tmp_path/'output';ctx=context();ctx['per_arm_allocation_seconds']=0.5
+    r=supervise([sys.executable,'-I',str(script),str(output)],output,context=ctx,seconds=5,environment=dict(os.environ))
+    assert r['deadline_triggered'] and r['arm_deadline_triggered']=='A' and r['execution_status']=='INCONCLUSIVE'
+    assert r['elapsed_seconds']<5
+
+
+def test_real_cpu_worker_runs_complete_production_collector_and_auditor(tmp_path):
+    from pathlib import Path
+    from self_improvement.si_transfer_eval.audit import audit
+    root=Path(__file__).resolve().parents[1]
+    script=tmp_path/'worker.py'
+    script.write_text('''import sys
+from pathlib import Path
+sys.path.insert(0,sys.argv[2]+'/src');sys.path.insert(0,sys.argv[2]+'/tests')
+from self_improvement.si_transfer_eval.evaluator import Evaluator
+from test_si_transfer_eval import manifest,FakeProducer,FakeEnv
+r=Evaluator(manifest(),Path(sys.argv[1])/'evaluation',producer_factory=lambda a,s:FakeProducer(a,s),environment_factory=FakeEnv).run()
+raise SystemExit(0 if r['status']=='COMPLETE' else 1)
+''')
+    output=tmp_path/'full';ctx=context();ctx['per_arm_allocation_seconds']=3
+    result=supervise([sys.executable,'-I',str(script),str(output),str(root)],output,context=ctx,seconds=8,environment=dict(os.environ))
+    assert result['authentic_returncode']==0 and result['cleanup_established'] and result['child_report_present'] and not result['deadline_triggered']
+    review=audit(output/'evaluation'/'events.jsonl',decode=lambda arm,ids:'A000',eos_ids=(10,))
+    assert review['episode_count']==6 and review['completed']['generations']==6 and review['completed']['environment_operations']==12
+
+
+def test_real_cpu_engineering_worker_preserves_one_call_only(tmp_path):
