+"""Seven package tree and interpreter checks with CPU-only synthetic packages."""
+import copy
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+import pytest
+from self_improvement.si_transfer_eval import runtime_identity as ri
+from self_improvement.si_p3.contract import ContractError
+
+
+def identity(tmp_path,monkeypatch):
+    modules={};packages={}
+    for name,distribution in ri.PACKAGES.items():
+        root=tmp_path/name;root.mkdir();entry=root/'__init__.py';entry.write_text('synthetic entry')
+        (root/'implementation.py').write_text('synthetic implementation')
+        modules[name]=SimpleNamespace(__file__=str(entry),__version__='1.0',__spec__=SimpleNamespace(origin=str(entry)))
+        packages[name]={'path':str(entry),'sha256':ri.file_sha256(entry),'version':'1.0','tree_sha256':ri.package_tree_sha256(root)}
+    monkeypatch.setattr(ri.importlib.util,'find_spec',lambda name:SimpleNamespace(origin=modules[name].__file__))
+    monkeypatch.setattr(ri.importlib.metadata,'version',lambda dist:'1.0')
+    monkeypatch.setattr(ri.importlib,'import_module',lambda name:modules[name])
+    expected={'interpreter':{'path':str(Path(sys.executable).resolve()),'sha256':ri.file_sha256(Path(sys.executable).resolve()),'python_version':sys.version},'packages':packages}
+    return expected,modules,{'python_version_binding':sys.version}
+
+
+def test_full_runtime_identity_before_and_after_import(tmp_path,monkeypatch):
+    expected,modules,shuffle=identity(tmp_path,monkeypatch)
+    ri.verify_static(expected,sys.executable,shuffle)
+    receipt=ri.verify_actual_imports(expected,tmp_path/'receipt.json')
+    assert receipt['status']=='PASS_ACTUAL_IMPORTED_MODULES' and set(receipt['modules'])==set(ri.PACKAGES)
+    binding={'path':str(tmp_path/'receipt.json'),'sha256':ri.file_sha256(tmp_path/'receipt.json')}
+    ri.verify_recorded_imports(expected,binding,output=tmp_path,name='receipt.json')
+    altered=copy.deepcopy(expected);altered['packages']['peft']['tree_sha256']='0'*64
+    with pytest.raises(ContractError,match='receipt identity'):ri.verify_recorded_imports(altered,binding,output=tmp_path,name='receipt.json')
+
+
+def test_non_entry_module_drift_rejected(tmp_path,monkeypatch):
+    expected,modules,shuffle=identity(tmp_path,monkeypatch)
+    (Path(expected['packages']['peft']['path']).parent/'implementation.py').write_text('changed')
+    with pytest.raises(ContractError,match='package tree mismatch'):ri.verify_static(expected,sys.executable,shuffle)
+
+
+def test_interpreter_bytes_or_version_drift_rejected(tmp_path,monkeypatch):
+    expected,modules,shuffle=identity(tmp_path,monkeypatch)
+    expected['interpreter']['sha256']='0'*64
+    with pytest.raises(ContractError,match='interpreter bytes'):ri.verify_static(expected,sys.executable,shuffle)
+    expected['interpreter']['sha256']=ri.file_sha256(Path(sys.executable).resolve());shuffle['python_version_binding']='wrong'
+    with pytest.raises(ContractError,match='Python version'):ri.verify_static(expected,sys.executable,shuffle)
+
+
+def test_actual_import_drift_persists_failed_receipt(tmp_path,monkeypatch):
+    import json
+    expected,modules,shuffle=identity(tmp_path,monkeypatch)
+    modules['peft'].__spec__.origin=str(tmp_path/'other.py')
+    with pytest.raises(ContractError,match='imported package identity'):ri.verify_actual_imports(expected,tmp_path/'failed.json')
+    receipt=json.loads((tmp_path/'failed.json').read_text())
+    assert receipt['status']=='FAILED' and receipt['modules']['peft']['spec_origin']!=expected['packages']['peft']['path']
+
+
+@pytest.mark.parametrize('engineering', [True,False])
+def test_offline_resource_audit_rejects_observed_oom(tmp_path,monkeypatch,engineering):
+    import json
+    from self_improvement.si_transfer_eval import live_audit
+    from self_improvement.si_transfer_eval.evaluator import EvaluationError
+    expected,modules,shuffle=identity(tmp_path,monkeypatch);monkeypatch.setattr(live_audit,'verify_adapter_state',lambda *args,**kwargs:None)
+    arms=('A',) if engineering else ('A','B','C')
+    def write(name,data):
+        p=tmp_path/name;p.write_text(json.dumps(data));return {'path':str(p),'sha256':ri.file_sha256(p)}
+    training=write('training.json',{'runtime_identity':expected});spec=write('spec.json',{'training_protocol':training})
+    key='runtime' if engineering else 'runtime_spec';auth=write('auth.json',{key:spec})
+    launch={'supervisor_argv':['x','--authorization',auth['path']],'authorization_sha256':auth['sha256'],'binding':{key+'_sha256':spec['sha256']}}
+    (tmp_path/'launch_context.json').write_text(json.dumps(launch))
+    rows=[];uuid='GPU-00000000-1111-2222-3333-444444444444';gib=1024**3
+    def add(point,arm=None,metadata=None):
+        row={'sequence':len(rows),'monotonic':len(rows),'point':point,'arm':arm,'ownership':'UNPROVEN_NOT_ASSERTED','status':'PASS','uuid_raw':uuid,'gpu_uuid_expected':uuid,'allocator_backend':'native','allocator_limit_bytes':24*gib,'allocator_fraction':.6,'allocator_stats':{'allocated_bytes.all.current':0,'allocated_bytes.all.peak':0,'reserved_bytes.all.current':0,'reserved_bytes.all.peak':0,'num_ooms':0,'num_alloc_retries':0},'global_free_bytes':35*gib,'global_total_bytes':40*gib,'metadata':metadata}
+        rows.append(row)
+    for arm in arms:
+        add('cuda_initialization_intent');rows[-1]['status']='STARTED';add('preweight');add('one_byte_before_weights')
+        receipts={}
+        for when in ('before','after'):
+            name='runtime_import_'+arm+'_'+when+'.json';ri.verify_actual_imports(expected,tmp_path/name);receipts[when]={'path':str(tmp_path/name),'sha256':ri.file_sha256(tmp_path/name)}
+        add('model_loaded',arm,{'adapter_sha256':arm*64,'adapter_state':{},'import_receipts':receipts})
+    path=tmp_path/('engineering_resource.jsonl' if engineering else 'resource.jsonl')
+    path.write_text(''.join(json.dumps(r)+'\n' for r in rows));manifest={'adapters':{a:a*64 for a in arms}}
+    live_audit.audit_resources(tmp_path,manifest,engineering_only=engineering)
+    rows[-1]['allocator_stats']['num_ooms']=1;path.write_text(''.join(json.dumps(r)+'\n' for r in rows))
+    with pytest.raises(EvaluationError,match='OOM counter'):live_audit.audit_resources(tmp_path,manifest,engineering_only=engineering)
+    rows[-1]['allocator_stats']['num_ooms']=0;rows[-1]['allocator_stats']['reserved_bytes.all.peak']=25*gib;path.write_text(''.join(json.dumps(r)+'\n' for r in rows))
+    with pytest.raises(EvaluationError,match='peak/limit'):live_audit.audit_resources(tmp_path,manifest,engineering_only=engineering)
+    rows[-1]['allocator_stats']['reserved_bytes.all.peak']=0;rows[-1]['allocator_fraction']=.7;path.write_text(''.join(json.dumps(r)+'\n' for r in rows))
+    with pytest.raises(EvaluationError,match='allocator fraction'):live_audit.audit_resources(tmp_path,manifest,engineering_only=engineering)
+    if engineering:
+        rows[-1]['allocator_fraction']=.6;rows[-1]['allocator_stats']['num_alloc_retries']=1;path.write_text(''.join(json.dumps(r)+'\n' for r in rows))
+        with pytest.raises(EvaluationError,match='retry counter'):live_audit.audit_resources(tmp_path,manifest,engineering_only=True)
