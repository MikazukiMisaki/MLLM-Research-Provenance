+
+import pytest
+from self_improvement.si_p3.contract import ContractError,canonical
+from self_improvement.si_p3.runtime_environment import (historical_replay,source_hash,replay_twice,
+                                                       ReadIsolatedEnvironment)
+from self_improvement.si_p3.runtime_ledger import EngineeringLedger
+from si_e2_support import permit,simple_evidence,environment_factory,FakeTextWorld
+
+
+def source_wire():
+    e=simple_evidence();before,after=e.states
+    meta={'schedule_index':0,'split':'train','task_family':e.family,'source_game_sha256':'g'*64,
+          'source_traj_data_sha256':'t'*64}
+    step={'index':0,'observation':before['observation'],'valid_actions':before['valid_actions'],'action_valid':True,
+          'action':'look','result_observation':after['observation'],'done':True,'reward':1.0,
+          'metadata':{'transition_truncated':False,'r19_transition_event_id':'step'}}
+    row={'task':{'task_id':e.task_id,'text':before['goal'],'split':'train'},'seed':42,'steps':[step],
+         'initial_observation':before['observation'],'metadata':meta}
+    h=source_hash(row);meta.update(source_trajectory_sha256=h,r19_source_event_refs={
+        'source_episode_event_id':'source','reset_event_id':'reset','transition_event_ids':['step']})
+    reset={'event_id':'reset','kind':'environment_operation_completed','payload':{'operation':'environment_reset',
+        'task_id':e.task_id,'seed':42,'transition':dict(before)}}
+    transition={'event_id':'step','kind':'environment_operation_completed','payload':{'command':'look','action_id':'A000',
+        'action_map':{'A000':'look','A001':'inventory'},'before_state':dict(before),
+        'transition':dict(after)|{'executed_command':'look'}}}
+    source={'event_id':'source','kind':'source_episode_completed','payload':{'trajectory_sha256':h,
+        'source_game_sha256':'g'*64,'source_traj_data_sha256':'t'*64}}
+    return row,[reset,transition,source],h
+
+
+def test_original_r19_source_wire_after_map_comes_from_transition_receipt():
+    row,events,h=source_wire()
+    e=historical_replay(canonical(row).encode(),b'\n'.join(canonical(x).encode() for x in events),
+                        expected_source_sha=h,software_fixture=True)
+    assert e==simple_evidence() and e.states[-1]['valid_actions']==[]
+
+
+@pytest.mark.parametrize('attack',['absent_map','wrong_order','wrong_command','wrong_game','no_completion','wrong_index','wrong_done'])
+def test_source_wire_negative_bindings(attack):
+    row,events,h=source_wire()
+    if attack=='absent_map':events[1]['payload']['transition'].pop('valid_actions')
+    elif attack=='wrong_order':events[1]['payload']['before_state']['valid_actions'].reverse()
+    elif attack=='wrong_command':events[1]['payload']['command']='inventory'
+    elif attack=='wrong_game':events[2]['payload']['source_game_sha256']='x'*64
+    elif attack=='no_completion':events[2]['kind']='source_episode_started'
+    elif attack=='wrong_index':row['metadata']['schedule_index']=1
+    elif attack=='wrong_done':events[1]['payload']['transition']['done']=False
+    with pytest.raises((ContractError,KeyError)):
+        historical_replay(canonical(row).encode(),b'\n'.join(canonical(x).encode() for x in events),expected_source_sha=h,software_fixture=True)
+
+
+def test_read_isolation_and_two_fresh_seeded_replays(tmp_path):
+    p=permit(tmp_path);p.output.mkdir();ledger=EngineeringLedger(p.output/'events.jsonl',p,evidence_class='synthetic_software_fixture')
+    e=simple_evidence();factory,instances,sentinel=environment_factory(tmp_path,e)
+    result=replay_twice(e,factory,ledger)
+    assert result['repeated_public_states_equal'] and result['terminal_map_observed']
+    assert len(instances)==2 and instances[0] is not instances[1]
+    assert all(x.seeds==[42] and x.closed for x in instances)
+    assert sentinel.read_text()=='MUST_NOT_OPEN'
+    assert ledger.snapshot()['completed']['resets']==2 and ledger.snapshot()['completed']['steps']==2
+    ledger.close()
+
+
+def test_production_no_scan_subclass_sets_game_list_before_constructor_returns(tmp_path,monkeypatch):
+    e=simple_evidence();factory,_,sentinel=environment_factory(tmp_path,e)
+    env=factory();env.factory_boundary=None
+    class ParentBoundary:
+        def __init__(self,config,train_eval):
+            assert Path(config['dataset']['data_path'])==env.game.parent
+            self.collect_game_files(verbose=True)
+            assert self.game_files==[str(env.game)] and self.num_games==1
+        def collect_game_files(self,verbose=False):raise AssertionError('global scan executed')
+        def init_env(self,batch_size):return FakeTextWorld(e,env.game)
+    import sys
+    monkeypatch.setitem(sys.modules,'alfworld.agents.environment.alfred_tw_env',SimpleNamespace(AlfredTWEnv=ParentBoundary))
+    isolation=env.initialize();assert isolation['discovery']=='explicit_no_scan_subclass'
+    assert env.reset(seed=e.seed).task.task_id==e.task_id
+    env.close();assert sentinel.exists()
+
+
+@pytest.mark.parametrize('fault',['missing_terminal','drift'])
+def test_terminal_missing_map_is_recorded_not_coerced_and_stops(tmp_path,fault):
+    p=permit(tmp_path);p.output.mkdir();ledger=EngineeringLedger(p.output/'events.jsonl',p,evidence_class='synthetic_software_fixture')
+    factory,instances,_=environment_factory(tmp_path,simple_evidence(),missing_terminal=fault=='missing_terminal',drift=fault=='drift')
+    with pytest.raises(ContractError,match='transition/map/terminal drift'):replay_twice(simple_evidence(),factory,ledger)
+    assert len(instances)==1 and instances[0].closed
+    data=next(x['payload']['data'] for x in ledger.events if x['kind']=='external_completed' and 'valid_actions' in x['payload']['data'] and x['payload']['data']['done'])
+    if fault=='missing_terminal':assert data['valid_actions'] is None
+    assert ledger.snapshot()['completed']['steps']==1
+    ledger.close()
+
+
+@pytest.mark.parametrize('attack',['copy','hash','identity'])
+def test_original_game_path_and_saved_hash_binding_rejects_staging(tmp_path,attack):
+    from self_improvement.si_p3.runtime_environment import bind_original_game_path
+    e=simple_evidence();game=tmp_path/e.task_id/'game.tw-pddl'
+    row={'task':{'metadata':{'game_file':str(game)}},'metadata':{'source_game_sha256':'g','source_traj_data_sha256':'t'}}
+    env={'game':str(game),'data_root':str(tmp_path),'game_sha256':'g','traj_data_sha256':'t'}
+    bind_original_game_path(env,row,e)
+    if attack=='copy':row['task']['metadata']['game_file']=str(tmp_path/'different'/e.task_id/'game.tw-pddl')
+    elif attack=='hash':env['game_sha256']='altered'
+    else:env['game']=str(tmp_path/'wrong-id'/'trial'/'game.tw-pddl');row['task']['metadata']['game_file']=env['game']
+    with pytest.raises(ContractError):bind_original_game_path(env,row,e)
