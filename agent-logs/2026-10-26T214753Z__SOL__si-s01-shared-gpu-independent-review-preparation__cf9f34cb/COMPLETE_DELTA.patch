+"""Shared-resource production observer and independent audit tests, fake external edges only."""
+from copy import deepcopy
+from pathlib import Path
+from dataclasses import replace
+import json,os,sys
+import pytest
+from self_improvement.si_s01.contract import ContractError,canonical
+from self_improvement.si_s01.shared_resource import binding,guard_for,STATS
+from self_improvement.si_s01.engineering_runtime import EngineeringRun,EngineeringProducer
+from self_improvement.si_s01.engineering_audit import audit_engineering
+from self_improvement.si_s01.evidence import read_events
+from si_s01_engineering_support import reseal_engineering
+from si_s01_shared_support import shared_fixture
+
+
+def run(f):
+    result=EngineeringRun(f.permit,f.permit.output).run()
+    return int(result['status']!='OBSERVED_PUBLIC_PATH_COMPATIBLE_NOT_RNG_RECONSTRUCTED')
+def encoder(f):return EngineeringProducer(f.state.tokenizer,None,evidence_class='synthetic_software_fixture')
+def report(f):return json.loads((f.permit.output/'engineering_report.json').read_text())
+def events(f):return read_events(f.permit.output/'engineering_events.jsonl')
+
+
+def test_shared_nonempty_production_coupled_path_and_independent_audit(tmp_path,monkeypatch):
+    f=shared_fixture(tmp_path,monkeypatch);f.state.foreign_post=True;assert run(f)==0
+    r=report(f);assert r['physical']['completed']['generation']==1 and r['physical']['completed']['step']==6
+    assert f.state.calls['one_byte_fake']==1 and f.state.calls['fraction_set_fake']==1 and f.state.calls['base_load_fake']==1
+    assert f.state.calls['resource_query_fake']==0 # unmapped NVML processes cannot become own evidence or kill targets
+    assert r['shared_resource']['validated_resource_samples']==5 and not r['shared_resource']['resource_rejected']
+    assert r['shared_resource']['resource_policy']==binding() and r['shared_resource']['NVML_mapping']=='UNPROVEN_NOT_ASSERTED'
+    assert r['historical_science_unchanged']=={'model_generations':5142,'environment_operations':7949}
+    assert audit_engineering(f.permit.output/'engineering_events.jsonl',f.permit,encoder(f))==r
+
+
+@pytest.mark.parametrize('value',[28*1024**3,28*1024**3-1])
+def test_before_weights_exact_threshold(tmp_path,monkeypatch,value):
+    f=shared_fixture(tmp_path,monkeypatch);f.state.free_before=value;code=run(f)
+    assert code==int(value<28*1024**3)
+    assert f.state.calls['base_load_fake']==int(value>=28*1024**3)
+    if code:assert report(f)['physical']['reserved_or_spent']['model_load']==1
+
+
+@pytest.mark.parametrize('value',[2*1024**3,2*1024**3-1])
+def test_running_global_free_threshold_and_no_call_retry(tmp_path,monkeypatch,value):
+    f=shared_fixture(tmp_path,monkeypatch);f.state.free_later=value;code=run(f)
+    assert code==int(value<2*1024**3) and f.state.calls['generation']==int(value>=2*1024**3)
+
+
+def test_postcall_memory_failure_preserves_durable_actual_return_and_reservation(tmp_path,monkeypatch):
+    f=shared_fixture(tmp_path,monkeypatch);f.state.post_free=2*1024**3-1;assert run(f)==1
+    r=report(f);assert f.state.calls['generation']==1 and r['physical']['observed_generation_returns']==1
+    assert r['physical']['observed_returned_output_tokens']==5 and r['physical']['reserved_or_spent']['generated_tokens']==16
+    assert r['shared_resource']['resource_rejected'] and r['status']=='ENGINEERING_STOP_NO_COMPATIBILITY_CLAIM'
+    assert any(e['payload']['kind']=='generation_returned' for e in events(f) if e['kind']=='runtime_evidence')
+
+
+@pytest.mark.parametrize('fault',['backend','readback','missing','bool','negative','overcap','nan','UUID','total','cached_probe'])
+def test_shared_bad_device_allocator_stats_reject_before_weights(tmp_path,monkeypatch,fault):
+    f=shared_fixture(tmp_path,monkeypatch)
+    if fault=='backend':f.state.backend='cudaMallocAsync'
+    elif fault=='readback':f.state.readback_delta=.01
+    elif fault=='missing':f.state.stat_fault=lambda s:s.pop('reserved_bytes.all.peak')
+    elif fault=='bool':f.state.stat_fault=lambda s:s.update({'num_ooms':False})
+    elif fault=='negative':f.state.stat_fault=lambda s:s.update({'num_alloc_retries':-1})
+    elif fault=='overcap':f.state.stat_fault=lambda s:s.update({'reserved_bytes.all.peak':25*1024**3})
+    elif fault=='nan':f.state.stat_fault=lambda s:s.update({'allocated_bytes.all.current':float('nan')})
+    elif fault=='UUID':f.state.uuid='GPU-deadbeef-abcd-abcd-abcd-123456789abc'
+    elif fault=='total':f.state.total=26*1024**3
+    elif fault=='cached_probe':f.state.stat_fault=lambda s:s.update(dict.fromkeys(STATS[:4],0))
+    assert run(f)==1 and f.state.calls['base_load_fake']==f.state.calls['generation']==0
+
+
