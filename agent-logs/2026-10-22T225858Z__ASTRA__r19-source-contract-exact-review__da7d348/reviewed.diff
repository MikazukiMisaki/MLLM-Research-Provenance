+"""Exercise the real source actor/collector/ledger/validators with synthetic edges only."""
+from collections import Counter
+import copy
+import hashlib
+import json
+from types import SimpleNamespace
+import pytest
+from env.base import Task, ResetResult, Transition
+from scripts import run_r19_experiment as runner
+from scripts import analyze_r19_recovery_duration as analyzer
+from recovery.r19_duration import (
+    DurableEventJournal, UnitRegistry, build_r19_source_schedule,
+    EvidenceIntegrityError,
+)
+TRIAL = 'pick_and_place_simple-Pencil-None-GarbageCan-316/trial_SYNTHETIC_R19'
+
+class ToyEnvironment:
+    def __init__(self, terminal_after=1):
+        self.task = Task(task_id=TRIAL, text='put a pencil in garbagecan', split='train',
+                         family='pick_and_place_simple')
+        self.terminal_after = terminal_after
+        self.actions = []
+        self.closed = False
+        self.comparison_path = None
+    def reset(self, *, seed=None):
+        assert seed == 30000
+        return ResetResult('state 0', self.task, ('look', 'go to garbagecan 1'))
+    def step(self, action):
+        if self.comparison_path is not None:
+            comparison = json.loads(self.comparison_path.read_text())
+            assert comparison['status'] == 'PASS'
+            assert comparison['comparison_before_first_environment_action'] is True
+            assert comparison['environment_actions_executed_before_comparison'] == 0
+        assert action in ('look', 'go to garbagecan 1')
+        self.actions.append(action)
+        done = len(self.actions) == self.terminal_after
+        return Transition(f'state {len(self.actions)}', float(done), done, False,
+                          ('look', 'go to garbagecan 1'))
+    def close(self):
+        self.closed = True
+
+def _synthetic_generation(prompt, raw):
+    ids = [65]
+    return {
+        'prompt': prompt, 'rendered_prompt': prompt,
+        'rendered_prompt_sha256': hashlib.sha256(prompt.encode()).hexdigest(),
+        'raw_output': raw, 'token_ids': ids,
+        'token_ids_sha256': hashlib.sha256(json.dumps(ids,separators=(',',':')).encode()).hexdigest(),
+        'input_tokens': 100, 'generated_tokens': 1, 'latency_seconds': 0.0,
+        'output_complete': True, 'token_cap_reached': False,
+        'max_new_tokens': 16, 'do_sample': False, 'thinking': False,
+    }
+
+def _expected_restart_snapshot(raw='A001'):
+    from models.action_parser import action_id_mapping
+    from models.policy import ActionRequest
+    from models.protocol_stability import parse_p2_selection
+    from sft.protocol import sft_p0_prompt
+    task = Task(task_id=TRIAL, text='put a pencil in garbagecan', split='train',
+                family='pick_and_place_simple')
+    valid_actions = ('look', 'go to garbagecan 1')
+    prompt = sft_p0_prompt(ActionRequest(task, 'state 0', (), valid_actions))
+    generation = _synthetic_generation(prompt, raw)
+    parsed = parse_p2_selection(raw, valid_actions, reflection_required=False)
+    mapping = action_id_mapping(valid_actions)
+    parser_result = {
+        'selection_status': parsed.selection_status, 'action_id': parsed.action_id,
+        'action': parsed.action, 'valid_actions': list(valid_actions), 'id_to_command': mapping,
+    }
+    return runner._source_restart_snapshot(
+        canonical_trial_id=TRIAL, schedule_index=0, seed=30000,
+        observation='state 0', valid_actions=valid_actions, prompt=prompt,
+        generation=generation, parser_result=parser_result, action_map=mapping,
+    )
+
+def run_source(tmp_path, monkeypatch, outputs, *, terminal_after=1,
+               restart_expected=False, expect_restart_mismatch=False):
+    schedule = build_r19_source_schedule([{
+        'canonical_trial_id': TRIAL, 'task_family': 'pick_and_place_simple',
+        'source_game_sha256': '1' * 64, 'source_traj_data_sha256': '2' * 64,
+    }], set())
+    output = tmp_path / 'source'; output.mkdir()
+    journal = DurableEventJournal(output / 'events.jsonl', run_id='synthetic-source-contract',
+        protocol_sha256='a' * 64, code_sha='b' * 40, evidence_class='synthetic')
+    registry = UnitRegistry(output / 'registry.json')
+    env = ToyEnvironment(terminal_after)
+    env.output_path = output
+    env.comparison_path = output / 'source_restart_comparison.json' if restart_expected else None
+    values = iter(outputs)
+    def generate(_backend, prompt, max_new_tokens):
+        assert max_new_tokens == 16
+        raw = next(values)
+        return _synthetic_generation(prompt, raw)
+    monkeypatch.setattr(runner, '_generate_exact', generate)
+    runtime = object.__new__(runner.LiveR19Runtime)
+    runtime.mode = 'pilot'
+    runtime.actor_backend = object()
+    runtime.actor = SimpleNamespace(model_version='synthetic-source-contract')
+    runtime.journal = journal
+    runtime.sink = journal.append
+    runtime.model_call_counts = Counter()
+    runtime.environment_operation_counts = Counter()
+    runtime.environment_step_counts = Counter()
+    runtime.environment_reset_count = 0
+    runtime.new_environment = lambda *_args: env
+    if restart_expected:
+        expected = _expected_restart_snapshot(outputs[0]) if restart_expected is True else copy.deepcopy(restart_expected)
+        runtime.source_restart_expected_snapshot = expected
+        runtime.source_restart_predecessor_run_id = 'preserved-failed-source-run'
+        runtime.source_restart_comparison_consumed = False
+    try:
+        rows = runtime.run_source_episodes(schedule, output, registry, {})
+    except EvidenceIntegrityError:
+        if not expect_restart_mismatch:
+            raise
+        rows = []
+    else:
+        assert not expect_restart_mismatch
+    events = [json.loads(line) for line in (output/'events.jsonl').read_text().splitlines()]
+    physical = analyzer.validate_event_ledger(events, expected_evidence_class='synthetic')
+    if expect_restart_mismatch:
+        comparison = json.loads((output/'source_restart_comparison.json').read_text())
+        assert comparison['status'] == 'MISMATCH_STOP'
+        assert comparison['comparison_before_first_environment_action'] is True
+        assert comparison['environment_actions_executed_before_comparison'] == 0
+        assert not env.actions
+        assert not (output/'source_trajectories.jsonl').exists()
+        assert all(u['status'] == 'in_progress' for u in registry.document['units'].values())
+        return None, events, physical, runtime, env, schedule, None
+    exclusions = {'schema_version': 'r19_exclusion_manifest_v1',
+                  'status': 'frozen_before_inference', 'excluded_task_trial_ids': []}
+    validated = analyzer.validate_live_source_schedule(schedule, exclusions, events, [], physical)
+    assert validated['status'] == 'PASS_FROZEN_TRAIN_SCHEDULE_BINDING'
+    assert validated['completed_source_episodes'] == 1
+    assert env.closed
+    assert all(u['status'] == 'completed' for u in registry.document['units'].values())
+    return rows[0], events, physical, runtime, env, schedule, exclusions
+
+@pytest.mark.parametrize('raw,status,actions', [
+    ('A001','selected',1), ('invalid','action_format_violation',0),
+    ('','action_format_violation',0), ('A999','action_out_of_range',0),
+])
+def test_real_actor_collector_ledger_and_source_validator(tmp_path, monkeypatch, raw, status, actions):
+    row, events, physical, runtime, env, _, _ = run_source(tmp_path, monkeypatch, [raw])
+    assert len(row['steps']) == 1
+    assert row['steps'][0]['parser_status'] == status
+    assert len(env.actions) == actions
+    assert runtime.environment_reset_count == 1
+    assert physical['completed_physical_model_generations'] == 1
+    assert physical['physical_environment_resets'] == 1
+    generations = [e for e in events if e['kind'] == 'generation_completed']
+    assert generations[0]['identity']['operation'] == 'source_generation'
+    assert row['steps'][0]['metadata']['action_selection']['selection_status'] == status
+    assert row['steps'][0]['metadata']['r19_generation_event_id'] == generations[0]['event_id']
+
+@pytest.mark.parametrize('length', [2, 6, 50])
+def test_multiple_source_steps_and_frozen_horizon(tmp_path, monkeypatch, length):
+    terminal_after = 100 if length == 50 else length
+    row, _, physical, _, env, _, _ = run_source(
+        tmp_path, monkeypatch, ['A000'] * length, terminal_after=terminal_after)
+    assert len(env.actions) == length == len(row['steps'])
+    assert physical['completed_physical_model_generations'] == length
+    if length == 50:
+        assert row['truncated'] is True
+        assert row['metadata']['termination_reason'] == 'max_steps'
+
+@pytest.mark.parametrize('field,value', [
+    ('operation','task_actor_generation'), ('component','sft'),
+    ('canonical_trial_id','a-different-task'), ('schedule_index',99),
+])
+def test_source_validator_still_rejects_wrong_event_identity(tmp_path, monkeypatch, field, value):
+    _, events, physical, _, _, schedule, exclusions = run_source(tmp_path, monkeypatch, ['A000'])
+    bad = copy.deepcopy(events)
+    event = next(e for e in bad if e['kind'] == 'generation_completed')
+    event['identity'][field] = value
+    with pytest.raises(EvidenceIntegrityError):
+        analyzer.validate_live_source_schedule(schedule, exclusions, bad, [], physical)
+
+def test_first_source_restart_compares_before_first_action_and_passes_production_validator(tmp_path, monkeypatch):
+    row, events, physical, runtime, env, schedule, exclusions = run_source(
+        tmp_path, monkeypatch, ['A001'], restart_expected=True)
+    assert row['metadata']['source_restart_comparison_sha256']
+    assert runtime.source_restart_comparison_consumed is True
+    assert len(env.actions) == 1
+    assert physical['completed_physical_model_generations'] == 1
+    assert physical['physical_environment_resets'] == 1
+    assert physical['physical_environment_operations'] == 1
+    assert analyzer.validate_live_source_schedule(schedule, exclusions, events, [], physical)[
+        'completed_source_episodes'] == 1
+    comparison_path = tmp_path/'source'/'source_restart_comparison.json'
+    comparison = json.loads(comparison_path.read_text())
+    manifest = {
+        'source_restart_comparison_sha256': hashlib.sha256(comparison_path.read_bytes()).hexdigest(),
+        'source_restart_comparison_status': 'PASS',
+        'source_restart_predecessor_run_id': 'preserved-failed-source-run',
+        'source_restart_repeated_generation_count': 1,
+        'source_restart_repeated_reset_count': 1,
+    }
+    validated = analyzer.validate_source_restart_comparison(
+        execution_manifest=manifest, events=events,
+        predecessor_run_id='preserved-failed-source-run',
+        expected_snapshot=_expected_restart_snapshot('A001'),
+        expected_snapshot_sha256=hashlib.sha256(json.dumps(
+            _expected_restart_snapshot('A001'), sort_keys=True, separators=(',', ':')).encode()).hexdigest(),
+        comparison_path=comparison_path,
+    )
+    assert validated['status'] == 'PASS_FIRST_SOURCE_RESTART_COMPARISON_AND_EPISODE_BINDING'
+
+def test_source_restart_production_validator_rejects_tampered_snapshot(tmp_path, monkeypatch):
+    row, events, _, _, _, _, _ = run_source(
+        tmp_path, monkeypatch, ['A001'], restart_expected=True)
+    assert row is not None
+    comparison_path = tmp_path/'source'/'source_restart_comparison.json'
+    comparison = json.loads(comparison_path.read_text())
+    comparison['observed_snapshot']['parser_and_action']['action_map_sha256'] = '0' * 64
+    comparison_path.write_text(json.dumps(comparison, sort_keys=True))
+    manifest = {
+        'source_restart_comparison_sha256': hashlib.sha256(comparison_path.read_bytes()).hexdigest(),
+        'source_restart_comparison_status': 'PASS',
+        'source_restart_predecessor_run_id': 'preserved-failed-source-run',
+        'source_restart_repeated_generation_count': 1,
+        'source_restart_repeated_reset_count': 1,
