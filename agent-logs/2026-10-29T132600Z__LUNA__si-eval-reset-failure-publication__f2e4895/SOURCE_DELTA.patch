index 0000000..38377e0
--- /dev/null
+++ b/src/self_improvement/si_transfer_eval/time_window.py
@@ -0,0 +1,10 @@
+"""One timezone-aware timestamp contract for preflight, clearance, and launch."""
+from datetime import datetime, timezone
+from .evaluator import _need
+
+
+def parse_utc(value: str) -> datetime:
+    _need(type(value) is str, 'timestamp string required')
+    parsed = datetime.fromisoformat(value.replace('Z', '+00:00'))
+    _need(parsed.tzinfo is not None, 'timezone required')
+    return parsed.astimezone(timezone.utc)
