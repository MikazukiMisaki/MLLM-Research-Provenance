+@pytest.mark.parametrize('mutation', [
+    'missing-launch', 'raw-launch', 'launch-digest', 'status-launch-digest',
+    'launch-schema', 'launch-run', 'launch-source', 'launch-class', 'launch-cwd',
+    'launch-argv', 'launch-interpreter', 'supervisor-argv', 'supervisor-entrypoint',
+    'record-dir', 'supervisor-class', 'supersedes', 'offline-environment',
+    'config-environment', 'data-environment', 'cache-environment', 'allowlist', 'omitted-environment',
+    'runtime-context', 'environment-context', 'runtime-file', 'environment-file',
+    'empty-context', 'mixed-context', 'empty-ledger', 'malformed-ledger', 'null-run',
+    'cross-run', 'mixed-source', 'protocol', 'exit-nonzero', 'exit-string', 'exit-bool',
+    'incomplete', 'interrupted', 'events-bytes', 'branches-bytes', 'log-bytes',
+    'status-missing', 'status-array', 'status-interrupted', 'status-class',
+    'status-receipt', 'receipt-bytes', 'receipt-array', 'event-view', 'contradictory-start',
+])
+def test_launch_receipt_tampering_fails_closed(tmp_path, mutation):
+    receipt, status, launch, kwargs = synthetic_receipt_bundle(tmp_path)
+    launch_path = kwargs['receipt_path'].parent / 'launch_context.json'
+    semantic = True
+    if mutation == 'missing-launch':
+        launch_path.unlink(); semantic = False
+    elif mutation == 'raw-launch':
+        launch_path.write_text('{}'); semantic = False
+    elif mutation in {'launch-digest', 'status-launch-digest'}:
+        (receipt if mutation == 'launch-digest' else status)['launch_context_sha256'] = '0' * 64
+        semantic = False
+    elif mutation.startswith('launch-'):
+        key = {'schema': 'schema_version', 'run': 'run_id', 'source': 'implementation_sha',
+               'class': 'evidence_class', 'cwd': 'cwd', 'argv': 'command_argv',
+               'interpreter': 'interpreter'}[mutation[7:]]
+        launch[key] = ['/tampered'] if key == 'command_argv' else '/tampered'
+    elif mutation == 'supervisor-argv':
+        launch['supervisor_argv'][-1] = 'tampered'
+    elif mutation == 'supervisor-entrypoint':
+        launch['supervisor_entrypoint'] = '/other/supervisor.py'
+    elif mutation in {'record-dir', 'supervisor-class'}:
+        key = '--record-dir' if mutation == 'record-dir' else '--evidence-class'
+        launch['supervisor_argv'][launch['supervisor_argv'].index(key) + 1] = '/tampered'
+    elif mutation == 'supersedes':
+        launch['supersedes_run_id'] = 'WRONG_PREDECESSOR'
+    elif mutation.endswith('-environment'):
+        if mutation == 'omitted-environment':
+            launch['omitted_environment_key_presence']['PYTHONPATH'] = 0
+        else:
+            launch['effective_environment'][{'offline-environment': 'HF_HUB_OFFLINE',
+                                             'config-environment': 'ALFWORLD_CONFIG_PATH',
+                                             'data-environment': 'ALFWORLD_DATA',
+                                             'cache-environment': 'HF_HUB_CACHE'}[mutation]] = '/tampered'
+    elif mutation == 'allowlist':
+        launch['environment_allowlist'] = []
+    elif mutation in {'runtime-context', 'environment-context'}:
+        kwargs['events'][0]['run_context'][mutation.split('-')[0] + '_manifest_sha256'] = 'f' * 64
+        kwargs['events_path'].write_text(json.dumps(kwargs['events'][0]) + '\n')
+        receipt['events_sha256'] = status['events_sha256'] = sha256_file(kwargs['events_path'])
+    elif mutation in {'runtime-file', 'environment-file'}:
+        write_json(kwargs['events_path'].parent / (mutation.split('-')[0] + '_manifest.json'), {})
+    elif mutation == 'empty-context':
+        kwargs['events'][0]['run_context'] = {}
+    elif mutation in {'mixed-context', 'cross-run', 'mixed-source'}:
+        other = copy.deepcopy(kwargs['events'][0])
+        if mutation == 'mixed-context':
+            other['run_context']['experiment_id'] = 'other'
+        else:
+            other['run_id' if mutation == 'cross-run' else 'implementation_sha'] = 'other'
+        kwargs['events'].append(other)
+    elif mutation == 'empty-ledger':
+        kwargs['events'] = []
+    elif mutation == 'malformed-ledger':
+        kwargs['events'] = [None]
+    elif mutation == 'null-run':
+        kwargs['events'][0]['run_id'] = None
+    elif mutation == 'protocol':
+        kwargs['protocol_sha256'] = 'f' * 64
+    elif mutation.startswith('exit-'):
+        receipt['exit_code'] = {'nonzero': 1, 'string': '0', 'bool': False}[mutation[5:]]
+    elif mutation in {'incomplete', 'interrupted'}:
+        receipt['artifacts_complete' if mutation == 'incomplete' else 'interrupted_by_supervisor'] = mutation != 'incomplete'
+    elif mutation in {'events-bytes', 'branches-bytes', 'log-bytes'}:
+        kwargs[{'events-bytes': 'events_path', 'branches-bytes': 'branches_path', 'log-bytes': 'runner_log_path'}[mutation]].write_text('tampered')
+    elif mutation.startswith('status-'):
+        if mutation in {'status-missing', 'status-array'}:
+            if mutation == 'status-missing':
+                kwargs['supervisor_status_path'].unlink()
+            else:
+                write_json(kwargs['supervisor_status_path'], [])
+            semantic = False
+        else:
+            status[{'status-interrupted': 'status', 'status-class': 'evidence_class',
+                    'status-receipt': 'runner_exit_sha256'}[mutation]] = 'tampered'
+            semantic = False
+    elif mutation in {'receipt-bytes', 'receipt-array'}:
+        write_json(kwargs['receipt_path'], {} if mutation == 'receipt-bytes' else [])
+        semantic = False
+    elif mutation == 'event-view':
+        kwargs['events'][0]['kind'] = 'unpersisted'
+    elif mutation == 'contradictory-start':
+        kwargs['events'][0]['kind'] = 'run_started'
+        kwargs['events'][0]['payload'] = {'run_context': {}}
+        kwargs['events_path'].write_text(json.dumps(kwargs['events'][0]) + '\n')
+        receipt['events_sha256'] = status['events_sha256'] = sha256_file(kwargs['events_path'])
+    else:
+        raise AssertionError(mutation)
+    if semantic:
+        reseal(receipt, status, launch, kwargs)
+    elif mutation not in {'receipt-bytes', 'receipt-array', 'status-array', 'status-missing'}:
+        write_json(kwargs['receipt_path'], receipt)
+        if mutation != 'status-receipt':
+            status['runner_exit_sha256'] = sha256_file(kwargs['receipt_path'])
+        write_json(kwargs['supervisor_status_path'], status)
+    with pytest.raises(EvidenceIntegrityError):
+        analyzer.validate_live_exit_receipt(receipt, **kwargs)
+
