+"""Only bounded synthetic-token engineering; no dataset or scientific result."""
+from __future__ import annotations
+
+import gc
+import json
+import math
+import os
+import shutil
+import time
+from pathlib import Path
+
+from self_improvement.si_s01.evidence import atomic_fresh_json
+from .training import ContractError, load_frozen_local_base, load_p0_adapter, tree_sha256
+
+
+def _cleanup_cuda_allocator(torch, result: dict, event) -> None:
+    """Measure cleanup; a CUDA workspace is a candidate, not a diagnosis."""
+    torch.cuda.synchronize()
+    torch.cuda.empty_cache()
+    torch.cuda.synchronize()
+    result["pre_workspace_clear_allocated_bytes"] = int(torch.cuda.memory_allocated(0))
+    result["pre_workspace_clear_reserved_bytes"] = int(torch.cuda.memory_reserved(0))
+    clear = getattr(torch._C, "_cuda_clearCublasWorkspaces", None)
+    result["cublas_workspace_clear_available"] = callable(clear)
+    result["cublas_workspace_clear_attempted"] = False
+    event("allocator_cleanup_measured", allocated_bytes=result["pre_workspace_clear_allocated_bytes"],
+          reserved_bytes=result["pre_workspace_clear_reserved_bytes"], workspace_clear_available=callable(clear))
+    if (result["pre_workspace_clear_allocated_bytes"] or result["pre_workspace_clear_reserved_bytes"]) and callable(clear):
+        result["cublas_workspace_clear_attempted"] = True
+        event("cublas_workspace_clear_started")
+        clear()
+        event("cublas_workspace_clear_completed")
+        torch.cuda.synchronize()
+        torch.cuda.empty_cache()
+        torch.cuda.synchronize()
+    result["post_cleanup_allocated_bytes"] = int(torch.cuda.memory_allocated(0))
+    result["post_cleanup_reserved_bytes"] = int(torch.cuda.memory_reserved(0))
+    event("allocator_cleanup_final", allocated_bytes=result["post_cleanup_allocated_bytes"],
+          reserved_bytes=result["post_cleanup_reserved_bytes"])
+    if result["post_cleanup_allocated_bytes"] != 0 or result["post_cleanup_reserved_bytes"] != 0:
+        raise ContractError("PyTorch allocations remain after engineering cleanup")
+
+
+def run_engineering(a: dict, plan: dict, protocol: dict, output: Path, *, device: str, resource=None, cleanup_observer=None) -> dict:
+    """Run two synthetic-only updates; trial adapter is hashed then removed."""
+    import torch
+
+    t = plan["training"]
+    config = protocol["training_config"]
+    journal = output / "engineering_events.jsonl"
+    counts = {"microbatches_started": 0, "microbatches_completed": 0, "optimizer_steps_started": 0, "optimizer_steps_completed": 0, "input_tokens": 0, "supervised_tokens": 0, "trial_saves_started": 0, "trial_saves_completed": 0}
+    result = {"schema": "SI_CONTINUATION_ENGINEERING_RESULT_V1", "scope": "SYNTHETIC_TOKEN_ENGINEERING_ONLY", "evidence_class": a["evidence_class"], "status": "FAILED", "scientific_checkpoint_eligible": False, "retry_authorized": False, "counts": counts}
+    start = time.monotonic()
+    model = base = optimizer = None
+    scratch = output / "engineering_trial_adapter"
+    scratch_created = False
+
+    def event(kind, **kwargs):
+        with journal.open("a", encoding="utf-8") as handle:
+            handle.write(json.dumps({"kind": kind, "monotonic": time.monotonic(), **kwargs}, sort_keys=True) + "\n")
+            handle.flush()
+            os.fsync(handle.fileno())
+
+    def check_time():
+        if time.monotonic() - start >= a["allocation_seconds"]:
+            raise ContractError("engineering worker time budget exceeded")
+
+    def sync():
+        if device == "cuda:0":
+            torch.cuda.synchronize()
+
+    try:
+        torch.manual_seed(config["seed"])
+        check_time()
+        if resource:
+            resource("before_model_load")
+        event("model_load_started")
+        started_load = time.monotonic()
+        base = load_frozen_local_base(Path(a["base"]["path"]))
+        model = load_p0_adapter(base, Path(a["adapter"]["path"]))
+        model.config.use_cache = False
+        if model.config.use_cache is not False or not getattr(model, "supports_gradient_checkpointing", False):
+            raise ContractError("engineering checkpoint/cache model invariant")
+        model.gradient_checkpointing_enable(gradient_checkpointing_kwargs={"use_reentrant": False})
+        if model.is_gradient_checkpointing is not True:
+            raise ContractError("engineering checkpointing not enabled")
+        model.to(device)
+        model.train()
+        sync()
+        result["load_seconds"] = time.monotonic() - started_load
+        event("model_load_completed", duration_seconds=result["load_seconds"], initial_p0_tensors_match=True, base_frozen=True)
+        if resource:
+            resource("after_model_load")
+        optimizer = torch.optim.AdamW((p for p in model.parameters() if p.requires_grad), lr=config["learning_rate"], weight_decay=config["weight_decay"], betas=(config["adam_beta1"], config["adam_beta2"]), eps=config["adam_epsilon"], fused=True)
+        if optimizer.defaults.get("fused") is not True or optimizer.state:
+            raise ContractError("engineering fused fresh optimizer invariant")
+        vocab = model.config.vocab_size
