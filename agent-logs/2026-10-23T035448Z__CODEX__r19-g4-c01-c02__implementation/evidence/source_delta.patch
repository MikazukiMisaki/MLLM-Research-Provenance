+"""Software fixtures only: no supervisor, model, ALFWorld, or scientific run.
+
+The receipt unit fixtures emulate live wire fields to test that consumer. Their
+contents and return values are never published as authentic live evidence. The
+separate source-to-report CLI stays explicitly synthetic throughout.
+"""
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import runpy
+import subprocess
+import sys
+
+import pytest
+
+from recovery.r19_duration import EvidenceIntegrityError, sha256_file, sha256_json
+from scripts import analyze_r19_recovery_duration as analyzer
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, indent=2) + '\n')
+
+
+def runtime_v2():
+    # Frozen producer's nested format. Metadata are explicitly synthetic.
+    return {
+        'schema_version': 'r19_inference_runtime_manifest_v2',
+        'python': 'synthetic', 'packages': {}, 'gpu': {'name': 'synthetic'},
+        'device': {'precision': 'bfloat16'},
+        'inference': {'transport': 'local_transformers', 'local_files_only': True,
+                      'external_model_calls': False,
+                      'generation': 'greedy; thinking disabled; synchronized per-generation latency',
+                      'offline_environment': {'HF_HUB_OFFLINE': '1', 'TRANSFORMERS_OFFLINE': '1'}},
+    }
+
+
+@pytest.mark.parametrize('version', [1, 2])
+def test_explicit_runtime_versions_preserve_raw_document(version):
+    runtime = runtime_v2() if version == 2 else {
+        'schema_version': 'r19_inference_runtime_manifest_v1', 'local_files_only': True,
+        'inference_transport': 'local_transformers', 'external_model_calls': False}
+    original = copy.deepcopy(runtime)
+    before = sha256_json(runtime)
+    analyzer._validate_local_inference_runtime(runtime)
+    assert runtime == original and sha256_json(runtime) == before
+
+
+@pytest.mark.parametrize('mutation', [
+    'missing-schema', 'unknown-schema', 'missing-inference', 'null-inference',
+    'list-inference', 'string-inference', 'missing-local', 'missing-external',
+    'missing-transport', 'local-false', 'local-string', 'local-integer',
+    'external-true', 'external-string', 'external-integer', 'transport',
+    'mixed-consistent', 'mixed-conflicting', 'mixed-transport', 'nested-transport', 'v1-nested', 'v1-local-integer',
+    'v1-external-integer', 'v1-transport', 'nonobject',
+])
+def test_runtime_shape_and_local_only_negatives(mutation):
+    runtime = runtime_v2()
+    inference = runtime['inference']
+    if mutation == 'missing-schema':
+        del runtime['schema_version']
+    elif mutation == 'unknown-schema':
+        runtime['schema_version'] = 'r19_inference_runtime_manifest_v3'
+    elif mutation == 'missing-inference':
+        del runtime['inference']
+    elif mutation.endswith('-inference'):
+        runtime['inference'] = {'null': None, 'list': [], 'string': 'local'}[mutation.split('-')[0]]
+    elif mutation.startswith('missing-'):
+        del inference[{'missing-local': 'local_files_only', 'missing-external': 'external_model_calls',
+                       'missing-transport': 'transport'}[mutation]]
+    elif mutation.startswith('local-'):
+        inference['local_files_only'] = {'false': False, 'string': 'true', 'integer': 1}[mutation.split('-')[1]]
+    elif mutation.startswith('external-'):
+        inference['external_model_calls'] = {'true': True, 'string': 'false', 'integer': 0}[mutation.split('-')[1]]
+    elif mutation == 'transport':
+        inference['transport'] = 'external'
+    elif mutation == 'nested-transport':
+        inference['inference_transport'] = 'external'
+    elif mutation == 'mixed-transport':
+        runtime['transport'] = 'external'
+    elif mutation.startswith('mixed-'):
+        runtime['local_files_only'] = mutation == 'mixed-consistent'
+    elif mutation.startswith('v1-'):
+        runtime = {'schema_version': 'r19_inference_runtime_manifest_v1', 'local_files_only': True,
+                   'inference_transport': 'local_transformers', 'external_model_calls': False}
+        if mutation == 'v1-nested':
+            runtime['inference'] = inference
+        else:
+            runtime[{'v1-local-integer': 'local_files_only', 'v1-external-integer': 'external_model_calls',
+                     'v1-transport': 'inference_transport'}[mutation]] = {
+                         'v1-local-integer': 1, 'v1-external-integer': 0, 'v1-transport': 'remote'}[mutation]
+    else:
+        runtime = []
+    with pytest.raises(EvidenceIntegrityError):
+        analyzer._validate_local_inference_runtime(runtime)
+
+
+def synthetic_receipt_bundle(tmp_path):
+    """Persist wire-format unit inputs; never execute the recorded command."""
+    output = tmp_path / 'synthetic-contract-output'
+    record = tmp_path / 'synthetic-contract-supervisor'
+    output.mkdir()
