+
+def test_v2_source_software_gate_produces_only_bound_zero_science_receipt(tmp_path):
+    a,p,ap,pp,save=gate_fixture(tmp_path,REPO);a['schema']='SI_S01_AUTHORIZATION_V2';a['resource_policy']=binding();a['environment']['PYTORCH_CUDA_ALLOC_CONF']='backend:native'
+    review=Path(a['review']['path']);v=json.loads(review.read_text());v.update(schema='SI_S01_INDEPENDENT_REVIEW_V2',resource_policy=binding());review.write_text(canonical(v));a['review']=file_binding(review)
+    r=subprocess.run(save(),cwd=REPO,env=a['environment'],capture_output=True,timeout=30)
+    (tmp_path/'software_gate.stdout').write_bytes(r.stdout);(tmp_path/'software_gate.stderr').write_bytes(r.stderr)
+    assert r.returncode==0,r.stderr.decode();receipt=json.loads(Path(a['preflight_receipt_path']).read_text())
+    assert receipt['schema']=='SI_S01_PREFLIGHT_RECEIPT_V2' and receipt['binding']['resource_policy']==binding() and all(type(v) is int and v==0 for v in receipt['counters'].values())
+    assert not Path(a['output_path']).exists()
+
+
+@pytest.mark.parametrize('attack',['V1_shared','missing','unknown','hash','claim','boolean_type','backend','uncached0'])
+def test_resource_authority_schema_negatives_have_no_cuda_side_effects(tmp_path,monkeypatch,attack):
