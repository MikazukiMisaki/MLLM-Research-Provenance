+            raw=self.call(j,'generation',lambda:producer.generate(p),z|{'generations':1,'input_tokens':len(p['input_ids']),'output_tokens':OUTPUT_CAP},prepared=p)
+            validate_generation(raw,p,arm='A',adapter_sha256=self.adapter_sha256,eos_ids=producer.eos_ids,decode=producer.decode)
+            parsed=parse_p2_selection(raw['raw_output'],state.valid_actions,reflection_required=False);parse_status=parsed.selection_status
