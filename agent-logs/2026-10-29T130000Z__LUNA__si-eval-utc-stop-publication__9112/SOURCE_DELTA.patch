+"""Authentic model-free static preflight subprocess receipt."""
+from __future__ import annotations
+import hashlib,json,os,subprocess,time
+from pathlib import Path
+from .evaluator import _need
+
+
+def supervise_preflight(argv: list[str], *, cwd: Path, auth_sha256: str, source_sha: str,
+                        receipt_path: Path, record_dir: Path, timeout_seconds: int) -> dict:
+    _need(type(argv) is list and bool(argv) and all(type(x) is str for x in argv), 'preflight subprocess argv')
+    _need(type(timeout_seconds) is int and 0<timeout_seconds<=900, 'bounded preflight timeout')
+    _need(not receipt_path.exists() and not receipt_path.is_symlink(), 'fresh preflight receipt')
+    record_dir.mkdir(mode=0o700,parents=False,exist_ok=False)
+    stdout_path=record_dir/'stdout';stderr_path=record_dir/'stderr'
+    started=time.monotonic();pid=None;tick=None;timed_out=False;code=None;failure=None
+    with stdout_path.open('xb') as out,stderr_path.open('xb') as err:
+        try:
+            p=subprocess.Popen(argv,cwd=cwd,stdout=out,stderr=err,start_new_session=True)
+            pid=p.pid
+            try:tick=int((Path('/proc')/str(pid)/'stat').read_text().rsplit(')',1)[1].split()[19])
+            except (OSError,ValueError,IndexError):tick=None
+            try:code=p.wait(timeout=timeout_seconds)
+            except subprocess.TimeoutExpired:
+                timed_out=True;os.killpg(p.pid,9);code=p.wait()
+        except BaseException as exc:failure={'type':type(exc).__name__,'message':str(exc)}
+    receipt_sha=hashlib.sha256(receipt_path.read_bytes()).hexdigest() if receipt_path.is_file() else None
+    row={'schema':'SI_U1_PREFLIGHT_EXECUTION_V1','authentic_returncode':code,'authorization_sha256':auth_sha256,
+         'preflight_receipt_sha256':receipt_sha,'argv':argv,'source_sha':source_sha,'cwd':str(cwd),
+         'child_pid':pid,'child_start_tick':tick,'timed_out':timed_out,'supervisor_error':failure,
+         'stdout_sha256':hashlib.sha256(stdout_path.read_bytes()).hexdigest(),'stderr_sha256':hashlib.sha256(stderr_path.read_bytes()).hexdigest(),
+         'elapsed_seconds':time.monotonic()-started}
+    path=record_dir/'preflight_execution.json'
+    with path.open('x',encoding='utf-8') as f:
+        f.write(json.dumps(row,sort_keys=True,separators=(',',':'))+'\n');f.flush();os.fsync(f.fileno())
+    return row
