+"""Fail-closed three-arm evaluator core; external edges are injected software ports.
+
+No model, ALFWorld or CUDA driver is exposed by this module. A separate reviewed
+live supervisor must authenticate all paths, adapters, costs and package origins.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import time
+from pathlib import Path
+from typing import Any, Mapping
+
+from models.action_parser import action_id_mapping
+from models.protocol_stability import parse_p2_selection
+from self_improvement.si_p3.contract import PublicState, projection
+
+ARMS = ("A", "B", "C")
+HORIZON = 50
+OUTPUT_CAP = 16
+DEV_SEEDS = {1005, 1009, 1010, 1022, 1027}
+COUNTERS = ("generations", "environment_operations", "input_tokens", "output_tokens")
+
+class EvaluationError(ValueError):
+    pass
+
+
+def _need(condition: bool, message: str) -> None:
+    if not condition:
+        raise EvaluationError(message)
+
+
+def _wire(value: Any) -> str:
+    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _hash(value: Any) -> str:
+    return hashlib.sha256(_wire(value).encode()).hexdigest()
+
+
+def _valid_hash(value: Any) -> bool:
+    return type(value) is str and len(value) == 64 and all(c in "0123456789abcdef" for c in value)
+
+
+def validate_manifest(manifest: Mapping[str, Any]) -> dict[str, Any]:
+    """Check declarations; independently verified real provenance is a separate gate."""
+    m = json.loads(_wire(manifest))
+    _need(set(m) == {"schema", "heldout", "tasks", "excluded_task_parents", "adapters", "limits", "arm_limits"}, "manifest fields")
+    _need(m["schema"] == "SI_TRANSFER_EVAL_V1" and type(m["heldout"]) is bool, "manifest schema")
+    tasks = m["tasks"]
+    _need(type(tasks) is list and bool(tasks), "nonempty task schedule required")
+    _need(type(m["excluded_task_parents"]) is list and all(type(x) is str and x for x in m["excluded_task_parents"]), "exclusion names")
+    excluded = set(m["excluded_task_parents"])
+    identities, parents, game_hashes = set(), set(), set()
+    for t in tasks:
+        _need(type(t) is dict and set(t) == {"task_id", "family", "seed", "game_sha256"}, "task shape")
+        _need(type(t["task_id"]) is str and "/" in t["task_id"] and type(t["family"]) is str and bool(t["family"]), "task identity")
+        _need(type(t["seed"]) is int and t["seed"] >= 0 and (not m["heldout"] or t["seed"] not in DEV_SEEDS), "seed")
+        _need(_valid_hash(t["game_sha256"]) and t["game_sha256"] not in game_hashes, "duplicate/invalid game identity")
+        game_hashes.add(t["game_sha256"])
+        parent = t["task_id"].split("/", 1)[0]
+        _need(t["task_id"] not in identities and parent not in parents and parent not in excluded, "duplicate or excluded task parent")
+        identities.add(t["task_id"]); parents.add(parent)
+    _need(type(m["adapters"]) is dict and set(m["adapters"]) == set(ARMS), "three adapter declarations")
+    _need(all(_valid_hash(m["adapters"][a]) for a in ARMS), "adapter digest")
+    limits = m["limits"]
+    _need(type(limits) is dict and set(limits) == set(COUNTERS) | {"per_call_input", "elapsed_seconds"}, "budget fields")
+    _need(all(type(limits[k]) is int and limits[k] > 0 for k in limits), "budget values")
+    arms = m["arm_limits"]
+    _need(type(arms) is dict and set(arms) == set(COUNTERS) | {"elapsed_seconds"}, "per-arm budget fields")
+    _need(all(type(arms[k]) is int and arms[k] > 0 for k in arms), "per-arm budget values")
+    _need(all(arms[k] <= limits[k] for k in COUNTERS) and arms['elapsed_seconds'] <= limits['elapsed_seconds'], "per-arm caps exceed overall")
+    return m
+
+
+def validate_generation(raw: Any, prepared: Mapping[str, Any], *, arm: str, adapter_sha256: str, eos_ids, decode) -> None:
+    keys = {"prompt", "rendered_prompt", "rendered_prompt_sha256", "raw_output", "token_ids", "token_ids_sha256", "input_tokens", "generated_tokens", "latency_seconds", "output_complete", "token_cap_reached", "max_new_tokens", "do_sample", "thinking", "adapter_mode", "adapter_sha256"}
+    _need(type(raw) is dict and set(raw) == keys, "raw producer schema")
+    ids = raw["token_ids"]
+    _need(type(ids) is list and 0 < len(ids) <= OUTPUT_CAP and all(type(i) is int and i >= 0 for i in ids), "raw token ids")
+    text_hash = lambda s: hashlib.sha256(s.encode()).hexdigest()
+    _need(raw["prompt"] == prepared["prompt"] and raw["rendered_prompt"] == prepared["rendered_prompt"] and raw["rendered_prompt_sha256"] == text_hash(prepared["rendered_prompt"]), "raw prompt binding")
+    _need(raw["token_ids_sha256"] == text_hash(json.dumps(ids, separators=(",", ":"))) and decode(ids) == raw["raw_output"], "token hash/decode")
+    _need(raw["input_tokens"] == len(prepared["input_ids"]) and raw["generated_tokens"] == len(ids), "raw token accounting")
+    _need(raw["adapter_mode"] == arm and raw["adapter_sha256"] == adapter_sha256, "raw adapter binding")
+    _need(raw["do_sample"] is False and raw["thinking"] is False and raw["max_new_tokens"] == OUTPUT_CAP, "decoding")
+    _need(type(raw["latency_seconds"]) in (int, float) and math.isfinite(raw["latency_seconds"]) and raw["latency_seconds"] >= 0, "generation latency")
+    _need(type(raw["output_complete"]) is bool and type(raw["token_cap_reached"]) is bool and raw["token_cap_reached"] == (len(ids) == OUTPUT_CAP) and raw["output_complete"] == (len(ids) < OUTPUT_CAP or ids[-1] in eos_ids), "completion/EOS")
+
+
+class Journal:
+    def __init__(self, path: Path, header: Mapping[str, Any]):
+        self.f = Path(path).open("x", encoding="utf-8")
+        self.previous = None
+        self.sequence = 0
+        self.append("run_opened", header)
+
+    def append(self, kind: str, payload: Mapping[str, Any]) -> str:
+        row = {"sequence": self.sequence, "previous": self.previous, "kind": kind,
+               "payload": payload, "monotonic": time.monotonic()}
+        row["event_id"] = _hash(row)
+        self.f.write(_wire(row) + "\n"); self.f.flush(); os.fsync(self.f.fileno())
+        self.sequence += 1; self.previous = row["event_id"]
+        return row["event_id"]
+
+    def close(self) -> None:
+        self.f.close()
+
+
+class Evaluator:
+    """Ports: producer.prepare/generate/close, env.reset/step/close; software only."""
+    def __init__(self, manifest: Mapping[str, Any], output: Path, *, producer_factory, environment_factory,
+                 evidence_class: str = "synthetic", allocation_started_at: float | None = None, live_permit=None):
+        if evidence_class == "live":
+            from .live_gate import WorkerPermit
+            _need(isinstance(live_permit, WorkerPermit) and Path(output)==live_permit.live.output/'evaluation' and dict(manifest)==live_permit.live.manifest and allocation_started_at==live_permit.allocation_started_monotonic, "authenticated live worker required")
+        else:
+            _need(evidence_class == "synthetic" and live_permit is None, "invalid evaluator mode")
+        self.manifest = validate_manifest(manifest)
+        self.output = Path(output)
+        self.producer_factory = producer_factory
+        self.environment_factory = environment_factory
+        self.evidence_class = evidence_class; self.live_permit = live_permit
+        self.used = {k: 0 for k in COUNTERS}; self.completed = {k: 0 for k in COUNTERS}
+        self.arm_used = {a: dict.fromkeys(COUNTERS, 0) for a in ARMS}; self.arm_completed = {a: dict.fromkeys(COUNTERS, 0) for a in ARMS}; self.arm_started_at = None
+        self.active = None; self.active_identity = None; self.return_events = {}; self.units = set(); self.started = False; self.started_at = None; self.allocation_started_at = allocation_started_at
+
+    def _call(self, journal: Journal, identity: Mapping[str, Any], fn, debit: Mapping[str, int], *, prepared=None, request=None) -> Any:
+        _need(self.active is None, "overlapping physical units")
+        if identity["op"] not in ("environment_close", "model_close"):
+            _need(self.started_at is not None and time.monotonic() - self.started_at <= self.manifest["limits"]["elapsed_seconds"], "elapsed time cap")
+            _need(self.arm_started_at is not None and time.monotonic() - self.arm_started_at <= self.manifest["arm_limits"]["elapsed_seconds"], "per-arm elapsed time cap")
+        unit = _hash(identity)
+        _need(unit not in self.units, "repeated unit forbidden")
+        _need(all(self.used[k] + debit[k] <= self.manifest["limits"][k] for k in COUNTERS), "budget exhausted before call")
+        _need(all(self.arm_used[identity["arm"]][k] + debit[k] <= self.manifest["arm_limits"][k] for k in COUNTERS), "per-arm budget exhausted before call")
+        if identity["op"] == "generation":
+            _need(debit["input_tokens"] <= self.manifest["limits"]["per_call_input"], "per-call input cap")
+        self.units.add(unit); self.used = {k: self.used[k] + debit[k] for k in COUNTERS}; self.arm_used[identity["arm"]] = {k: self.arm_used[identity["arm"]][k] + debit[k] for k in COUNTERS}; self.active = unit; self.active_identity = dict(identity); self.return_events[unit]=[]
+        started = journal.append("unit_started", {"identity": identity, "unit": unit, "reservation": debit, "prepared": prepared, "request": request})
+        try:
+            result = fn()
+            actual = dict(debit)
+            if identity["op"] == "generation":
+                _need(type(result) is dict and type(result.get("token_ids")) is list, "raw generation receipt")
+                actual["output_tokens"] = len(result["token_ids"])
+                _need(0 < actual["output_tokens"] <= OUTPUT_CAP, "output cap")
+            journal.append("unit_completed", {"identity": identity, "unit": unit, "started_event": started, "data": result, "actual": actual, "return_events": list(self.return_events[unit])})
+            self.used["output_tokens"] -= debit["output_tokens"] - actual["output_tokens"]
+            self.arm_used[identity["arm"]]["output_tokens"] -= debit["output_tokens"] - actual["output_tokens"]
+            self.arm_completed[identity["arm"]] = {k: self.arm_completed[identity["arm"]][k] + actual[k] for k in COUNTERS}
+            self.completed = {k: self.completed[k] + actual[k] for k in COUNTERS}
+            return result
+        except BaseException as error:
+            journal.append("unit_failed", {"identity": identity, "unit": unit, "started_event": started,
+                           "exception": type(error).__name__, "message": str(error),
+                           "raw_evidence": getattr(error, "raw_evidence", None), "resource_evidence": getattr(error, "resource_evidence", None), "return_events": list(self.return_events[unit])})
+            raise
+        finally:
+            self.active = None; self.active_identity = None
+
+    def run(self) -> dict[str, Any]:
+        _need(not self.started, "automatic rerun forbidden"); self.started = True
+        now = time.monotonic(); self.started_at = now if self.allocation_started_at is None else self.allocation_started_at
+        _need(type(self.started_at) in (int,float) and math.isfinite(self.started_at) and self.started_at <= now, "allocation start clock")
+        self.output.mkdir(parents=False, exist_ok=False)
+        journal = Journal(self.output / "events.jsonl", {"schema": "SI_TRANSFER_EVAL_EVENTS_V1", "evidence_class": self.evidence_class,
+                          "manifest": self.manifest, "manifest_sha256": _hash(self.manifest), "horizon": HORIZON, "output_cap": OUTPUT_CAP, "live_binding": ({"binding": self.live_permit.live.binding, "launch_context_sha256": self.live_permit.launch_context_sha256, "worker_start_sha256": self.live_permit.worker_start_sha256} if self.evidence_class == "live" else None)})
+        def record_return(boundary, data):
+            _need(self.active is not None and self.active_identity is not None, "returned boundary requires active reserved unit")
+            event=journal.append('external_returned', {'unit':self.active,'identity':self.active_identity,'boundary':boundary,'data':data})
+            self.return_events[self.active].append(event)
+        rows = []; stop = None
+        zero = dict.fromkeys(COUNTERS, 0)
+        try:
+            for arm in ARMS:
+                self.arm_started_at = self.started_at if arm == "A" else time.monotonic()
+                journal.append("arm_started", {"arm": arm, "started_monotonic": self.arm_started_at})
+                producer = None
+                try:
+                    holder = {}
+                    def load():
+                        holder["producer"] = self.producer_factory(arm, self.manifest["adapters"][arm])
+                        return {"adapter_sha256": self.manifest["adapters"][arm]}
+                    self._call(journal, {"arm": arm, "op": "model_load"}, load, zero)
+                    producer = holder["producer"]
+                    if callable(getattr(producer,'attach_recorder',None)):producer.attach_recorder(record_return)
+                    else:_need(self.evidence_class=='synthetic', 'live generation recorder required')
+                    for task in self.manifest["tasks"]:
+                        task_id = task["task_id"]
+                        env = None
+                        try:
+                            holder = {}
+                            def construct():
+                                holder["env"] = self.environment_factory(task)
+                                proof=getattr(holder["env"],"initialization",None) if self.evidence_class=="live" else {"synthetic_software_fixture":True}
+                                _need(type(proof) is dict, "environment initialization evidence")
+                                return {"task_id": task_id, "game_sha256": task["game_sha256"], "environment_evidence": proof}
+                            self._call(journal, {"arm": arm, "task_id": task_id, "op": "environment_construct"}, construct, zero)
+                            env = holder["env"]
+                            if callable(getattr(env,'attach_recorder',None)):env.attach_recorder(record_return)
+                            else:_need(self.evidence_class=='synthetic', 'live environment recorder required')
+                            reset = self._call(journal, {"arm": arm, "task_id": task_id, "op": "reset"},
+                                lambda: env.reset(seed=task["seed"]).to_dict(), zero | {"environment_operations": 1})
+                            state = PublicState.from_dict(reset)
+                            _need((state.task_id, state.family) == (task_id, task["family"]) and not state.ended and state.reward == 0, "reset identity/state")
+                            history = []; termination = None
+                            for index in range(HORIZON):
+                                if state.ended:
+                                    termination = "terminal" if state.done else "truncated"; break
+                                _need(bool(state.valid_actions), "empty action map")
+                                public = projection(state, history)
+                                prepared = producer.prepare(public["public_prompt"])
+                                _need(type(prepared) is dict and set(prepared) == {"prompt", "rendered_prompt", "input_ids", "attention_mask"}, "prepared envelope")
+                                _need(prepared["prompt"] == public["public_prompt"] and type(prepared["input_ids"]) is list and bool(prepared["input_ids"]) and all(type(i) is int and i >= 0 for i in prepared["input_ids"]) and prepared["attention_mask"] == [1] * len(prepared["input_ids"]), "prepared prompt/tensors")
+                                raw = self._call(journal, {"arm": arm, "task_id": task_id, "op": "generation", "index": index},
+                                    lambda: producer.generate(prepared), zero | {"generations": 1, "input_tokens": len(prepared["input_ids"]), "output_tokens": OUTPUT_CAP}, prepared=prepared)
+                                validate_generation(raw, prepared, arm=arm, adapter_sha256=self.manifest["adapters"][arm], eos_ids=producer.eos_ids, decode=producer.decode)
+                                parsed = parse_p2_selection(raw["raw_output"], state.valid_actions, reflection_required=False)
+                                if parsed.selection_status != "selected":
+                                    termination = "selection_failure"
+                                    break
+                                _need(action_id_mapping(state.valid_actions).get(parsed.action_id) == parsed.action, "selected action/map conflict")
+                                before = state
+                                step = self._call(journal, {"arm": arm, "task_id": task_id, "op": "step", "index": index},
+                                    lambda: env.step(parsed.action).to_dict(), zero | {"environment_operations": 1}, request={"action_id": parsed.action_id, "command": parsed.action, "action_map": action_id_mapping(before.valid_actions)})
+                                state = PublicState.from_dict(step)
+                                _need((state.task_id, state.family, state.goal) == (before.task_id, before.family, before.goal), "transition identity drift")
+                                history.append((before.observation, parsed.action))
+                            if state.ended:
+                                termination = "terminal" if state.done else "truncated"
+                            elif termination is None:
+                                termination = "horizon"
+                            _need(termination != "truncated", "truncated outcome is unknown; stop entire comparison")
+                            # Selection failure and full horizon are fixed protocol failures.
+                            success = int(state.done and state.reward > 0) if state.done else (0 if termination in ("horizon", "selection_failure") else None)
+                            row = {"arm": arm, "task_id": task_id, "family": task["family"], "seed": task["seed"],
+                                   "outcome": success, "termination": termination, "steps": len(history), "end_state": state.to_dict()}
+                            rows.append(row); journal.append("episode_closed", row)
+                        finally:
+                            if env is not None:
+                                self._call(journal, {"arm": arm, "task_id": task_id, "op": "environment_close"}, lambda: (env.close() or {"closed": True}), zero)
+                finally:
+                    if producer is not None:
+                        self._call(journal, {"arm": arm, "op": "model_close"}, lambda: (producer.close() or {"closed": True}), zero)
+                ended = time.monotonic()
+                _need(ended - self.arm_started_at <= self.manifest["arm_limits"]["elapsed_seconds"] and ended - self.started_at <= self.manifest["limits"]["elapsed_seconds"], "elapsed cap including cleanup")
+                journal.append("arm_finished", {"arm": arm, "ended_monotonic": ended})
+        except BaseException as exc:
+            stop = {"type": type(exc).__name__, "message": str(exc)}
+            journal.append("run_stopped", stop)
+        finally:
+            report = {"schema": "SI_TRANSFER_EVAL_REPORT_V1", "evidence_class": self.evidence_class,
+                      "manifest_sha256": _hash(self.manifest), "status": "COMPLETE" if stop is None else "STOPPED",
+                      "episodes": rows, "pending_na": [{"arm": a, "task_id": t["task_id"], "outcome": None} for a in ARMS for t in self.manifest["tasks"] if (a, t["task_id"]) not in {(r["arm"], r["task_id"]) for r in rows}], "stop": stop, "reserved_or_spent": self.used, "completed": self.completed, "arm_reserved_or_spent": self.arm_used, "arm_completed": self.arm_completed}
+            journal.append("run_closed", report); journal.close()
+            with (self.output / "report.json").open("x", encoding="utf-8") as f:
+                f.write(_wire(report) + "\n"); f.flush(); os.fsync(f.fileno())
