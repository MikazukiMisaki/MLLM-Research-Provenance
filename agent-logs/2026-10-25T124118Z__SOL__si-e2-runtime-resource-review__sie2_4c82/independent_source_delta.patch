+
+
+def raw_generate_edge(model,torch,*,fail=False):
+    calls=[]
+    def generate(**kwargs):
+        from self_improvement.si_p3.runtime_backend import adapter_state
+        calls.append({'input_ids':kwargs['input_ids'].clone(),'attention_mask':kwargs['attention_mask'].clone(),
+                      'adapter':adapter_state(model),'options':{k:v for k,v in kwargs.items() if k not in ('input_ids','attention_mask')}})
+        if fail:raise RuntimeError('synthetic generation boundary failure')
+        ids=torch.tensor([[3,1]],dtype=torch.long)
+        return SimpleNamespace(sequences=torch.cat([kwargs['input_ids'],ids],dim=1),scores=(None,None))
+    model.generate=generate
