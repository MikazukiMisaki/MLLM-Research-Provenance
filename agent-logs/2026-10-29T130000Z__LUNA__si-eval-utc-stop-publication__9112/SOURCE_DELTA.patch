+    file_binding(spec['isolation_proof'])  # The frozen protocol separately binds and validates this review.
+    inputs=spec['isolation_inputs']; _need(type(inputs) is dict and set(inputs)=={'b_dataset','c_dataset','known_use_registry','source_usage','reservation','game_manifest'}, 'isolation input bindings')
+    for row in inputs.values():file_binding(row)
+    env=spec['environment']
+    _need(type(env) is dict and set(env)=={'config','data_root','pool_seed','logic_files'}, 'environment binding')
+    file_binding(env['config']); _need(Path(env['data_root']).is_absolute() and Path(env['data_root']).is_dir() and env['pool_seed']==42, 'environment root/seed')
+    _need(type(env['logic_files']) is dict and set(env['logic_files'])=={'domain','grammar'}, 'environment logic binding')
+    for row in env['logic_files'].values(): file_binding(row)
+    adapters = spec['adapters'];_need(type(adapters) is dict and set(adapters) == set(ARMS), 'adapter binding arms')
+    train_bindings = {}
+    for arm in ARMS:
