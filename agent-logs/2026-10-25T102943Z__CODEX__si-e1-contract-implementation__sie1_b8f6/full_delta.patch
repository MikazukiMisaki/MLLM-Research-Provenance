index 0000000..0b24897
--- /dev/null
+++ b/src/self_improvement/si_p3/evidence.py
@@ -0,0 +1,250 @@
+"""Append-only unit receipts and conservative pre-call resource reservations."""
+from __future__ import annotations
+
+import json
+import math
+import os
+import time
+import uuid
+from collections import Counter
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Callable, Mapping
+
+from .contract import CONTRACT_FILE_SHA256, CAPS, PublicState, Slot, VERSION, canonical, digest, integer, require, software_only
+
+
+class Journal:
+    """Fresh run only; an existing or partially written run cannot be retried."""
+    def __init__(self, path: Path, *, plan_sha256: str, evidence_class: str) -> None:
+        software_only(evidence_class)
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self._handle = self.path.open("x", encoding="utf-8")
+        self.events: list[dict[str, Any]] = []
+        self.run_id = uuid.uuid4().hex
+        self.append("run_opened", {"schema": VERSION, "run_id": self.run_id, "evidence_class": evidence_class,
+                                  "plan_sha256": plan_sha256, "contract_sha256": CONTRACT_FILE_SHA256, "execution_authorized": False})
+
+    def append(self, kind: str, payload: Mapping[str, Any]) -> str:
+        row = {"sequence": len(self.events), "previous": self.events[-1]["event_id"] if self.events else None,
+               "kind": kind, "payload": json.loads(canonical(payload))}
+        row["event_id"] = digest(row)
+        self._handle.write(canonical(row) + "\n")
+        self._handle.flush()
+        os.fsync(self._handle.fileno())
+        self.events.append(row)
+        return row["event_id"]
+
+    def close(self) -> None:
+        self._handle.close()
+
+
+def validate_journal(events: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
+    require(bool(events), "empty journal")
+    run_id = events[0]["payload"].get("run_id")
+    require(type(run_id) is str and len(run_id) == 32 and all(c in "0123456789abcdef" for c in run_id), "journal run identity")
+    previous = None
+    index = {}
+    states = {}
+    for sequence, row in enumerate(events):
+        require(set(row) == {"sequence", "previous", "kind", "payload", "event_id"}, "journal shape")
+        body = {k: v for k, v in row.items() if k != "event_id"}
+        require(row["sequence"] == sequence and row["previous"] == previous and row["event_id"] == digest(body),
+                "journal sequence/hash chain")
+        require(row["event_id"] not in index, "duplicate receipt")
+        previous = row["event_id"]
+        index[previous] = row
+        if row["kind"].startswith("unit_"):
+            p = row["payload"]
+            unit = p["unit"]
+            if row["kind"] == "unit_started":
+                require(unit not in states, "unit retry/duplicate start")
+                require(set(p["identity"]) == {"slot", "task_id", "phase", "index", "operation"}, "unit identity fields")
+                require(unit == digest([run_id, p["identity"]]), "unit identity digest")
+                states[unit] = row
+            else:
+                require(row["kind"] in ("unit_completed", "unit_failed") and unit in states and
+                        states[unit]["kind"] == "unit_started", "orphan/duplicate unit completion")
+                require(p["started_event"] == states[unit]["event_id"], "unit start receipt binding")
+                require(p["identity"] == states[unit]["payload"]["identity"], "unit operation identity changed")
+                states[unit] = row
+    header = events[0]
+    require(header["kind"] == "run_opened" and header["payload"]["schema"] == VERSION and
+            header["payload"]["evidence_class"] == "synthetic" and
+            header["payload"]["execution_authorized"] is False and header["payload"]["contract_sha256"] == CONTRACT_FILE_SHA256, "journal authorization boundary")
+    return index
+
+
+class UnitRegistry:
+    """Online run/task/kind/start binding, in addition to the consumer audit."""
+    def __init__(self, journal: Journal) -> None:
+        self.journal = journal
+        self.states: dict[str, str] = {}
+        self.starts: dict[str, tuple[dict[str, Any], str]] = {}
+        self.completed_events: dict[str, dict[str, Any]] = {}
+        self.slots: dict[str, Slot] = {}
+
+    def _slot(self, identity: Mapping[str, Any]) -> Slot:
+        if not self.slots:
+            self.slots = {row["payload"]["slot_key"]: Slot(**row["payload"]["slot"])
+                          for row in self.journal.events if row["kind"] == "slot_planned"}
+        require(set(identity) == {"slot", "task_id", "phase", "index", "operation"}, "unit identity fields")
+        require(identity["slot"] in self.slots, "unplanned slot/run")
+        slot = self.slots[identity["slot"]]
+        require(slot.key == identity["slot"] and slot.task_id == identity["task_id"], "unit task/seed identity")
+        phase, op, index = identity["phase"], identity["operation"], identity["index"]
+        require(integer(index), "operation index")
+        allowed = {"source": {"reset", "generation", "step"}, "replay": {"reset", "step"},
+                   "stage_one": {"generation"}, "stage_two": {"generation"}, "teacher": {"step"},
+                   "suffix": {"generation", "step"}}
+        require(phase in allowed and op in allowed[phase], "cross-kind operation")
+        require((op == "reset" and index == 0) or
+                (op != "reset" and phase == "source" and index < 50) or
+                (op == "step" and phase == "replay" and index < slot.cutoff) or
+                (phase in {"stage_one", "stage_two", "teacher"} and index == slot.cutoff) or
+                (phase == "suffix" and slot.cutoff + 1 <= index < 50), "phase/cutoff index")
+        return slot
+
+    def start(self, identity: Mapping[str, Any], reservation: Mapping[str, Any]) -> tuple[str, str]:
+        self._slot(identity)
+        unit = digest([self.journal.run_id, identity])
+        require(unit not in self.states, "physical unit already attempted; no retry")
+        event = self.journal.append("unit_started", {"unit": unit, "identity": identity, "reservation": reservation})
+        self.states[unit] = "started"
+        self.starts[unit] = (dict(identity), event)
+        return unit, event
+
+    def _data_contract(self, identity: Mapping[str, Any], data: Mapping[str, Any]) -> None:
+        from models.action_parser import action_id_mapping
+        slot = self._slot(identity)
+        op, phase = identity["operation"], identity["phase"]
+        if op == "reset":
+            require(set(data) == {"session", "seed", "state"} and data["seed"] == slot.seed and
+                    data["session"] == digest([slot.key, phase]), "reset run/task/seed receipt")
+            states = [data["state"]]
+        elif op == "generation":
+            require(set(data) == {"prepared", "raw", "eos_ids", "state", "parsed"}, "cross-kind generation receipt")
+            require(data["raw"]["max_new_tokens"] == CAPS[phase], "phase generation cap")
+            states = [data["state"]]
+        else:
+            require(set(data) == {"session", "before", "after", "command", "action_id", "action_map", "generation_event", "source_step"},
+                    "cross-kind step receipt")
+            require(data["session"] == digest([slot.key, "source" if phase == "source" else "replay"]), "step session")
+            before = PublicState.from_dict(data["before"])
+            require(data["action_map"] == action_id_mapping(before.valid_actions) and
+                    data["action_id"] in data["action_map"] and data["action_map"][data["action_id"]] == data["command"],
+                    "Action-ID map receipt")
+            reference = data["source_step"] if phase == "replay" else data["generation_event"]
+            require(reference in self.completed_events, "foreign run/missing action source receipt")
+            proof = self.completed_events[reference]
+            expected_phase = "source" if phase == "replay" else "stage_two" if phase == "teacher" else phase
+            expected_op = "step" if phase == "replay" else "generation"
+            expected = dict(identity) | {"phase": expected_phase, "operation": expected_op}
+            require(proof["identity"] == expected, "action source task/kind/index receipt")
+            if phase == "replay":
+                require(data["generation_event"] is None and proof["data"]["before"] == data["before"] and proof["data"]["action_id"] == data["action_id"] and
+                        proof["data"]["command"] == data["command"], "replay original action binding")
+            else:
+                require(data["source_step"] is None and proof["data"]["state"] == data["before"] and proof["data"]["parsed"]["status"] == "selected" and
+                        proof["data"]["parsed"]["action_id"] == data["action_id"] and
+                        proof["data"]["parsed"]["command"] == data["command"], "selected generation binding")
+            states = [data["before"], data["after"]]
+        for wire in states:
+            state = PublicState.from_dict(wire)
+            require(state.task_id == slot.task_id and state.family == slot.family, "receipt public task/family")
+
+    def finish(self, identity: Mapping[str, Any], unit: str, started: str,
+               data: Mapping[str, Any], *, failed: bool = False) -> str:
+        require(self.states.get(unit) == "started", "unit is not open")
+        require(unit == digest([self.journal.run_id, identity]) and
+                self.starts[unit] == (dict(identity), started), "completion wrong run/task/kind/start")
+        if not failed:
+            self._data_contract(identity, data)
+        else:
+            require(type(data.get("exception")) is str and type(data.get("message")) is str, "failure receipt")
+        kind = "unit_failed" if failed else "unit_completed"
+        payload = {"unit": unit, "identity": identity, "started_event": started, "data": data}
+        event = self.journal.append(kind, payload)
+        self.states[unit] = kind
+        if not failed:
+            self.completed_events[event] = payload
+        return event
+
+
+@dataclass(frozen=True)
+class Caps:
+    generations: int = 8496
+    environment_operations: int = 9792
+    generated_tokens: int = 138240
+    input_tokens: int = 16000000
+    per_call_input: int = 8192
+    device_hours: float = 4.0
+
+    def __post_init__(self) -> None:
+        defaults = type(self).__dataclass_fields__
+        for key in ("generations", "environment_operations", "generated_tokens", "input_tokens", "per_call_input"):
+            require(integer(getattr(self, key), 1) and getattr(self, key) <= defaults[key].default, "caps may only tighten")
+        require(type(self.device_hours) in (int, float) and 0 < self.device_hours <= 4, "device-hour cap")
+
+
+class Budget:
+    """Count started attempts; failed calls retain their reservations as unknown physical cost."""
+    def __init__(self, *, caps: Caps = Caps(), allocated_devices: int = 0,
+                 monotonic: Callable[[], float] = time.monotonic) -> None:
+        require(integer(allocated_devices), "allocated device count")
+        self.caps, self.devices, self.clock = caps, allocated_devices, monotonic
+        self.started_at = self.last = monotonic()
+        require(math.isfinite(self.started_at), "monotonic clock")
+        self.used = Counter(generations=0, environment_operations=0, generated_tokens=0, input_tokens=0)
+        self.completed = Counter()
+        self.open: dict[str, dict[str, int]] = {}
+        self.stopped = False
+
+    def check_time(self) -> float:
+        require(not self.stopped, "budget/run already stopped")
+        now = self.clock()
+        require(math.isfinite(now) and now >= self.last, "monotonic time reversed")
+        self.last = now
+        elapsed = self.devices * (now - self.started_at) / 3600
+        if elapsed > self.caps.device_hours:
+            self.stopped = True
+            require(False, "allocated GPUs x monotonic exceeds device-hour cap")
+        return elapsed
+
+    def reserve(self, unit: str, *, input_tokens: int = 0, output_cap: int = 0) -> dict[str, int]:
+        self.check_time()
+        require(unit not in self.open, "duplicate budget reservation")
+        generation = output_cap > 0
+        require(integer(input_tokens) and integer(output_cap), "reservation token types")
+        require((generation and input_tokens > 0) or (not generation and input_tokens == 0), "reservation shape")
+        require(input_tokens <= self.caps.per_call_input, "per-call input cap (no truncation)")
+        debit = {"generations": int(generation), "environment_operations": int(not generation),
+                 "generated_tokens": output_cap, "input_tokens": input_tokens}
+        for key, amount in debit.items():
+            if self.used[key] + amount > getattr(self.caps, key):
+                self.stopped = True
+                require(False, "pre-call budget cap: " + key)
+        self.used.update(debit)
+        self.open[unit] = debit
+        return debit
+
+    def complete(self, unit: str, *, actual_output: int = 0) -> None:
+        require(unit in self.open, "budget completion without reservation")
+        debit = self.open.pop(unit)
+        require(integer(actual_output) and actual_output <= debit["generated_tokens"], "output debit mismatch")
+        self.used["generated_tokens"] -= debit["generated_tokens"] - actual_output
+        self.completed.update(debit | {"generated_tokens": actual_output})
+        self.check_time()
+
+    def stop(self) -> None:
+        self.stopped = True
+
+    def snapshot(self) -> dict[str, Any]:
+        # No clock reset at task boundaries; open output reservations stay conservative.
+        now = self.clock()
+        require(math.isfinite(now) and now >= self.last, "monotonic time reversed")
+        return {"reserved_or_spent": dict(self.used), "completed": dict(self.completed),
+                "open_units": sorted(self.open), "allocated_devices": self.devices,
+                "device_hours": self.devices * (now - self.started_at) / 3600,
+                "cost_interpretation": "synthetic software receipts; no scientific expenditure"}
