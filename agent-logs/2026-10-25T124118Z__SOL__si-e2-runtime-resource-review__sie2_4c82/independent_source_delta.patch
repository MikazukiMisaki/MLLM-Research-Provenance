+def validate_documents(authorization: Mapping[str, Any], proposal: Mapping[str, Any], *,
+                       proposal_sha256: str, source_sha: str, clean: bool,
+                       visible_devices: str, now: datetime) -> None:
+    """Pure validation, also used by software fixtures; creates no runtime objects."""
+    required = {"schema", "purpose", "scope_sha256", "authorization_id", "issuer", "status",
+                "source_sha", "proposal_sha256", "output_path", "gpu_uuid", "not_before_utc",
+                "expires_utc", "ceilings", "science_authorized"}
+    require(set(authorization) == required, "authorization fields")
+    a = authorization
+    require(a["schema"] == "SI_E2_AUTHORIZATION_V1" and a["purpose"] == PURPOSE and
+            a["scope_sha256"] == SCOPE_SHA256 and a["issuer"] == "Sol Designer" and
+            a["status"] == "RELEASED_ENGINEERING_ONLY" and a["science_authorized"] is False,
+            "engineering release absent; science is forbidden")
+    require(type(a["authorization_id"]) is str and re.fullmatch("[0-9a-f]{32}", a["authorization_id"]) is not None,
+            "unique authorization identity")
+    require(re.fullmatch("[0-9a-f]{40}", source_sha) is not None and a["source_sha"] == source_sha and clean,
+            "exact source SHA and clean gate")
+    require(a["proposal_sha256"] == proposal_sha256, "proposal hash binding")
+    require(type(a["gpu_uuid"]) is str and re.fullmatch(r"GPU-[0-9a-fA-F-]{8,}", a["gpu_uuid"]) is not None and
+            visible_devices == a["gpu_uuid"], "one GPU UUID must be visible")
+    require(utc(a["not_before_utc"]) <= now < utc(a["expires_utc"]), "release time window")
+    require(set(a["ceilings"]) == set(MAXIMA), "ceiling fields")
+    for key, maximum in MAXIMA.items():
+        value = a["ceilings"][key]
+        require(type(value) in (int, float) and math.isfinite(value) and 0 < value <= maximum,
+                "ceiling may only tighten: " + key)
+        if key not in ("seconds", "device_hours"):
+            require(type(value) is int, "integer ceiling: " + key)
+    require(a["ceilings"]["generations"] == 4 and a["ceilings"]["generated_tokens"] == 88 and
+            a["ceilings"]["resets"] == 2, "fixed diagnostic worst-case calls/output/resets must fit before construction")
+    output = Path(a["output_path"])
+    require(output.is_absolute() and str(output) == str(output.resolve()) and output.name not in ("", ".", ".."),
+            "canonical absolute unique output")
+    require(set(proposal) == {"schema", "purpose", "model", "environment", "interpreter", "packages", "synthetic_prompts_sha256"} and
+            proposal["schema"] == "SI_E2_PROPOSAL_V1" and proposal["purpose"] == PURPOSE, "proposal fields/purpose")
+    require(proposal["synthetic_prompts_sha256"] == digest(engineering_prompts()), "four fixed synthetic prompts")
