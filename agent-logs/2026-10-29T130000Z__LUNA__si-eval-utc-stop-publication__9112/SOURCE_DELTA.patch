+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--authorization',type=Path,required=True);p.add_argument('--authorization-sha256',required=True);p.add_argument('--record-dir',type=Path,required=True);p.add_argument('--timeout-seconds',type=int,default=900);a=p.parse_args()
