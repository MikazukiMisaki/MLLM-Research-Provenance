+        self.arm, self.sha, self.invalid, self.fail = arm, sha, invalid, fail
+        self.eos_ids = (10,)
+    def prepare(self, prompt):
+        return {"prompt": prompt, "rendered_prompt": "render:" + prompt, "input_ids": [1, 2, 3], "attention_mask": [1, 1, 1]}
+    def generate(self, prepared):
+        if self.fail:
+            raise RuntimeError("opaque producer failed after external call")
+        return {"prompt": prepared["prompt"], "rendered_prompt": prepared["rendered_prompt"],
+                "raw_output": "bad" if self.invalid else "A000", "token_ids": [9, 10],
+                "input_tokens": len(prepared["input_ids"]), "generated_tokens": 2,
+                "adapter_sha256": self.sha, "adapter_mode": self.arm, "do_sample": False, "thinking": False, "max_new_tokens": 16,
+                "rendered_prompt_sha256": hashlib.sha256(prepared["rendered_prompt"].encode()).hexdigest(),
+                "token_ids_sha256": hashlib.sha256(b"[9,10]").hexdigest(), "latency_seconds": 0.01,
+                "output_complete": True, "token_cap_reached": False}
+    def decode(self, ids):
+        return "bad" if self.invalid else "A000"
+    def close(self):
+        return {"closed": True}
+
+class FakeEnv:
+    def __init__(self, task, *, truncate=False):
+        self.task, self.truncate, self.actions = task, truncate, []
+    def reset(self, *, seed):
+        assert seed == self.task["seed"]
+        return PublicState(self.task["task_id"], self.task["family"], "take object", "observed", ("take object",))
+    def step(self, command):
+        self.actions.append(command)
+        return PublicState(self.task["task_id"], self.task["family"], "take object", "after", (),
+                           done=not self.truncate, reward=0.0 if self.truncate else 1.0, truncated=self.truncate)
+    def close(self):
+        return {"closed": True}
+
+
