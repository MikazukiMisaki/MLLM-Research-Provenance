+++ b/tests/test_si_s01_source_only.py
@@ -0,0 +1,189 @@
+"""Nonempty96/five-family production fixtures; only external model/env boundaries fake."""
+import copy,json
+from pathlib import Path
+import pytest
+from self_improvement.si_s01.contract import *
+from self_improvement.si_s01.evidence import read_events
+from self_improvement.si_s01.audit import audit
+from si_s01_support import run_fixture,plan,metadata
+
+
+def rewrite(path,mutate):
+    rows=[json.loads(s) for s in path.read_text().splitlines()];mutate(rows)
+    refs={};previous=None
+    def replace(value):
+        if isinstance(value,str):return refs.get(value,value)
+        if isinstance(value,list):return [replace(x) for x in value]
+        if isinstance(value,dict):return {k:replace(v) for k,v in value.items()}
+        return value
+    for row in rows:
+        old=row['event_id'];row['payload']=replace(row['payload']);row['previous']=previous
+        row['event_id']=digest({k:v for k,v in row.items() if k!='event_id'});refs[old]=row['event_id'];previous=row['event_id']
+    path.write_text(''.join(canonical(r)+'\n' for r in rows))
+
+
+def test_all96_five_family_production_source_seal_and_not_futile(tmp_path):
+    p,r,c,producer,calls,envs=run_fixture(tmp_path/'run')
+    assert r['status']=='SOURCE_UPPER_BOUNDS_NOT_FUTILE' and r['normal_sources']==96
+    assert r['upper_bounds']['E']==96 and all(r['upper_bounds']['by_family'][f]['F']>=ADOPTION_QUOTAS[f] for f in FAMILIES)
+    assert r['physical']['components']['reset']==96 and r['physical']['components']['env_construct']==96 and r['physical']['components']['env_close']==96
+    assert r['physical']['completed']['environment_operations']==96+r['physical']['components']['step']
+    assert len(calls)==r['physical']['completed']['generations'] and all(e.closed and e.resets==1 for e in envs.values())
+    assert all(row['YT'] is None for row in c.rows)
+    assert (tmp_path/'run/source_report.json').is_file() and (tmp_path/'run/SOURCE_REPORT.md').is_file()
+
+
+def test_complete_source_structural_no_go_is_not_teacher_failure(tmp_path):
+    _,r,c,_,_,_=run_fixture(tmp_path/'run',options={'*':{'invalid_at':-1}})
+    assert r['source_phase_sealed'] and r['status']=='COMPLETE_SOURCE96_STRUCTURAL_NO_GO'
+    assert r['upper_bounds']['F']==0 and all(row['YT'] is None and row['Y0']==1 for row in c.rows)
+
+
+@pytest.mark.parametrize('config',[{'done_at':5,'invalid_at':-1},{'truncated_at':5,'invalid_at':-1},{'empty_at':5,'invalid_at':-1},{'done_at':2,'invalid_at':-1},{'empty_at':0}])
+def test_terminal_truncated_empty_and_early_stop_not_eligible(tmp_path,config):
+    _,r,_,_,_,_=run_fixture(tmp_path/'run',options={'*':config})
+    assert r['source_phase_sealed'] and r['upper_bounds']['E']==0
+
+
+def test_fifth_action_then_sixth_parser_failure_is_eligible(tmp_path):
+    _,r,c,_,_,_=run_fixture(tmp_path/'run',options={'*':{'invalid_at':5}})
+    assert r['upper_bounds']['E']==96 and r['upper_bounds']['F']==96
+    assert all(len(row['source']['steps'])==5 and len(row['source']['generations'])==6 and row['Y0']==0 for row in c.rows)
+
+
+def test_family_failure_floor_is_separate_from_global_counts(tmp_path):
+    p=plan();opts={s.task_id:{'invalid_at':-1} for s in p.slots if s.family==FAMILIES[3]}
+    _,r,_,_,_,_=run_fixture(tmp_path/'run',options=opts)
+    assert r['upper_bounds']['F']>=24 and r['upper_bounds']['S']>=24 and r['upper_bounds']['E']==96
+    assert r['status']=='COMPLETE_SOURCE96_STRUCTURAL_NO_GO' and r['upper_bounds']['by_family'][FAMILIES[3]]['F']==0
+
+
+@pytest.mark.parametrize('kind',['technical','missing_map','budget'])
+def test_partial_stops_keep_prior_y0_and_no_structural_claim(tmp_path,kind):
+    p=plan();opts={p.slots[1].task_id:{'technical_at':0 if kind=='technical' else -1,'missing_map_at':1 if kind=='missing_map' else -1}}
+    ceiling=LIMITS|{'generations':8} if kind=='budget' else None
+    _,r,c,_,_,_=run_fixture(tmp_path/'run',options=opts,ceilings=ceiling)
+    assert not r['source_phase_sealed'] and r['upper_bounds'] is None and r['normal_sources']>=1
+    assert c.rows[0]['Y0'] in (0,1) and all(row['Y0'] is None for row in c.rows if row['disposition']!='NORMAL_SOURCE')
+    assert r['status'] in ('TECHNICAL_STOP','INTEGRITY_STOP','BUDGET_STOP')
+    if kind!='budget':assert r['physical']['failed_units'] and r['physical']['open_units']
+
+
+@pytest.mark.parametrize('role',['stage_one','stage_two','teacher','replay','suffix','train','eval'])
+def test_forbidden_non_source_requests_before_raw_calls(tmp_path,role):
+    p,_,_,producer,calls,_=run_fixture(tmp_path/'run');before=len(calls)
+    with pytest.raises(ContractError):producer.generate(producer.prepare('public'),p.slots[0],0,phase=role)
+    assert len(calls)==before
+
+
+def test_p0_valid_id_eos_incomplete_is_not_rejected(tmp_path):
+    _,r,c,_,_,_=run_fixture(tmp_path/'run',options={'*':{'incomplete':True,'invalid_at':-1}})
+    assert r['normal_sources']==96 and all(row['Y0']==1 for row in c.rows)
+
+
+@pytest.mark.parametrize('attack,reason',[
+    ('snapshot_late','S5 absent/late'),('placeholder_early','premature placeholder'),('missing_map','action list wire type'),
+    ('wrong_y0','normal Y0/stop'),('seed','one seed42'),('map','Action-ID/map/command'),
+    ('reference','Action-ID/map/command'),('phase','source-only'),('reservation','pre-call reservation'),
+    ('origin','explicit software boundary'),('source_seal95','source seal before96')])
+def test_independent_auditor_targeted_semantics_after_full_reference_reseal(tmp_path,attack,reason):
+    from si_s01_support import reseal_bundle,assert_reference_consistency
+    p,_,_,producer,_,_=run_fixture(tmp_path/'run');output=tmp_path/'run'
+    def mutate(events,trajectories):
+        if attack in ('snapshot_late','placeholder_early'):
+            marker=next(r for r in events if r['kind']=='anchor_sealed');events.remove(marker)
+            if attack=='placeholder_early':
+                marker['payload']={'slot_key':marker['payload']['slot_key'],'after_step_event':None,'state':None,'history':None,'projection':None,'usable':False}
+                after=next(i for i,r in enumerate(events) if r['kind']=='unit_completed' and r['payload']['identity']['kind']=='reset')
+            else:
+                fifth=next(i for i,r in enumerate(events) if r['event_id']==marker['payload']['after_step_event'])
+                after=next(i for i in range(fifth+1,len(events)) if events[i]['kind']=='unit_completed' and events[i]['payload']['identity']['kind']=='generation')
+            events.insert(after+1,marker);return
+        if attack=='wrong_y0':trajectories[0]['Y0']=1-trajectories[0]['Y0'];return
+        if attack=='source_seal95':next(r for r in events if r['kind']=='sources_sealed')['payload']['source_hashes'].pop();return
+        if attack=='reference':
+            generation=next(r['event_id'] for r in events if r['kind']=='unit_completed' and r['payload']['identity']['kind']=='generation')
+            slot=trajectories[1]['slot_key']
+            next(r for r in events if r['kind']=='unit_completed' and r['payload']['identity']['kind']=='step' and r['payload']['identity']['slot']==slot)['payload']['data']['generation_event']=generation;return
+        for row in events:
+            if row['kind']=='unit_started' and attack=='phase':row['payload']['identity']['phase']='suffix';return
+            if row['kind']=='unit_started' and row['payload']['identity']['kind']=='generation' and attack=='reservation':row['payload']['reservation']['input_tokens']=0;return
+            if row['kind']!='unit_completed':continue
+            operation=row['payload']['identity']['kind'];data=row['payload']['data']
+            if operation=='reset' and attack=='seed':data['seed']=43;return
+            if operation=='step' and attack=='map':data['action_map']['A000']='wrong command';return
+            if operation=='step' and attack=='missing_map':data['after']['valid_actions']=None;return
+            if operation=='generation' and attack=='origin':data['runtime']={'synthetic_software_fixture':False};return
+    reseal_bundle(output,mutate)
+    assert_reference_consistency(output) # Pass hash/unit/trajectory/seal refs before business validation.
+    with pytest.raises(ContractError,match=reason):audit(output/'source_events.jsonl',output/'source_trajectories.jsonl',p,producer)
+
+
+def test_step50_nonterminal_empty_map_preserves_frozen_horizon_priority(tmp_path):
+    p=plan();opts={'*':{'done_at':2,'invalid_at':-1},p.slots[0].task_id:{'done_at':99,'empty_at':50,'invalid_at':-1}}
+    _,r,c,_,_,_=run_fixture(tmp_path/'run',options=opts)
+    assert r['source_phase_sealed'] and c.rows[0]['termination']=='horizon' and len(c.rows[0]['source']['steps'])==50
+
+
+def test_failed_construct_cleanup_is_real_but_construct_stays_failed_open(tmp_path):
+    from self_improvement.si_s01.collector import Collector,Producer
+    from si_s01_support import Tokenizer,FakeEnv
+    p=plan();closed=[]
+    class Broken(FakeEnv):
+        def initialize(self):raise RuntimeError('synthetic init failure')
+        def close(self):closed.append(self.slot.key)
+    producer=Producer(Tokenizer(),lambda *_:None,evidence_class=p.evidence_class)
+    c=Collector(p,lambda _:producer,lambda s:Broken(s,{}),tmp_path/'run',run_id='1'*32);c.run()
+    r=audit(tmp_path/'run/source_events.jsonl',tmp_path/'run/source_trajectories.jsonl',p,producer)
+    assert r['status']=='TECHNICAL_STOP' and r['normal_sources']==0 and len(closed)==1
+    assert r['physical']['components']['env_close']==1 and r['physical']['failed_units'] and r['physical']['open_units']
+
+
+def test_full_horizon_exact_caps_and_next_reservation_cannot_touch_raw(tmp_path):
+    p,r,c,producer,calls,_=run_fixture(tmp_path/'run',options={'*':{'done_at':99,'invalid_at':-1,'incomplete':True}})
+    assert r['source_phase_sealed'] and r['physical']['completed']=={'generations':4800,'environment_operations':4896,'generated_tokens':76800,'input_tokens':r['physical']['completed']['input_tokens']}
+    before=len(calls)
+    with pytest.raises(ContractError):c.ledger.call(p.slots[0],'generation',50,lambda:producer.generate(producer.prepare('forbidden extra'),p.slots[0],50),prepared=producer.prepare('forbidden extra').to_dict())
+    assert len(calls)==before and r['real_device_hours']==0
+
+
+def test_fixed_plan_seed_order_and_live_metadata_no_override():
+    p=plan();assert len(p.slots)==96 and all(s.seed==s.pool_seed==42 and s.cutoff==5 for s in p.slots)
+    with pytest.raises(ContractError):Plan(tuple(reversed(p.slots)),p.metadata_sha256,p.evidence_class)
+    with pytest.raises(ContractError):Slot(p.slots[0].task_id,p.slots[0].family,seed=43)
+    with pytest.raises(ContractError):bind_plan(metadata(),evidence_class='live_source_only',synthetic_sha256=p.metadata_sha256)
+
+
+def test_simulated_allocation_clock_does_not_reset_at_source_boundaries(tmp_path):
+    class Clock:
+        def __init__(self):self.now=0.0
+        def __call__(self):self.now+=.01;return self.now
+    _,r,_,_,_,_=run_fixture(tmp_path/'run',ceilings=LIMITS|{'device_hours':.001},clock=Clock(),devices=1)
+    assert r['status']=='BUDGET_STOP' and not r['source_phase_sealed']
+    assert r['allocation_budget_device_hours']>.001 and r['real_device_hours']==0
+
+
+@pytest.mark.parametrize('attack',['devices0','run_id','loosened_cap','allocation_earlier','allocation_later','worker_pid','metadata','evidence_class'])
+def test_resealed_header_must_match_external_supervisor_and_authority(tmp_path,attack):
+    from si_s01_support import gate_fixture,fixture_permit,context_fixture,reseal_bundle,assert_reference_consistency
+    repo=Path(__file__).resolve().parents[1]
+    a,p,ap,pp,save=gate_fixture(tmp_path,repo);a['ceilings']=LIMITS|{'generations':800};save()
+    permit=context_fixture(tmp_path,fixture_permit(tmp_path,repo,a,p,ap,pp))
+    plan_value,r,_,producer,_,_=run_fixture(permit.output,authority=permit,devices=1)
+    assert r['source_phase_sealed'] and r['real_device_hours']==0
+    def mutate(events,trajectories):
+        h=events[0]['payload']
+        if attack=='devices0':h['allocated_devices']=0
+        elif attack=='run_id':h['run_id']='9'*32
+        elif attack=='loosened_cap':h['ceilings']['generations']=4800
+        elif attack=='worker_pid':h['live_binding']['worker_pid']+=100000
+        elif attack in ('metadata','evidence_class'):
+            h['plan']['metadata_sha256']='9'*64 if attack=='metadata' else METADATA_SHA256
+            if attack=='evidence_class':h['plan']['evidence_class']='live_source_only'
+            h['plan_sha256']=restore_plan(h['plan']).sha256
+            next(r for r in events if r['kind']=='sources_sealed')['payload']['plan_sha256']=h['plan_sha256']
+        else:h['allocation_started_monotonic']+=100 if attack=='allocation_later' else -100
+    reseal_bundle(permit.output,mutate);assert_reference_consistency(permit.output)
+    expected=restore_plan(read_events(permit.output/'source_events.jsonl')[0]['payload']['plan']) if attack in ('metadata','evidence_class') else plan_value
+    with pytest.raises(ContractError,match='external (run|worker|authorized)'):
+        audit(permit.output/'source_events.jsonl',permit.output/'source_trajectories.jsonl',expected,producer,authority=permit)
diff --git a/tests/test_si_s01_supervisor.py b/tests/test_si_s01_supervisor.py
new file mode 100644
index 0000000..9651757
--- /dev/null
+++ b/tests/test_si_s01_supervisor.py
@@ -0,0 +1,21 @@
+"""Real subprocess exit/deadline receipts, entirely software-only and GPU0."""
+from pathlib import Path
+import json,os,sys
+import pytest
+from self_improvement.si_s01.supervisor import supervise_source
+from self_improvement.si_s01.contract import ContractError
+
+@pytest.mark.parametrize('code',[0,7])
+def test_authentic_exit_and_own_four_hour_ceiling_without_waiting(tmp_path,code):
+    output=tmp_path/'run'
+    context={'authorization_sha256':'a'*64,'source_sha':'b'*40,'evidence_class':'synthetic_software_fixture'}
+    result=supervise_source([sys.executable,'-I','-c',f'raise SystemExit({code})'],output,context=context,seconds=14400,environment={'PATH':os.defpath,'CUDA_VISIBLE_DEVICES':''})
+    assert result['authentic_returncode']==code and not result['deadline_triggered'] and result['allocated_device_hours']==0
+    assert not result['science_authorized'] and result['members_after_cleanup']==[]
+    # Same authorized output/claim cannot be consumed twice.
+    with pytest.raises((ContractError,FileExistsError)):supervise_source([sys.executable,'-I','-c','pass'],output,context=context,seconds=2,environment={})
+
+
+def test_deadline_terminates_real_child_and_preserves_nonzero_exit(tmp_path):
+    result=supervise_source([sys.executable,'-I','-c','import time;time.sleep(20)'],tmp_path/'deadline',context={'authorization_sha256':'a'*64,'source_sha':'b'*40,'evidence_class':'synthetic_software_fixture'},seconds=.5,environment={'PATH':os.defpath,'CUDA_VISIBLE_DEVICES':''})
+    assert result['deadline_triggered'] and result['authentic_returncode']!=0 and not result['members_after_cleanup']
