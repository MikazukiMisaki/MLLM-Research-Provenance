+"""Actual import observations are distinct from static, model-free checks."""
+import copy
+import hashlib
+import json
+import sys
+
+import pytest
+
+from self_improvement.continuation.runtime_identity import package_tree_sha256, static_identity, verify_actual_imports, verify_static
+from self_improvement.continuation.training import ContractError
+
+
+def test_static_identity_does_not_import_modules_in_clean_child():
+    # Isolated subprocess is covered by actual CLI preflight, which must say
+    # STATIC_METADATA_ONLY_NO_PACKAGE_IMPORTS. Here static lookup is exercised
+    # independently, while this test's process may already have other imports.
+    identity = static_identity()
+    verify_static(identity, sys.executable, {"python_version_binding": identity["interpreter"]["python_version"]})
+
+
+def test_actual_import_mismatch_records_failure_without_pass(tmp_path):
+    identity = copy.deepcopy(static_identity())
+    identity["packages"]["torch"]["version"] = "0.0.0"
+    receipt = tmp_path / "actual.json"
+    with pytest.raises(ContractError, match="actual imported package identity mismatch"):
+        verify_actual_imports(identity, receipt)
+    observed = json.loads(receipt.read_text())
+    assert observed["status"] == "FAILED"
+    assert observed["modules"]["torch"]["version"] != "0.0.0"
+
+
+def test_static_versions_and_origins_are_not_actual_import_receipts():
+    identity = static_identity()
+    assert set(identity) == {"interpreter", "packages"}
+    assert "status" not in identity
+
+
+def test_package_tree_binds_source_and_binary_but_ignores_only_bytecode(tmp_path):
+    (tmp_path / "__init__.py").write_text("v1")
+    (tmp_path / "kernel.so").write_bytes(b"binary1")
+    before = package_tree_sha256(tmp_path)
+    (tmp_path / "__pycache__").mkdir()
+    (tmp_path / "__pycache__" / "mod.pyc").write_bytes(b"ignored")
+    assert package_tree_sha256(tmp_path) == before
+    (tmp_path / "kernel.so").write_bytes(b"binary2")
+    assert package_tree_sha256(tmp_path) != before
+    (tmp_path / "other").symlink_to(tmp_path / "kernel.so")
+    with pytest.raises(ContractError, match="symlink"):
+        package_tree_sha256(tmp_path)
+
+
+def test_package_tree_order_uses_path_components(tmp_path):
+    (tmp_path / "_C").mkdir()
+    (tmp_path / "_C/a.py").write_text("a")
+    (tmp_path / "_C.so").write_text("b")
+    rows = []
+    for path in sorted(tmp_path.rglob("*")):
+        if path.is_file():
+            rows.append([path.relative_to(tmp_path).as_posix(), path.stat().st_size, hashlib.sha256(path.read_bytes()).hexdigest()])
+    assert [row[0] for row in rows] == ["_C/a.py", "_C.so"]
+    expected = hashlib.sha256(json.dumps(rows, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
+    assert package_tree_sha256(tmp_path) == expected
