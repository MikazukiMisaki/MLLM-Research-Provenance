+        refs = row["evidence_refs"]["k_arms"][str(k)]
+        if refs.get("arm_event_id") != complete.get("event_id"):
+            raise EvidenceIntegrityError("branch arm completion differs from its physical lifecycle")
+    return by_kind["duration_arm_started"]
