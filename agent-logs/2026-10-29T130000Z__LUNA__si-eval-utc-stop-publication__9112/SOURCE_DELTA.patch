+
+def verify_actual_imports(expected: dict, receipt_path: Path) -> dict:
+    """Import actual modules once and persist observations before model work."""
+    result = {"schema": "SI_TRANSFER_RUNTIME_IMPORT_V1", "runtime_identity_sha256": identity_digest(expected), "python_version": python_version(), "modules": {}, "status": "FAILED"}
+    try:
