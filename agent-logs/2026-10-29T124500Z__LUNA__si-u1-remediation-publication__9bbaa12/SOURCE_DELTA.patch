+        event("training_failed", error=outcome["error"])
+        (output_dir / "training_result.json").write_text(json.dumps(outcome, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+        raise
+    (output_dir / "training_result.json").write_text(json.dumps(outcome, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    return outcome
