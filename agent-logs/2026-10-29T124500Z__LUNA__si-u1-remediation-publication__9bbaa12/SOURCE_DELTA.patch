+"""Shared GPU guard: device identity and allocator, not exclusive ownership."""
+from __future__ import annotations
+import json
+import os
+import time
+from pathlib import Path
+
+from self_improvement.si_p3.runtime_backend import cuda_uuid_matches
+from .training import ContractError
+
+
+class SharedResource:
+    def __init__(self, gpu: dict, record_path: Path, *, strict_no_allocator_retry: bool = False):
+        self.gpu = gpu
+        self.record_path = record_path
+        self.strict_no_allocator_retry = strict_no_allocator_retry
+        self.configured = False
+
+    def __call__(self, point: str):
+        import torch
+        row = {"point": point, "observed_monotonic": time.monotonic(), "exclusive_gpu": False, "device_wide_delta_attribution": False, "nvml_process_mapping": "UNPROVEN"}
+        try:
+            if torch.cuda.device_count() != 1:
+                raise ContractError("exactly one visible CUDA device required")
+            observed = str(getattr(torch.cuda.get_device_properties(0), "uuid", ""))
+            row["observed_uuid"] = observed
+            if not cuda_uuid_matches(observed, self.gpu["uuid"]):
+                raise ContractError("CUDA UUID mismatch or unavailable")
+            if torch.cuda.memory.get_allocator_backend() != "native":
+                raise ContractError("native CUDA allocator required")
+            free, total = torch.cuda.mem_get_info(0)
+            if not self.configured:
+                if point != "before_model_load" or free < self.gpu["preweight_free_bytes"] or self.gpu["allocator_cap_bytes"] > total:
+                    raise ContractError("preweight GPU capacity insufficient")
+                fraction = self.gpu["allocator_cap_bytes"] / total
+                torch.cuda.memory.set_per_process_memory_fraction(fraction, 0)
+                self.configured = True
+            fraction = torch.cuda.memory.get_per_process_memory_fraction(0)
+            stats = torch.cuda.memory.memory_stats(0)
+            reserved = stats.get("reserved_bytes.all.current")
+            allocated = stats.get("allocated_bytes.all.current")
+            row.update(free_bytes=free, total_bytes=total, reserved_bytes=reserved, allocator_fraction=fraction,
+                       allocated_bytes=allocated,
+                       allocated_peak_bytes=stats.get("allocated_bytes.all.peak"), reserved_peak_bytes=stats.get("reserved_bytes.all.peak"),
+                       allocator_ooms=stats.get("num_ooms"), allocator_retries=stats.get("num_alloc_retries"))
+            if any(type(row[key]) is not int or row[key] < 0 for key in ("allocated_bytes", "reserved_bytes", "allocator_ooms", "allocator_retries", "allocated_peak_bytes", "reserved_peak_bytes")):
+                raise ContractError("allocator peak/OOM/retry counters unavailable")
+            if row["allocator_ooms"] != 0:
+                raise ContractError("allocator OOM detected")
+            if self.strict_no_allocator_retry and row["allocator_retries"] != 0:
+                raise ContractError("allocator allocation retry detected")
+            if not (allocated <= reserved <= row["reserved_peak_bytes"] <= self.gpu["allocator_cap_bytes"] and allocated <= row["allocated_peak_bytes"] <= row["reserved_peak_bytes"]) or abs(fraction * total - self.gpu["allocator_cap_bytes"]) > 1:
+                raise ContractError("allocator cap drift")
+            if free < (self.gpu["preweight_free_bytes"] if point == "before_model_load" else self.gpu["later_free_bytes"]):
+                raise ContractError("global free memory below frozen threshold")
+            row["status"] = "PASS"
+        except BaseException as exc:
+            row.update(status="FAILED", error=f"{type(exc).__name__}: {exc}")
+            raise
+        finally:
+            with self.record_path.open("a", encoding="utf-8") as handle:
+                handle.write(json.dumps(row, sort_keys=True) + "\n")
+                handle.flush()
+                os.fsync(handle.fileno())
