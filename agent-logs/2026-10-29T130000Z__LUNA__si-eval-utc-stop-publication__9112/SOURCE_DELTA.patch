+"""Fail-closed, read-only gate for a future transfer evaluator.
+
+A preflight is not a launch clearance. Live entry stays deliberately disabled
+until an independently reviewed production resource/supervisor driver exists.
+"""
+from __future__ import annotations
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+from .evaluator import _need
+from .runtime_binding import file_binding, verify_static_runtime
+from .protocol import validate_frozen_protocol
+from .isolation import validate_isolation_spec
+from .runtime_identity import verify_static as verify_static_identity
+
+
+def _git(repository: Path) -> tuple[str, bool]:
+    sha = subprocess.check_output(['git','rev-parse','HEAD'], cwd=repository, text=True).strip()
+    dirty = subprocess.check_output(['git','status','--porcelain','--untracked-files=normal'], cwd=repository, text=True)
+    return sha, not dirty
+
+
+def authenticate_preflight(repository: Path, authorization_path: Path, expected_sha256: str, *, argv: list[str], git_identity=_git, _release_recheck: bool = False) -> tuple[dict, dict]:
+    auth_path = Path(authorization_path).resolve()
+    raw = file_binding({'path':str(auth_path),'sha256':expected_sha256}).read_bytes(); a=json.loads(raw)
+    _need(set(a) == {'schema','purpose','source_sha','uid','environment','manifest','runtime_spec','review','plan','protocol','schedule','analysis','not_before','expires','receipt_path','output_path','interpreter','preflight_argv'}, 'authorization fields')
+    _need(a['schema']=='SI_TRANSFER_EVAL_AUTHORIZATION_V1' and a['purpose']=='PREFLIGHT_ONLY' and a['uid']==os.getuid(), 'preflight purpose/UID')
+    actual_sha, clean = git_identity(repository);_need(clean and actual_sha==a['source_sha'], 'exact clean source')
+    _need(type(a['environment']) is dict and dict(os.environ)==a['environment'], 'effective process environment')
+    _need(not any(k in a['environment'] for k in ('PYTHONPATH','PYTHONHOME','LD_PRELOAD')) and all(a['environment'].get(k)=='1' for k in ('HF_HUB_OFFLINE','TRANSFORMERS_OFFLINE','PYTHONDONTWRITEBYTECODE')), 'offline/isolated env')
+    _need(Path(sys.executable).resolve()==Path(a['interpreter']).resolve() and sys.flags.isolated==1, 'pinned isolated interpreter')
+    def utc(value):
+        parsed=datetime.fromisoformat(value.replace('Z','+00:00'));_need(parsed.tzinfo is not None,'timezone required');return parsed.astimezone(timezone.utc)
+    now=datetime.now(timezone.utc);_need(utc(a['not_before'])<=now<utc(a['expires']),'preflight time window')
+    receipt=Path(a['receipt_path']); output=Path(a['output_path'])
+    _need(receipt.is_absolute() and receipt.parent.is_dir() and not receipt.is_symlink() and output.is_absolute() and not output.is_symlink() and output.parent.is_dir() and output.parent.stat().st_uid==os.getuid() and output.parent.stat().st_mode & 0o022==0 and not receipt.is_relative_to(output), 'safe receipt/output parent')
+    _need((receipt.is_file() if _release_recheck else not receipt.exists()) and (_release_recheck or not output.exists()), 'fresh receipt/output')
+    expected=[a['interpreter'],'-I',str(Path(repository)/'scripts/run_si_transfer_eval.py'),'--preflight-only','--authorization',str(auth_path),'--authorization-sha256','@AUTHORIZATION_SHA256@']
+    _need(a['preflight_argv']==expected and argv==[expected_sha256 if x=='@AUTHORIZATION_SHA256@' else x for x in expected], 'exact preflight argv')
+    manifest_raw=file_binding(a['manifest']).read_bytes();manifest=json.loads(manifest_raw);spec=json.loads(file_binding(a['runtime_spec']).read_bytes());review=json.loads(file_binding(a['review']).read_bytes())
+    plan_raw=file_binding(a['plan']).read_bytes(); protocol=json.loads(file_binding(a['protocol']).read_bytes()); schedule_raw=file_binding(a['schedule']).read_bytes();file_binding(a['analysis'])
+    _need(review=={'schema':'SI_TRANSFER_EVAL_REVIEW_V1','decision':'PASS_SOFTWARE_ONLY','source_sha':a['source_sha'],'manifest_sha256':a['manifest']['sha256'],'runtime_spec_sha256':a['runtime_spec']['sha256'],'protocol_sha256':a['protocol']['sha256'],'plan_sha256':a['plan']['sha256']}, 'independent exact-source review')
+    validate_frozen_protocol(protocol,plan_raw,manifest_raw,schedule_raw,isolation_review_sha256=spec['isolation_proof']['sha256'],analysis_sha256=a['analysis']['sha256'])
+    validate_isolation_spec(spec,manifest_sha256=a['manifest']['sha256'],schedule_sha256=a['schedule']['sha256'])
+    resource=protocol['resource'];_need(a['environment'].get('CUDA_VISIBLE_DEVICES')==resource['gpu_uuid'] and a['environment'].get('PYTORCH_CUDA_ALLOC_CONF')=='backend:native' and a['environment'].get('CUDA_MODULE_LOADING')=='LAZY', 'frozen GPU/allocator environment')
+    from self_improvement.si_s01.shared_resource import contract
+    contract()  # verifies versioned shared-resource contract bytes
+    _need(spec['p0_legacy_sha256']=='6e403d85b150a74dfcc176f1f180ce4baf6fdacd922d2f96b3ceef0a21100f11' and Path(spec['base_path']).name=='b968826d9c46dd6066d109eabc6255188de91218', 'fixed P0/base model')
+    checks=verify_static_runtime(spec,manifest)
+    training=json.loads(file_binding(spec['training_protocol']).read_bytes())
+    verify_static_identity(training['runtime_identity'],a['interpreter'],training['epoch_shuffle_rule'])
+    return a, {'schema':'SI_TRANSFER_EVAL_PREFLIGHT_V1','status':'PREFLIGHT_ONLY_PASS_NOT_LAUNCH_AUTHORITY','authorization_sha256':expected_sha256,'source_sha':a['source_sha'],'manifest_sha256':a['manifest']['sha256'],'runtime_spec_sha256':a['runtime_spec']['sha256'],'review_sha256':a['review']['sha256'],'plan_sha256':a['plan']['sha256'],'protocol_sha256':a['protocol']['sha256'],'schedule_sha256':a['schedule']['sha256'],'analysis_sha256':a['analysis']['sha256'],'checks':checks}
+
+
+def write_preflight(authorization: dict, receipt: dict) -> None:
+    path=Path(authorization['receipt_path'])
+    with path.open('x',encoding='utf-8') as f:
+        f.write(json.dumps(receipt,sort_keys=True,separators=(',',':'))+'\n');f.flush();os.fsync(f.fileno())
