+            "exact historical environment input fields")
+    require(set(proposal["interpreter"]) == {"path", "sha256"} and
+            set(proposal["packages"]) == set(PACKAGE_NAMES), "interpreter/package origin bindings")
+    require(set(proposal["environment"]["logic_files"]) == {"domain", "grammar"}, "domain/grammar bindings")
+    for row in proposal["packages"].values():
