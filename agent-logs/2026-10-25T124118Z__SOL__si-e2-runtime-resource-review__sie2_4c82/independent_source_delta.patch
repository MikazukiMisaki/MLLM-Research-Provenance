+def validate_gpu_rows(devices: list[list[str]], processes: list[list[str]], *, gpu_uuid: str,
+                      allowed_pids: set[int]) -> None:
+    bound = [row for row in devices if len(row) == 4 and row[0] == gpu_uuid]
+    require(len(bound) == 1 and "A40" in bound[0][1], "bound GPU must be one visible A40")
+    for row in processes:
+        require(len(row) == 4 and row[1].isdigit(), "unreadable GPU ownership")
+        pid = int(row[1])
+        if row[0] == gpu_uuid:
+            require(pid in allowed_pids, "foreign GPU process")
+            try: owner = Path(f"/proc/{pid}").stat().st_uid
+            except (FileNotFoundError, PermissionError):
+                require(False, "cannot prove GPU PID ownership in this namespace")
+            require(owner == os.getuid(), "foreign GPU process UID")
+        elif pid in allowed_pids:
+            require(False, "owned process on foreign GPU")
