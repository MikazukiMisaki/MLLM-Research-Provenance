+    with pytest.raises(ContractError):b.generate(phase,b.prepare('public input'),cap,mode)
+    assert not calls and ledger.snapshot()['external_started']==0
+
+
+def test_duplicate_phase_cannot_make_second_call(parts):
+    _,ledger,b,calls=parts
+    b.generate('source',b.prepare('public input'),16,'P0')
+    with pytest.raises(ContractError):b.generate('source',b.prepare('public input'),16,'P0')
+    assert len(calls)==1
+
+
+def rehash(events):
+    previous=None
+    for i,row in enumerate(events):
+        row['sequence']=i;row['previous']=previous
+        row['event_id']=digest({k:v for k,v in row.items() if k!='event_id'});previous=row['event_id']
+
+
+@pytest.mark.parametrize('attack',['raw_input','sent_mask','reservation','summary_zero'])
+def test_full_chain_rehash_does_not_hide_cost_or_tensor_tamper(parts,attack):
+    _,ledger,b,_=parts;b.generate('source',b.prepare('public input'),16,'P0')
+    events=copy.deepcopy(ledger.events)
+    if attack=='summary_zero':
+        report={'purpose':'ENGINEERING_DIAGNOSTIC_ONLY','science_authorized':False,'status':'TECHNICAL_STOP_NO_RETRY','cost':copy.deepcopy(ledger.snapshot())}
+        for counters in ('completed','reserved_or_spent'):
+            report['cost'][counters]={key:0 for key in report['cost'][counters]}
+        with pytest.raises(ContractError,match='summary cost'):validate_report(report,events)
+        return
+    if attack=='reservation':next(x for x in events if x['kind']=='external_started')['payload']['reservation']['input_tokens']=0
+    else:
+        data=next(x for x in events if x['kind']=='external_completed')['payload']['data']
+        if attack=='raw_input':data['raw']['input_tokens']=0
+        else:data['tensor_proof']['sent']['attention_mask'][-1]=0
+    rehash(events)
+    with pytest.raises(ContractError):reconstruct(events)
