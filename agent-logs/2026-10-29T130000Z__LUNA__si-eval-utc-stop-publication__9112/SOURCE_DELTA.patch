+"""Validate durable external-return evidence independently of the runtime ports."""
+import base64
+from .evaluator import _need
+
+
+def _decode_wire(value):
+    if type(value) is list: return [_decode_wire(x) for x in value]
+    if type(value) is dict:
+        if value.get('wire_type') == 'python_tuple' and set(value)=={'wire_type','items'}:
+            return tuple(_decode_wire(x) for x in value['items'])
+        if value.get('wire_type') == 'python_dict' and set(value)=={'wire_type','items'}:
+            items=value['items'];_need(type(items) is list and all(type(x) is list and len(x)==2 and type(x[0]) is str for x in items) and len({x[0] for x in items})==len(items),'raw dictionary wire')
+            return {k:_decode_wire(v) for k,v in items}
+        if set(value)=={'numpy_dtype','shape','bytes_base64'}:
+            import numpy as np
+            dtype=np.dtype(value['numpy_dtype']);_need(not dtype.hasobject,'raw object array')
+            array=np.frombuffer(base64.b64decode(value['bytes_base64'],validate=True),dtype=dtype).reshape(value['shape'])
+            return array[()] if not value['shape'] else array
+        _need(False, 'unknown raw wire object')
+    return value
+
+
+def _check_raw_normalized(op, raw, normalized):
+    from env.alfworld import AlfWorldTextEnvironment
+    value=_decode_wire(raw);_need(type(value) is tuple and len(value)==(2 if op=='reset' else 4),'raw environment return shape')
+    first=AlfWorldTextEnvironment._first
+    info=AlfWorldTextEnvironment._info_dict(value[-1])
+    _need(normalized['observation']==first(value[0]) and normalized['valid_actions']==list(AlfWorldTextEnvironment._valid_actions_from_info(info) or ()), 'raw observation/action reconstruction')
+    _need(normalized['metadata']=={'alfworld_info':info},'raw info reconstruction')
+    if op=='step':_need(normalized['reward']==float(first(value[1])) and normalized['done']==bool(first(value[2])) and normalized['truncated'] is False, 'raw reward/terminal reconstruction')
+
+
+def add_return(unit, op, row):
+    p = row['payload']; boundary = p['boundary']; data = p['data']
+    allowed = {
+        'generation': ('generation_call_returned', 'generation_sequence_observed', 'generation_sequence_unknown'),
+        'reset': ('raw_reset_call_returned', 'raw_reset_returned', 'raw_reset_return_unknown', 'normalized_reset_returned'),
+        'step': ('raw_step_call_returned', 'raw_step_returned', 'raw_step_return_unknown', 'normalized_step_returned'),
+    }
+    _need(op in allowed and boundary in allowed[op] and type(data) is dict and data.get('returned') is True, 'external return boundary')
+    previous = [x['boundary'] for x in unit['returns']]
+    _need(boundary not in previous, 'duplicate external return')
+    if op == 'generation':
+        if boundary == 'generation_call_returned':
+            _need(not previous and data.get('sequence_status') == 'NOT_YET_OBSERVED' and data.get('input_token_count') == len(unit['prepared']['input_ids']), 'generation return ordering')
+        else:
+            _need(previous == ['generation_call_returned'], 'generation sequence ordering')
+            if boundary == 'generation_sequence_observed':
+                seq = data.get('observed_sequence'); prefix = unit['prepared']['input_ids']
+                _need(data.get('sequence_status') == 'OBSERVED' and data.get('input_token_count') == len(prefix) and type(seq) is list and all(type(x) is int and x >= 0 for x in seq), 'observed generation sequence')
+            else: _need(data.get('sequence_status') == 'UNKNOWN', 'unknown generation sequence')
+    else:
+        call='raw_'+op+'_call_returned';raw='raw_'+op+'_returned';unknown='raw_'+op+'_return_unknown'
+        if boundary==call:_need(not previous and data.get('content_status')=='NOT_YET_OBSERVED','environment call return ordering')
+        elif boundary==raw:
+            _need(previous==[call] and type(data.get('lossless')) is bool and 'value' in data,'environment return serialization')
+        elif boundary==unknown:_need(previous==[call] and data.get('content_status')=='UNKNOWN','environment unknown serialization')
+        else:_need(previous==[call,raw] and type(data.get('lossless')) is bool and 'value' in data,'normalized environment return ordering')
+    unit['returns'].append({'id': row['event_id'], 'boundary': boundary, 'data': data})
+
+
+def validate_completed(unit, op, data, *, require_live):
+    returns = unit['returns']; names = [x['boundary'] for x in returns]
+    if not returns and not require_live: return
+    if op == 'generation':
+        _need(names == ['generation_call_returned', 'generation_sequence_observed'], 'completed generation needs observed raw sequence')
+        seq = returns[1]['data']['observed_sequence']
+        _need(seq == unit['prepared']['input_ids'] + data['token_ids'], 'observed raw token binding')
+    elif op in ('reset', 'step'):
+        _need(names == ['raw_' + op + '_call_returned', 'raw_' + op + '_returned', 'normalized_' + op + '_returned'] and all(x['data']['lossless'] for x in returns[1:]), 'completed environment return evidence')
+        norm = returns[-1]['data']['value']; _need(type(norm) is dict, 'normalized environment object')
+        if require_live: _check_raw_normalized(op, returns[1]['data']['value'], norm)
+        _need(norm['observation'] == data['observation'] and norm['valid_actions'] == data['valid_actions'], 'normalized observation/action map binding')
+        if op == 'reset':
+            _need(norm['task']['task_id'] == data['task_id'] and norm['task']['text'] == data['goal'], 'normalized reset identity')
+        else:
+            _need(all(norm[k] == data[k] for k in ('reward', 'done', 'truncated')), 'normalized physical step binding')
+    else: _need(not returns, 'unexpected external return for operation')
+
+
+def generation_observation(units):
+    observed = unknown = tokens = 0
+    for u in units:
+        returns = u['returns']; names = [x['boundary'] for x in returns]
+        if 'generation_call_returned' in names:
+            observed += 1
+            if 'generation_sequence_observed' in names:
+                seq = next(x['data']['observed_sequence'] for x in returns if x['boundary'] == 'generation_sequence_observed')
+                prefix = u['prepared']['input_ids']
+                if seq[:len(prefix)] == prefix: tokens += len(seq) - len(prefix)
+                else: unknown += 1
+            else: unknown += 1
+    return {'returned_generations': observed, 'observed_output_tokens': tokens, 'unknown_output_sequences': unknown}
