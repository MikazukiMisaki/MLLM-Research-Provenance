+#!/usr/bin/env python3
+"""Isolated static preflight or independently cleared one-arm continuation."""
+from __future__ import annotations
+import argparse
+import json
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+from self_improvement.continuation.gate import verify, preflight
+from self_improvement.si_p3.runtime_gate import utc
+
+
+def main(argv=None):
+    entered = time.monotonic()
+    parser = argparse.ArgumentParser(description=__doc__)
+    modes = parser.add_mutually_exclusive_group(required=True)
+    modes.add_argument("--preflight-only", action="store_true")
+    modes.add_argument("--live", action="store_true")
+    modes.add_argument("--worker", action="store_true", help=argparse.SUPPRESS)
+    parser.add_argument("--authorization", type=Path, required=True)
+    parser.add_argument("--authorization-sha256", required=True)
+    parser.add_argument("--clearance", type=Path)
+    parser.add_argument("--clearance-sha256")
+    parser.add_argument("--launch-context-sha256", help=argparse.SUPPRESS)
+    args = parser.parse_args(argv)
+    mode = "preflight" if args.preflight_only else "worker" if args.worker else "live"
+    try:
+        authorization, binding = verify(ROOT, args.authorization, args.authorization_sha256,
+            mode=mode, argv=list(sys.orig_argv), clearance_path=args.clearance,
+            clearance_sha=args.clearance_sha256, launch_context_sha=args.launch_context_sha256)
+        if mode == "preflight":
+            print(json.dumps(preflight(authorization, binding)))
+            return 0
+        if mode == "worker":
+            from self_improvement.continuation.training import load_reviewed_manifest, load_frozen_local_base, load_frozen_local_tokenizer, read_bound_json, train_from_p0
+            from self_improvement.continuation.gate import bind_protocol_training
+            manifest, _ = load_reviewed_manifest(Path(authorization["manifest"]["path"]), authorization["manifest"]["sha256"])
+            protocol = read_bound_json(Path(authorization["protocol"]["path"]), authorization["protocol"]["sha256"])
+            from self_improvement.continuation.runtime_identity import verify_actual_imports
+            verify_actual_imports(protocol["runtime_identity"], Path(authorization["output_path"]) / "runtime_import_receipt.json")
+            _, rows = load_reviewed_manifest(Path(authorization["manifest"]["path"]), authorization["manifest"]["sha256"])
+            expected = bind_protocol_training(protocol, manifest, rows, authorization["arm"])
+            resource = None
+            device = "cpu"
+            if authorization["evidence_class"] == "live":
+                from self_improvement.continuation.resource import SharedResource
+                resource = SharedResource(authorization["gpu"], Path(authorization["output_path"]) / "resource.jsonl")
+                device = "cuda:0"
+            result = train_from_p0(base_dir=Path(authorization["base"]["path"]), base_sha256=authorization["base"]["sha256"],
+                adapter_dir=Path(authorization["adapter"]["path"]), adapter_sha256=authorization["adapter"]["sha256"],
+                manifest_path=Path(authorization["manifest"]["path"]), manifest_sha256=authorization["manifest"]["sha256"],
+                config=manifest["training_config"], output_dir=Path(authorization["output_path"]) / "training",
+                model_loader=load_frozen_local_base, tokenizer_loader=load_frozen_local_tokenizer,
+                device=device, resource_check=resource, expected_totals=expected,
+                expected_supervised_per_example=protocol["dose"]["supervised_tokens_per_example_including_EOS"])
+            if device == "cuda:0":
+                import torch
+                torch.cuda.synchronize()
+                torch.cuda.empty_cache()
+            return 0 if result["status"] == "COMPLETED" else 1
+        from self_improvement.continuation.supervisor import supervise
+        remaining = (utc(authorization["expires"]) - datetime.now(timezone.utc)).total_seconds()
+        seconds = min(authorization["allocation_seconds"], remaining)
+        command = ["--worker" if x == "--live" else x for x in sys.orig_argv]
+        receipt = supervise(command, Path(authorization["output_path"]), binding=binding,
+            environment=authorization["environment"], seconds=seconds, entered=entered,
+            gpu_allocated=int(authorization["evidence_class"] == "live"))
+        return 0 if receipt["authentic_returncode"] == 0 and receipt["status"] == "EXIT_RECORDED" and receipt["training_result_sha256"] else 1
+    except Exception as error:
+        print(json.dumps({"status": "REJECTED_OR_INCONCLUSIVE", "exception": type(error).__name__, "message": str(error)}), file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
