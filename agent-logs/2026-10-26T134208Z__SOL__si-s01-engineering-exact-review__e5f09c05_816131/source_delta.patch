+"""Guarded P0 mechanics shared by genuine source and separate engineering wrappers."""
+from __future__ import annotations
+from pathlib import Path
+from typing import Any,Mapping,Protocol
+import json,os,time
+from .contract import *
+from self_improvement.si_p3.runtime_backend import (adapter_state,verify_adapter_state,module_origin,verify_cuda_uuid)
+from self_improvement.si_p3.runtime_gate import inspect_gpu
+
+class RuntimeBinding(Protocol):
+    proposal:Mapping[str,Any]
+    gpu_uuid:str
+
+class RuntimeSink:
+    def __init__(self,ledger):self.ledger=ledger
+    def append(self,kind,data):self.ledger.runtime(kind,data)
+
+
+def load_guarded(cls,permit:RuntimeBinding,ledger,*,evidence_class:str,probe_started=None,probe_completed=None):
+    import torch,transformers,peft
+    from models.qwen import QwenPolicy,QwenPolicyConfig
+    from models.policy import GenerationOptions
+    for name,module in [('torch',torch),('transformers',transformers),('peft',peft)]:
+        insist(module_origin(module)==permit.proposal['packages'][name],'actual module origin/version: '+name)
+    if probe_started is not None:probe_started()
+    insist(torch.cuda.is_available() and torch.cuda.device_count()==1,'one visible CUDA device')
+    torch.cuda.init()
+    verify_cuda_uuid(torch,RuntimeSink(ledger),permit.gpu_uuid,point='source_before_context_probe')
+    probe=torch.empty(1,dtype=torch.uint8,device='cuda:0')
+    ledger.runtime('one_byte_before_weights',inspect_gpu(permit.gpu_uuid,allowed_pids={os.getpid()},require_owned_context=True));del probe
+    if probe_completed is not None:probe_completed()
+    configured=QwenPolicy(QwenPolicyConfig(model_id=permit.proposal['model']['base_snapshot'],device='cuda:0',dtype='bfloat16',local_files_only=True,trust_remote_code=False,enable_thinking=False,generation=GenerationOptions(max_new_tokens=16,do_sample=False)))
+    tokenizer,base,_=configured._load()
+    model=peft.PeftModel.from_pretrained(base,permit.proposal['model']['adapter_path'],is_trainable=False,local_files_only=True)
+    for parameter in model.parameters():parameter.requires_grad_(False)
+    insist(str(model.device)=='cuda:0' and all(str(p.device)=='cuda:0' for p in model.parameters()),'one CUDA device no offload')
+    insist(not getattr(model,'is_loaded_in_4bit',False) and not getattr(model,'is_loaded_in_8bit',False),'no quantization')
+    for name,p in model.named_parameters():
+        if p.is_floating_point():insist(p.dtype in ((torch.bfloat16,torch.float32) if 'lora_' in name else (torch.bfloat16,)),'frozen base/PEFT dtypes')
+    insist(model.config.model_type=='qwen3' and getattr(model.config,'_attn_implementation','')=='sdpa' and Path(model.config._name_or_path).resolve()==Path(permit.proposal['model']['base_snapshot']).resolve(),'effective frozen Qwen3/SDPA config')
+    insist(all(v in (0,'cuda:0') for v in getattr(model,'hf_device_map',{}).values()),'no offload map')
+    model.eval();verify_adapter_state(adapter_state(model),enabled=True)
+    verify_cuda_uuid(torch,RuntimeSink(ledger),permit.gpu_uuid,point='source_after_load')
+    result=cls(tokenizer,lambda *_:None,evidence_class=evidence_class)
+    result.torch,result.model,result.permit,result.ledger=torch,model,permit,ledger;result.raw=result._raw
+    ledger.runtime('model_loaded',{'origins':{name:module_origin(m) for name,m in [('torch',torch),('transformers',transformers),('peft',peft)]},'adapter_state':adapter_state(model),'resource':result.resource()})
+    return result
+
+
+def guarded_generation(self,prepared:PreparedTensors,active:str,*,pre_call=None):
+    insist(self.prepare(prepared.prepared.prompt)==prepared,'prepared drift before actual generation')
+    self.model.eval();insist(all(not p.requires_grad for p in self.model.parameters()),'frozen inference')
+    before=adapter_state(self.model);verify_adapter_state(before,enabled=True)
+    encoded=self.tokenizer(text=prepared.prepared.rendered_prompt,add_special_tokens=True,return_tensors='pt')
+    insist(set(encoded)=={'input_ids','attention_mask'},'actual tensor keys')
+    inputs={k:v.to(self.model.device) for k,v in encoded.items()}
+    insist(all(v.ndim==2 and v.shape[0]==1 for v in inputs.values()),'single full row')
+    sent=prepared.prepared.to_dict()|{'input_ids':inputs['input_ids'][0].tolist(),'attention_mask':inputs['attention_mask'][0].tolist()}
+    insist(sent==prepared.to_dict(),'actual input IDs/mask')
+    during=adapter_state(self.model);verify_adapter_state(during,enabled=True)
+    self.ledger.runtime('resource_before_generation',self.resource())
+    generated=None;returned=None
+    try:
+        self.torch.cuda.synchronize();at=time.perf_counter()
+        if pre_call is not None:pre_call()
+        with self.torch.no_grad():
+            generated=self.model.generate(**inputs,max_new_tokens=16,do_sample=False,return_dict_in_generate=True,output_scores=True)
+        self.torch.cuda.synchronize();elapsed=time.perf_counter()-at
+        seq=generated.sequences[0].tolist();tokens=seq[len(sent['input_ids']):];reached=len(tokens)==16
+        raw={'prompt':prepared.prepared.prompt,'rendered_prompt':prepared.prepared.rendered_prompt,
+             'rendered_prompt_sha256':hash_text(prepared.prepared.rendered_prompt),'raw_output':self.decode(tokens),
+             'token_ids':tokens,'token_ids_sha256':hash_text(json.dumps(tokens,separators=(',',':'))),
+             'input_tokens':len(sent['input_ids']),'generated_tokens':len(tokens),'latency_seconds':elapsed,
+             'output_complete':not reached or bool(tokens and tokens[-1] in self.eos_ids),'token_cap_reached':reached,
+             'max_new_tokens':16,'do_sample':False,'thinking':False,'adapter_mode':'P0','adapter_sha256':P0_SHA256}
+        returned={'generation_returned':True,'prepared':prepared.to_dict(),'raw':raw,'observed_sequence':seq}
+        self.ledger.runtime('generation_returned',returned)
+        insist(seq[:len(sent['input_ids'])]==sent['input_ids'] and len(generated.scores or ())==len(tokens),'generated prefix/scores')
+        after=adapter_state(self.model);verify_adapter_state(after,enabled=True)
+        insist(before==after and all(not p.requires_grad for p in self.model.parameters()),'P0 remains enabled/default/unmerged/frozen')
+        insist(inputs['input_ids'][0].tolist()==sent['input_ids'] and inputs['attention_mask'][0].tolist()==sent['attention_mask'],'generate mutated input')
+        proof={'tensor_proof':{'prepared':prepared.to_dict(),'sent':sent},'adapter_states':{'before':before,'during':during,'after':after},'resource_after':self.resource()}
+        return {'raw':raw,'runtime':proof}
+    except BaseException as error:
+        if generated is not None:
+            if returned is None:
+                returned={'generation_returned':True,'prepared':prepared.to_dict(),'raw':None,'observation_error':{'exception':type(error).__name__,'message':str(error)}}
+                try:returned['observed_sequence']=generated.sequences[0].tolist()
+                except Exception as capture_error:returned['capture_error']=str(capture_error)
+            if not self.ledger.units[active].get('return_event'):self.ledger.runtime('generation_returned',returned)
+            error.raw_evidence=returned
+        raise
+
+
+def resource(self):
+    return inspect_gpu(self.permit.gpu_uuid,allowed_pids={os.getpid()},require_owned_context=True)
+
+
+def hash_text(text):
+    from self_improvement.si_p3.contract import text_hash
+    return text_hash(text)
