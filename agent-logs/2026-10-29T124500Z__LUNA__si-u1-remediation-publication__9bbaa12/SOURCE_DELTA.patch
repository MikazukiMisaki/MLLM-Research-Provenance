@@ -0,0 +1,45 @@
+"""Allocator and global free checks with a synthetic CUDA edge only."""
+import json
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from self_improvement.continuation.resource import SharedResource
+from self_improvement.continuation.training import ContractError
+
+
+def test_synthetic_resource_cap_free_and_drift(monkeypatch, tmp_path):
+    state = {"fraction": None, "free": 90, "reserved": 0, "ooms": 0, "retries": 0}
+    memory = SimpleNamespace(
+        get_allocator_backend=lambda: "native",
+        set_per_process_memory_fraction=lambda value, device: state.update(fraction=value),
+        get_per_process_memory_fraction=lambda device: state["fraction"],
+        memory_stats=lambda device: {"allocated_bytes.all.current": 0, "reserved_bytes.all.current": state["reserved"], "reserved_bytes.all.peak": state["reserved"], "allocated_bytes.all.peak": 0, "num_ooms": state["ooms"], "num_alloc_retries": state["retries"]},
+    )
+    cuda = SimpleNamespace(device_count=lambda: 1, get_device_properties=lambda device: SimpleNamespace(uuid="b08bc603-ebdb-787d-b5b6-ec796ea3022a"),
+                           mem_get_info=lambda device: (state["free"], 100), memory=memory)
+    monkeypatch.setitem(sys.modules, "torch", SimpleNamespace(cuda=cuda))
+    gpu = {"uuid": "GPU-b08bc603-ebdb-787d-b5b6-ec796ea3022a", "allocator_cap_bytes": 30, "preweight_free_bytes": 70, "later_free_bytes": 10}
+    path = tmp_path / "resource.jsonl"
+    guard = SharedResource(gpu, path, strict_no_allocator_retry=True)
+    guard("before_model_load")
+    state.update(reserved=20, free=15)
+    guard("after_model_load")
+    state["free"] = 9
+    with pytest.raises(ContractError, match="global free"):
+        guard("before_microbatch")
+    records = [json.loads(line) for line in path.read_text().splitlines()]
+    assert [row["status"] for row in records] == ["PASS", "PASS", "FAILED"]
+    assert all(row["exclusive_gpu"] is False for row in records)
+    state.update(free=90, retries=1)
+    with pytest.raises(ContractError, match="allocation retry"):
+        guard("before_microbatch")
+    science_guard = SharedResource(gpu, tmp_path / "science_resource.jsonl")
+    science_guard("before_model_load")
+    assert json.loads((tmp_path / "science_resource.jsonl").read_text())["allocator_retries"] == 1
+    state["ooms"] = 1
+    with pytest.raises(ContractError, match="OOM"):
+        science_guard("before_microbatch")
+    science_rows = [json.loads(line) for line in (tmp_path / "science_resource.jsonl").read_text().splitlines()]
+    assert science_rows[-1]["allocator_ooms"] == 1 and science_rows[-1]["status"] == "FAILED"
