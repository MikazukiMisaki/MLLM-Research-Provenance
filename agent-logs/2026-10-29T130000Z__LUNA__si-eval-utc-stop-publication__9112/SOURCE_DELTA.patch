+    validate_generation(raw,prepared,arm='B',adapter_sha256='b'*64,eos_ids=producer.eos_ids,decode=producer.decode)
+    assert res.calls==[('before','B'),('after','B')] and raw['token_ids']==[9,10]
+    assert [x[0] for x in observed]==['generation_call_returned','generation_sequence_observed'] and observed[1][1]['observed_sequence']==[1,2,9,10]
