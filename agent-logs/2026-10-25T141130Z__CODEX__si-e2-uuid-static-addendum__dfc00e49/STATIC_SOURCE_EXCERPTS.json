          "511: def get_device_properties(device: Optional[_device_t] = None) -> _CudaDeviceProperties:",
          "512:     r\"\"\"Get the properties of a device.",
          "513: ",
          "514:     Args:",
          "515:         device (torch.device or int or str, optional): device for which to return the",
          "516:             properties of the device.  It uses the current device, given by",
          "517:             :func:`~torch.cuda.current_device`, if :attr:`device` is ``None``",
          "518:             (default).",
          "519: ",
          "520:     Returns:",
          "521:         _CudaDeviceProperties: the properties of the device",
          "522:     \"\"\"",
          "523:     _lazy_init()  # will define _get_device_properties",
          "524:     device = _get_device_index(device, optional=True)",
          "525:     if device < 0 or device >= device_count():",
          "526:         raise AssertionError(\"Invalid device id\")",
          "527:     return _get_device_properties(device)  # type: ignore[name-defined]"
        ]
