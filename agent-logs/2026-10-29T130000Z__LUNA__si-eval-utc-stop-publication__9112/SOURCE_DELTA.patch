+        file_binding({'path':row['path'],'sha256':row['sha256']})
+    _need(type(spec['base_files']) is list and bool(spec['base_files']), 'base snapshot inventory')
+    base_path = Path(spec['base_path']); _need(base_path.is_absolute() and base_path.is_dir(), 'base path')
+    for row in spec['base_files']:
+        _need(Path(row['path']).parent == base_path, 'base file location')
