+"""Nonempty production diagnostic with fake I/O, plus actual subprocess cleanup."""
+import json
+import os
+from pathlib import Path
+import sys
+
+import pytest
+from self_improvement.si_p3.contract import ContractError
+from self_improvement.si_p3.runtime_diagnostic import run_diagnostic
+from self_improvement.si_p3.runtime_backend import LocalInference
+from self_improvement.si_p3.runtime_ledger import EngineeringLedger,validate_report
+from self_improvement.si_p3.runtime_supervisor import supervise
+from si_e2_support import permit,tiny_components,raw_generate_edge,simple_evidence,environment_factory
+
+
+def test_nonempty_production_diagnostic_to_report_independent_four_phases(tmp_path):
+    p=permit(tmp_path);p.output.mkdir();e=simple_evidence()
+    factory,instances,_=environment_factory(tmp_path,e)
+    edges=[]
+    def load(permit,ledger):
+        ledger.reserve('model-load','model_load')
+        tok,model,torch=tiny_components();calls=raw_generate_edge(model,torch);edges.append(calls)
+        backend=LocalInference(tok,model,torch,ledger,lambda:{'software':True},software_fixture=True)
+        ledger.complete('model-load',{'software_tiny_cpu_model':True});return backend
+    report=run_diagnostic(p,software_fixture=True,software_loader=load,software_environment_factory=factory,software_replay=e)
+    assert report['status']=='ENGINEERING_BOUNDARY_OBSERVED_NOT_SCIENTIFIC_ACCEPTANCE',report['error']
+    assert report['evidence_class']=='synthetic_software_fixture' and len(edges[0])==4
+    assert report['results']['generations'][1]['parsed']['status']!='valid'  # observed invalid Stage1 never triggers tuning/retry/fabricated diagnosis
+    assert report['results']['generations'][2]['raw']['prompt'] in __import__('self_improvement.si_p3.runtime_gate',fromlist=['engineering_prompts']).engineering_prompts().values()
+    assert report['results']['environment']['generated_commands_executed']==0
+    assert [x['phase'] for x in report['results']['generations']]==['source','stage_one','stage_two','suffix']
+    events=[json.loads(line) for line in (p.output/'engineering_events.jsonl').read_text().splitlines()]
+    assert validate_report(report,events)['completed']['generations']==4
+    assert len(instances)==2
+
+
+def test_known_replay_budget_rejects_before_loading_or_environment(tmp_path):
+    p=permit(tmp_path);p.output.mkdir();p.authorization['ceilings']['steps']=1
+    calls=[]
+    def forbidden(*a):calls.append(a);raise AssertionError('side effect')
+    report=run_diagnostic(p,software_fixture=True,software_loader=forbidden,software_environment_factory=forbidden,software_replay=simple_evidence())
+    assert report['status']=='TECHNICAL_STOP_NO_RETRY' and not calls
+    assert report['cost']['external_started']==0
+
+
+def test_real_diagnostic_rejects_software_injection_before_output(tmp_path):
+    p=permit(tmp_path)
+    with pytest.raises(ContractError,match='software injection'):run_diagnostic(p,software_loader=lambda *_:None)
+    assert not p.output.exists()
+
+
+@pytest.mark.parametrize('code',[0,7])
+def test_authentic_subprocess_exit_and_create_exclusive(tmp_path,code):
+    output=tmp_path/'probe'
+    ctx={'authorization_sha256':'software-only','source_sha':'software-only','evidence_class':'synthetic_software_fixture'}
+    r=supervise([sys.executable,'-c',f'print("software subprocess");raise SystemExit({code})'],output,
+                context=ctx,seconds=5,environment=dict(os.environ,CUDA_VISIBLE_DEVICES=''))
+    assert r['authentic_returncode']==code and not r['deadline_triggered'] and not r['members_after_cleanup']
+    assert (output/'worker.stdout').read_text().strip()=='software subprocess'
+    with pytest.raises(ContractError,match='fresh'):supervise([sys.executable,'-c','pass'],output,context=ctx,seconds=5,environment=os.environ)
+
+
+@pytest.mark.parametrize("escape_session",[False,True])
+def test_external_deadline_kills_worker_and_descendant_with_raw_exit(tmp_path,escape_session):
+    output=tmp_path/'deadline';childfile=tmp_path/'grandchild.pid'
+    program='import subprocess,sys,time; p=subprocess.Popen([sys.executable,"-c","import time;time.sleep(60)"],start_new_session='+str(escape_session)+');open(sys.argv[1],"w").write(str(p.pid));time.sleep(60)'
+    ctx={'authorization_sha256':'software-only','source_sha':'software-only','evidence_class':'synthetic_software_fixture'}
+    r=supervise([sys.executable,'-c',program,str(childfile)],output,context=ctx,seconds=1.5,
+                environment=dict(os.environ,CUDA_VISIBLE_DEVICES=''))
+    assert r['deadline_triggered'] and r['authentic_returncode']==-9 and r['members_after_cleanup']==[]
+    assert not Path('/proc/'+childfile.read_text()).exists()
+    assert json.loads((output/'supervisor_exit.json').read_text())==r
+    assert not r['child_report_present'] and r['retry_authorized'] is False
