+from .contract import insist
+
+PURPOSE='ENGINEERING_HISTORICAL_SOURCE_ONCE'
+MODE='engineering_historical_source_once'
+SOFTWARE='synthetic_software_fixture'
+TASK_SHA256='525d271b38a8ecd2248c653291679a1c8fd37ceaec05b4dbf3b575932a7e103b'
+PROPOSAL_REVISION_SHA256='fe974f732ca03d96718c679facaf1201aa78a364c2f3251690c461f28acf189f'
+HISTORY_MANIFEST_SHA256='c361ba0c9d9276eb7dc20c31d0428f51db3f1a9fdd7fccfa23db5edc4f64eb38'
