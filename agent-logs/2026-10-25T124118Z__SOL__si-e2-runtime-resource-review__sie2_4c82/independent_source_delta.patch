+"""Read-isolated, two-fresh-instance replay of the first completed R19 source."""
+from __future__ import annotations
+
+import copy
+import json
+import os
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Callable, Mapping
+
+from env.alfworld import AlfWorldConfig, AlfWorldTextEnvironment, _expand_environment
+from models.action_parser import action_id_mapping
+from recovery.r19_duration import sha256_json
+
+from .contract import require
+from .runtime_gate import Permit
+from .runtime_ledger import EngineeringLedger
+
+HISTORICAL_SOURCE_SHA = "fba2a4278c4f1d9640c1c39f527fe3d5e7022ab50af4d353bc017bb31bbead89"
+HISTORICAL_RUN = "260422ac02bd42a8b2929d7ef240526b"
+HISTORICAL_CODE = "2da980f631badc25086d12db60d128ff507d3ae6"
+ISOLATION_RULING = "READ_ISOLATION_SCOPE_RULING.md; effective dataset.data_path restricted before construction"
+
+
+@dataclass(frozen=True)
+class ReplayEvidence:
+    task_id: str
+    family: str
+    seed: int
+    states: tuple[Mapping[str, Any], ...]
+    commands: tuple[str, ...]
+
+
+def source_hash(row: Mapping[str, Any]) -> str:
+    document = copy.deepcopy(row)
+    for name in ("source_trajectory_sha256", "r19_source_event_refs"):
+        document["metadata"].pop(name, None)
+    for step in document["steps"]:
+        for name in ("r19_generation_event_id", "r19_transition_event_id"):
+            step["metadata"].pop(name, None)
+    return sha256_json(document)
+
+
+def historical_replay(trajectory_bytes: bytes, events_bytes: bytes, *, expected_source_sha: str = HISTORICAL_SOURCE_SHA,
+                      software_fixture: bool = False) -> ReplayEvidence:
+    """Parse original production wire records. Never reconstruct an absent after-map."""
+    require(software_fixture or expected_source_sha == HISTORICAL_SOURCE_SHA, "fixed first source; no outcome search")
+    row = json.loads(trajectory_bytes.splitlines()[0])
+    meta = row["metadata"]
+    require(meta["schedule_index"] == 0 and meta["split"] == row["task"]["split"] == "train" and
+            source_hash(row) == expected_source_sha == meta["source_trajectory_sha256"], "authentic first completed source")
+    events = [json.loads(line) for line in events_bytes.splitlines() if line]
+    index = {event["event_id"]: event for event in events}
+    require(len(index) == len(events), "duplicate historical event")
+    refs = meta["r19_source_event_refs"]
+    source = index[refs["source_episode_event_id"]]
+    require(source["kind"] == "source_episode_completed" and source["payload"]["trajectory_sha256"] == expected_source_sha,
+            "source completion receipt")
+    if not software_fixture:
+        require(source["run_id"] == HISTORICAL_RUN and source["implementation_sha"] == HISTORICAL_CODE and
+                source["evidence_class"] == "live", "original completed G3 context")
+    require(source["payload"]["source_game_sha256"] == meta["source_game_sha256"] and
+            source["payload"]["source_traj_data_sha256"] == meta["source_traj_data_sha256"], "source/game byte identity")
+    task = row["task"]
+    def state(transition: Mapping[str, Any]) -> dict[str, Any]:
+        require(set(transition) >= {"observation", "valid_actions", "done", "reward", "truncated"} and
+                type(transition["valid_actions"]) is list, "saved full ordered after-map required")
+        return {"task_id": task["task_id"], "family": meta["task_family"], "goal": task["text"],
+                **{key: transition[key] for key in ("observation", "valid_actions", "done", "reward", "truncated")}}
+    reset = index[refs["reset_event_id"]]
+    require(reset["kind"] == "environment_operation_completed" and reset["payload"]["operation"] == "environment_reset" and
+            reset["payload"]["task_id"] == task["task_id"] and reset["payload"]["seed"] == row["seed"], "saved reset receipt")
+    states = [state(reset["payload"]["transition"])]; commands = []
+    require(states[0]["observation"] == row["initial_observation"], "initial observation")
+    require(len(refs["transition_event_ids"]) == len(row["steps"]) and 0 < len(row["steps"]) <= 50,
+            "complete executed source steps")
+    for i, (step, ref) in enumerate(zip(row["steps"], refs["transition_event_ids"])):
+        event = index[ref]; p = event["payload"]
+        before = states[-1]
+        require(event["kind"] == "environment_operation_completed" and step["index"] == i and
+                step["action_valid"] is True and step["metadata"]["r19_transition_event_id"] == ref and
+                step["observation"] == before["observation"] and step["valid_actions"] == before["valid_actions"] and
+                not before["done"] and not before["truncated"], "source step/before state")
+        require(p["command"] == step["action"] == p["transition"]["executed_command"] and
+                p["action_map"] == action_id_mapping(tuple(before["valid_actions"])) and
+                p["action_map"].get(p["action_id"]) == step["action"], "source command/ID/map")
+        require(p["before_state"]["observation"] == before["observation"] and
+                p["before_state"]["valid_actions"] == before["valid_actions"], "receipt before-state binding")
+        after = state(p["transition"])
+        require(after["observation"] == step["result_observation"] and after["done"] == step["done"] and
+                after["reward"] == step["reward"] and
+                after["truncated"] == step["metadata"]["transition_truncated"], "trajectory/receipt after state")
+        states.append(after); commands.append(step["action"])
+    return ReplayEvidence(task["task_id"], meta["task_family"], row["seed"], tuple(states), tuple(commands))
