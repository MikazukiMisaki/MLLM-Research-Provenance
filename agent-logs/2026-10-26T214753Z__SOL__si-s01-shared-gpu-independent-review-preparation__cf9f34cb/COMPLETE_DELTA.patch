+"""Only fake raw CUDA/model/world edges; production guards, parser and auditors stay real."""
+from dataclasses import replace
+from types import SimpleNamespace
+import os,sys,json
+from pathlib import Path
+from si_s01_engineering_support import fixture_setup,file_binding
+from self_improvement.si_s01.shared_resource import binding,local_identity,STATS
+from self_improvement.si_s01.contract import canonical
+
+
+def shared_fixture(tmp,monkeypatch):
+    f=fixture_setup(tmp,monkeypatch);f.auth['schema']='SI_S01_ENGINEERING_AUTHORIZATION_V2';f.auth['resource_policy']=binding()
+    f.auth['environment']['PYTORCH_CUDA_ALLOC_CONF']='backend:native'
+    review=Path(f.auth['review']['path']);v=json.loads(review.read_text());v['schema']='SI_S01_ENGINEERING_REVIEW_V2';v['resource_policy']=binding();review.write_text(canonical(v));f.auth['review']=file_binding(review)
+    f.save();f.permit=replace(f.permit,authorization_sha256=file_binding(f.ap)['sha256'],proposal_sha256=file_binding(f.pp)['sha256'])
+    s=f.state;s.total=48*1024**3+13;s.free_before=35*1024**3;s.free_later=12*1024**3;s.backend='native';s.fraction=None;s.readback_delta=0.;s.stat_fault=None;s.peak=0;s.retries=0;s.ooms=0;s.post_free=None
+    torch=sys.modules['torch']
+    def info(device):
+        assert device==0
+        free=s.free_later if s.calls['base_load_fake'] else s.free_before
+        if s.calls['generation'] and s.post_free is not None:free=s.post_free
+        return free,s.total
+    def fraction(value,device):
+        assert device==0 and s.calls['one_byte_fake']==s.calls['base_load_fake']==0
+        s.calls['fraction_set_fake']+=1;s.fraction=value
+    def get_fraction(device):return int(s.fraction*float(s.total))/s.total+s.readback_delta
+    def stats(device):
+        a=16*1024**3 if s.calls['base_load_fake'] else 512 if s.calls['one_byte_fake'] else 0
+        r=a if a>512 else 2*1024**2 if a else 0;s.peak=max(s.peak,r)
+        result=dict(zip(STATS,[a,max(a,s.peak),r,s.peak,s.ooms,s.retries]))
+        if s.stat_fault:s.stat_fault(result)
+        return result
+    torch.cuda.mem_get_info=info
+    torch.cuda.memory=SimpleNamespace(get_allocator_backend=lambda:s.backend,set_per_process_memory_fraction=fraction,get_per_process_memory_fraction=get_fraction,memory_stats=stats)
+    monkeypatch.setattr(os,'environ',os.environ) # ordinary exact environment, restored by monkeypatch below
+    monkeypatch.setattr(os,'environ',dict(f.auth['environment']))
+    return f
