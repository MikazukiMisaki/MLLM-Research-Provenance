+"""Future guarded production ports. No CLI exposes them yet.
+
+The evaluator currently refuses live mode; these adapters alone are not
+launch authority. A reviewed worker/supervisor must bind their inputs and
+resource journal before this module can be used for science.
+"""
+from __future__ import annotations
+from pathlib import Path
+from typing import Any
+import hashlib
+import dataclasses
+import base64
+import math
+import json
+import time
+from .evaluator import OUTPUT_CAP, _need
+from .runtime_binding import file_sha256, tree_sha256
+from self_improvement.si_p3.contract import PublicState
+
+
+def _sha_text(value: str) -> str:
+    return hashlib.sha256(value.encode()).hexdigest()
+
+
+def _raw_wire(value, *, preserve_tuples=False):
+    """JSON-safe snapshot; unsupported objects remain explicitly non-lossless."""
+    if value is None or type(value) in (bool,int,str):return value,True
