+               '--output', str(tmp_path / 'report'), '--evidence-class', 'synthetic', '--allow-synthetic']
+    result = subprocess.run(command, cwd=tmp_path, env=clean, text=True, capture_output=True)
+    (tmp_path / 'alias_cli_result.json').write_text(json.dumps({
