+def _executed_g3_source(relative_path: str) -> str:
+    result = subprocess.run(
+        ["git", "-C", str(runner.PROJECT_ROOT), "show", f"{_EXECUTED_G3_SHA}:{relative_path}"],
+        capture_output=True,
+    )
+    assert result.returncode == 0, f"required exact executed-G3 Git object unavailable: {result.stderr}"
+    return result.stdout.decode("utf-8")
+
+
+def _historical_method_sha(key: str) -> str:
+    relative_path, object_path = key.split("::", 1)
+    source = _executed_g3_source(relative_path)
+    nodes = ast.parse(source).body
+    for component in object_path.split("."):
+        matches = [node for node in nodes
+                   if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
+                   and node.name == component]
+        assert len(matches) == 1, f"missing or ambiguous historical method: {key}"
+        node = matches[0]
+        nodes = node.body
+    segment = ast.get_source_segment(source, node)
+    assert segment
+    return hashlib.sha256(segment.encode()).hexdigest()
+
+
+def _assert_only_g4_consumer_ast_delta() -> None:
+    path = "scripts/analyze_r19_recovery_duration.py"
+    historical = ast.parse(_executed_g3_source(path))
+    current = ast.parse((runner.PROJECT_ROOT / path).read_text())
+    changed = {"validate_live_execution_provenance", "validate_live_exit_receipt"}
+    added = {"_validate_local_inference_runtime", "_supervisor_option",
+             "_read_supervisor_object", "_validate_supervisor_launch_context"}
+    old_methods = {node.name: node for node in historical.body if isinstance(node, ast.FunctionDef)}
+    new_methods = {node.name: node for node in current.body if isinstance(node, ast.FunctionDef)}
+    assert len(new_methods) == sum(isinstance(node, ast.FunctionDef) for node in current.body)
+    assert set(new_methods) - set(old_methods) == added
+    assert not set(old_methods) - set(new_methods)
+    assert {name for name in old_methods
+            if ast.dump(old_methods[name]) != ast.dump(new_methods[name])} == changed
+    # Imports, constants, classes, guards and every other definition remain exact.
+    def remainder(tree, permitted):
+        return [ast.dump(node) for node in tree.body
+                if not (isinstance(node, ast.FunctionDef) and node.name in permitted)]
+    assert remainder(historical, changed) == remainder(current, changed | added)
 
 
