+    w=json.loads(bound(c['worker_path'],c['worker_sha256']));launch=json.loads(bound(c['launch_path'],c['launch_sha256']))
+    insist((identity['pid'],identity['uid'],identity['start_tick'],identity['pgid'],identity['sid'])==(w['pid'],w['uid'],w['start_tick'],w['pgid'],w.get('sid',w['pgid'])),'shared local worker PID/UID/starttick/PGID/SID')
+    insist(w['authorization_sha256']==permit.authorization_sha256 and w['launch_context_sha256']==c['launch_sha256'] and launch['allocation_started_monotonic']<=w['started_monotonic'],'shared external worker/context binding')
