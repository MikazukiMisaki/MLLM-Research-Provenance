+    ledger.close()
+
+
+def test_actual_peft_exception_restores_grad_flags_and_retains_full_open_reservation(parts):
+    _,ledger,b,calls=parts
+    b.generate('source',b.prepare('public input'),16,'P0')
+    before=adapter_state(b.model)
+    raw_generate_edge(b.model,b.torch,fail=True)
+    with pytest.raises(RuntimeError,match='synthetic generation'):b.generate('stage_one',b.prepare('public input'),40,'BASE')
+    assert adapter_state(b.model)==before
+    assert ledger.snapshot()['open_units']==['generation-stage_one']
+    assert ledger.snapshot()['reserved_or_spent']['generated_tokens']==42
+    assert ledger.snapshot()['completed']['generated_tokens']==2
+
+
+@pytest.mark.parametrize('which',['input_ids','attention_mask'])
+def test_actual_sent_tensor_drift_rejected_before_external_reservation(parts,which):
+    _,ledger,b,calls=parts
+    tok=b.tokenizer
+    class Drift:
+        eos_token_id=tok.eos_token_id
+        def apply_chat_template(self,*a,**k):return tok.apply_chat_template(*a,**k)
+        def decode(self,*a,**k):return tok.decode(*a,**k)
+        def __call__(self,*a,**k):
+            value=tok(*a,**k)
+            if k.get('return_tensors')=='pt':value[which][0,-1]=0 if which=='attention_mask' else 4
+            return value
+    b.tokenizer=Drift()
+    with pytest.raises(ContractError,match='sent full'):b.generate('source',b.prepare('public input'),16,'P0')
+    assert not calls and ledger.snapshot()['external_started']==0
+
+
+def test_caller_prepared_drift_rejected_before_external_reservation(parts):
+    _,ledger,b,calls=parts
+    prepared=b.prepare('public input')
+    forged=replace(prepared,prepared=replace(prepared.prepared,input_ids=(4,)))
+    with pytest.raises(ContractError,match='prepared-token'):b.generate('source',forged,16,'P0')
+    assert not calls and ledger.snapshot()['external_started']==0
+
+
+def test_adapter_switch_failure_rejects_before_generate_and_reservation(parts):
+    _,ledger,b,calls=parts
+    b.generate('source',b.prepare('public input'),16,'P0')
+    @contextmanager
+    def broken():yield
+    b.model.disable_adapter=broken
+    with pytest.raises(ContractError,match='PEFT enabled'):b.generate('stage_one',b.prepare('public input'),40,'BASE')
+    assert len(calls)==1 and ledger.snapshot()['completed']['generations']==1
