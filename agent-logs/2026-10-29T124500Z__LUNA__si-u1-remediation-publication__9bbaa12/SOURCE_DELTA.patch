@@ -0,0 +1,384 @@
+"""Small CPU-only exercises of the actual continuation contract."""
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import random
+from pathlib import Path
+
+import pytest
+import torch
+from peft import LoraConfig, get_peft_model
+from transformers import GPT2Config, GPT2LMHeadModel
+
+from self_improvement.continuation.training import (
+    ContractError, collate, compare_initial_conditions, encode_examples, file_sha256, learning_rate_for_step, load_p0_adapter,
+    load_reviewed_manifest, train_from_p0, tree_sha256, validate_config,
+)
+
+
+class CharacterTokenizer:
+    eos_token = "~"
+    eos_token_id = 127
+    pad_token_id = None
+
+    def __call__(self, *, text, add_special_tokens):
+        assert add_special_tokens
+        return {"input_ids": [1] + [127 if c == "~" else ord(c) % 100 + 2 for c in text]}
+
+
+def tiny_base(_path=None):
+    with torch.random.fork_rng():
+        torch.manual_seed(99)
+        return GPT2LMHeadModel(GPT2Config(vocab_size=128, n_positions=64, n_ctx=64,
+                                        n_embd=8, n_layer=1, n_head=2, resid_pdrop=0,
+                                        embd_pdrop=0, attn_pdrop=0))
+
+
+def schedule_digest(doc):
+    binding = {k: doc[k] for k in ("sample_schedule", "ordered_sample_ids", "epoch_lengths", "epoch_each_sample_once", "task_exposures")}
+    return hashlib.sha256(json.dumps(binding, sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
+
+
+@pytest.fixture
+def inputs(tmp_path):
+    base = tmp_path / "base"
+    base.mkdir()
+    (base / "weights.identity").write_text("synthetic-base")
+    adapter = tmp_path / "p0"
+    p0 = get_peft_model(tiny_base(), LoraConfig(r=2, lora_alpha=4, target_modules=["c_attn"], task_type="CAUSAL_LM"))
+    with torch.no_grad():
+        for name, param in p0.named_parameters():
+            if "lora_B" in name:
+                param.fill_(0.25)
+    p0.save_pretrained(adapter)
+    rows = [
+        {"sample_id": "a", "task_group": "task-1", "prompt": "first?", "completion": "A1"},
+        {"sample_id": "b", "task_group": "task-1", "prompt": "second?", "completion": "A2"},
+    ]
+    data = tmp_path / "data.jsonl"
+    data.write_text("".join(json.dumps(r) + "\n" for r in rows))
+    config = {"seed": 9, "batch_size": 1, "gradient_accumulation_steps": 1, "optimizer_steps": 2,
+              "learning_rate": 0.01, "weight_decay": 0., "max_grad_norm": 1., "max_length": 64,
+              "max_supervised_tokens": 100, "max_input_tokens": 100, "max_wall_seconds": 300.,
+              "adam_beta1": 0.9, "adam_beta2": 0.999, "adam_epsilon": 1e-8,
+              "gradient_checkpointing": False, "use_cache": False, "optimizer": "adamw", "optimizer_fused": False,
+              "scheduler": "cosine", "warmup_steps": 0, "min_lr_ratio": .1, "loss_normalization": "active_tokens"}
+    schedule = [{"sample_id": r["sample_id"], "task_group": r["task_group"], "exposures": 1} for r in rows]
+    order = [r["sample_id"] for r in rows]
+    schedule_binding = {"sample_schedule": schedule, "ordered_sample_ids": order, "epoch_lengths": [2], "epoch_each_sample_once": True, "task_exposures": {"task-1": 2}}
+    sh = schedule_digest(schedule_binding)
+    review = tmp_path / "review.json"
+    review.write_text(json.dumps({"decision": "PASS_DATA_ONLY", "dataset_sha256": file_sha256(data), "schedule_sha256": sh, "arm": "B"}))
+    manifest = tmp_path / "manifest.json"
+    manifest.write_text(json.dumps({"schema": "SI_CONTINUATION_DATA_V1", "arm": "B", "base_sha256": tree_sha256(base), "p0_adapter_sha256": tree_sha256(adapter), "dataset": {"path": str(data), "sha256": file_sha256(data)},
+                                    "independent_review": {"path": str(review), "sha256": file_sha256(review)},
+                                    **schedule_binding, "training_config": config}))
+    return {"base": base, "adapter": adapter, "rows": rows, "config": config, "manifest": manifest, "data": data, "review": review}
+
+
+def run(inputs, output, **changes):
+    kwargs = {"base_dir": inputs["base"], "base_sha256": tree_sha256(inputs["base"]),
+              "adapter_dir": inputs["adapter"], "adapter_sha256": tree_sha256(inputs["adapter"]),
+              "manifest_path": inputs["manifest"], "manifest_sha256": file_sha256(inputs["manifest"]),
+              "config": inputs["config"], "output_dir": output,
+              "model_loader": tiny_base, "tokenizer_loader": lambda _: CharacterTokenizer(), "device": "cpu"}
+    kwargs.update(changes)
+    return train_from_p0(**kwargs)
+
+
+def test_real_peft_p0_identity_and_freeze(inputs):
+    a = load_p0_adapter(tiny_base(), inputs["adapter"])
+    b = load_p0_adapter(tiny_base(), inputs["adapter"])
+    av = {n: p.detach().clone() for n, p in a.named_parameters()}
+    bv = {n: p.detach().clone() for n, p in b.named_parameters()}
+    assert av.keys() == bv.keys()
+    assert all(torch.equal(av[n], bv[n]) for n in av)
+    assert any("lora_B" in n and torch.all(p == .25) for n, p in av.items())
+    assert all(("lora_" in n) == p.requires_grad for n, p in a.named_parameters())
+
+
+def test_comparable_arms_require_identical_base_adapter_and_config(inputs):
+    arm_b = json.loads(inputs["manifest"].read_text())
+    arm_c = dict(arm_b, arm="C")
+    compare_initial_conditions(arm_b, arm_c)
+    for field in ("base_sha256", "p0_adapter_sha256", "training_config"):
+        with pytest.raises(ContractError, match="initial condition mismatch"):
+            compare_initial_conditions(arm_b, dict(arm_c, **{field: "different"}))
+
+
+def test_frozen_warmup_cosine_learning_rates(inputs):
+    cfg = dict(inputs["config"], optimizer_steps=6, warmup_steps=2, learning_rate=1., min_lr_ratio=0.)
+    values = [learning_rate_for_step(cfg, step) for step in range(6)]
+    assert values == pytest.approx([.5, 1., .8535533905932737, .5, .14644660940672627, 0.])
+    with pytest.raises(ContractError):
+        learning_rate_for_step(cfg, 6)
+
+
+def test_causal_masks_eos_and_padding(inputs):
+    encoded = encode_examples(CharacterTokenizer(), inputs["rows"], 64)
+    for row, tokens in zip(inputs["rows"], encoded):
+        boundary = len(row["prompt"]) + 1
+        assert tokens["labels"][:boundary] == [-100] * boundary
+        assert tokens["labels"][boundary:] == tokens["input_ids"][boundary:]
+        assert tokens["labels"][-1] == 127
+        assert tokens["supervised_tokens"] == len(row["completion"]) + 1
+    batch = collate(encoded, 127)
+    assert batch["labels"][0, -1].item() == -100
+    assert batch["attention_mask"][0, -1].item() == 0
+
+
+def test_end_to_end_real_peft_production_loop_and_no_eval(inputs, tmp_path):
+    out = tmp_path / "out"
+    res = run(inputs, out)
+    assert res["status"] == "COMPLETED"
+    assert res["counts"] == {"input_tokens": 21, "padded_input_tokens": 21, "supervised_tokens": 6, "microbatches_started": 2, "microbatches_completed": 2, "optimizer_steps": 2}
+    assert (out / "final_adapter" / "adapter_model.safetensors").exists()
+    assert not (out / "checkpoints").exists()
+    events = [json.loads(x) for x in (out / "training_events.jsonl").read_text().splitlines()]
+    assert [e["kind"] for e in events].count("microbatch_started") == 2
+    assert [e["sample_ids"] for e in events if e["kind"] == "microbatch_started"] == [["a"], ["b"]]
+    assert all(e.get("task_groups") == ["task-1"] for e in events if e["kind"] == "microbatch_started")
+    trained = load_p0_adapter(tiny_base(), out / "final_adapter")
+    initial = load_p0_adapter(tiny_base(), inputs["adapter"])
+    assert any(not torch.equal(p, dict(initial.named_parameters())[n]) for n, p in trained.named_parameters() if "lora_" in n)
+    with pytest.raises(ContractError, match="already exists"):
+        run(inputs, out)
+
+
+def test_manifest_rejects_modified_task_group_and_review(inputs):
+    doc = json.loads(inputs["manifest"].read_text())
+    doc["sample_schedule"][0]["task_group"] = "wrong"
+    inputs["manifest"].write_text(json.dumps(doc))
+    with pytest.raises(ContractError, match="schedule"):
+        load_reviewed_manifest(inputs["manifest"], file_sha256(inputs["manifest"]))
+
+
+def test_predeclared_multiple_passes_preserved_and_reordering_rejected(inputs):
+    doc = json.loads(inputs["manifest"].read_text())
+    for row in doc["sample_schedule"]:
+        row["exposures"] = 2
+    doc["ordered_sample_ids"] = ["a", "b", "b", "a"]
+    doc["epoch_lengths"] = [2, 2]
+    doc["task_exposures"] = {"task-1": 4}
+    review = json.loads(inputs["review"].read_text())
+    review["schedule_sha256"] = schedule_digest(doc)
+    inputs["review"].write_text(json.dumps(review))
+    doc["independent_review"]["sha256"] = file_sha256(inputs["review"])
+    inputs["manifest"].write_text(json.dumps(doc))
+    _, rows = load_reviewed_manifest(inputs["manifest"], file_sha256(inputs["manifest"]))
+    assert [row["sample_id"] for row in rows] == ["a", "b", "b", "a"]
+    doc["ordered_sample_ids"] = ["a", "a", "b", "b"]
+    inputs["manifest"].write_text(json.dumps(doc))
+    with pytest.raises(ContractError, match="schedule"):
+        load_reviewed_manifest(inputs["manifest"], file_sha256(inputs["manifest"]))
+
+
+def test_exposure_count_cannot_be_changed_by_rebinding_manifest_and_review(inputs):
+    doc = json.loads(inputs["manifest"].read_text())
+    doc["ordered_sample_ids"] = ["a", "a"]
+    review = json.loads(inputs["review"].read_text())
+    review["schedule_sha256"] = schedule_digest(doc)
+    inputs["review"].write_text(json.dumps(review))
+    doc["independent_review"]["sha256"] = file_sha256(inputs["review"])
+    inputs["manifest"].write_text(json.dumps(doc))
+    with pytest.raises(ContractError, match="exposure counts"):
+        load_reviewed_manifest(inputs["manifest"], file_sha256(inputs["manifest"]))
+
+
+def test_duplicate_in_epoch_rejected_even_when_total_counts_match(inputs):
+    doc = json.loads(inputs["manifest"].read_text())
+    for row in doc["sample_schedule"]:
+        row["exposures"] = 2
+    doc["ordered_sample_ids"] = ["a", "a", "b", "b"]
+    doc["epoch_lengths"] = [2, 2]
+    doc["task_exposures"] = {"task-1": 4}
+    review = json.loads(inputs["review"].read_text())
+    review["schedule_sha256"] = schedule_digest(doc)
+    inputs["review"].write_text(json.dumps(review))
+    doc["independent_review"]["sha256"] = file_sha256(inputs["review"])
+    inputs["manifest"].write_text(json.dumps(doc))
+    with pytest.raises(ContractError, match="epoch omits or duplicates"):
+        load_reviewed_manifest(inputs["manifest"], file_sha256(inputs["manifest"]))
+
+
+def test_token_budget_fail_closed_before_model_load_preserves_receipt(inputs, tmp_path):
+    config = dict(inputs["config"], max_input_tokens=1)
+    manifest = json.loads(inputs["manifest"].read_text())
+    manifest["training_config"] = config
+    inputs["manifest"].write_text(json.dumps(manifest))
+    out = tmp_path / "out"
+    calls = []
+    with pytest.raises(ContractError, match="before model load"):
+        run(inputs, out, config=config, model_loader=lambda _: calls.append("load"))
+    result = json.loads((out / "training_result.json").read_text())
+    assert result["status"] == "FAILED" and result["counts"]["microbatches_started"] == 0
+    assert calls == [] and not (out / "final_adapter").exists()
+
+
+def test_encoded_protocol_total_mismatch_stops_before_model_load(inputs, tmp_path):
+    out = tmp_path / "wrong-total"
+    calls = []
+    with pytest.raises(ContractError, match="encoded token totals"):
+        run(inputs, out, expected_totals={"input_tokens": 22, "supervised_tokens": 6}, model_loader=lambda _: calls.append("load"))
+    assert calls == [] and not (out / "final_adapter").exists()
+    assert json.loads((out / "training_result.json").read_text())["status"] == "FAILED"
+
+
+def test_timeout_and_bad_inputs_stop_before_model_load(inputs, tmp_path):
+    with pytest.raises(ContractError, match="hash mismatch"):
+        run(inputs, tmp_path / "bad", adapter_sha256="0" * 64)
+    times = iter([0., 301., 301.])
+    with pytest.raises(ContractError, match="wall-clock"):
+        run(inputs, tmp_path / "timeout", clock=lambda: next(times))
+    result = json.loads((tmp_path / "timeout" / "training_result.json").read_text())
+    assert result["status"] == "FAILED" and result["counts"]["microbatches_started"] == 0
+
+
+def test_failed_forward_is_charged_and_has_no_final_adapter(inputs, tmp_path, monkeypatch):
+    import self_improvement.continuation.training as module
+    real_load = module.load_p0_adapter
+
+    def broken_forward(base, adapter):
+        model = real_load(base, adapter)
+        def fail(*args, **kwargs):
+            raise RuntimeError("synthetic forward failure")
+        model.forward = fail
+        return model
+
+    monkeypatch.setattr(module, "load_p0_adapter", broken_forward)
+    out = tmp_path / "broken"
+    with pytest.raises(RuntimeError, match="synthetic forward failure"):
+        run(inputs, out)
+    result = json.loads((out / "training_result.json").read_text())
+    assert result["status"] == "FAILED"
+    assert result["counts"]["microbatches_started"] == 1
+    assert result["counts"]["microbatches_completed"] == 0
+    assert result["counts"]["input_tokens"] == 10
+    assert not (out / "final_adapter").exists()
+
+
+def test_production_loop_enables_real_gradient_checkpointing(inputs, tmp_path, monkeypatch):
+    import self_improvement.continuation.training as module
+    config = dict(inputs["config"], gradient_checkpointing=True)
+    doc = json.loads(inputs["manifest"].read_text())
+    doc["training_config"] = config
+    inputs["manifest"].write_text(json.dumps(doc))
+    real_load = module.load_p0_adapter
+    captured = []
+    def capture(base, adapter):
+        model = real_load(base, adapter)
+        captured.append(model)
+        return model
+    monkeypatch.setattr(module, "load_p0_adapter", capture)
+    result = run(inputs, tmp_path / "checkpointed", config=config)
+    assert result["status"] == "COMPLETED"
+    assert captured[0].is_gradient_checkpointing is True
+    assert captured[0].config.use_cache is False
+
+
+def test_explicit_fused_optimizer_flag_is_recorded_without_fallback(inputs, tmp_path):
+    config = dict(inputs["config"], optimizer_fused=True)
+    doc = json.loads(inputs["manifest"].read_text())
+    doc["training_config"] = config
+    inputs["manifest"].write_text(json.dumps(doc))
+    result = run(inputs, tmp_path / "fused", config=config)
+    assert result["status"] == "COMPLETED"
+    events = [json.loads(line) for line in (tmp_path / "fused/training_events.jsonl").read_text().splitlines()]
+    options = [row for row in events if row["kind"] == "optimizer_configured"]
+    assert len(options) == 1 and options[0]["fused"] is True and options[0]["initial_state_entries"] == 0
+    steps = [row for row in events if row["kind"] == "optimizer_step_started"]
+    assert [row["learning_rate"] for row in steps] == pytest.approx([config["learning_rate"] * .55, config["learning_rate"] * .1])
+
+
+def test_accumulation_weights_each_active_token_like_combined_batch(inputs, tmp_path, monkeypatch):
+    inputs["rows"][1]["completion"] = "A2long"
+    inputs["data"].write_text("".join(json.dumps(r) + "\n" for r in inputs["rows"]))
+    review = json.loads(inputs["review"].read_text())
+    review["dataset_sha256"] = file_sha256(inputs["data"])
+    inputs["review"].write_text(json.dumps(review))
+    manifest = json.loads(inputs["manifest"].read_text())
+    manifest["dataset"]["sha256"] = file_sha256(inputs["data"])
+    manifest["independent_review"]["sha256"] = file_sha256(inputs["review"])
+    original_step = torch.optim.AdamW.step
+    gradients = []
+    def capture(optimizer, *args, **kwargs):
+        gradients.append([p.grad.detach().clone() for group in optimizer.param_groups for p in group["params"] if p.grad is not None])
+        return original_step(optimizer, *args, **kwargs)
+    monkeypatch.setattr(torch.optim.AdamW, "step", capture)
+    for name, batch, accum in (("micro", 1, 2), ("batch", 2, 1)):
+        cfg = dict(inputs["config"], batch_size=batch, gradient_accumulation_steps=accum, optimizer_steps=1)
+        manifest["training_config"] = cfg
+        inputs["manifest"].write_text(json.dumps(manifest))
+        run(inputs, tmp_path / name, config=cfg)
+    assert len(gradients) == 2 and len(gradients[0]) == len(gradients[1])
