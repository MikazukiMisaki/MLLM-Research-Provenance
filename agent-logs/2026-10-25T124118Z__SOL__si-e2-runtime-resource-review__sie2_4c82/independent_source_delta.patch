+class ReadIsolatedEnvironment(AlfWorldTextEnvironment):
+    """Old normalization, fresh TextWorld seed, and no global dataset discovery."""
+    def __init__(self, config: AlfWorldConfig, *, game: Path, pool_seed: int,
+                 factory_boundary: Any = None) -> None:
+        require(config.split == "train" and game.name == "game.tw-pddl", "exact historical TRAIN game")
+        super().__init__(config)
+        self.game, self.pool_seed, self.factory_boundary = game, pool_seed, factory_boundary
+        self.isolation: dict[str, Any] = {}
+        self.previous_data_environment = os.environ.get("ALFWORLD_DATA")
+
+    def _get_environment(self) -> Any:
+        if self._environment is not None: return self._environment
+        import yaml
+        if self._config.data_path is not None: os.environ["ALFWORLD_DATA"] = str(self._config.data_path)
+        configuration = _expand_environment(yaml.safe_load(self._config.config_path.read_text()))
+        # Apply BEFORE __init__: stock AlfredTWEnv otherwise opens all TRAIN bodies.
+        configuration = copy.deepcopy(configuration)
+        configuration["dataset"]["data_path"] = str(self.game.parent)
+        self.isolation = {"original_config_unchanged": True, "effective_dataset_data_path": str(self.game.parent),
+                          "exact_game": str(self.game), "pool_seed": self.pool_seed,
+                          "discovery": "explicit_no_scan_subclass", "scope": ISOLATION_RULING}
+        if self._config.data_path is not None: os.environ["ALFWORLD_DATA"] = str(self._config.data_path)
+        if self.factory_boundary is None:
+            from alfworld.agents.environment.alfred_tw_env import AlfredTWEnv
+            target = str(self.game)
+            class OneHistoricalGame(AlfredTWEnv):
+                def collect_game_files(self, verbose: bool = False) -> None:
+                    self.game_files = [target]
+                    self.num_games = 1
+            factory = OneHistoricalGame(configuration, train_eval="train")
+        else:
+            # Only explicit software edge substitution; never exposed by the real CLI.
+            factory = self.factory_boundary(configuration, train_eval="train")
+        require(factory.game_files == [str(self.game)], "factory discovered a foreign task")
+        factory.num_games = 1
+        environment = factory.init_env(batch_size=1)
+        self._environment = environment  # Retain even if seed fails, so cleanup can close it.
+        environment.seed(self.pool_seed)
+        return environment
+
+    def initialize(self) -> Mapping[str, Any]:
+        self._get_environment()
+        return self.isolation
+
+    def close(self) -> None:
+        if self._environment is not None:
+            self._environment.close()
+            self._environment = None
+        if self.previous_data_environment is None: os.environ.pop("ALFWORLD_DATA", None)
+        else: os.environ["ALFWORLD_DATA"] = self.previous_data_environment
+
