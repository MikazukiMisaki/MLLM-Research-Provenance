+            fraction=mem.get_per_process_memory_fraction(0);stats=mem.memory_stats(0)
+            names=('allocated_bytes.all.current','allocated_bytes.all.peak','reserved_bytes.all.current','reserved_bytes.all.peak','num_ooms','num_alloc_retries')
+            _need(type(fraction) is float and math.isfinite(fraction) and abs(fraction*total-self.limit)<=1, 'allocator limit drift')
+            _need(all(k in stats and type(stats[k]) is int and stats[k]>=0 for k in names), 'allocator stats missing')
+            observed.update(allocator_backend='native',allocator_fraction=fraction,allocator_limit_bytes=self.limit,allocator_stats={k:stats[k] for k in names})
+            _need(stats['num_ooms']==0, 'CUDA allocator OOM observed')
+            _need(not self.engineering_only or stats['num_alloc_retries']==0, 'engineering allocator retry observed')
