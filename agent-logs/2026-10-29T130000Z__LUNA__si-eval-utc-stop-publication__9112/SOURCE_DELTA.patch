+    binding=launch.get('binding');_need(type(binding) is dict and binding.get('schema')=='SI_U1_EVAL_BINDING_V1' and binding.get('output_path')==str(output) and binding.get('source_sha')==launch.get('source_sha') and binding.get('authorization_sha256')==launch.get('authorization_sha256'),'partial external context')
+    _need(launch.get('evidence_class')=='live' and launch.get('allocated_devices')==1 and launch.get('science_authorized') is True and worker.get('authorization_sha256')==launch.get('authorization_sha256') and worker.get('launch_context_sha256')==_sha(lp) and type(worker.get('pid')) is int and type(worker.get('start_tick')) is int and worker.get('pgid')==worker.get('pid') and worker.get('sid')==worker.get('pid'),'partial worker identity')
