+def test_raw_identity_survives_abrupt_child_exit_without_ledger_close(tmp_path):
+    script = r"""
+import json, os, sys
+from pathlib import Path
+from types import SimpleNamespace
+sys.path[:0] = sys.argv[1:3]
+from si_e2_support import GPU, permit
+from self_improvement.si_p3.runtime_backend import verify_cuda_uuid
+from self_improvement.si_p3.runtime_ledger import EngineeringLedger
+from self_improvement.si_p3.contract import ContractError
+p=permit(Path(sys.argv[3]));p.output.mkdir()
+ledger=EngineeringLedger(p.output/'durable.jsonl',p,evidence_class='synthetic_software_fixture')
+try:
+    verify_cuda_uuid(SimpleNamespace(cuda=SimpleNamespace(get_device_properties=lambda ordinal: SimpleNamespace(uuid='missing'))),ledger,GPU,point='cuda_uuid_before_context')
+except ContractError:
+    os._exit(23)
+os._exit(99)
+"""
+    repo = Path(__file__).resolve().parents[1]
+    argv = [sys.executable, "-I", "-c", script, str(repo / "src"), str(repo / "tests"), str(tmp_path)]
+    child = subprocess.run(argv, capture_output=True, env={"PATH": os.defpath, "CUDA_VISIBLE_DEVICES": "", "PYTHONDONTWRITEBYTECODE": "1"}, timeout=20)
+    (tmp_path / "child.stdout").write_bytes(child.stdout)
+    (tmp_path / "child.stderr").write_bytes(child.stderr)
+    (tmp_path / "child_receipt.json").write_text(json.dumps({"argv": argv, "authentic_returncode": child.returncode}))
+    assert child.returncode == 23, child.stderr.decode()
+    rows = [json.loads(line) for line in (tmp_path / "output/durable.jsonl").read_text().splitlines()]
+    assert rows[-1]["payload"]["observed"]["uuid"]["str"] == "missing"
+    assert reconstruct(rows)["external_started"] == 0
