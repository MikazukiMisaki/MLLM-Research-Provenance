+
+def test_nonempty_source_fixture_reaches_synthetic_report_renderer(tmp_path, monkeypatch):
+    row, events, physical, _, env, _, _ = run_source(tmp_path, monkeypatch, ['A001'])
+    assert row['steps'] and env.actions
+    def cost(total, actions):
+        return {'input_tokens': total - 1, 'generated_tokens': 1, 'total_tokens': total,
+                'model_calls': 1, 'environment_actions': actions}
+    branch = {
+        'prefix_id': 'synthetic-source-report', 'attempted': True,
+        'eligible_primary': True, 'stratum': 'failure',
+        'task_family': 'pick_and_place_simple', 'continue_success': 0,
+        'continue_logical_cost': {'full_branch': cost(12, 2)},
+        'k_results': {
+            str(k): {'success': int(k >= 3), 'logical_cost': {
+                'full_branch': cost(10 + k, k), 'recovery_only': cost(4 + k, k - 1),
+            }} for k in range(1, 6)
+        },
+    }
+    from recovery.r19_duration import analyze_duration_branches
+    summary = analyze_duration_branches([branch])
+    provenance = {
+        **physical, 'protocol_sha256': 'a' * 64,
+        'events_sha256': hashlib.sha256(json.dumps(events, sort_keys=True).encode()).hexdigest(),
+        'branches_sha256': hashlib.sha256(json.dumps([branch], sort_keys=True).encode()).hexdigest(),
+        'live_scope_validation': None,
