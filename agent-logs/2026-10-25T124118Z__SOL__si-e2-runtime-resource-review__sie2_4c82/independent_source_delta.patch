+def inspect_gpu(gpu_uuid: str, *, allowed_pids: set[int], require_owned_context: bool = False) -> dict[str, Any]:
+    """Read actual NVIDIA ownership; never allocate a CUDA context."""
+    def query(option: str) -> str:
+        return subprocess.check_output(["nvidia-smi", option, "--format=csv,noheader,nounits"], text=True, timeout=10)
+    gpu_raw = query("--query-gpu=uuid,name,memory.total,memory.used")
+    process_raw = query("--query-compute-apps=gpu_uuid,pid,process_name,used_gpu_memory")
+    devices = list(csv.reader(io.StringIO(gpu_raw), skipinitialspace=True))
+    rows = list(csv.reader(io.StringIO(process_raw), skipinitialspace=True))
+    evidence = {"gpu_raw": gpu_raw, "process_raw": process_raw, "checked_pid": os.getpid()}
+    try:
+        validate_gpu_rows(devices, rows, gpu_uuid=gpu_uuid, allowed_pids=allowed_pids)
+        if require_owned_context:
+            require(any(len(row) == 4 and row[0] == gpu_uuid and int(row[1]) in allowed_pids for row in rows),
+                    "cannot prove own NVML compute PID before model allocation")
+    except ContractError as error:
+        error.resource_evidence = evidence
+        raise
+    return evidence
