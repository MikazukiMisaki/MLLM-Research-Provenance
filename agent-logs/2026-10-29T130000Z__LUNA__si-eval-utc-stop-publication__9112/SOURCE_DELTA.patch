+"""Independent CPU reconstruction of a synthetic transfer event stream."""
+from __future__ import annotations
+import json
+import math
+from pathlib import Path
+from models.action_parser import action_id_mapping
+from models.protocol_stability import parse_p2_selection
+from self_improvement.si_p3.contract import PublicState, projection
+from .evaluator import ARMS, COUNTERS, HORIZON, OUTPUT_CAP, _hash, _need, validate_generation, validate_manifest
+from .return_audit import add_return, generation_observation, validate_completed
+
+
+def audit_interrupted(path: Path, *, allow_closed: bool = False) -> dict:
+    """Reconcile durable reservations/returns after abrupt death; never certify outcomes."""
+    raw=Path(path).read_bytes();trailing_unknown=bool(raw and not raw.endswith(b'\n'))
+    if trailing_unknown:raw=raw[:raw.rfind(b'\n')+1]
+    rows = [json.loads(line) for line in raw.splitlines()]
+    _need(rows and rows[0]['kind'] == 'run_opened' and (allow_closed or rows[-1]['kind'] != 'run_closed'), 'interrupted journal required')
+    previous = None;last_monotonic=-float('inf')
+    for i, row in enumerate(rows):
+        _need(set(row)=={'sequence','previous','kind','payload','monotonic','event_id'} and row['sequence'] == i and row['previous'] == previous and row['event_id'] == _hash({k:v for k,v in row.items() if k!='event_id'}), 'interrupted journal chain')
+        _need(type(row['monotonic']) in (int,float) and math.isfinite(row['monotonic']) and row['monotonic']>=last_monotonic,'interrupted journal clock')
+        previous = row['event_id'];last_monotonic=row['monotonic']
+    manifest = validate_manifest(rows[0]['payload']['manifest'])
+    header=rows[0]['payload'];_need(header['schema']=='SI_TRANSFER_EVAL_EVENTS_V1' and header['manifest_sha256']==_hash(manifest) and header['horizon']==HORIZON and header['output_cap']==OUTPUT_CAP,'interrupted header binding')
+    units={};active=None;spent=dict.fromkeys(COUNTERS,0);episodes=[];closed=None
+    schedule=[(a,t['task_id']) for a in ARMS for t in manifest['tasks']]
+    for row in rows[1:]:
+        p=row['payload'];kind=row['kind']
+        if kind=='unit_started':
+            ident=p['identity'];unit=p['unit'];op=ident['op'];debit=dict.fromkeys(COUNTERS,0)
+            _need(active is None and unit not in units and unit==_hash(ident) and ident['arm'] in ARMS and op in ('model_load','environment_construct','reset','generation','step','environment_close','model_close'), 'interrupted reservation identity')
+            if op in ('reset','step'):debit['environment_operations']=1
+            if op=='generation':
+                prep=p['prepared'];_need(type(prep) is dict and type(prep.get('input_ids')) is list and bool(prep['input_ids']), 'interrupted generation input')
+                debit.update(generations=1,input_tokens=len(prep['input_ids']),output_tokens=OUTPUT_CAP)
+            _need(p['reservation']==debit and all(spent[k]+debit[k]<=manifest['limits'][k] for k in COUNTERS), 'interrupted debit')
+            spent={k:spent[k]+debit[k] for k in COUNTERS};units[unit]={'identity':ident,'started':row['event_id'],'prepared':p['prepared'],'returns':[],'debit':debit};active=unit
+        elif kind=='external_returned':
+            unit=p['unit'];_need(active==unit and p['identity']==units[unit]['identity'], 'interrupted return identity');add_return(units[unit],units[unit]['identity']['op'],row)
+        elif kind in ('unit_completed','unit_failed'):
+            unit=p['unit'];_need(active==unit and p['identity']==units[unit]['identity'] and p['started_event']==units[unit]['started'] and p['return_events']==[x['id'] for x in units[unit]['returns']], 'interrupted completion identity')
+            if kind=='unit_completed':
+                u=units[unit];op=u['identity']['op'];validate_completed(u,op,p['data'],require_live=rows[0]['payload']['evidence_class']=='live')
+                actual=dict(u['debit'])
+                if op=='generation':actual['output_tokens']=len(p['data']['token_ids'])
+                _need(p['actual']==actual and actual['output_tokens']<=u['debit']['output_tokens'],'interrupted actual debit')
+                spent['output_tokens']-=u['debit']['output_tokens']-actual['output_tokens']
+            active=None
+        elif kind=='episode_closed':
+            _need(active is None and len(episodes)<len(schedule) and (p['arm'],p['task_id'])==schedule[len(episodes)],'interrupted episode schedule')
+            episodes.append(p)
+        elif kind=='run_closed':
+            _need(allow_closed and row is rows[-1] and active is None,'partial closed journal position');closed=p
+        else:_need(kind in ('arm_started','arm_finished','run_stopped'), 'interrupted unexpected event')
+    observed={(x['arm'],x['task_id']) for x in episodes}
+    pending=[{'arm':a,'task_id':t['task_id'],'outcome':None} for a in ARMS for t in manifest['tasks'] if (a,t['task_id']) not in observed]
+    if closed is not None:
+        _need(closed['schema']=='SI_TRANSFER_EVAL_REPORT_V1' and closed['evidence_class']==rows[0]['payload']['evidence_class'] and closed['manifest_sha256']==_hash(manifest) and closed['episodes']==episodes and closed['pending_na']==pending and closed['reserved_or_spent']==spent,'partial closed physical report')
+    return {'status':'INTERRUPTED_PARTIAL_NOT_COMPARABLE','reserved_or_spent':spent,'active_unit':active,'generation_return_observation':generation_observation(units.values()),'pending_na':pending,'closed_report_present':closed is not None,'unknown_trailing_bytes':trailing_unknown}
+
+
+def audit_partial_live(path: Path, *, live_output: Path) -> dict:
+    """Authenticate incomplete/failed live execution; never certify a comparison."""
+    from .live_audit import authenticate_partial_run, partial_resources
+    output=Path(live_output);_need(Path(path)==output/'evaluation'/'events.jsonl','partial journal path')
+    context=authenticate_partial_run(output);raw=Path(path).read_bytes();first=json.loads(raw.split(b'\n',1)[0]);header=first['payload']
+    _need(header['evidence_class']=='live' and header['live_binding']==context['binding'],'partial real supervisor binding')
+    result=audit_interrupted(path,allow_closed=True)
+    return dict(result)|{'status':'PARTIAL_NOT_COMPARABLE','supervisor':context['supervisor'],'resource':partial_resources(output)}
+
+
+def audit(path: Path, *, decode, eos_ids, live_output: Path | None = None) -> dict:
+    """Validate physical receipts and outcomes; no producer/environment is called."""
+    rows = [json.loads(line) for line in Path(path).read_text().splitlines()]
+    _need(bool(rows), "empty journal")
+    previous = None
+    last_monotonic = -float("inf")
+    for index, row in enumerate(rows):
+        _need(set(row) == {"sequence", "previous", "kind", "payload", "monotonic", "event_id"} and row["sequence"] == index and row["previous"] == previous, "journal sequence")
+        _need(row["event_id"] == _hash({k: v for k, v in row.items() if k != "event_id"}), "journal hash")
+        _need(type(row["monotonic"]) in (int, float) and math.isfinite(row["monotonic"]) and row["monotonic"] >= last_monotonic, "journal clock")
+        last_monotonic = row["monotonic"]; previous = row["event_id"]
+    _need(rows[0]["kind"] == "run_opened" and rows[-1]["kind"] == "run_closed", "journal boundaries")
+    header = rows[0]["payload"]; m = validate_manifest(header["manifest"])
+    _need(header["schema"] == "SI_TRANSFER_EVAL_EVENTS_V1" and header["manifest_sha256"] == _hash(m) and header["horizon"] == HORIZON and header["output_cap"] == OUTPUT_CAP, "header binding")
+    if header['evidence_class']=='live':
+        from .live_audit import authenticate_run
+        _need(live_output is not None and Path(path)==Path(live_output)/'evaluation'/'events.jsonl' and header['live_binding']==authenticate_run(live_output), 'external live provenance')
+    else:
+        _need(header['evidence_class']=='synthetic' and header.get('live_binding') is None and live_output is None, 'synthetic evidence class')
+    lookup = {t["task_id"]: t for t in m["tasks"]}; schedule = [(a, t["task_id"]) for a in ARMS for t in m["tasks"]]
+    units = {}; active = None; totals = dict.fromkeys(COUNTERS, 0); completed = dict.fromkeys(COUNTERS, 0)
+    context = {}; outcomes = []; stopped = None; loaded = []
+    arm_totals = {a: dict.fromkeys(COUNTERS, 0) for a in ARMS}; arm_completed = {a: dict.fromkeys(COUNTERS, 0) for a in ARMS}; begun=[];finished=[];arm_start=None
+    for row in rows[1:-1]:
+        kind, p = row["kind"], row["payload"]
