+"""Real CPU software children only; never an actual engineering invocation."""
+from pathlib import Path
+import json,os,sys
+import pytest
+from self_improvement.si_s01.engineering_supervisor import supervise_engineering,engineering_exit_ok
+from self_improvement.si_s01.engineering_contract import PURPOSE,SOFTWARE
+from self_improvement.si_s01.contract import ContractError
+
+@pytest.mark.parametrize('code',[0,7])
+def test_engineering_supervisor_preserves_exit_but_exit0_without_report_is_not_success(tmp_path,code):
+    context={'purpose':PURPOSE,'science_authorized':False,'evidence_class':SOFTWARE,'authorization_sha256':'a'*64,'source_sha':'b'*40}
+    r=supervise_engineering([sys.executable,'-I','-c',f'raise SystemExit({code})'],tmp_path/'run',context=context,seconds=600,environment={'PATH':os.defpath,'CUDA_VISIBLE_DEVICES':''})
+    assert r['authentic_returncode']==code and r['science_authorized'] is False and r['allocated_device_hours']==0
+    assert r['cleanup_established'] and not r['child_report_present'] and not engineering_exit_ok(r,None)
+    assert not engineering_exit_ok(r,{'status':'OBSERVED_PUBLIC_PATH_COMPATIBLE_NOT_RNG_RECONSTRUCTED'})
+    assert json.loads((tmp_path/'run.launch_claim.json').read_text())['purpose']==PURPOSE
+    with pytest.raises(ContractError):supervise_engineering([sys.executable,'-I','-c','pass'],tmp_path/'other',context=context,seconds=601,environment={})
+    with pytest.raises((ContractError,FileExistsError)):supervise_engineering([sys.executable,'-I','-c','pass'],tmp_path/'run',context=context,seconds=1,environment={})
+
+
+def test_engineering_supervisor_deadline_keeps_real_exit_and_cleanup_receipt(tmp_path):
+    r=supervise_engineering([sys.executable,'-I','-c','import time;time.sleep(20)'],tmp_path/'run',context={'purpose':PURPOSE,'science_authorized':False,'evidence_class':SOFTWARE,'authorization_sha256':'a'*64,'source_sha':'b'*40},seconds=.5,environment={'PATH':os.defpath,'CUDA_VISIBLE_DEVICES':''})
+    assert r['deadline_triggered'] and r['authentic_returncode']!=0 and r['cleanup_established'] and not r['members_after_cleanup'] and not engineering_exit_ok(r,None)
