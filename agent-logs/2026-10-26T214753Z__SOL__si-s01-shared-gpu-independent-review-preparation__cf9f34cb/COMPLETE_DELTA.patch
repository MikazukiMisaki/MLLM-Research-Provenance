+"""Full96 synthetic source pipeline through real collector/actor/guards/independent auditor."""
+from dataclasses import replace
+from pathlib import Path
+from copy import deepcopy
+import json,os,sys
+import pytest
+from self_improvement.si_s01.contract import canonical,ContractError
+from self_improvement.si_s01.gate import Permit
+from self_improvement.si_s01.runtime import LiveProducer
+from self_improvement.si_s01.runtime_core import load_guarded
+from self_improvement.si_s01.shared_resource import guard_for,binding,local_identity
+from self_improvement.si_s01.collector import Collector
+from self_improvement.si_s01.audit import audit
+from si_s01_shared_support import shared_fixture
+from si_s01_support import gate_fixture,plan,FakeEnv,context_fixture
+from si_s01_engineering_support import file_binding
+
+
+def source_fixture(tmp,monkeypatch,*,stop=False):
+    f=shared_fixture(tmp/'edges',monkeypatch);d=tmp/'source';d.mkdir();a,p,ap,pp,save=gate_fixture(d,Path(__file__).resolve().parents[1])
+    a['schema']='SI_S01_AUTHORIZATION_V2';a['resource_policy']=binding();a['environment']=deepcopy(f.auth['environment']);p['packages']=deepcopy(f.proposal['packages']);p['model']=deepcopy(f.proposal['model']);pp.write_text(canonical(p));a['proposal_sha256']=file_binding(pp)['sha256'];ap.write_text(canonical(a))
+    permit=Permit(a,p,plan(),Path(__file__).resolve().parents[1],file_binding(ap)['sha256'],file_binding(pp)['sha256']);permit=context_fixture(d,permit)
+    worker=Path(permit.context_evidence['worker_path']);value=json.loads(worker.read_text());identity=local_identity();value.update(start_tick=identity['start_tick'],pgid=identity['pgid'],sid=identity['sid']);worker.write_text(canonical(value));permit=replace(permit,context_evidence=permit.context_evidence|{'worker_sha256':file_binding(worker)['sha256']})
+    if stop:f.state.post_free=0
+    def loader(ledger):return load_guarded(LiveProducer,permit,ledger,evidence_class=permit.plan.evidence_class,resource_policy=guard_for(permit,ledger))
+    collector=Collector(permit.plan,loader,lambda slot:FakeEnv(slot,{}),permit.output,run_id=a['run_id'],ceilings=permit.ceilings,devices=1,started_at=json.loads(Path(permit.context_evidence['launch_path']).read_text())['allocation_started_monotonic'],live_permit=permit)
+    producer,reason=collector.run()
+    return f,permit,collector,producer,reason
+
+
+def test_shared_full96_production_source_pipeline_with_no_teacher_or_NVML_ownership(tmp_path,monkeypatch):
+    f,p,c,producer,reason=source_fixture(tmp_path,monkeypatch);assert reason is None
+    r=audit(p.output/'source_events.jsonl',p.output/'source_trajectories.jsonl',p.plan,producer,authority=p)
+    assert r['source_phase_sealed'] and r['normal_sources']==96 and r['all_YT'] is None
+    assert r['physical']['completed']['generations']==672 and r['shared_resource']['validated_resource_samples']==3+2*672
+    assert f.state.calls['resource_query_fake']==0 and f.state.calls['one_byte_fake']==1
+    assert all(x['Y0']==1 and x['YT'] is None for x in c.rows)
+
+
+def test_shared_resource_technical_stop_is_not_task_failure_or_structural_no_go(tmp_path,monkeypatch):
+    f,p,c,producer,reason=source_fixture(tmp_path,monkeypatch,stop=True);assert reason is not None
+    r=audit(p.output/'source_events.jsonl',p.output/'source_trajectories.jsonl',p.plan,producer,authority=p)
+    assert not r['source_phase_sealed'] and r['upper_bounds'] is None and r['normal_sources']==0
+    assert r['status']!='COMPLETE_SOURCE96_STRUCTURAL_NO_GO' and all(x['Y0'] is None and x['disposition']=='NOT_NORMAL_SOURCE' for x in c.rows)
+    assert r['physical']['observed_returned_generation_boundaries']==1 and f.state.calls['generation']==1
+
+
+def test_source_auditor_rejects_wrong_resource_mode_before_scientific_summary(tmp_path,monkeypatch):
+    f,p,c,producer,reason=source_fixture(tmp_path,monkeypatch,stop=True)
