+    checked_context(permit,identity)
+    nvml=raw['NVML'];insist(nvml=={'status':'NOT_COLLECTED','mapping':'UNPROVEN_NOT_ASSERTED'},'shared NVML must not assert ownership')
+    device=raw['cuda'];insist(set(device)=={'device_count','ordinal','uuid','observation'} and type(device['device_count']) is int and device['device_count']==1 and type(device['ordinal']) is int and device['ordinal']==0 and device['uuid']==permit.gpu_uuid,'shared actual CUDA device binding')
+    observed=device['observation'];insist(observed['point']=='shared_'+raw['point'] and observed['observed']['expected_uuid']==permit.gpu_uuid and observed['observed']['device']==0 and cuda_uuid_matches(observed['observed']['uuid']['str'],permit.gpu_uuid),'shared observed raw CUDA UUID')
+    memory=raw['global_memory'];insist(set(memory)=={'free_bytes','total_bytes'} and all(type(v) is int for v in memory.values()) and 0<=memory['free_bytes']<=memory['total_bytes'],'shared global memory integer bounds')
+    c=contract();total=memory['total_bytes'];insist(total>=c['preweight_global_free_min_bytes'],'shared device total capacity')
+    alloc=raw['allocator'];insist(set(alloc)=={'backend','requested_fraction','readback_fraction','effective_limit_bytes','configuration','stats'} and alloc['backend']=='native' and alloc['configuration']==c['allocator_config'],'shared native allocator evidence')
+    requested=c['allocator_cap_bytes']/total;effective=int(requested*float(total));readback=alloc['readback_fraction']
+    insist(type(alloc['requested_fraction']) is float and alloc['requested_fraction']==requested and type(alloc['effective_limit_bytes']) is int and alloc['effective_limit_bytes']==effective and 0<effective<=c['allocator_cap_bytes'],'shared independent fraction/cap reconstruction')
+    insist(type(readback) is float and math.isfinite(readback) and 0<readback<=1 and abs(readback*total-effective)<=c['readback_reconstruction_tolerance_bytes'],'shared independent readback reconstruction')
+    stats=alloc['stats'];insist(set(stats)==set(STATS) and all(type(v) is int and v>=0 for v in stats.values()),'shared explicit mandatory stats; no default zero')
+    a,ap,r,rp=(stats[k] for k in STATS[:4]);insist(a<=r<=effective and a<=ap<=rp<=effective and r<=rp,'shared independent stats/cap consistency')
+    if raw['point']=='one_byte_before_weights':insist(raw['probe']=={'bytes':1,'synchronized':True} and a>=1 and r>=a,'shared live synchronized probe evidence')
+    else:insist(raw['probe'] is None,'shared probe only at original point')
+    if raw['point']!='configured_before_probe':
+        floor=c['preweight_global_free_min_bytes'] if raw['point']=='one_byte_before_weights' else c['later_global_free_min_bytes']
+        insist(memory['free_bytes']>=floor,'shared independent sampled free threshold')
+    return stats
+
+
+def audit_resources(events,permit,header):
+    """Require successful physical units' full resource chain, retaining failed prefixes."""
+    b=policy_binding(permit.authorization)
+    if b is None:return None
+    worker=header.get('live_binding',header)
+    insist(worker.get('resource_policy')==b,'shared externally bound event header resource policy')
+    units={};points={};uuids={};ordinal=0;previous=None;last=header['allocation_started_monotonic'];intent=None;configured=None;rejected=False;count=0;allocator_binding=None;worker_identity=None
+    def accept(raw,point,unit,event):
+        nonlocal ordinal,previous,last,count,allocator_binding
+        stats=validate_receipt(raw,permit,header,point=point,unit=unit)
+        insist(raw['local_worker']==worker_identity,'shared worker identity changed after initialization intent')
+        observed_binding=(raw['global_memory']['total_bytes'],raw['allocator']['requested_fraction'],raw['allocator']['readback_fraction'],raw['allocator']['effective_limit_bytes'],raw['allocator']['configuration'],raw['allocator']['backend'])
+        if allocator_binding is None:
+            insist(point=='configured_before_probe','shared initial configured allocator binding');allocator_binding=observed_binding
+        insist(observed_binding==allocator_binding,'shared allocator configured total/fraction/configuration drift')
+        insist(raw['ordinal']==ordinal and last<=raw['observed_monotonic']<=event['monotonic'],'shared resource monotonic ordinal/sequence')
+        insist(units[unit]['started_monotonic']<=raw['observed_monotonic'],'shared sample predates durable unit reservation')
+        insist(uuids.get((unit,point))==raw['cuda']['observation'],'shared raw UUID observation/event link')
+        if previous is not None:insist(all(stats[k]>=previous[k] for k in (STATS[1],STATS[3],STATS[4],STATS[5])),'shared independent peak/counter rollback')
+        insist(point not in points.setdefault(unit,set()),'shared repeated resource point')
+        points[unit].add(point);ordinal+=1;previous=deepcopy(stats);last=raw['observed_monotonic'];count+=1
+    for event in events[1:]:
+        kind=event['kind'];p=event['payload']
+        if kind=='unit_started':
+            units[p['unit']]={'kind':p['identity']['kind'],'finished':False,'failed':False,'started_monotonic':event['monotonic']}
+            if rejected:insist(p['identity']['kind']=='env_close','shared external unit after resource rejection')
+        elif kind=='runtime_evidence':
+            unit=p['unit'];tag=p['kind'];data=p['data']
+            if tag=='resource':
+                insist(intent is not None,'shared CUDA observation before durable initialization intent')
+            if tag=='resource' and data.get('point','').startswith('shared_'):
+                point=data['point'].removeprefix('shared_');insist((unit,point) not in uuids,'shared repeated UUID point');uuids[unit,point]=data
+            elif tag=='shared_resource_intent':
+                insist(intent is None and units[unit]['kind'] in ('model_load','context_probe') and data['unit']==unit and data['authority']==authority(permit) and data['resource_policy']==b and data['point']=='intent_before_cuda','shared pre-CUDA persistent intent')
+                checked_context(permit,data['local_worker']);intent=unit;worker_identity=deepcopy(data['local_worker'])
+                insist(max(header['allocation_started_monotonic'],units[unit]['started_monotonic'])<=data['observed_monotonic']<=event['monotonic'],'shared initialization intent allocation/reservation timing')
+            elif tag=='shared_allocator_configured':
+                insist(intent==unit and configured is None,'shared setup intent/order');accept(data,'configured_before_probe',unit,event);configured=unit
+            elif tag=='one_byte_before_weights':
+                insist(configured==unit,'shared original one-byte after setup');accept(data,'one_byte_before_weights',unit,event)
+            elif tag=='model_loaded':
+                insist(configured is not None and 'one_byte_before_weights' in points[configured] and units[unit]['kind']=='model_load','shared model after bounded original probe');accept(data['resource'],'model_loaded',unit,event)
+            elif tag=='resource_before_generation':
+                insist(units[unit]['kind']=='generation' and any('model_loaded' in v for v in points.values()),'shared generation after guarded load');accept(data,'before_generation',unit,event)
+            elif tag=='generation_returned':
+                insist('before_generation' in points.get(unit,set()),'shared actual return lacks pre-call resource evidence')
+            elif tag=='shared_resource_rejected':
+                insist(data['authority']==authority(permit) and data['resource_policy']==b and data['unit']==unit,'shared failure evidence binding');rejected=True
+        elif kind in ('unit_completed','unit_failed'):
+            unit=p['unit'];op=units[unit]['kind'];units[unit]['failed']=kind=='unit_failed';units[unit]['finished']=kind=='unit_completed'
+            if kind=='unit_failed':continue
+            if op=='model_load':insist('model_loaded' in points.get(unit,set()),'shared completed load lacks resource evidence')
+            if op=='context_probe':insist({'configured_before_probe','one_byte_before_weights'}<=points.get(unit,set()),'shared completed probe lacks evidence')
+            if op=='generation':
+                insist('before_generation' in points.get(unit,set()),'shared completed generation lacks precheck')
+                accept(p['data']['runtime']['resource_after'],'after_generation',unit,event)
+    return {'resource_policy':b,'validated_resource_samples':count,'resource_rejected':rejected,'resource_accounting':'FULL_ONE_DEVICE_ELAPSED_SHARED_NONEXCLUSIVE','NVML_mapping':'UNPROVEN_NOT_ASSERTED'}
