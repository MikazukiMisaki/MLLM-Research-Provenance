+"""Authenticate one live supervisor/worker against the frozen SI-U1 artifacts."""
+from __future__ import annotations
+from dataclasses import dataclass
+from datetime import datetime, timezone
+import hashlib,json,os,re,sys,time
+from pathlib import Path
+from .evaluator import _need
+from .gate import authenticate_preflight
+from .runtime_binding import file_binding
+from self_improvement.si_m1.gate import arm_parent_death
+
+@dataclass(frozen=True)
+class LivePermit:
+    authorization: dict
+    authorization_sha256: str
+    clearance: dict
+    clearance_sha256: str
+    output: Path
+    binding: dict
+    manifest: dict
+    spec: dict
+    protocol: dict
+
+@dataclass(frozen=True)
+class WorkerPermit:
+    live: LivePermit
+    allocation_started_monotonic: float
+    launch_context_sha256: str
+    worker_start_sha256: str
+
+
+def authenticate_live(repository: Path, auth_path: Path, auth_sha: str, clearance_path: Path, clearance_sha: str, *, mode: str, argv: list[str]) -> LivePermit:
+    _need(mode in ('live','worker'), 'live gate mode')
+    # Re-run every static reviewed check. The actual preflight invocation is
+    # independently bound below, so this recheck does not impersonate it.
+    raw_a=file_binding({'path':str(auth_path.resolve()),'sha256':auth_sha}).read_bytes();original=json.loads(raw_a)
+    preflight_argv=[auth_sha if x=='@AUTHORIZATION_SHA256@' else x for x in original['preflight_argv']]
+    a,expected_preflight=authenticate_preflight(repository,auth_path,auth_sha,argv=preflight_argv,_release_recheck=True)
+    receipt_path=Path(a['receipt_path']);receipt_raw=receipt_path.read_bytes();_need(json.loads(receipt_raw)==expected_preflight, 'exact positive preflight receipt')
+    clear_path=clearance_path.resolve();c=json.loads(file_binding({'path':str(clear_path),'sha256':clearance_sha}).read_bytes())
+    fields={'schema','decision','authorization_sha256','preflight_receipt_sha256','preflight_execution','source_sha','manifest_sha256','runtime_spec_sha256','review_sha256','plan_sha256','protocol_sha256','run_id','not_before','expires','maximum_launches','retry_authorized','live_argv'}
+    _need(set(c)==fields and c['schema']=='SI_U1_EVAL_CLEARANCE_V1' and c['decision']=='RELEASE_ONE_THREE_ARM_EVALUATION' and c['authorization_sha256']==auth_sha and c['preflight_receipt_sha256']==hashlib.sha256(receipt_raw).hexdigest(), 'one clearance bound to genuine preflight')
+    _need(c['source_sha']==a['source_sha'] and all(c[k+'_sha256']==a[k]['sha256'] for k in ('manifest','runtime_spec','review','plan','protocol')), 'clearance exact source/artifacts')
+    _need(type(c['maximum_launches']) is int and c['maximum_launches']==1 and c['retry_authorized'] is False and re.fullmatch('[0-9a-f]{32}',c['run_id']), 'one distinct no-retry run')
+    def utc(x):
+        v=datetime.fromisoformat(x.replace('Z','+00:00'));_need(v.tzinfo is not None,'UTC timezone');return v.astimezone(timezone.utc)
+    now=datetime.now(timezone.utc);_need(utc(c['not_before'])<=now<utc(c['expires']) and utc(c['expires'])<=utc(a['expires']), 'clearance window')
+    execution=json.loads(file_binding(c['preflight_execution']).read_bytes())
+    required={'schema','authentic_returncode','authorization_sha256','preflight_receipt_sha256','argv','source_sha','cwd','child_pid','child_start_tick','timed_out','supervisor_error','stdout_sha256','stderr_sha256','elapsed_seconds'}
+    _need(type(execution) is dict and set(execution)==required and execution['schema']=='SI_U1_PREFLIGHT_EXECUTION_V1' and execution['authentic_returncode']==0 and execution['authorization_sha256']==auth_sha and execution['preflight_receipt_sha256']==c['preflight_receipt_sha256'] and execution['argv']==preflight_argv and execution['source_sha']==a['source_sha'] and execution['cwd']==str(repository) and type(execution['child_pid']) is int and execution['child_pid']>0 and type(execution['child_start_tick']) is int and execution['child_start_tick']>0 and execution['timed_out'] is False and execution['supervisor_error'] is None, 'authentic preflight execution binding')
+    exec_dir=Path(c['preflight_execution']['path']).parent
+    _need(hashlib.sha256((exec_dir/'stdout').read_bytes()).hexdigest()==execution['stdout_sha256'] and hashlib.sha256((exec_dir/'stderr').read_bytes()).hexdigest()==execution['stderr_sha256'], 'preflight raw subprocess logs')
+    template=[a['interpreter'],'-I',str(repository/'scripts/run_si_transfer_eval.py'),'--live','--authorization',str(auth_path.resolve()),'--authorization-sha256','@AUTHORIZATION_SHA256@','--clearance',str(clear_path),'--clearance-sha256','@CLEARANCE_SHA256@']
+    _need(c['live_argv']==template,'exact live argv template')
+    live=[auth_sha if v=='@AUTHORIZATION_SHA256@' else clearance_sha if v=='@CLEARANCE_SHA256@' else v for v in template]
+    expected=live if mode=='live' else ['--worker' if x=='--live' else x for x in live]
+    if mode=='worker':
+        _need(len(argv)==len(expected)+2 and argv[:-2]==expected and argv[-2]=='--launch-context-sha256' and re.fullmatch('[0-9a-f]{64}',argv[-1]), 'exact worker argv')
+    else:_need(argv==expected, 'exact live argv')
+    out=Path(a['output_path']);claim=out.parent/(out.name+'.launch_claim.json')
+    if mode=='live':_need(not out.exists() and not claim.exists() and not claim.is_symlink(), 'one fresh launch and output')
+    else:
+        _need(out.is_dir() and claim.is_file(), 'worker supervision artifacts')
+        _need(json.loads(claim.read_bytes())=={'authorization_sha256':auth_sha,'source_sha':a['source_sha'],'maximum_launches':1,'retry_authorized':False}, 'one-shot launch claim')
+    manifest=json.loads(file_binding(a['manifest']).read_bytes());spec=json.loads(file_binding(a['runtime_spec']).read_bytes());protocol=json.loads(file_binding(a['protocol']).read_bytes())
+    binding={'schema':'SI_U1_EVAL_BINDING_V1','authorization_sha256':auth_sha,'clearance_sha256':clearance_sha,'run_id':c['run_id'],'source_sha':a['source_sha'],'manifest_sha256':a['manifest']['sha256'],'runtime_spec_sha256':a['runtime_spec']['sha256'],'protocol_sha256':a['protocol']['sha256'],'output_path':str(out),'gpu_uuid':protocol['resource']['gpu_uuid']}
+    return LivePermit(a,auth_sha,c,clearance_sha,out,binding,manifest,spec,protocol)
+
+
+def authenticate_worker(permit: LivePermit, launch_sha: str, *, argv: list[str]) -> WorkerPermit:
+    launch_path=permit.output/'launch_context.json';launch=json.loads(file_binding({'path':str(launch_path),'sha256':launch_sha}).read_bytes())
+    _need(launch['binding']==permit.binding and launch['evidence_class']=='live' and launch['allocated_devices']==1 and launch['science_authorized'] is True and launch['authorization_sha256']==permit.authorization_sha256 and launch['source_sha']==permit.authorization['source_sha'] and launch['per_arm_allocation_seconds']==permit.manifest['arm_limits']['elapsed_seconds'] and launch['max_allocation_seconds']==permit.manifest['limits']['elapsed_seconds'], 'supervisor live binding')
+    parent=[x.decode() for x in Path('/proc/'+str(os.getppid())+'/cmdline').read_bytes().split(b'\0') if x]
+    expected_live=[permit.authorization_sha256 if x=='@AUTHORIZATION_SHA256@' else permit.clearance_sha256 if x=='@CLEARANCE_SHA256@' else x for x in permit.clearance['live_argv']]
+    _need(parent==expected_live and launch['supervisor_pid']==os.getppid() and os.getsid(0)==os.getpid(), 'actual supervised parent')
+    until=time.monotonic()+2;start=permit.output/'worker_start.json'
+    while not start.exists() and time.monotonic()<until:time.sleep(.01)
+    wraw=start.read_bytes();w=json.loads(wraw);tick=int(Path('/proc/self/stat').read_text().rsplit(')',1)[1].split()[19])
+    _need(w['pid']==os.getpid() and w['uid']==os.getuid() and w['start_tick']==tick and w['argv']==argv and w['pgid']==os.getpgid(0) and w['sid']==os.getsid(0) and w['launch_context_sha256']==launch_sha and w['authorization_sha256']==permit.authorization_sha256, 'worker identity')
+    arm_parent_death(launch['supervisor_pid'],launch['supervisor_start_tick'])
+    return WorkerPermit(permit,float(launch['allocation_started_monotonic']),launch_sha,hashlib.sha256(wraw).hexdigest())
