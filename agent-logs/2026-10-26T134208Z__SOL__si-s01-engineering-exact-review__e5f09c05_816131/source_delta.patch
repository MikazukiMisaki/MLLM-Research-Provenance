+#!/usr/bin/env python3
+"""One separately authorized engineering historical-source check; never science."""
+from __future__ import annotations
+from pathlib import Path
+from datetime import datetime,timezone
+import argparse,json,sys,time
+ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT/'src'))
+from self_improvement.si_s01.contract import insist
+from self_improvement.si_s01.engineering_gate import authenticate_engineering,engineering_binding,verify_artifacts
+
+def main(argv=None):
+    entered=time.monotonic();parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--authorization',type=Path,required=True);parser.add_argument('--authorization-sha256',required=True);parser.add_argument('--proposal',type=Path,required=True)
+    mode=parser.add_mutually_exclusive_group(required=True);mode.add_argument('--preflight-only',action='store_true');mode.add_argument('--live',action='store_true');mode.add_argument('--worker',action='store_true',help=argparse.SUPPRESS)
+    parser.add_argument('--launch-context-sha256',help=argparse.SUPPRESS);args=parser.parse_args(argv)
+    try:
+        insist(sys.flags.isolated==1,'isolated engineering interpreter -I required')
+        phase='preflight' if args.preflight_only else 'worker' if args.worker else 'live'
+        permit=authenticate_engineering(ROOT,args.authorization,args.authorization_sha256,args.proposal,invocation=list(sys.orig_argv),mode=phase,launch_context_sha256=args.launch_context_sha256)
+        if args.preflight_only:
+            print(json.dumps(verify_artifacts(permit)|{'evidence_class':permit.evidence_class,'output_exists':permit.output.exists()}));return 0
+        if args.worker:
+            from self_improvement.si_s01.engineering_runtime import run_engineering_worker
+            return run_engineering_worker(permit)
+        from self_improvement.si_s01.engineering_supervisor import supervise_engineering,engineering_exit_ok
+        from self_improvement.si_s01.engineering_contract import PURPOSE
+        from self_improvement.si_p3.runtime_gate import utc
+        seconds=min(permit.ceilings['seconds'],(utc(permit.authorization['expires_utc'])-datetime.now(timezone.utc)).total_seconds())
+        command=['--worker' if x=='--live' else x for x in sys.orig_argv]
+        context={'purpose':PURPOSE,'science_authorized':False,'evidence_class':permit.evidence_class,'source_sha':permit.authorization['source_sha'],
+            'authorization_sha256':permit.authorization_sha256,'supervisor_argv':list(sys.orig_argv),'allocation_started_monotonic':entered,'engineering_binding':engineering_binding(permit)}
+        r=supervise_engineering(command,permit.output,context=context,seconds=seconds,environment=permit.authorization['environment'])
+        report_path=permit.output/'engineering_report.json';report=json.loads(report_path.read_bytes()) if report_path.is_file() else None
+        return 0 if engineering_exit_ok(r,report) and report['run_id']==permit.authorization['run_id'] and report['history_manifest_sha256']==permit.history.manifest_sha256 else 1
+    except Exception as error:
+        print(json.dumps({'status':'ENGINEERING_REJECTED_OR_STOPPED','science_authorized':False,'exception':type(error).__name__,'message':str(error),'resource_evidence':getattr(error,'resource_evidence',None)}),file=sys.stderr);return 1
+if __name__=='__main__':raise SystemExit(main())
