+''')
+    output=tmp_path/'engineering';ctx=context();ctx['scope']='one_task_engineering_only'
+    result=supervise([sys.executable,'-I',str(script),str(output),str(root)],output,context=ctx,seconds=8,environment=dict(os.environ))
+    assert result['authentic_returncode']==0 and result['child_report_present'] and not result['science_authorized']
+    report=json.loads((output/'engineering'/'engineering_report.json').read_text())
+    assert report['scientific_result'] is False and report['completed']['generations']==1 and report['completed']['environment_operations']==2
