+def authenticate(repository: Path, authorization_path: Path, authorization_sha256: str,
+                 proposal_path: Path, *, worker: bool = False) -> Permit:
+    authorization = json.loads(read_bound(authorization_path, authorization_sha256))
+    proposal_bytes = read_bound(proposal_path, authorization["proposal_sha256"])
+    proposal = json.loads(proposal_bytes)
+    source_sha, clean = git_state(repository)
+    validate_documents(authorization, proposal, proposal_sha256=hashlib.sha256(proposal_bytes).hexdigest(),
+                       source_sha=source_sha, clean=clean,
+                       visible_devices=os.environ.get("CUDA_VISIBLE_DEVICES", ""), now=datetime.now(timezone.utc))
+    require(os.environ.get("HF_HUB_OFFLINE") == "1" and os.environ.get("TRANSFORMERS_OFFLINE") == "1",
+            "offline environment required")
+    import sys
+    interpreter = proposal["interpreter"]
+    require(Path(sys.executable).resolve() == Path(interpreter["path"]).resolve() and
+            file_hash(Path(sys.executable)) == interpreter["sha256"], "pinned interpreter bytes")
+    output = Path(authorization["output_path"])
+    if worker:
+        marker = json.loads((output / "launch_context.json").read_bytes())
+        # The hidden worker must be a fresh-session child of this exact -I supervisor.
+        parent_cmdline = Path(f"/proc/{os.getppid()}/cmdline").read_bytes().split(b"\0")
+        parent_argv = [arg.decode() for arg in parent_cmdline if arg]
+        require(parent_argv == marker["supervisor_argv"] and len(parent_argv) >= 3 and parent_argv[1] == "-I" and
+                Path(parent_argv[2]).resolve() == repository / "scripts/run_si_p3_engineering_probe.py" and
+                "--worker" not in parent_argv and os.getsid(0) == os.getpid(), "direct/foreign worker supervisor")
+        import ctypes, signal
+        libc = ctypes.CDLL(None, use_errno=True)
+        require(libc.prctl(1, signal.SIGKILL, 0, 0, 0) == 0, "worker parent-death signal unavailable")
+        require(marker["authorization_sha256"] == authorization_sha256 and marker["supervisor_pid"] == os.getppid() and
+                marker["source_sha"] == source_sha, "worker must belong to authenticated supervisor")
+    else:
+        require(not output.exists() and not output.is_symlink(), "output exists; no retry or overwrite")
+    return Permit(authorization, proposal, authorization_sha256, authorization["proposal_sha256"], repository)
